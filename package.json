{
  "name": "bibli",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run repo:validate && npm run ui:validate && npm run i18n:audit && npm run personal:validate && npm run studies:validate && npm run studies:import && npm run content:validate && npm run bibliimg:validate && npm run bibliimg:publish:check && npm run connections:validate && npm run db:validate",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "clean:generated": "node scripts/clean-generated.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "db:validate": "node scripts/validate-db.mjs",
    "learning:validate": "node scripts/validate-learning-model.mjs",
    "repo:validate": "node scripts/validate-repository.mjs",
    "studies:sync": "node scripts/sync-studies.mjs",
    "studies:validate": "node scripts/validate-studies.mjs",
    "studies:import": "node scripts/import-studies.mjs",
    "studies:refresh": "npm run studies:sync && npm run studies:validate && npm run studies:import && npm run studies:status",
    "bible:import:rvr1960": "node scripts/import-bible-rvr1960.mjs",
    "bible:validate:kjv": "node scripts/validate-bible-kjv.mjs",
    "bible:import:kjv": "node scripts/import-bible-kjv.mjs",
    "bible:audit:kjv": "node scripts/audit-bible-kjv-text.mjs",
    "bible:audit:kjv:spacing": "node scripts/audit-bible-kjv-spacing.mjs",
    "studies:status": "node scripts/studies-status.mjs",
    "ui:validate": "node scripts/validate-ui.mjs",
    "postbuild": "npm run site:audit && npm run derived:validate",
    "site:audit": "node scripts/audit-site.mjs",
    "i18n:audit": "node scripts/audit-i18n.mjs",
    "personal:validate": "node scripts/validate-personal-state.mjs",
    "qa:e2e:setup": "node scripts/setup-browser-qa.mjs",
    "qa:e2e": "node scripts/run-browser-qa.mjs",
    "qa:search": "npm run qa:quick-build && node scripts/run-browser-qa.mjs tests/e2e/bible-reference-search.spec.ts tests/e2e/search-ranking.spec.ts --project=desktop-chromium --workers=3",
    "qa:fast": "npm run qa:quick-build && node scripts/run-browser-qa.mjs tests/e2e/accessibility.spec.ts tests/e2e/bible-reference-search.spec.ts tests/e2e/personal.spec.ts tests/e2e/responsive.spec.ts tests/e2e/search-ranking.spec.ts tests/e2e/smoke.spec.ts --project=desktop-chromium --workers=3",
    "qa:all": "npm run build && npm run qa:e2e",
    "qa:ci": "node scripts/run-browser-qa.mjs",
    "qa:certify": "npm run build && npm run qa:ci",
    "content:validate": "node scripts/validate-content.mjs",
    "derived:validate": "node scripts/validate-derived-output.mjs",
    "connections:validate": "node scripts/validate-connections.mjs",
    "bibliimg:validate": "node scripts/validate-bibli-images.mjs",
    "bibliimg:sync": "node scripts/sync-bibli-images.mjs",
    "bibliimg:sync:check": "node scripts/sync-bibli-images.mjs --check",
    "bibliimg:plan": "node scripts/plan-bibli-image-glossary.mjs",
    "bibliimg:plan:check": "node scripts/plan-bibli-image-glossary.mjs --check",
    "bibliimg:publish:preview": "node scripts/publish-bibli-image-glossary.mjs --preview",
    "bibliimg:publish": "node scripts/publish-bibli-image-glossary.mjs --apply",
    "bibliimg:publish:check": "node scripts/publish-bibli-image-glossary.mjs --check",
    "bibliimg:r2:plan": "node scripts/publish-bibli-images-r2.mjs --plan",
    "bibliimg:r2:publish": "node scripts/publish-bibli-images-r2.mjs --publish",
    "bibliimg:r2:check": "node scripts/publish-bibli-images-r2.mjs --check",
    "qa:quick-build": "astro build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "astro": "^7.0.3",
    "better-sqlite3": "^12.11.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "js-yaml": "4.3.0",
    "sharp": "0.34.5"
  }
}
