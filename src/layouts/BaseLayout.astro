    /* Header compacto global */
  .site-header {
    position: relative;
    z-index: 50;
    align-items: center;
    flex-direction: row;
  }

  .logo {
    flex: 1 1 auto;
    min-width: 0;
  }

  .header-actions {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
  }

  .global-search-shell,
  .global-menu-shell {
    position: relative;
  }

  .global-search-form {
    display: inline-flex;
    align-items: center;
    width: min(320px, 36vw);
    min-height: 42px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--surface-elevated);
    overflow: hidden;
    transition:
      width 180ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .global-search-form input {
    width: 100%;
    min-width: 0;
    height: 42px;
    padding: 0 6px 0 16px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--heading-color);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 750;
  }

  .global-search-form input::-webkit-search-cancel-button,
  .global-search-form input::-webkit-search-decoration,
  .global-search-form input::-webkit-search-results-button,
  .global-search-form input::-webkit-search-results-decoration {
    display: none;
    -webkit-appearance: none;
  }

  .global-search-form input::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }

  .global-search-submit,
  .global-search-toggle,
  .menu-toggle,
  .language-switch {
    display: inline-flex;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font: inherit;
    font-size: 1rem;
    font-weight: 900;
    cursor: pointer;
  }

  .language-switch {
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .global-search-toggle[aria-expanded="true"] {
    font-size: 1.15rem;
  }

  .global-search-submit {
    pointer-events: auto;
  }

  .global-search-submit.is-close {
    font-size: 1.15rem;
    line-height: 1;
  }

  .global-search-submit {
    border-top: 0;
    border-right: 0;
    border-bottom: 0;
    border-left: 1px solid var(--border-color);
    border-radius: 0;
  }

  .global-search-submit:hover,
  .global-search-toggle:hover,
  .menu-toggle:hover,
  .language-switch:hover {
    background: var(--surface-muted);
  }

  .global-search-popover,
  .global-menu {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    border: 1px solid var(--border-color);
    border-radius: 22px;
    background: var(--surface);
    box-shadow: 0 22px 60px rgba(15, 23, 42, 0.18);
  }

  .global-search-popover {
    display: grid;
    gap: 12px;
    width: min(520px, calc(100vw - 32px));
    padding: 14px;
  }

  .global-search-popover[hidden],
  .global-menu[hidden] {
    display: none;
  }

  .global-search-filters {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--accent) 32%, transparent) transparent;
  }

  .global-search-filters::-webkit-scrollbar {
    height: 8px;
  }

  .global-search-filters::-webkit-scrollbar-track {
    background: transparent;
  }

  .global-search-filters::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .global-search-filters::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, var(--accent) 44%, transparent);
  }

  .global-search-filters button {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 44px;
    align-items: center;
    gap: 6px;
    padding: 0 11px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--surface-elevated);
    color: var(--accent);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 900;
    cursor: pointer;
  }

  .global-search-results {
    display: grid;
    gap: 8px;
    max-height: 370px;
    overflow-y: auto;
    padding: 5px 7px 5px 5px;
    scroll-padding-block: 5px;
    box-sizing: border-box;
  }

  .global-search-results::-webkit-scrollbar {
    width: 8px;
  }

  .global-search-results::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .global-search-state.is-error { color:var(--text-muted); border-color:color-mix(in srgb,var(--accent) 34%,var(--border-color)); background:var(--surface-soft); }

  .global-search-result {
    display: grid;
    gap: 4px;
    padding: 12px 13px;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    background: var(--surface-elevated);
    text-decoration: none;
  }

  .global-search-result span {
    color: var(--accent);
