    line-height: 1.7;
  }

  .notice-box strong {
    color: var(--heading-color);
  }

  .site-footer {
    max-width: 1120px;
    margin: 48px auto 0;
    padding: 28px max(20px,env(safe-area-inset-right)) max(40px,env(safe-area-inset-bottom)) max(20px,env(safe-area-inset-left));
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .site-footer-inner {
    display: grid;
    gap: 14px;
    border-top: 1px solid var(--border-color);
