---
import { sitePath } from "../lib/site-paths";
import { getBibleRootPath } from "../lib/bible-routes";
import Icon from "../components/Icon.astro";
import GlobalTTS from "../components/GlobalTTS.astro";

type LanguageCode = "es" | "en";

type AlternateLanguage = {
  code: LanguageCode;
  label: string;
  href: string;
};

interface Props {
  title: string;
  description?: string;
  lang?: LanguageCode;
  alternateLanguage?: AlternateLanguage;
}

const {
  title,
  lang = "es",
  alternateLanguage,
} = Astro.props;

const ui = {
  es: {
    siteName: "BIBLIOTECA BÍBLICA",
    shortName: "Bibli",
    defaultDescription: "Recursos para escudriñar y comprender las Escrituras.",
    searchOpen: "Abrir búsqueda",
    searchClose: "Cerrar búsqueda",
    searchIcon: "Icono de búsqueda",
    searchLabel: "Búsqueda global",
    searchInputLabel: "Buscar en Bibli",
    searchPlaceholder: "Biblia, lecciones, rutas…",
    searchFilters: "Filtros de búsqueda",
    searchResults: "Resultados de búsqueda",
    searchAll: "Ver todos los resultados →",
    searchEmpty: "Escribe una palabra para comenzar.",
    searchNone: "No se encontraron resultados.",
    searchAdvanced: "Búsqueda avanzada",
    menuOpen: "Abrir menú",
    menuLabel: "Menú principal",
    mainRoute: "Ruta principal",
    readBible: "Leer la Biblia",
    resources: "Recursos visuales",
    explore: "Explorar",
    about: "Acerca de Bibli",
    installApp: "Instalar Bibli",
    offlineLibrary: "Sin conexión",
    theme: "Tema",
    themeAuto: "Automático",
    themeLight: "Claro",
    themeDark: "Oscuro",
    themeCycle: "Cambiar tema",
    appearance: "Apariencia",
    accent: "Color de énfasis",
    accentEarth: "Tierra",
    accentOcean: "Azul",
    accentForest: "Bosque",
    accentPlum: "Ciruela",
    accentClay: "Arcilla",
    footerText: "Biblioteca Bíblica · Recursos para escudriñar y comprender las Escrituras.",
    footerLabel: "Navegación secundaria",
    legal: "Avisos legales",
    all: "Todos",
    skipContent: "Saltar al contenido",
  },
  en: {
    siteName: "BIBLICAL LIBRARY",
    shortName: "Bibli",
    defaultDescription: "Resources for studying and understanding the Scriptures.",
    searchOpen: "Open search",
    searchClose: "Close search",
    searchIcon: "Search icon",
    searchLabel: "Global search",
    searchInputLabel: "Search Bibli",
    searchPlaceholder: "Search...",
    searchFilters: "Search filters",
    searchResults: "Search results",
    searchAll: "View all results →",
    searchEmpty: "Type a word to begin.",
    searchNone: "No results found.",
    searchAdvanced: "Advanced search",
    menuOpen: "Open menu",
    menuLabel: "Main menu",
    mainRoute: "Main route",
    readBible: "Read the Bible",
    resources: "Visual resources",
    explore: "Explore",
    about: "About Bibli",
    installApp: "Install Bibli",
    offlineLibrary: "Offline",
    theme: "Theme",
    themeAuto: "Automatic",
    themeLight: "Light",
    themeDark: "Dark",
    themeCycle: "Change theme",
    appearance: "Appearance",
    accent: "Accent color",
    accentEarth: "Earth",
    accentOcean: "Blue",
    accentForest: "Forest",
    accentPlum: "Plum",
    accentClay: "Clay",
    footerText: "Biblical Library · Resources for studying and understanding the Scriptures.",
    footerLabel: "Secondary navigation",
    legal: "Legal notices",
    all: "All",
    skipContent: "Skip to content",
  },
} as const;

const activeUi = ui[lang];
const description = Astro.props.description ?? activeUi.defaultDescription;
const siteName = activeUi.siteName;
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;

const searchDataUrl =
  lang === "en"
    ? sitePath("/en/search/data.json")
    : sitePath("/buscar/datos.json");
const searchPageUrl =
  lang === "en" ? sitePath("/en/search/") : sitePath("/buscar/");
const homeUrl = lang === "en" ? sitePath("/en/") : sitePath("/");
const bibleRootUrl = getBibleRootPath(lang);
const manifestUrl = sitePath("/manifest.webmanifest");
const serviceWorkerUrl = sitePath("/sw.js");
const appleTouchIconUrl = sitePath("/icons/apple-touch-icon.png");
const serviceWorkerEnabled = import.meta.env.PROD;

const normalizePathname = (value: string) => {
  const pathname = new URL(value, Astro.url).pathname;
  return pathname === "/" ? "/" : `${pathname.replace(/\/+$/, "")}/`;
};
const currentPathname = normalizePathname(Astro.url.pathname);
const isCurrentNavigationItem = (href: string) => {
  const targetPathname = normalizePathname(href);
  return targetPathname === "/"
    ? currentPathname === "/"
    : currentPathname === targetPathname || currentPathname.startsWith(targetPathname);
};

const menuItems =
  lang === "en"
    ? [
        { href: searchPageUrl, label: activeUi.searchAdvanced, icon: "search" as const },
        { href: bibleRootUrl, label: activeUi.readBible, icon: "book" as const },
        { href: sitePath("/en/download/"), label: activeUi.offlineLibrary, icon: "download" as const },
      ]
    : [
        { href: searchPageUrl, label: activeUi.searchAdvanced, icon: "search" as const },
        {
          href: sitePath("/rutas/"),
          label: activeUi.mainRoute,
          icon: "route" as const,
        },
        { href: bibleRootUrl, label: activeUi.readBible, icon: "book" as const },
        { href: sitePath("/descargar/"), label: activeUi.offlineLibrary, icon: "download" as const },
        { href: sitePath("/explorar/"), label: activeUi.explore, icon: "compass" as const },
        { href: sitePath("/recursos/"), label: activeUi.resources, icon: "image" as const },
        { href: sitePath("/acerca/"), label: activeUi.about, icon: "info" as const },
      ];

const footerItems =
  lang === "en"
    ? [
        { href: searchPageUrl, label: activeUi.searchAdvanced },
        { href: bibleRootUrl, label: activeUi.readBible },
        { href: sitePath("/en/download/"), label: activeUi.offlineLibrary },
      ]
    : [
        { href: searchPageUrl, label: activeUi.searchAdvanced },
        { href: bibleRootUrl, label: activeUi.readBible },
        { href: sitePath("/descargar/"), label: activeUi.offlineLibrary },
        { href: sitePath("/rutas/"), label: activeUi.mainRoute },
        { href: sitePath("/explorar/"), label: activeUi.explore },
        { href: sitePath("/acerca/"), label: activeUi.about },
        { href: sitePath("/legal/"), label: activeUi.legal },
      ];

const canonicalHref = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.href;
const alternateHref = alternateLanguage
  ? Astro.site
    ? new URL(alternateLanguage.href, Astro.site).toString()
    : alternateLanguage.href
  : null;
const languageTarget = alternateLanguage ?? {
  code: (lang === "es" ? "en" : "es") as LanguageCode,
  label: lang === "es" ? "English" : "Spanish",
  href: lang === "es" ? getBibleRootPath("en") : getBibleRootPath("es"),
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalHref} />
    {alternateLanguage && alternateHref && (
      <link
        rel="alternate"
        hreflang={alternateLanguage.code}
        href={alternateHref}
      />
    )}
    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} />
    <link rel="manifest" href={manifestUrl} />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} />
    <meta name="theme-color" content="#5f4769" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Bibli" />

    <style is:inline>
      html[data-theme="dark"] .button {
        background: var(--accent) !important;
        border-color: var(--accent) !important;
        color: var(--accent-contrast) !important;
      }

      html[data-theme="dark"] .button.secondary {
        background: transparent !important;
        border-color: var(--accent-hover) !important;
        color: var(--accent) !important;
      }

      html[data-theme="dark"] .button.secondary:hover {
        background: var(--surface-muted) !important;
        border-color: var(--accent) !important;
        color: var(--heading-color) !important;
      }

      .hero {
        position: relative;
        overflow: hidden;
      }

      .hero::after {
        content: "";
        position: absolute;
        right: -90px;
        bottom: -120px;
        width: 320px;
        height: 320px;
        border-radius: 999px;
        background: radial-gradient(circle, color-mix(in srgb, var(--accent) 16%, transparent), transparent 68%);
        pointer-events: none;
      }

      .hero > * {
        position: relative;
        z-index: 1;
      }

            /*
        Estilo crítico para evitar parpadeo de la línea de tiempo.
        Debe coincidir con el layout final de /linea-de-tiempo/ desde el primer render.
      */
      .timeline-ready .timeline-period,
      .timeline-ready .timeline-card,
      .timeline-ready .timeline-card-header,
      .timeline-ready .timeline-marker,
      .timeline-ready .timeline-marker span,
      .timeline-ready .timeline-date,
      .timeline-ready .timeline-order,
      .timeline-ready .timeline-meta,
      .timeline-ready .timeline-meta span,
      .timeline-ready .timeline-period-header strong {
        box-sizing: border-box;
      }

      .timeline-ready .timeline-period {
        display: grid;
        gap: 18px;
        padding: 22px;
        border-radius: 24px;
      }

      .timeline-ready .timeline-period-header strong {
        display: inline-flex;
        min-height: 34px;
        max-width: 100%;
        align-items: center;
        padding: 7px 12px;
        border-radius: 18px;
        background: var(--surface);
        border: 1px solid var(--border-color);
        color: var(--accent);
        font-size: 0.86rem;
        line-height: 1.22;
        white-space: normal;
        overflow-wrap: anywhere;
      }

      .timeline-ready .timeline-list {
        position: relative;
        display: grid;
        gap: 14px;
      }

      .timeline-ready .timeline-list::before {
        content: "";
        position: absolute;
        top: 12px;
        bottom: 12px;
        left: 13px;
        width: 2px;
        background: var(--border-color);
      }

      .timeline-ready .timeline-item {
        position: relative;
        display: grid;
        grid-template-columns: 28px minmax(0, 1fr);
        gap: 14px;
      }

      .timeline-ready .timeline-marker {
        position: relative;
        display: flex;
        justify-content: center;
        padding-top: 18px;
        z-index: 1;
      }

      .timeline-ready .timeline-marker span {
        width: 12px;
        height: 12px;
        flex: 0 0 12px;
        border-radius: 999px;
        background: var(--accent);
        border: 3px solid var(--surface-elevated);
        box-shadow: 0 0 0 1px var(--border-strong);
      }

      .timeline-ready .timeline-card {
        display: grid;
        gap: 10px;
        min-width: 0;
        padding: 18px;
        border-radius: 20px;
        background: var(--surface);
        border: 1px solid var(--border-color);
      }

      .timeline-ready .timeline-card-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
      }

      .timeline-ready .timeline-date,
      .timeline-ready .timeline-order,
      .timeline-ready .timeline-meta span {
        display: inline-flex;
        min-height: 30px;
        max-width: 100%;
        align-items: center;
        padding: 7px 12px;
        border-radius: 18px;
        background: var(--accent-soft);
        border: 1px solid var(--border-color);
        color: var(--accent);
        line-height: 1.22;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: normal;
      }

      .timeline-ready .timeline-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        min-width: 0;
      }

      html[data-theme="dark"] .timeline-ready .timeline-list::before {
        background: var(--surface-muted);
      }

      html[data-theme="dark"] .timeline-ready .timeline-marker span {
        background: var(--accent);
        border-color: var(--surface-soft);
        box-shadow: 0 0 0 1px var(--accent-hover);
      }

      html[data-theme="dark"] .timeline-ready .timeline-period-header strong,
      html[data-theme="dark"] .timeline-ready .timeline-date,
      html[data-theme="dark"] .timeline-ready .timeline-order,
      html[data-theme="dark"] .timeline-ready .timeline-meta span {
        background: var(--surface);
        border-color: var(--border-color);
        color: var(--accent);
      }

      @media (max-width: 640px) {
        .timeline-ready .timeline-period {
          padding: 18px;
        }

        .timeline-ready .timeline-card {
          padding: 18px;
        }

        .timeline-ready .timeline-card-header {
          flex-direction: column;
          align-items: flex-start;
        }

        .timeline-ready .timeline-date,
        .timeline-ready .timeline-order,
        .timeline-ready .timeline-meta span {
          padding: 8px 12px;
          border-radius: 16px;
          line-height: 1.25;
          letter-spacing: 0.06em;
        }

        .timeline-ready .timeline-date {
          max-width: min(100%, 220px);
        }
      }

      .timeline-page .timeline-date,
      .timeline-page .timeline-order,
      .timeline-page .timeline-meta span {
        background: var(--accent-soft);
        border: 1px solid var(--border-color);
        color: var(--accent);
      }

      .timeline-page .timeline-period-header strong {
        background: var(--surface);
        border: 1px solid var(--border-color);
        color: var(--accent);
      }

      html[data-theme="dark"] .timeline-page .timeline-period-header strong,
      html[data-theme="dark"] .timeline-page .timeline-date,
      html[data-theme="dark"] .timeline-page .timeline-order,
      html[data-theme="dark"] .timeline-page .timeline-meta span {
        background: var(--surface);
        border-color: var(--border-color);
        color: var(--accent);
      }

      @media (max-width: 640px) {
        .timeline-page .timeline-date,
        .timeline-page .timeline-order,
        .timeline-page .timeline-meta span {
          padding: 8px 12px;
          border-radius: 16px;
          line-height: 1.25;
          letter-spacing: 0.06em;
        }

        .timeline-page .timeline-date {
          max-width: min(100%, 220px);
        }

        .timeline-page .timeline-meta span {
          max-width: 100%;
        }
      }

      html[data-theme="dark"] .lesson-progress-panel,
      html[data-theme="dark"] .lesson-toc a,
      html[data-theme="dark"] .mini-nav-link {
        background: var(--surface) !important;
        border-color: var(--border-color) !important;
        color: var(--heading-color) !important;
      }

      html[data-theme="dark"] .lesson-progress-panel *,
      html[data-theme="dark"] .lesson-toc a,
      html[data-theme="dark"] .mini-nav-link span,
      html[data-theme="dark"] .mini-nav-link strong {
        color: inherit;
      }

      html[data-theme="dark"] .lesson-toc a,
      html[data-theme="dark"] .mini-nav-link span {
        color: var(--accent) !important;
      }

      html[data-theme="dark"] .mini-nav-link strong,
      html[data-theme="dark"] .lesson-progress-main h2,
      html[data-theme="dark"] .lesson-progress-main strong {
        color: var(--heading-color) !important;
      }

      html[data-theme="dark"] .lesson-progress-main p {
        color: var(--text-muted) !important;
      }

      html[data-theme="dark"] .lesson-progress-bar {
        background: var(--surface-muted) !important;
      }

      html[data-theme="dark"] .lesson-progress-bar span {
        background: var(--accent) !important;
      }
    </style>

    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        const currentKey = "bibli-theme";
        const accentKey = "bibli-accent";
        const storedPreference = localStorage.getItem(currentKey);
        const storedAccent = localStorage.getItem(accentKey);

        const preference =
          storedPreference === "auto" ||
          storedPreference === "light" ||
          storedPreference === "dark"
            ? storedPreference
            : "auto";

        const effectiveTheme =
          preference === "auto"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : preference;

        document.documentElement.dataset.theme = effectiveTheme;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.accent = ["earth", "ocean", "forest", "plum", "clay"].includes(storedAccent ?? "")
          ? storedAccent
          : "plum";

        const lessonMode = localStorage.getItem("bibli-lesson-mode-v1") === "reading" ? "reading" : "study";
        const studyAids = localStorage.getItem("bibli-study-aids-v1") === "hidden" ? "hidden" : "visible";
        const storedToc = localStorage.getItem("bibli-lesson-toc-v1") === "hidden" ? "hidden" : "visible";
        const mobileToc = window.matchMedia("(max-width: 920px)").matches;
        document.documentElement.dataset.lessonMode = lessonMode;
        document.documentElement.dataset.studyAids = studyAids;
        document.documentElement.dataset.lessonToc = mobileToc ? "hidden" : storedToc;

        const storedReaderSize = localStorage.getItem("bibli-reader-size-v1");
        const storedReaderFont = localStorage.getItem("bibli-reader-font-v1");
        const storedReaderAlign = localStorage.getItem("bibli-reader-align-v1");
        document.documentElement.dataset.readerSize = ["small", "large"].includes(storedReaderSize ?? "") ? storedReaderSize : "default";
        document.documentElement.dataset.readerFont = ["sans", "serif"].includes(storedReaderFont ?? "") ? storedReaderFont : "default";
        document.documentElement.dataset.readerAlign = ["left", "justify"].includes(storedReaderAlign ?? "") ? storedReaderAlign : "default";
      })();
    </script>
  </head>

  <body data-service-worker-url={serviceWorkerUrl} data-service-worker-enabled={serviceWorkerEnabled ? "true" : "false"}>
    <a class="skip-link" href="#bibli-content">{activeUi.skipContent}</a>
    <header class="site-header" data-site-header>
      <a href={homeUrl} class="logo" aria-label={siteName}>{activeUi.shortName}</a>

      <div class="header-actions">
        <div
          class="global-search-shell"
          data-global-search-shell
          data-search-url={searchDataUrl}
          data-empty-label={activeUi.searchEmpty}
          data-none-label={activeUi.searchNone}
          data-all-label={activeUi.searchAll}
          data-advanced-label={activeUi.searchAdvanced}
          data-filter-all-label={activeUi.all}
          data-search-open-label={activeUi.searchOpen}
          data-search-close-label={activeUi.searchClose}
          data-search-icon-label={activeUi.searchIcon}
        >
          <button
            type="button"
            class="global-search-toggle"
            data-global-search-toggle
            aria-label={activeUi.searchOpen}
            aria-expanded="false"
            aria-controls="bibli-global-search"
            aria-keyshortcuts="/ Control+k Meta+k"
          ><Icon name="search" size={18} /></button>

          <form
            id="bibli-global-search"
            class="global-search-form"
            action={searchPageUrl}
            method="get"
            role="search"
            aria-label={activeUi.searchLabel}
            data-global-search-form
          >
            <label class="sr-only" for="global-search">
              {activeUi.searchInputLabel}
            </label>

            <input
              id="global-search"
              name="q"
              type="search"
              placeholder={activeUi.searchPlaceholder}
              autocomplete="off"
              data-global-search-input
            />

            <button
              type="button"
              class="global-search-submit"
              data-global-search-submit
              aria-label={activeUi.searchOpen}
            ><span class="search-open-icon"><Icon name="search" size={18} /></span><span class="search-close-icon"><Icon name="close" size={18} /></span></button>
          </form>

          <div
            class="global-search-popover"
            data-global-search-popover
            hidden
          >
            <div
              class="global-search-filters"
              data-global-search-filters
              aria-label={activeUi.searchFilters}
            ></div>

            <div
              class="global-search-results"
              data-global-search-results
              aria-label={activeUi.searchResults}
              aria-live="polite"
              aria-atomic="false"
            ></div>

            <a
              href={searchPageUrl}
              class="global-search-all"
              data-global-search-all
            >
              {activeUi.searchAll}
            </a>
          </div>
        </div>

        <a
          class="language-switch"
          href={languageTarget.href}
          hreflang={languageTarget.code}
          lang={languageTarget.code}
          title={languageTarget.label}
          data-language-switch
          data-language-code={languageTarget.code}
        >
          <Icon name="globe" size={16} />
          <span>{languageTarget.code.toUpperCase()}</span>
        </a>

        <button
          type="button"
          class="theme-quick-toggle"
          data-theme-quick-toggle
          aria-label={activeUi.themeCycle}
          title={activeUi.themeCycle}
        >
          <span class="quick-theme-light"><Icon name="moon" size={17} /></span>
          <span class="quick-theme-dark"><Icon name="sun" size={17} /></span>
        </button>

        <div class="global-menu-shell">
          <button
            type="button"
            class="menu-toggle"
            data-menu-toggle
            aria-label={activeUi.menuOpen}
            aria-expanded="false"
            aria-controls="bibli-global-menu"
          ><Icon name="grid" size={18} /></button>

          <nav
            id="bibli-global-menu"
            class="global-menu"
            data-global-menu
            aria-label={activeUi.menuLabel}
            hidden
          >
            <div class="menu-links">
              {menuItems.map((item) => {
                const current = isCurrentNavigationItem(item.href);
                return (
                  <a
                    href={item.href}
                    class:list={{ "is-current": current }}
                    aria-current={current ? "page" : undefined}
                  >
                    <Icon name={item.icon} size={17} />
                    <span>{item.label}</span>
                  </a>
                );
              })}
            </div>

            <button type="button" class="install-app-button" data-install-app hidden>
              <Icon name="download" size={17} />
              <span>{activeUi.installApp}</span>
            </button>

            <div class="appearance-panel">
              <div class="appearance-title"><Icon name="palette" size={17} /><strong>{activeUi.appearance}</strong></div>
              <div class="appearance-group">
                <span>{activeUi.theme}</span>
                <div class="theme-options" role="group" aria-label={activeUi.theme}>
                  <button type="button" data-theme-choice="auto" aria-label={activeUi.themeAuto}><Icon name="monitor" size={15} /><span>{activeUi.themeAuto}</span></button>
                  <button type="button" data-theme-choice="light" aria-label={activeUi.themeLight}><Icon name="sun" size={15} /><span>{activeUi.themeLight}</span></button>
                  <button type="button" data-theme-choice="dark" aria-label={activeUi.themeDark}><Icon name="moon" size={15} /><span>{activeUi.themeDark}</span></button>
                </div>
              </div>
              <div class="appearance-group">
                <span>{activeUi.accent}</span>
                <div class="accent-options" role="group" aria-label={activeUi.accent}>
                  <button type="button" data-accent-choice="earth" title={activeUi.accentEarth} aria-label={activeUi.accentEarth}><span class="accent-swatch earth"></span></button>
                  <button type="button" data-accent-choice="ocean" title={activeUi.accentOcean} aria-label={activeUi.accentOcean}><span class="accent-swatch ocean"></span></button>
                  <button type="button" data-accent-choice="forest" title={activeUi.accentForest} aria-label={activeUi.accentForest}><span class="accent-swatch forest"></span></button>
                  <button type="button" data-accent-choice="plum" title={activeUi.accentPlum} aria-label={activeUi.accentPlum}><span class="accent-swatch plum"></span></button>
                  <button type="button" data-accent-choice="clay" title={activeUi.accentClay} aria-label={activeUi.accentClay}><span class="accent-swatch clay"></span></button>
                </div>
              </div>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <div id="bibli-content" class="content-anchor" tabindex="-1"></div>
    <slot />

    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>{activeUi.footerText}</p>

        <nav class="footer-links" aria-label={activeUi.footerLabel}>
          {footerItems.map((item) => {
            const current = isCurrentNavigationItem(item.href);
            return (
              <a href={item.href} aria-current={current ? "page" : undefined}>{item.label}</a>
            );
          })}
        </nav>
      </div>
    </footer>
    <GlobalTTS lang={lang} />
    <script>
  import {
    SEARCH_FILTER_ORDER,
    getAvailableSearchFilters,
    getDisplaySearchResults,
    getSearchCounts,
    getSearchResults,
    normalizeSearchText,
  } from "../lib/search-engine";

  (() => {
    const siteHeader = document.querySelector("[data-site-header]");
    const themeChoiceButtons = document.querySelectorAll("[data-theme-choice]");
    const accentChoiceButtons = document.querySelectorAll("[data-accent-choice]");
    const themeQuickToggle = document.querySelector("[data-theme-quick-toggle]");

    const menuToggle = document.querySelector("[data-menu-toggle]");
    const globalMenu = document.querySelector("[data-global-menu]");
    const languageSwitch = document.querySelector("[data-language-switch]");
    const installButton = document.querySelector("[data-install-app]");
    let deferredInstallPrompt;

    const searchShell = document.querySelector("[data-global-search-shell]");
    const searchToggle = document.querySelector("[data-global-search-toggle]");
    const searchForm = document.querySelector("[data-global-search-form]");
    const searchInput = document.querySelector("[data-global-search-input]");
    const searchSubmit = document.querySelector("[data-global-search-submit]");
    const searchPopover = document.querySelector("[data-global-search-popover]");
    const searchFilters = document.querySelector("[data-global-search-filters]");
    const searchResults = document.querySelector("[data-global-search-results]");
    const searchAllLink = document.querySelector("[data-global-search-all]");

    const ALL_SEARCH_TYPE = "Todos";
    const THEME_KEY = "bibli-theme";
    const ACCENT_KEY = "bibli-accent";
    const LANGUAGE_KEY = "bibli-language";

    const searchEmptyLabel =
      searchShell?.getAttribute("data-empty-label") ??
      "Escribe una palabra para comenzar.";
    const searchNoneLabel =
      searchShell?.getAttribute("data-none-label") ??
      "No se encontraron resultados.";
    const searchAllLabel =
      searchShell?.getAttribute("data-all-label") ??
      "Ver todos los resultados →";
    const searchAdvancedLabel =
      searchShell?.getAttribute("data-advanced-label") ??
      "Búsqueda avanzada";
    const filterAllLabel =
      searchShell?.getAttribute("data-filter-all-label") ?? "Todos";
    const searchOpenLabel =
      searchShell?.getAttribute("data-search-open-label") ??
      "Abrir búsqueda";
    const searchCloseLabel =
      searchShell?.getAttribute("data-search-close-label") ??
      "Cerrar búsqueda";
    const searchIconLabel =
      searchShell?.getAttribute("data-search-icon-label") ??
      "Icono de búsqueda";

    let searchItems = null;
    let activeSearchType = ALL_SEARCH_TYPE;
    let globalSearchDebounceTimer;

    function getThemePreference() {
      const storedTheme = localStorage.getItem(THEME_KEY);

      if (
        storedTheme === "auto" ||
        storedTheme === "light" ||
        storedTheme === "dark"
      ) {
        return storedTheme;
      }

      return "auto";
    }

    function getEffectiveTheme(preference) {
      if (preference === "light" || preference === "dark") {
        return preference;
      }

      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }

    function applyThemePreference(preference) {
      document.documentElement.dataset.theme =
        getEffectiveTheme(preference);
      document.documentElement.dataset.themePreference = preference;
    }

    function syncThemeChoices(preference) {
      themeChoiceButtons.forEach((button) => {
        const active = button.getAttribute("data-theme-choice") === preference;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    }

    function getAccentPreference() {
      const accent = localStorage.getItem(ACCENT_KEY);
      return ["earth", "ocean", "forest", "plum", "clay"].includes(accent ?? "") ? accent : "plum";
    }

    function applyAccentPreference(accent) {
      document.documentElement.dataset.accent = accent;
      accentChoiceButtons.forEach((button) => {
        const active = button.getAttribute("data-accent-choice") === accent;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    }

    function setAccentPreference(accent) {
      localStorage.setItem(ACCENT_KEY, accent);
      applyAccentPreference(accent);
    }

    function setThemePreference(preference) {
      localStorage.setItem(THEME_KEY, preference);
      applyThemePreference(preference);
      syncThemeChoices(preference);
    }

    function syncThemeFromStorage() {
      const preference = getThemePreference();
      applyThemePreference(preference);
      syncThemeChoices(preference);
    }

    function normalizeText(value) {
      return normalizeSearchText(value);
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function escapeRegExp(value) {
      return String(value).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }

    function getHighlightWords(query) {
      return Array.from(
        new Set(
          normalizeText(query)
            .split(/\s+/)
            .filter((word) => word.length >= 3)
        )
      );
    }

    function highlightMatches(value, query) {
      const safeValue = escapeHtml(value);
      const words = getHighlightWords(query);

      if (words.length === 0) {
        return safeValue;
      }

      const pattern = new RegExp(`(${words.map(escapeRegExp).join("|")})`, "gi");

      return safeValue.replace(pattern, "<mark>$1</mark>");
    }

    async function loadSearchItems() {
      if (searchItems) return searchItems;

      const searchUrl = searchShell?.getAttribute("data-search-url");

      if (!searchUrl) {
        searchItems = [];
        return searchItems;
      }

      try {
        const response = await fetch(searchUrl);
        searchItems = await response.json();
      } catch {
        searchItems = [];
      }

      return searchItems;
    }

    function openMenu({ focusFirst = false } = {}) {
      if (!globalMenu || !menuToggle) return;

      globalMenu.hidden = false;
      menuToggle.setAttribute("aria-expanded", "true");

      if (focusFirst) {
        window.requestAnimationFrame(() => {
          const firstControl = globalMenu.querySelector("a, button");
          if (firstControl instanceof HTMLElement) firstControl.focus();
        });
      }
    }

    function closeMenu({ returnFocus = false } = {}) {
      if (!globalMenu || !menuToggle) return;

      const hadFocusInside = globalMenu.contains(document.activeElement);
      globalMenu.hidden = true;
      menuToggle.setAttribute("aria-expanded", "false");

      if (returnFocus && hadFocusInside) menuToggle.focus();
    }

    function toggleMenu() {
      if (!globalMenu) return;

      if (globalMenu.hidden) {
        openMenu();
        closeSearchPopover();
      } else {
        closeMenu();
      }
    }

    function openSearchShell() {
      if (!searchShell || !searchToggle) return;

      searchShell.classList.add("is-open");
      siteHeader?.classList.add("search-open");
      searchToggle.setAttribute("aria-expanded", "true");
      searchToggle.setAttribute("aria-label", searchCloseLabel);
      syncSearchSubmitIcon();

      window.requestAnimationFrame(() => {
        searchInput?.focus();
      });
    }

    function closeSearchShell({ returnFocus = false } = {}) {
      if (!searchShell || !searchToggle) return;

      const hadFocusInside = searchShell.contains(document.activeElement);
      searchShell.classList.remove("is-open");
      siteHeader?.classList.remove("search-open");
      searchToggle.setAttribute("aria-expanded", "false");
      searchToggle.setAttribute("aria-label", searchOpenLabel);
      closeSearchPopover();
      syncSearchSubmitIcon();

      if (returnFocus && hadFocusInside) searchToggle.focus();
    }

    function openSearchPopover() {
      if (!searchPopover) return;

      searchPopover.hidden = false;
    }

    function closeSearchPopover() {
      if (!searchPopover) return;

      searchPopover.hidden = true;
    }

    function isMobileSearch() {
      return window.matchMedia("(max-width: 760px)").matches;
    }

    function isEditableTarget(target) {
      return target instanceof HTMLElement && (
        target.isContentEditable ||
        target.matches("input, textarea, select")
      );
    }

    function syncSearchSubmitIcon() {
      if (!searchSubmit) return;

      const isOpen = Boolean(searchShell?.classList.contains("is-open"));

      if (isMobileSearch() && isOpen) {
        searchSubmit.setAttribute("aria-label", searchCloseLabel);
        searchSubmit.classList.add("is-close");
        return;
      }

      searchSubmit.setAttribute("aria-label", searchIconLabel);
      searchSubmit.classList.remove("is-close");
    }

    function updateAllResultsLink(query, hasResults = false) {
      if (!searchAllLink) return;

      const normalizedQuery = normalizeText(query);
      const url = new URL(searchAllLink.href);

      if (normalizedQuery) {
        url.searchParams.set("q", query);
        searchAllLink.textContent = hasResults
          ? searchAllLabel
          : `${searchAdvancedLabel} →`;
      } else {
        url.searchParams.delete("q");
        searchAllLink.textContent = `${searchAdvancedLabel} →`;
      }

      searchAllLink.href = `${url.pathname}${url.search}`;
    }

    function renderFilters(results) {
      if (!searchFilters) return;

      const counts = getSearchCounts(results);

      if (
        activeSearchType !== ALL_SEARCH_TYPE &&
        !SEARCH_FILTER_ORDER.includes(activeSearchType)
      ) {
        activeSearchType = ALL_SEARCH_TYPE;
      }

      if (activeSearchType !== ALL_SEARCH_TYPE && !counts[activeSearchType]) {
        activeSearchType = ALL_SEARCH_TYPE;
      }

      const filters = getAvailableSearchFilters(results);

      searchFilters.innerHTML = [
        `<button type="button" data-global-search-filter="${ALL_SEARCH_TYPE}">${escapeHtml(filterAllLabel)} <span>${results.length}</span></button>`,
        ...filters.map(({ type, count }) => {
          const label =
            results.find((item) => item.type === type)?.typeLabel ?? type;

          return `<button type="button" data-global-search-filter="${escapeHtml(type)}">${escapeHtml(label)} <span>${count}</span></button>`;
        }),
      ].join("");

      searchFilters
        .querySelectorAll("[data-global-search-filter]")
        .forEach((button) => {
          button.classList.toggle(
            "is-active",
            button.getAttribute("data-global-search-filter") === activeSearchType
          );

          button.addEventListener("click", (event) => {
            event.preventDefault();
            event.stopPropagation();

            activeSearchType =
              button.getAttribute("data-global-search-filter") ?? ALL_SEARCH_TYPE;

            renderSearchResults(searchInput?.value ?? "");
            openSearchPopover();
          });
        });
    }

    function renderResultCard(item) {
      const query = searchInput?.value ?? "";

      return `
        <a href="${escapeHtml(item.url)}" class="global-search-result">
          <span>${escapeHtml(item.typeLabel ?? item.type)}</span>
          <strong>${highlightMatches(item.title, query)}</strong>
          <small>${highlightMatches(item.summary, query)}</small>
        </a>
      `;
    }

    async function renderSearchResults(rawQuery) {
      if (!searchResults || !searchFilters) return;

      const query = normalizeText(rawQuery);

      updateAllResultsLink(rawQuery, false);

      if (!query) {
        searchResults.innerHTML = `
          <div class="global-search-state">
            ${escapeHtml(searchEmptyLabel)}
          </div>
        `;
        searchFilters.innerHTML = "";
        openSearchPopover();
        return;
      }

      const items = await loadSearchItems();

      const results = getSearchResults(items, rawQuery);

      if (results.length === 0) {
        searchResults.innerHTML = `
          <div class="global-search-state">
            ${escapeHtml(searchNoneLabel)}
          </div>
        `;
        searchFilters.innerHTML = "";
        openSearchPopover();
        return;
      }

      updateAllResultsLink(rawQuery, true);

      renderFilters(results);

      searchFilters
        .querySelectorAll("[data-global-search-filter]")
        .forEach((button) => {
          button.classList.toggle(
            "is-active",
            button.getAttribute("data-global-search-filter") === activeSearchType
          );
        });

      const filteredResults = getDisplaySearchResults(
        results,
        activeSearchType,
        80
      );

      searchResults.innerHTML = filteredResults.map(renderResultCard).join("");

      openSearchPopover();
    }

    syncThemeFromStorage();
    applyAccentPreference(getAccentPreference());

    themeChoiceButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const choice = button.getAttribute("data-theme-choice");
        if (choice === "auto" || choice === "light" || choice === "dark") setThemePreference(choice);
      });
    });

    themeQuickToggle?.addEventListener("click", () => {
      const current = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      setThemePreference(current === "dark" ? "light" : "dark");
    });

    accentChoiceButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const choice = button.getAttribute("data-accent-choice");
        if (["earth", "ocean", "forest", "plum", "clay"].includes(choice ?? "")) setAccentPreference(choice);
      });
    });

    window.addEventListener("beforeinstallprompt", (event) => {
      event.preventDefault();
      deferredInstallPrompt = event;

      if (installButton && !window.matchMedia("(display-mode: standalone)").matches) {
        installButton.hidden = false;
      }
    });

    installButton?.addEventListener("click", async () => {
      if (!deferredInstallPrompt) return;

      deferredInstallPrompt.prompt();
      await deferredInstallPrompt.userChoice;
      deferredInstallPrompt = undefined;
      installButton.hidden = true;
      closeMenu();
    });

    window.addEventListener("appinstalled", () => {
      deferredInstallPrompt = undefined;
      if (installButton) installButton.hidden = true;
    });

    const serviceWorkerUrl = document.body.dataset.serviceWorkerUrl;
    const serviceWorkerEnabled = document.body.dataset.serviceWorkerEnabled === "true";
    if (serviceWorkerEnabled && serviceWorkerUrl && "serviceWorker" in navigator) {
      window.addEventListener("load", () => {
        navigator.serviceWorker.register(serviceWorkerUrl).catch(() => {});
      });
    }

    menuToggle?.addEventListener("click", toggleMenu);

    languageSwitch?.addEventListener("click", () => {
      const language = languageSwitch.getAttribute("data-language-code");

      if (language === "es" || language === "en") {
        localStorage.setItem(LANGUAGE_KEY, language);
      }
    });

    searchToggle?.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();

      if (searchShell?.classList.contains("is-open")) {
        closeSearchShell();
        return;
      }

      openSearchShell();
      closeMenu();
    });

    searchSubmit?.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();

      if (isMobileSearch() && searchShell?.classList.contains("is-open")) {
        closeSearchShell({ returnFocus: true });
        return;
      }

      openSearchShell();
      searchInput?.focus();
    });

    searchInput?.addEventListener("input", () => {
      activeSearchType = ALL_SEARCH_TYPE;

      window.clearTimeout(globalSearchDebounceTimer);

      globalSearchDebounceTimer = window.setTimeout(() => {
        renderSearchResults(searchInput.value);
      }, 120);
    });

    searchInput?.addEventListener("focus", () => {
      openSearchShell();
      renderSearchResults(searchInput.value);
    });

    searchPopover?.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    searchFilters?.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    searchResults?.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    searchForm?.addEventListener("submit", (event) => {
      event.preventDefault();

      const query = searchInput?.value?.trim() ?? "";

      if (!query) {
        searchInput?.focus();
        return;
      }

      renderSearchResults(query);
    });

    document.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Node)) return;

      const clickedInsideSearch = Boolean(searchShell?.contains(target));
      const clickedInsideMenu = Boolean(globalMenu?.contains(target));
      const clickedMenuToggle = Boolean(menuToggle?.contains(target));

      if (!clickedInsideSearch) {
        closeSearchPopover();

        if (window.matchMedia("(max-width: 760px)").matches) {
          closeSearchShell();
        }
      }

      if (!clickedInsideMenu && !clickedMenuToggle) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      const searchShortcut =
        (!isEditableTarget(target) && event.key === "/" && !event.metaKey && !event.ctrlKey && !event.altKey) ||
        ((!isEditableTarget(target)) && (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k");

      if (searchShortcut) {
        event.preventDefault();
        openSearchShell();
        closeMenu();
        return;
      }

      if (event.key === "Escape") {
        const menuWasOpen = Boolean(globalMenu && !globalMenu.hidden);
        const searchWasOpen = Boolean(searchShell?.classList.contains("is-open"));

        closeMenu({ returnFocus: menuWasOpen });
        closeSearchShell({ returnFocus: searchWasOpen });
      }
    });

    window.addEventListener("pageshow", () => {
      syncThemeFromStorage();
      applyAccentPreference(getAccentPreference());
    });

    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => {
        if (getThemePreference() === "auto") {
          syncThemeFromStorage();
        }
      });
  })();
</script>


  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --page-bg: #f7f8fa;
    --surface: #ffffff;
    --surface-elevated: #ffffff;
    --surface-soft: #f3f5f7;
    --surface-muted: #e9edf2;
    --text-color: #303640;
    --text-muted: #6b7280;
    --heading-color: #151922;
    --border-color: rgba(15, 23, 42, 0.10);
    --border-strong: rgba(15, 23, 42, 0.16);
    --accent: #4b6f97;
    --accent-hover: #365a82;
    --accent-soft: #e6edf5;
    --accent-contrast: #ffffff;
    --focus-ring: rgba(75, 111, 151, 0.20);
    --shadow-sm: 0 8px 24px rgba(15, 23, 42, 0.06);
    --shadow-md: 0 18px 48px rgba(15, 23, 42, 0.10);
    --content-max: 1180px;
  }

  body {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    background: var(--page-bg);
    color: var(--text-color);
    transition: background-color 180ms ease, color 180ms ease;
  }

  a {
    color: inherit;
  }

  .site-header {
    width: min(var(--content-max), calc(100% - 32px));
    margin: 0 auto;
    padding: 16px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .logo {
    font-weight: 850;
    text-decoration: none;
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .nav a {
    padding: 9px 12px;
    border-radius: 999px;
    color: var(--accent);
    font-weight: 800;
    text-decoration: none;
  }

  .nav a:hover {
    background: var(--accent-soft);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .header-search {
    display: inline-flex;
    align-items: center;
    width: min(240px, 100%);
    min-height: 40px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--surface-elevated);
    overflow: hidden;
  }

  .header-search input {
    width: 100%;
    min-width: 0;
    height: 40px;
    padding: 0 4px 0 14px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--heading-color);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .header-search input::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }

  .header-search button {
    display: inline-flex;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 0;
    border-left: 1px solid var(--border-color);
    background: var(--accent-soft);
    color: var(--accent);
    font: inherit;
    cursor: pointer;
  }

  .header-search button:hover {
    background: var(--surface-muted);
  }

  .header-search:focus-within {
    border-color: var(--border-strong);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .theme-toggle {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--accent-soft);
    color: var(--accent);
    font: inherit;
    font-size: 1.05rem;
    font-weight: 800;
    cursor: pointer;
  }

  .theme-toggle:hover {
    background: var(--surface-elevated);
  }

  .theme-toggle-icon {
    line-height: 1;
  }

  .page {
    width: min(var(--content-max), calc(100% - 32px));
    margin: 0 auto;
    padding: 32px 0 72px;
  }

  .hero {
    position: relative;
    padding: 64px 32px;
    border-radius: 28px;
    background: var(--surface-elevated);
    border: 1px solid var(--border-color);
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
    overflow: hidden;
  }

  .hero::after {
    content: "";
    position: absolute;
    right: -90px;
    bottom: -120px;
    width: 320px;
    height: 320px;
    border-radius: 999px;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 16%, transparent), transparent 68%);
    pointer-events: none;
  }

  .hero > * {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    margin: 0 0 16px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(2.4rem, 7vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .subtitle {
    max-width: 760px;
    margin: 24px 0 0;
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
