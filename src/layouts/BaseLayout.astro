    <script>
  import {
    getBibleReferenceTarget,
    SEARCH_FILTER_ORDER,
    decodeSearchIndexPayload,
    getAvailableSearchFilters,
    getSearchPreviewResults,
    getSearchCounts,
    getSearchResults,
    normalizeSearchText,
  } from "../lib/search-engine";
  import { createPersonalContentRef, recordHistoryVisit } from "../lib/personal-state";

  (() => {
    const siteHeader = document.querySelector("[data-site-header]");
    const themeChoiceButtons = document.querySelectorAll("[data-theme-choice]");
    const accentChoiceButtons = document.querySelectorAll("[data-accent-choice]");
    const themeQuickToggle = document.querySelector("[data-theme-quick-toggle]");
    let themeSwitchFrame = 0;
    let themeSwitchCleanupFrame = 0;

    const menuToggle = document.querySelector("[data-menu-toggle]");
    const globalMenu = document.querySelector("[data-global-menu]");
    const languageSwitch = document.querySelector("[data-language-switch]");
    const installButton = document.querySelector("[data-install-app]");
    let deferredInstallPrompt;
    let serviceWorkerRegistration;
    let lastServiceWorkerUpdateCheck = 0;
    const SERVICE_WORKER_UPDATE_INTERVAL = 60 * 60 * 1000;

    const searchShell = document.querySelector("[data-global-search-shell]");
    const getSearchTriggers = () => [
      ...document.querySelectorAll(
        "[data-top-search-trigger], [data-context-search], [data-dock-action=\"search\"]",
      ),
    ];
    let lastSearchTrigger = null;
    const searchForm = document.querySelector("[data-global-search-form]");
    const searchInput = document.querySelector("[data-global-search-input]");
    const searchInputIcon = document.querySelector("[data-global-search-input-icon]");
    const searchClear = document.querySelector("[data-global-search-clear]");
    const searchSubmit = document.querySelector("[data-global-search-submit]");
    const searchPopover = document.querySelector("[data-global-search-popover]");
    const searchFilters = document.querySelector("[data-global-search-filters]");
    const searchResults = document.querySelector("[data-global-search-results]");
    const searchStatus = document.querySelector("[data-global-search-status]");
    const searchAllLink = document.querySelector("[data-global-search-all]");
    const connectionStatus = document.querySelector("[data-connection-status]");
    const connectionStatusText = document.querySelector("[data-connection-status-text]");
    let connectionStatusTimer;
    const appUpdateStatus = document.querySelector("[data-app-update]");
    const appUpdateAnnouncer = document.querySelector("[data-app-update-announcer]");
    const appUpdateNow = document.querySelector("[data-app-update-now]");
    const appUpdateLater = document.querySelector("[data-app-update-later]");

    const syncHeaderMetrics = () => {
      if (!(siteHeader instanceof HTMLElement)) return;
      const height = Math.ceil(siteHeader.getBoundingClientRect().height);
      document.documentElement.style.setProperty("--header-height", `${height}px`);
    };

    const syncVisualViewportMetrics = () => {
      const viewport = window.visualViewport;
      const viewportHeight = Math.max(1, Math.round(viewport?.height ?? window.innerHeight));
      const viewportOffsetTop = Math.max(0, Math.round(viewport?.offsetTop ?? 0));
      const layoutHeight = Math.max(window.innerHeight, document.documentElement.clientHeight);
      const keyboardInset = Math.max(0, Math.round(layoutHeight - viewportHeight - viewportOffsetTop));
      const compactViewport = window.matchMedia("(max-width: 760px)").matches;
      const keyboardOpen = compactViewport && keyboardInset > 96;

      document.documentElement.style.setProperty("--visual-viewport-height", `${viewportHeight}px`);
      document.documentElement.style.setProperty("--visual-viewport-offset-top", `${viewportOffsetTop}px`);
      document.documentElement.style.setProperty("--virtual-keyboard-inset", `${keyboardInset}px`);
      document.documentElement.dataset.virtualKeyboard = keyboardOpen ? "open" : "closed";
    };

    const syncViewportMetrics = () => {
      syncHeaderMetrics();
      syncVisualViewportMetrics();
    };

    syncViewportMetrics();
    if (siteHeader instanceof HTMLElement && "ResizeObserver" in window) {
      new ResizeObserver(syncHeaderMetrics).observe(siteHeader);
    } else {
      window.addEventListener("resize", syncViewportMetrics, { passive: true });
    }
    window.visualViewport?.addEventListener("resize", syncViewportMetrics, { passive: true });
    window.visualViewport?.addEventListener("scroll", syncVisualViewportMetrics, { passive: true });
    window.addEventListener("orientationchange", () => {
      requestAnimationFrame(syncViewportMetrics);
    }, { passive: true });
    document.fonts?.ready.then(syncHeaderMetrics).catch(() => undefined);

    const ALL_SEARCH_TYPE = "Todos";
    const THEME_KEY = "bibli-theme";
    const ACCENT_KEY = "bibli-accent";
    const LANGUAGE_KEY = "bibli-language";
    const languageBaseHref = languageSwitch?.getAttribute("href") ?? "";

    const recordCurrentPersonalContent = () => {
      const pageTitle = document.documentElement.dataset.personalPageTitle || "";
      const pageLang = document.documentElement.dataset.personalPageLang;
      if (pageLang !== "es" && pageLang !== "en") return;
      const ref = createPersonalContentRef({
        pathname: window.location.pathname,
        href: `${window.location.pathname}${window.location.hash}`,
        title: pageTitle,
        lang: pageLang,
      });
      if (ref) recordHistoryVisit(ref);
    };

    recordCurrentPersonalContent();

    const syncLanguageSwitchContext = () => {
      if (!(languageSwitch instanceof HTMLAnchorElement) || !languageBaseHref) return;
      const target = new URL(languageBaseHref, window.location.href);
      const mode = languageSwitch.getAttribute("data-language-mode");
      if (mode === "equivalent") {
        if (!target.search && window.location.search) target.search = window.location.search;
        if (!target.hash && window.location.hash) target.hash = window.location.hash;
      }
      languageSwitch.href = target.href;
    };

    const focusHashTarget = () => {
      if (!window.location.hash || window.location.hash === "#") return;
      let rawId = window.location.hash.slice(1);
      try { rawId = decodeURIComponent(rawId); } catch {}
      if (!rawId) return;
      const byId = document.getElementById(rawId);
      const byName = !byId ? document.querySelector(`[name="${CSS.escape(rawId)}"]`) : null;
      const target = byId ?? byName;
      if (!(target instanceof HTMLElement)) return;
      const naturallyFocusable = target.matches("a[href],button,input,select,textarea,summary,[tabindex]");
      const hadTabIndex = target.hasAttribute("tabindex");
      if (!naturallyFocusable) target.setAttribute("tabindex", "-1");
      target.focus({ preventScroll: true });
      if (!naturallyFocusable && !hadTabIndex) {
        target.addEventListener("blur", () => target.removeAttribute("tabindex"), { once: true });
      }
    };

    const searchEmptyLabel =
      searchShell?.getAttribute("data-empty-label") ??
      "Escribe una palabra para comenzar.";
    const searchNoneLabel =
      searchShell?.getAttribute("data-none-label") ??
      "No se encontraron resultados.";
    const searchErrorLabel =
      searchShell?.getAttribute("data-error-label") ??
      "No pudimos cargar la búsqueda. Revisa tu conexión e inténtalo de nuevo.";
    const searchAllLabel =
      searchShell?.getAttribute("data-all-label") ??
      "Ver todos los resultados →";
    const searchAdvancedLabel =
      searchShell?.getAttribute("data-advanced-label") ??
      "Búsqueda avanzada";
    const filterAllLabel =
      searchShell?.getAttribute("data-filter-all-label") ?? "Todos";
    const searchOpenLabel =
      searchShell?.getAttribute("data-search-open-label") ??
      "Abrir búsqueda";
    const searchCloseLabel =
      searchShell?.getAttribute("data-search-close-label") ??
      "Cerrar búsqueda";
    const searchIconLabel =
      searchShell?.getAttribute("data-search-icon-label") ??
      "Icono de búsqueda";
    const searchResultsOneLabel =
      searchShell?.getAttribute("data-results-one-label") ??
      "1 resultado disponible.";
    const searchResultsManyLabel =
      searchShell?.getAttribute("data-results-many-label") ??
      "{count} resultados disponibles.";
    const searchResultsFilteredLabel =
      searchShell?.getAttribute("data-results-filtered-label") ??
      "{count} resultados en {filter}.";

    let searchItems = null;
    let searchLoadPromise = null;
    let searchLoadFailed = false;
    let activeSearchType = ALL_SEARCH_TYPE;
    let globalSearchDebounceTimer;
    let searchRenderGeneration = 0;

    function getThemePreference() {
      const storedTheme = localStorage.getItem(THEME_KEY);

      if (
        storedTheme === "auto" ||
        storedTheme === "light" ||
        storedTheme === "dark"
      ) {
        return storedTheme;
      }

      return "auto";
    }

    function getEffectiveTheme(preference) {
      if (preference === "light" || preference === "dark") {
        return preference;
      }

      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }

    function applyThemePreference(preference) {
      const root = document.documentElement;
      const effectiveTheme = getEffectiveTheme(preference);
      const themeChanged = Boolean(root.dataset.theme) && root.dataset.theme !== effectiveTheme;

      if (themeChanged) {
        cancelAnimationFrame(themeSwitchFrame);
        cancelAnimationFrame(themeSwitchCleanupFrame);
        root.dataset.themeChanging = "true";
        // Commit the no-transition state before swapping theme tokens.
        void root.offsetWidth;
      }

      root.dataset.theme = effectiveTheme;
      root.dataset.themePreference = preference;
      root.style.colorScheme = effectiveTheme;

      const themeColor = document.querySelector('meta[data-theme-color]');
      if (themeColor) {
        themeColor.setAttribute(
          "content",
          effectiveTheme === "dark" ? "#0f1115" : "#f7f8fa",
        );
      }

      if (themeChanged) {
        themeSwitchFrame = requestAnimationFrame(() => {
          themeSwitchCleanupFrame = requestAnimationFrame(() => {
            delete root.dataset.themeChanging;
          });
        });
      }
    }

    function syncThemeChoices(preference) {
      themeChoiceButtons.forEach((button) => {
        const active = button.getAttribute("data-theme-choice") === preference;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    }

    function getAccentPreference() {
      const accent = localStorage.getItem(ACCENT_KEY);
      return ["earth", "ocean", "forest", "plum", "clay"].includes(accent ?? "") ? accent : "earth";
    }

    function applyAccentPreference(accent) {
      document.documentElement.dataset.accent = accent;
      accentChoiceButtons.forEach((button) => {
        const active = button.getAttribute("data-accent-choice") === accent;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      document.dispatchEvent(
        new CustomEvent("bibli:accent-change", { detail: { accent } }),
      );
    }

    function setAccentPreference(accent) {
      localStorage.setItem(ACCENT_KEY, accent);
      applyAccentPreference(accent);
    }

    function setThemePreference(preference) {
      localStorage.setItem(THEME_KEY, preference);
      applyThemePreference(preference);
      syncThemeChoices(preference);
    }

    function syncThemeFromStorage() {
      const preference = getThemePreference();
      applyThemePreference(preference);
      syncThemeChoices(preference);
    }

    function normalizeText(value) {
      return normalizeSearchText(value);
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function getHighlightWords(query) {
      return Array.from(
        new Set(
          normalizeText(query)
            .split(/\s+/)
            .filter((word) => word.length >= 2)
        )
      );
    }

    function foldSearchTextWithMap(value) {
      const chars = Array.from(String(value ?? ""));
      let folded = "";
      const map = [];

      chars.forEach((char, sourceIndex) => {
        const normalized = normalizeText(char);
        for (const unit of Array.from(normalized)) {
          folded += unit;
          map.push(sourceIndex);
        }
      });

      return { chars, folded, map };
    }

    function highlightMatches(value, query) {
      const source = String(value ?? "");
      const words = getHighlightWords(query);
      if (words.length === 0 || !source) return escapeHtml(source);

      const { chars, folded, map } = foldSearchTextWithMap(source);
      const ranges = [];

      for (const word of words) {
        let from = 0;
        while (from < folded.length) {
          const matchIndex = folded.indexOf(word, from);
          if (matchIndex < 0) break;
          const start = map[matchIndex];
          const endMapIndex = matchIndex + word.length - 1;
          const end = (map[endMapIndex] ?? start) + 1;
          if (Number.isInteger(start) && end > start) ranges.push([start, end]);
          from = matchIndex + Math.max(1, word.length);
        }
      }

      if (ranges.length === 0) return escapeHtml(source);

      ranges.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
      const merged = [];
      for (const range of ranges) {
        const previous = merged[merged.length - 1];
        if (previous && range[0] <= previous[1]) previous[1] = Math.max(previous[1], range[1]);
        else merged.push([...range]);
      }

      let output = "";
      let cursor = 0;
      for (const [start, end] of merged) {
        output += escapeHtml(chars.slice(cursor, start).join(""));
        output += `<mark>${escapeHtml(chars.slice(start, end).join(""))}</mark>`;
        cursor = end;
      }
      output += escapeHtml(chars.slice(cursor).join(""));
      return output;
    }

    async function loadSearchItems() {
      if (searchItems) return searchItems;
      if (searchLoadPromise) return searchLoadPromise;

      const searchUrl = searchShell?.getAttribute("data-search-url");

      if (!searchUrl) {
        searchLoadFailed = true;
        return [];
      }

      searchLoadPromise = (async () => {
        try {
          const response = await fetch(searchUrl);
          if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
          const payload = await response.json();
          searchItems = decodeSearchIndexPayload(payload);
          searchLoadFailed = false;
          return searchItems;
        } catch {
          searchLoadFailed = true;
          searchItems = null;
          return [];
        } finally {
          searchLoadPromise = null;
        }
      })();

      return searchLoadPromise;
    }

    function openMenu({ focusFirst = false } = {}) {
      if (!globalMenu || !menuToggle) return;

      closeSearchShell();
      globalMenu.hidden = false;
      menuToggle.setAttribute("aria-expanded", "true");

      if (focusFirst) {
        window.requestAnimationFrame(() => {
          const firstControl = globalMenu.querySelector("a, button");
          if (firstControl instanceof HTMLElement) firstControl.focus();
        });
      }
    }

    function closeMenu({ returnFocus = false } = {}) {
      if (!globalMenu || !menuToggle) return;

      const hadFocusInside = globalMenu.contains(document.activeElement);
      globalMenu.hidden = true;
      menuToggle.setAttribute("aria-expanded", "false");

      if (returnFocus && hadFocusInside) menuToggle.focus();
    }

    function toggleMenu() {
      if (!globalMenu) return;

      if (globalMenu.hidden) {
        openMenu();
      } else {
        closeMenu();
      }
    }

    function syncSearchTriggerState(open) {
      getSearchTriggers().forEach((trigger) => {
        if (!(trigger instanceof HTMLElement)) return;
        trigger.setAttribute("aria-expanded", String(open));
        if (trigger instanceof HTMLButtonElement) trigger.setAttribute("aria-pressed", String(open));
      });
      document.dispatchEvent(new CustomEvent("bibli:global-search-state", { detail: { open } }));
    }

    function focusSearchInput() {
      if (!(searchInput instanceof HTMLInputElement)) return false;
      try {
        searchInput.focus({ preventScroll: true });
      } catch {
        searchInput.focus();
      }
      try {
        const end = searchInput.value.length;
        searchInput.setSelectionRange(end, end);
      } catch {}
      return document.activeElement === searchInput;
    }

    function openSearchShell({ trigger = null } = {}) {
      if (!searchShell) return;
      if (trigger instanceof HTMLElement) lastSearchTrigger = trigger;
      closeMenu();
      document.dispatchEvent(new CustomEvent("bibli:global-search-opening"));
      document.dispatchEvent(new CustomEvent("bibli:reader-preferences-close"));
      document.dispatchEvent(new CustomEvent("bibli:tts-close"));

      // Make the search field focusable before moving focus. Keeping the closed shell
      // inert (rather than visibility:hidden) lets the same trusted click/tap open the
      // mobile keyboard reliably.
      searchShell.removeAttribute("inert");
      searchShell.classList.add("is-open");
      searchShell.setAttribute("aria-hidden", "false");
      syncSearchTriggerState(true);
      syncSearchSubmitIcon();
      syncSearchInputDecoration();

      // Force the open state to participate in layout before focus. This keeps focus
      // synchronous with the original user gesture on mobile and also makes PC focus
      // deterministic.
      void searchShell.offsetWidth;
      focusSearchInput();
      queueMicrotask(() => {
        if (searchShell.classList.contains("is-open") && document.activeElement !== searchInput) {
          focusSearchInput();
        }
      });
      window.requestAnimationFrame(() => {
        if (searchShell.classList.contains("is-open") && document.activeElement !== searchInput) {
          focusSearchInput();
        }
        syncVisualViewportMetrics();
      });
      void renderSearchResults(searchInput?.value ?? "");
    }

    function closeSearchShell({ returnFocus = false } = {}) {
      if (!searchShell) return;
      searchRenderGeneration += 1;
      const hadFocusInside = searchShell.contains(document.activeElement);
      searchShell.classList.remove("is-open");
      searchShell.setAttribute("aria-hidden", "true");
      searchShell.setAttribute("inert", "");
      closeSearchPopover();
      syncSearchTriggerState(false);
      syncSearchSubmitIcon();
      syncSearchInputDecoration();
      if (hadFocusInside && document.activeElement instanceof HTMLElement) document.activeElement.blur();
      if (returnFocus && hadFocusInside && lastSearchTrigger instanceof HTMLElement) lastSearchTrigger.focus();
    }

    function canOpenSearchPopover() {
      return Boolean(
        searchPopover &&
        searchShell?.classList.contains("is-open") &&
        (!globalMenu || globalMenu.hidden),
      );
    }

    function openSearchPopover() {
      if (!canOpenSearchPopover() || !searchPopover) return;
      searchPopover.hidden = false;
    }

    function closeSearchPopover({ invalidate = true } = {}) {
      if (invalidate) searchRenderGeneration += 1;
      if (!searchPopover) return;
      searchPopover.hidden = true;
    }

    function isMobileSearch() {
      return window.matchMedia("(max-width: 760px)").matches;
    }

    function isEditableTarget(target) {
      return target instanceof HTMLElement && (
        target.isContentEditable ||
        target.matches("input, textarea, select")
      );
    }

    function syncSearchSubmitIcon() {
      if (!searchSubmit) return;
      searchSubmit.setAttribute("aria-label", searchIconLabel);
      searchSubmit.classList.remove("is-close");
    }

    function syncSearchInputDecoration() {
      const hasQuery = Boolean(searchInput instanceof HTMLInputElement && searchInput.value.trim());
      if (searchInputIcon instanceof HTMLElement) searchInputIcon.hidden = hasQuery;
      if (searchClear instanceof HTMLButtonElement) searchClear.hidden = !hasQuery;
    }

    function updateAllResultsLink(query, _hasResults = false) {
      if (!searchAllLink) return;

      const normalizedQuery = normalizeText(query);
      const url = new URL(searchAllLink.href);

      if (normalizedQuery) url.searchParams.set("q", query);
      else url.searchParams.delete("q");

      // The advanced page is intentionally reachable only through this explicit action.
      searchAllLink.textContent = `${searchAdvancedLabel} →`;
      searchAllLink.href = `${url.pathname}${url.search}`;
    }

    function renderFilters(results) {
      if (!searchFilters) return;

      const counts = getSearchCounts(results);

      if (
        activeSearchType !== ALL_SEARCH_TYPE &&
        !SEARCH_FILTER_ORDER.includes(activeSearchType)
      ) {
        activeSearchType = ALL_SEARCH_TYPE;
      }

      if (activeSearchType !== ALL_SEARCH_TYPE && !counts[activeSearchType]) {
        activeSearchType = ALL_SEARCH_TYPE;
      }

      const filters = getAvailableSearchFilters(results);

      searchFilters.innerHTML = [
        `<button type="button" data-global-search-filter="${ALL_SEARCH_TYPE}">${escapeHtml(filterAllLabel)} <span>${results.length}</span></button>`,
        ...filters.map(({ type, count }) => {
          const label =
            results.find((item) => item.type === type)?.typeLabel ?? type;

          return `<button type="button" data-global-search-filter="${escapeHtml(type)}">${escapeHtml(label)} <span>${count}</span></button>`;
        }),
      ].join("");

      searchFilters
        .querySelectorAll("[data-global-search-filter]")
        .forEach((button) => {
          const isActive = button.getAttribute("data-global-search-filter") === activeSearchType;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-pressed", String(isActive));

          button.addEventListener("click", (event) => {
            event.preventDefault();
            event.stopPropagation();

            activeSearchType =
              button.getAttribute("data-global-search-filter") ?? ALL_SEARCH_TYPE;

            void renderSearchResults(searchInput?.value ?? "");
          });
        });
    }

    function setSearchStatus(message = "") {
      if (searchStatus instanceof HTMLElement) searchStatus.textContent = message;
    }

    function formatSearchStatus(count, filterLabel = "") {
      if (filterLabel) {
        return searchResultsFilteredLabel
          .replace("{count}", String(count))
          .replace("{filter}", filterLabel);
      }
      if (count === 1) return searchResultsOneLabel;
      return searchResultsManyLabel.replace("{count}", String(count));
    }

    function renderResultCard(item) {
      const query = searchInput?.value ?? "";

      return `
        <a href="${escapeHtml(item.url)}" class="global-search-result">
          <span>${escapeHtml(item.typeLabel ?? item.type)}</span>
          <strong>${highlightMatches(item.title, query)}</strong>
          <small>${highlightMatches(item.summary, query)}</small>
        </a>
      `;
    }

    async function renderSearchResults(rawQuery) {
      if (!searchResults || !searchFilters) return;

      const renderGeneration = ++searchRenderGeneration;
      const query = normalizeText(rawQuery);

      updateAllResultsLink(rawQuery, false);

      if (!query) {
        if (renderGeneration !== searchRenderGeneration || !canOpenSearchPopover()) return;
        searchResults.innerHTML = `
          <div class="global-search-state">
            ${escapeHtml(searchEmptyLabel)}
          </div>
        `;
        searchFilters.innerHTML = "";
        setSearchStatus("");
        openSearchPopover();
        return;
      }

      searchResults.setAttribute("aria-busy", "true");
      const items = await loadSearchItems();
      searchResults.setAttribute("aria-busy", "false");

      if (renderGeneration !== searchRenderGeneration || !canOpenSearchPopover()) return;

      if (searchLoadFailed) {
        searchResults.innerHTML = `
          <div class="global-search-state is-error">
            ${escapeHtml(searchErrorLabel)}
          </div>
        `;
        searchFilters.innerHTML = "";
        setSearchStatus(searchErrorLabel);
        openSearchPopover();
        return;
      }

      const results = getSearchResults(items, rawQuery);

      if (results.length === 0) {
        searchResults.innerHTML = `
          <div class="global-search-state">
            ${escapeHtml(searchNoneLabel)}
          </div>
        `;
        searchFilters.innerHTML = "";
        setSearchStatus(searchNoneLabel);
        openSearchPopover();
        return;
      }

      updateAllResultsLink(rawQuery, true);

      renderFilters(results);

      searchFilters
        .querySelectorAll("[data-global-search-filter]")
        .forEach((button) => {
          const isActive = button.getAttribute("data-global-search-filter") === activeSearchType;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        });

      const previewLimit = activeSearchType === ALL_SEARCH_TYPE ? 12 : 24;
      const filteredResults = getSearchPreviewResults(
        results,
        activeSearchType,
        previewLimit
      );

      searchResults.innerHTML = filteredResults.map(renderResultCard).join("");
      const activeFilterLabel = activeSearchType === ALL_SEARCH_TYPE
        ? ""
        : (results.find((item) => item.type === activeSearchType)?.typeLabel ?? activeSearchType);
      const activeResultCount = activeSearchType === ALL_SEARCH_TYPE
        ? results.length
        : (getSearchCounts(results)[activeSearchType] ?? filteredResults.length);
      setSearchStatus(formatSearchStatus(activeResultCount, activeFilterLabel));

      if (renderGeneration === searchRenderGeneration) openSearchPopover();
    }

    syncThemeFromStorage();
    applyAccentPreference(getAccentPreference());

    themeChoiceButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const choice = button.getAttribute("data-theme-choice");
        if (choice === "auto" || choice === "light" || choice === "dark") setThemePreference(choice);
      });
    });

    themeQuickToggle?.addEventListener("click", () => {
      const current = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      setThemePreference(current === "dark" ? "light" : "dark");
    });

    accentChoiceButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const choice = button.getAttribute("data-accent-choice");
        if (["earth", "ocean", "forest", "plum", "clay"].includes(choice ?? "")) setAccentPreference(choice);
      });
    });

    window.addEventListener("beforeinstallprompt", (event) => {
      event.preventDefault();
      deferredInstallPrompt = event;

      if (installButton && !window.matchMedia("(display-mode: standalone)").matches) {
        installButton.hidden = false;
      }
    });

    installButton?.addEventListener("click", async () => {
      if (!deferredInstallPrompt) return;

      deferredInstallPrompt.prompt();
      await deferredInstallPrompt.userChoice;
      deferredInstallPrompt = undefined;
      installButton.hidden = true;
      closeMenu();
    });

    window.addEventListener("appinstalled", () => {
      deferredInstallPrompt = undefined;
      if (installButton) installButton.hidden = true;
    });

    const showConnectionStatus = (state) => {
      if (!connectionStatus || !connectionStatusText) return;

      window.clearTimeout(connectionStatusTimer);
      const online = state === "online";
      const label = connectionStatus.getAttribute(online ? "data-online-label" : "data-offline-label") || "";
      connectionStatusText.textContent = label;
      connectionStatus.classList.toggle("is-online", online);
      connectionStatus.hidden = false;

      if (online) {
        connectionStatusTimer = window.setTimeout(() => {
          connectionStatus.hidden = true;
          connectionStatus.classList.remove("is-online");
        }, 3500);
      }
    };

    if (!navigator.onLine) showConnectionStatus("offline");
    window.addEventListener("offline", () => showConnectionStatus("offline"));
    window.addEventListener("online", () => showConnectionStatus("online"));

    const serviceWorkerUrl = document.body.dataset.serviceWorkerUrl;
    const serviceWorkerEnabled = document.body.dataset.serviceWorkerEnabled === "true";
    async function checkForServiceWorkerUpdate({ force = false } = {}) {
      if (!serviceWorkerRegistration || !navigator.onLine) return;
      const now = Date.now();
      if (!force && now - lastServiceWorkerUpdateCheck < SERVICE_WORKER_UPDATE_INTERVAL) return;
      lastServiceWorkerUpdateCheck = now;
      try {
        await serviceWorkerRegistration.update();
      } catch {
        // Browsers can reject update checks transiently while reconnecting.
      }
    }

    if (serviceWorkerEnabled && serviceWorkerUrl && "serviceWorker" in navigator) {
      const hadServiceWorkerController = Boolean(navigator.serviceWorker.controller);
      let updateNoticeShown = false;

      navigator.serviceWorker.addEventListener("controllerchange", () => {
        if (!hadServiceWorkerController || updateNoticeShown || !appUpdateStatus) return;
        updateNoticeShown = true;
        appUpdateStatus.hidden = false;
        if (appUpdateAnnouncer instanceof HTMLElement) {
          appUpdateAnnouncer.textContent = appUpdateAnnouncer.getAttribute("data-message") ?? "";
        }
      });

      window.addEventListener("load", async () => {
        try {
          serviceWorkerRegistration = await navigator.serviceWorker.register(serviceWorkerUrl);
          lastServiceWorkerUpdateCheck = Date.now();
        } catch {
          serviceWorkerRegistration = undefined;
        }
      });

      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") void checkForServiceWorkerUpdate();
      });
      window.addEventListener("online", () => void checkForServiceWorkerUpdate({ force: true }));
    }

    appUpdateNow?.addEventListener("click", () => {
      window.location.reload();
    });

    appUpdateLater?.addEventListener("click", () => {
      if (appUpdateStatus instanceof HTMLElement) appUpdateStatus.hidden = true;
      if (appUpdateAnnouncer instanceof HTMLElement) appUpdateAnnouncer.textContent = "";
    });

    const warmSearchIndex = () => {
      void loadSearchItems();
    };

    getSearchTriggers().forEach((trigger) => {
      trigger.addEventListener("pointerenter", warmSearchIndex, { once: true });
      trigger.addEventListener("pointerdown", warmSearchIndex, { once: true });
    });
    searchForm?.addEventListener("pointerenter", warmSearchIndex, { once: true });
    searchShell?.addEventListener("focusin", warmSearchIndex, { once: true });

    menuToggle?.addEventListener("click", toggleMenu);
    menuToggle?.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown") return;
      event.preventDefault();
      closeSearchShell();
      openMenu({ focusFirst: true });
    });

    globalMenu?.addEventListener("keydown", (event) => {
      if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return;
      const controls = [...globalMenu.querySelectorAll("a[href], button:not([hidden]):not([disabled])")].filter(
        (control) => control instanceof HTMLElement,
      );
      if (controls.length === 0) return;
      const currentIndex = controls.indexOf(document.activeElement);
      event.preventDefault();
      if (event.key === "Home") {
        controls[0]?.focus();
        return;
      }
      if (event.key === "End") {
        controls[controls.length - 1]?.focus();
        return;
      }
      const fallbackIndex = event.key === "ArrowDown" ? -1 : 0;
      const baseIndex = currentIndex >= 0 ? currentIndex : fallbackIndex;
      const delta = event.key === "ArrowDown" ? 1 : -1;
      const nextIndex = (baseIndex + delta + controls.length) % controls.length;
      controls[nextIndex]?.focus();
    });

    syncLanguageSwitchContext();

    languageSwitch?.addEventListener("click", () => {
      const language = languageSwitch.getAttribute("data-language-code");

      if (language === "es" || language === "en") {
        localStorage.setItem(LANGUAGE_KEY, language);
      }
    });

    document.addEventListener("bibli:global-search-toggle", (event) => {
      const trigger = event instanceof CustomEvent ? event.detail?.trigger : null;
      if (searchShell?.classList.contains("is-open")) {
        closeSearchShell({ returnFocus: false });
        return;
      }
      openSearchShell({ trigger });
    });
    document.addEventListener("bibli:global-search-open", (event) => {
      const trigger = event instanceof CustomEvent ? event.detail?.trigger : null;
      openSearchShell({ trigger });
    });
    document.addEventListener("bibli:global-search-close", () => closeSearchShell());
    document.addEventListener("bibli:reader-preferences-opening", () => closeSearchShell());
    document.addEventListener("bibli:tts-opening", () => closeSearchShell());

    searchSubmit?.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    function getSearchNavigationLinks() {
      const resultLinks = searchResults
        ? [...searchResults.querySelectorAll("a.global-search-result")].filter(
            (link) => link instanceof HTMLElement && !link.hidden,
          )
        : [];
      return searchAllLink && !searchAllLink.hidden
        ? [...resultLinks, searchAllLink]
        : resultLinks;
    }

    searchShell?.addEventListener("keydown", (event) => {
      if (searchPopover?.hidden) return;
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;

      const links = getSearchNavigationLinks();
      if (links.length === 0) return;

      const active = document.activeElement;
      if (active === searchInput) {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          links[0]?.focus();
        }
        return;
      }

      const currentIndex = links.indexOf(active);
      if (currentIndex === -1) return;

      event.preventDefault();
      if (event.key === "ArrowDown") {
        links[Math.min(currentIndex + 1, links.length - 1)]?.focus();
      } else if (currentIndex === 0) {
        searchInput?.focus();
      } else {
        links[currentIndex - 1]?.focus();
      }
    });

    searchInput?.addEventListener("input", () => {
      activeSearchType = ALL_SEARCH_TYPE;
      syncSearchInputDecoration();

      window.clearTimeout(globalSearchDebounceTimer);

      globalSearchDebounceTimer = window.setTimeout(() => {
        renderSearchResults(searchInput.value);
      }, 120);
    });

    searchClear?.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (!(searchInput instanceof HTMLInputElement)) return;
      window.clearTimeout(globalSearchDebounceTimer);
      searchInput.value = "";
      activeSearchType = ALL_SEARCH_TYPE;
      syncSearchInputDecoration();
      focusSearchInput();
      void renderSearchResults("");
    });

    searchInput?.addEventListener("focus", () => {
      if (!searchShell?.classList.contains("is-open")) openSearchShell();
      else renderSearchResults(searchInput.value);
    });

    searchPopover?.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    searchFilters?.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    searchResults?.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    searchForm?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const query = searchInput?.value?.trim() ?? "";

      if (!query) {
        searchInput?.focus();
        return;
      }

      window.clearTimeout(globalSearchDebounceTimer);

      const items = await loadSearchItems();

      if (!searchLoadFailed) {
        const bibleTarget = getBibleReferenceTarget(items, query);

        if (bibleTarget) {
          window.location.assign(bibleTarget);
          return;
        }
      }

      void renderSearchResults(query);
    });

    document.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Node)) return;

      const clickedInsideSearch = Boolean(searchShell?.contains(target));
      const clickedInsideMenu = Boolean(globalMenu?.contains(target));
      const clickedMenuToggle = Boolean(menuToggle?.contains(target));

      if (!clickedInsideSearch) {
        closeSearchShell();
      }

      if (!clickedInsideMenu && !clickedMenuToggle) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      const searchShortcut =
        (!isEditableTarget(target) && event.key === "/" && !event.metaKey && !event.ctrlKey && !event.altKey) ||
        ((!isEditableTarget(target)) && (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k");

      if (searchShortcut) {
        event.preventDefault();
        openSearchShell();
        return;
      }

      if (event.key === "Escape") {
        const menuWasOpen = Boolean(globalMenu && !globalMenu.hidden);
        const searchWasOpen = Boolean(searchShell?.classList.contains("is-open"));

        closeMenu({ returnFocus: menuWasOpen });
        closeSearchShell({ returnFocus: searchWasOpen });
      }
    });

    // Keep the display awake on Bibli's learning/reading surfaces, not only during audio.
    // This intentionally covers lessons, Bible reading, glossary and the other content catalogs/details
    // where the user may spend several minutes reading without touching the screen.
    // Screen Wake Lock is best-effort: browsers may revoke it (for example on low battery),
    // so we reacquire it whenever the document becomes visible again.
    const learningPath = /\/(?:lecciones|rutas|explorar|es\/biblia|en\/bible|glosario|libros|pasajes|personajes|temas|eventos|recursos|lugares|linea-de-tiempo|mapa(?:-3d)?)\//;
    const wakeLockContext = Boolean(
      document.querySelector("main") &&
      (document.querySelector("[data-reader-content], [data-detail-root]") || learningPath.test(window.location.pathname)),
    );
    let screenWakeLock = null;
    let wakeLockRequestPending = false;

    async function requestReadingWakeLock() {
      if (!wakeLockContext || wakeLockRequestPending || document.visibilityState !== "visible") return;
      const wakeLockApi = (navigator as Navigator & { wakeLock?: { request(type: "screen"): Promise<any> } }).wakeLock;
      if (!wakeLockApi || screenWakeLock) return;
      wakeLockRequestPending = true;
      try {
        const sentinel = await wakeLockApi.request("screen");
        screenWakeLock = sentinel;
        sentinel.addEventListener("release", () => {
          if (screenWakeLock === sentinel) screenWakeLock = null;
        }, { once: true });
      } catch {
        // Unsupported/denied/low-power cases degrade normally without blocking reading.
      } finally {
        wakeLockRequestPending = false;
      }
    }

    async function releaseReadingWakeLock() {
      const sentinel = screenWakeLock;
      screenWakeLock = null;
      if (!sentinel || sentinel.released) return;
      try { await sentinel.release(); } catch {}
    }

    if (wakeLockContext) {
      void requestReadingWakeLock();
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") void requestReadingWakeLock();
        else void releaseReadingWakeLock();
      });
      // Retry after a real user gesture in browsers that defer the first request.
      const retryWakeLock = () => { if (!screenWakeLock) void requestReadingWakeLock(); };
      document.addEventListener("pointerdown", retryWakeLock, { passive: true, once: true });
      document.addEventListener("keydown", retryWakeLock, { once: true });
      window.addEventListener("pagehide", () => { void releaseReadingWakeLock(); });
    }

    window.addEventListener("pageshow", (event) => {
      syncThemeFromStorage();
      applyAccentPreference(getAccentPreference());
      syncLanguageSwitchContext();
      syncHeaderMetrics();
      if (event.persisted) {
        closeMenu();
        closeSearchShell();
        recordCurrentPersonalContent();
      }
    });
    window.addEventListener("pagehide", () => {
      closeMenu();
      closeSearchShell();
      window.clearTimeout(globalSearchDebounceTimer);
      window.clearTimeout(connectionStatusTimer);
    });
    window.addEventListener("hashchange", () => {
      syncLanguageSwitchContext();
      recordCurrentPersonalContent();
      requestAnimationFrame(focusHashTarget);
    });
    window.addEventListener("popstate", () => {
      syncLanguageSwitchContext();
      syncHeaderMetrics();
      if (window.location.hash) requestAnimationFrame(focusHashTarget);
    });

    window.addEventListener("storage", (event) => {
      if (event.storageArea && event.storageArea !== localStorage) return;
      if (event.key === THEME_KEY) syncThemeFromStorage();
      if (event.key === ACCENT_KEY) applyAccentPreference(getAccentPreference());
    });

    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => {
        if (getThemePreference() === "auto") {
          syncThemeFromStorage();
        }
      });
  })();
</script>


  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --page-bg: #f7f8fa;
    --surface: #ffffff;
    --surface-elevated: #ffffff;
    --surface-soft: #f3f5f7;
    --surface-muted: #e9edf2;
    --text-color: #303640;
    --text-muted: #6b7280;
    --heading-color: #151922;
    --border-color: rgba(15, 23, 42, 0.10);
    --border-strong: rgba(15, 23, 42, 0.16);
    --accent: #4b6f97;
    --accent-hover: #365a82;
    --accent-soft: #e6edf5;
    --accent-contrast: #ffffff;
    --focus-ring: rgba(75, 111, 151, 0.20);
    --shadow-sm: 0 8px 24px rgba(15, 23, 42, 0.06);
    --shadow-md: 0 18px 48px rgba(15, 23, 42, 0.10);
    --shadow-card: 0 14px 34px rgba(15, 23, 42, 0.05);
    --shadow-card-hover: 0 14px 30px rgba(15, 23, 42, 0.08);
    --shadow-panel: 0 18px 42px rgba(15, 23, 42, 0.10);
    --content-max: 1180px;
    --header-height: 62px;
  }

  body {
    min-height: 100svh;
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    background: var(--page-bg);
    color: var(--text-color);
    transition: background-color 180ms ease, color 180ms ease;
  }

  a {
    color: inherit;
  }

  .site-header {
    width: min(var(--content-max), calc(100% - 32px));
    margin: 0 auto;
    padding: 16px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .logo {
    font-weight: 850;
    text-decoration: none;
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .page {
    width: min(var(--content-max), calc(100% - 32px));
    margin: 0 auto;
    padding: 32px max(0px,env(safe-area-inset-right)) 72px max(0px,env(safe-area-inset-left));
  }

  .hero {
    position: relative;
    padding: 64px 32px;
    border-radius: 28px;
    background: var(--surface-elevated);
    border: 1px solid var(--border-color);
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
