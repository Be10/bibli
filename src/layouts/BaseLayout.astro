    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 900;
  }

  .section-intro {
    max-width: 760px;
    margin: -8px 0 24px;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .section[id],
