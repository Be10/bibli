    .places-index-hero {
      grid-template-columns: 1fr;
    }

    .places-index-hero-card {
      padding: 20px;
    }

    .places-summary-grid,
    .places-directory-grid {
      grid-template-columns: 1fr;
    }

    .place-directory-card {
      min-height: auto;
    }

    .place-hero {
      grid-template-columns: 1fr;
    }

    .place-hero-card {
      padding: 20px;
    }

    .place-meta-grid {
      grid-template-columns: 1fr;
    }

    .place-events-grid,
    .place-lessons-grid {
      grid-template-columns: 1fr;
    }

    .place-event-card,
    .place-lesson-card {
      min-height: auto;
    }

    .site-header {
      align-items: flex-start;
    }

    .header-search {
      order: 10;
      width: 100%;
      flex-basis: 100%;
    }

    .header-search input {
      font-size: 1rem;
    }

  }

    /* Header compacto global */
  .site-header {
    position: relative;
    z-index: 50;
    align-items: center;
    flex-direction: row;
  }

  .logo {
    flex: 1 1 auto;
    min-width: 0;
  }

  .header-actions {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
  }

  .global-search-shell,
  .global-menu-shell {
    position: relative;
  }

  .global-search-form {
    display: inline-flex;
    align-items: center;
    width: min(320px, 36vw);
    min-height: 42px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--surface-elevated);
    overflow: hidden;
    transition:
      width 180ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .global-search-form:focus-within {
    border-color: var(--border-strong);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .global-search-form input {
    width: 100%;
    min-width: 0;
    height: 42px;
    padding: 0 6px 0 16px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--heading-color);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 750;
  }

  .global-search-form input::-webkit-search-cancel-button,
  .global-search-form input::-webkit-search-decoration,
  .global-search-form input::-webkit-search-results-button,
  .global-search-form input::-webkit-search-results-decoration {
    display: none;
    -webkit-appearance: none;
  }

  .global-search-form input::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }

  .global-search-submit,
  .global-search-toggle,
  .menu-toggle,
  .language-switch {
    display: inline-flex;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font: inherit;
    font-size: 1rem;
    font-weight: 900;
    cursor: pointer;
  }

  .language-switch {
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .global-search-toggle[aria-expanded="true"] {
    font-size: 1.15rem;
  }

  .global-search-submit {
    pointer-events: auto;
  }

  .global-search-submit.is-close {
    font-size: 1.15rem;
    line-height: 1;
  }

  .global-search-submit {
    border-top: 0;
    border-right: 0;
    border-bottom: 0;
    border-left: 1px solid var(--border-color);
    border-radius: 0;
  }

  .global-search-toggle {
    display: none;
  }

  .global-search-submit:hover,
  .global-search-toggle:hover,
  .menu-toggle:hover,
  .language-switch:hover {
    background: var(--surface-muted);
  }

  .global-search-popover,
  .global-menu {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    border: 1px solid var(--border-color);
    border-radius: 22px;
    background: var(--surface);
    box-shadow: 0 22px 60px rgba(15, 23, 42, 0.18);
  }

  .global-search-popover {
    display: grid;
    gap: 12px;
    width: min(520px, calc(100vw - 32px));
    padding: 14px;
  }

  .global-search-popover[hidden],
  .global-menu[hidden] {
    display: none;
  }

  .global-search-filters {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--accent) 32%, transparent) transparent;
  }

  .global-search-filters::-webkit-scrollbar {
    height: 8px;
  }

  .global-search-filters::-webkit-scrollbar-track {
    background: transparent;
  }

  .global-search-filters::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .global-search-filters::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, var(--accent) 44%, transparent);
  }

  .global-search-filters button {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 32px;
    align-items: center;
    gap: 6px;
    padding: 0 11px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--surface-elevated);
    color: var(--accent);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 900;
    cursor: pointer;
  }

  .global-search-filters button.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  .global-search-results {
    display: grid;
    gap: 8px;
    max-height: 370px;
    overflow-y: auto;
    padding-right: 4px;
  }

  .global-search-results::-webkit-scrollbar {
    width: 8px;
  }

  .global-search-results::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .global-search-result {
    display: grid;
    gap: 4px;
    padding: 12px 13px;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    background: var(--surface-elevated);
    text-decoration: none;
  }

  .global-search-result:hover {
    border-color: var(--border-strong);
    background: var(--accent-soft);
  }

  .global-search-result span {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .global-search-result strong {
    color: var(--heading-color);
    font-size: 0.98rem;
    line-height: 1.3;
  }

  .global-search-result small {
    display: -webkit-box;
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.45;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .global-search-result mark {
    padding: 0 2px;
    border-radius: 5px;
    background: var(--accent-soft);
    color: var(--heading-color);
    font-weight: 900;
  }

  html[data-theme="dark"] .global-search-result mark {
    background: var(--accent-hover);
    color: var(--accent-contrast);
  }

  .global-search-state {
    padding: 18px;
    border-radius: 16px;
    background: var(--surface-elevated);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .global-search-all {
    display: inline-flex;
    justify-content: center;
    min-height: 38px;
    align-items: center;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 900;
    text-decoration: none;
  }

  .global-menu {
    display: grid;
    width: min(280px, calc(100vw - 32px));
    padding: 10px;
  }

  .global-menu a {
    display: flex;
    min-height: 40px;
    align-items: center;
    padding: 0 12px;
    border-radius: 14px;
    color: var(--accent);
    font-weight: 850;
    text-decoration: none;
  }

  .global-menu a:hover {
    background: var(--accent-soft);
  }

  .menu-theme-row {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 6px;
    padding: 8px 10px 4px 12px;
    border-top: 1px solid var(--border-color);
    color: var(--accent);
    font-weight: 850;
  }

  .menu-theme-toggle {
    width: 38px;
    height: 38px;
  }

  .floating-theme-toggle {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.18);
  }

  html[data-theme="dark"] .global-search-form,
  html[data-theme="dark"] .global-search-popover,
  html[data-theme="dark"] .global-menu {
    background: var(--surface);
    border-color: var(--surface-muted);
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.38);
  }

  html[data-theme="dark"] .global-search-form input {
    color: var(--heading-color);
  }

  html[data-theme="dark"] .global-search-form input::placeholder {
    color: var(--text-muted);
  }

  html[data-theme="dark"] .global-search-submit,
  html[data-theme="dark"] .global-search-toggle,
  html[data-theme="dark"] .menu-toggle,
  html[data-theme="dark"] .language-switch,
  html[data-theme="dark"] .global-search-filters button,
  html[data-theme="dark"] .global-search-result,
  html[data-theme="dark"] .global-search-state {
    background: var(--surface-soft);
    border-color: var(--surface-muted);
    color: var(--accent);
  }

  html[data-theme="dark"] .global-search-form:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent);
  }

  html[data-theme="dark"] .global-search-submit:hover,
  html[data-theme="dark"] .global-search-toggle:hover,
  html[data-theme="dark"] .menu-toggle:hover,
  html[data-theme="dark"] .language-switch:hover,
  html[data-theme="dark"] .global-search-result:hover,
  html[data-theme="dark"] .global-menu a:hover {
    background: var(--surface-muted);
    border-color: var(--accent-hover);
  }

  html[data-theme="dark"] .global-search-filters button.is-active,
  html[data-theme="dark"] .global-search-all {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  html[data-theme="dark"] .global-search-result span,
  html[data-theme="dark"] .global-menu a,
  html[data-theme="dark"] .menu-theme-row {
    color: var(--accent);
  }

  html[data-theme="dark"] .global-search-result strong {
    color: var(--heading-color);
  }

  html[data-theme="dark"] .global-search-result small,
  html[data-theme="dark"] .global-search-state {
    color: var(--text-muted);
  }

  html[data-theme="dark"] .global-search-filters {
    scrollbar-color: color-mix(in srgb, var(--accent) 42%, transparent) transparent;
  }

  html[data-theme="dark"] .global-search-filters::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--accent) 42%, transparent);
  }

  html[data-theme="dark"] .global-search-filters::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, var(--accent) 56%, transparent);
  }

  html[data-theme="dark"] .menu-theme-row {
    border-top-color: var(--surface-muted);
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: center;
      flex-direction: row;
      gap: 10px;
      padding: 14px 0;
    }

    .site-header.search-open .logo {
      display: none;
    }

    .header-actions {
      margin-left: auto;
    }

    .global-search-shell {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .global-search-toggle {
      display: inline-flex;
      order: 1;
    }

    .global-search-form {
      display: none;
      order: 1;
      width: calc(100vw - 96px);
    }

    .global-search-shell.is-open .global-search-toggle {
      display: none;
    }

    .global-search-shell.is-open .global-search-form {
      display: inline-flex;
    }

    .global-search-popover {
      position: fixed;
      top: 76px;
      left: 16px;
      right: 16px;
      width: auto;
    }

    .global-menu {
      position: fixed;
      top: 76px;
      right: 16px;
      width: min(280px, calc(100vw - 32px));
    }

    .floating-theme-toggle {
      right: 14px;
      bottom: 14px;
    }
  }


  /* Bibli visual system v2: neutral adaptive palette, consistent across the app. */
  html[data-theme="dark"] {
    color-scheme: dark;
    --page-bg: #0f1115;
    --surface: #171a1f;
    --surface-elevated: #1d2127;
    --surface-soft: #242a31;
    --surface-muted: #2d343d;
    --text-color: #e6eaf0;
    --text-muted: #a6aebb;
    --heading-color: #f7f9fb;
    --border-color: rgba(226, 232, 240, 0.10);
    --border-strong: rgba(226, 232, 240, 0.18);
    --accent: #82add6;
    --accent-hover: #9bc0e2;
    --accent-soft: #202f3f;
    --accent-contrast: #101820;
    --focus-ring: rgba(130, 173, 214, 0.22);
    --shadow-sm: 0 10px 28px rgba(0, 0, 0, 0.20);
    --shadow-md: 0 22px 58px rgba(0, 0, 0, 0.32);
  }

  /* Global surfaces and typography. */
  body { background: var(--page-bg); color: var(--text-color); }
  h1, h2, h3, h4, h5, h6 { color: var(--heading-color); }
  .logo { color: var(--accent); }
  .eyebrow { color: var(--accent); }
  .subtitle,
  .card p,
  .section p,
  .breadcrumb,
  .site-footer,
  .meta { color: var(--text-muted); }

  .hero, .section, .card {
    background: var(--surface);
    border-color: var(--border-color);
    box-shadow: var(--shadow-sm);
  }
  .hero {
    background: linear-gradient(145deg, var(--surface), color-mix(in srgb, var(--accent-soft) 38%, var(--surface)));
  }
  .hero::after {
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 14%, transparent), transparent 68%);
  }
  .button { background: var(--accent); color: var(--accent-contrast); }
  .button:hover { background: var(--accent-hover); }
  .button.secondary { background: var(--surface); color: var(--accent); border-color: var(--border-strong); }
  .button.secondary:hover { background: var(--surface-soft); border-color: var(--accent); }

  /* Header, search and menu. */
  .global-search-form,
  .global-search-popover,
  .global-menu {
    background: var(--surface-elevated);
    border-color: var(--border-color);
    box-shadow: var(--shadow-md);
  }
  .global-search-form input { color: var(--text-color); }
  .global-search-form input::placeholder { color: var(--text-muted); }
  .global-search-submit,
  .global-search-toggle,
  .menu-toggle,
  .language-switch,
  .theme-toggle {
    background: var(--surface-elevated);
    border-color: var(--border-color);
    color: var(--accent);
  }
  .global-search-submit:hover,
  .global-search-toggle:hover,
  .menu-toggle:hover,
  .language-switch:hover,
  .theme-toggle:hover {
    background: var(--accent-soft);
    border-color: var(--border-strong);
    color: var(--accent-hover);
  }
  .global-search-form:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--focus-ring);
  }
  .global-search-submit { border-left-color: var(--border-color); }
  .global-menu { width: min(260px, calc(100vw - 32px)); padding: 8px; border-radius: 18px; }
  .global-menu a { min-height: 42px; border-radius: 11px; color: var(--text-color); font-weight: 720; }
  .global-menu a:hover { background: var(--surface-soft); color: var(--heading-color); }
  .menu-theme-row { border-top-color: var(--border-color); color: var(--text-muted); font-weight: 650; }
  .global-search-filters button,
  .global-search-result,
  .global-search-state {
    background: var(--surface);
    border-color: var(--border-color);
    color: var(--text-color);
  }
  .global-search-filters button.is-active, .global-search-all {
    background: var(--accent); border-color: var(--accent); color: var(--accent-contrast);
  }
  .global-search-result span { color: var(--accent); }
  .global-search-result strong { color: var(--heading-color); }
  .global-search-result small, .global-search-state { color: var(--text-muted); }
  .global-search-result:hover { background: var(--surface-soft); border-color: var(--border-strong); }
  .global-search-result mark { background: var(--accent-soft); color: var(--heading-color); }

  /* Interface icon geometry is centralized in components/Icon.astro (Lucide 24x24 language). */
  .global-search-submit, .global-search-toggle, .menu-toggle { position: relative; }
  .floating-theme-toggle { box-shadow: var(--shadow-sm); }

  /* Legacy surfaces still used by secondary sections inherit the same system. */
  .entity-card, .timeline-card, .map-shell, .search-input, .search-result, .explore-card,
  .route-stat, .lesson-study-panel, .mini-nav-link, .lesson-nav-card, .connections-section,
  .passage-study-section, .main-idea-section, .lesson-points-section, .study-card,
  .storyline-content, .connection-card, .passage-study-card, .main-idea-card,
  .lesson-points-list li, .lesson-track-card, .notice-box, .copyright-box,
  .place-hero-card, .place-meta-card, .place-map-panel, .place-importance-section,
  .place-events-section, .place-lessons-section, .place-empty-section {
    background: var(--surface);
    border-color: var(--border-color);
    color: var(--text-color);
  }
  .place-map-preview, .place-empty-map, .place-importance-card, .place-event-card, .place-lesson-card,
  .info-list li, .search-empty, .route-progress, .section-count {
    background: var(--surface-soft);
    border-color: var(--border-color);
    color: var(--text-muted);
  }
  .chapter-link, .pill-list a, .pill-list span, .connection-list a, .timeline-date, .timeline-meta span {
    background: var(--surface-soft); border-color: var(--border-color); color: var(--text-color);
