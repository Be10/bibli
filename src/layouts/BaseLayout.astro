  }

  .site-footer a {
    color: var(--accent);
    font-weight: 800;
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    max-width: 760px;
  }

  .footer-links a {
    white-space: nowrap;
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .section-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
