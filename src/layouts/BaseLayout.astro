    margin-bottom: 22px;
  }

  .section-header h2 {
    margin-bottom: 0;
  }

  .section-header .eyebrow {
    margin-bottom: 8px;
  }
  html {
    scroll-behavior: smooth;
  }

  .section-count {
    display: inline-flex;
