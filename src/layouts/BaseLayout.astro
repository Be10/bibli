  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 24px;
  }

  .card {
    padding: 24px;
    border-radius: 22px;
    background: var(--surface);
    border: 1px solid var(--border-color);
  }

  .card h2,
  .card h3 {
