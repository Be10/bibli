      flex-direction: column;
      align-items: stretch;
    }

    .route-overview {
      grid-template-columns: 1fr;
    }

    .lesson-progress-panel {
      grid-template-columns: 1fr;
      padding: 20px;
    }

    .mini-nav-link.next {
      text-align: left;
    }

    .lesson-track-card {
      grid-template-columns: 1fr;
    }

    .lesson-track-number {
      width: 44px;
      height: 44px;
    }

    .lesson-nav {
      grid-template-columns: 1fr;
    }

    .lesson-nav-card,
    .lesson-nav-card.next,
    .lesson-nav-card.center {
      text-align: left;
    }

    .lesson-study-panel {
      grid-template-columns: 1fr;
      padding: 16px;
    }

    .lesson-toc {
      display: grid;
      grid-template-columns: 1fr;
    }

    .lesson-toc a {
      justify-content: center;
    }

    .storyline {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .storyline::before {
      top: 18px;
      bottom: 18px;
      left: 17px;
      right: auto;
      width: 3px;
      height: auto;
    }

    .storyline-item {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto;
      align-items: stretch;
      gap: 14px;
    }

    .storyline-dot {
      width: 36px;
      height: 36px;
    }

    .storyline-content {
      min-height: auto;
    }

    .connections-grid {
      grid-template-columns: 1fr;
    }

    .connection-card {
      min-height: auto;
    }

    .section-count {
      align-self: flex-start;
    }

    .passage-study-grid {
      grid-template-columns: 1fr;
    }

    .passage-study-card {
      min-height: auto;
    }

    .main-idea-card {
      gap: 8px;
      padding: 26px 20px 28px;
    }

    .quote-mark {
      height: 32px;
    }

    .quote-mark::before,
    .quote-mark::after {
      width: 16px;
      height: 24px;
    }

    .lesson-points-list li {
      grid-template-columns: auto 1fr;
      align-items: center;
      min-height: 48px;
      padding: 9px 12px;
    }

    .lesson-point-number {
      width: 32px;
      height: 32px;
    }

    .map-layer-switcher {
      min-width: 142px;
      width: 142px;
      padding: 6px;
      border-radius: 18px;
    }

    .map-layer-current {
      display: flex;
      min-height: 34px;
      padding: 0 10px;
    }

    .map-layer-current span {
      display: none;
    }

    .map-layer-current strong {
      font-size: 0.78rem;
    }

    .map-layer-options {
      display: none;
      grid-template-columns: 1fr;
      gap: 5px;
      margin-top: 6px;
    }

    .map-layer-switcher.is-open .map-layer-options {
      display: grid;
    }

    .map-layer-button {
      min-height: 32px;
      padding: 0 10px;
      font-size: 0.78rem;
    }

    .map-popup {
      width: min(220px, calc(100vw - 112px));
      max-width: min(220px, calc(100vw - 112px));
    }

    .map-popup-compact,
    .map-popup-disclosure {
      width: 100%;
      max-width: 100%;
    }

    .map-popup-details {
      width: 100%;
      max-width: 100%;
      max-height: 188px;
      overflow-y: auto;
      padding-right: 4px;
    }

    .map-popup-details::-webkit-scrollbar {
      width: 6px;
    }

    .map-popup-details::-webkit-scrollbar-thumb {
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent) 42%, transparent);
    }

    .leaflet-popup {
      margin-bottom: 18px;
    }

    .leaflet-popup-content {
      max-width: min(220px, calc(100vw - 112px));
      margin: 20px 20px 18px;
    }

    .leaflet-container a.leaflet-popup-close-button {
      top: 8px;
      right: 8px;
