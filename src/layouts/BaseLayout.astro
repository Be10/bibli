---
import { sitePath } from "../lib/site-paths";
import { getBibleRootPath } from "../lib/bible-routes";
import Icon from "../components/Icon.astro";
import BibliLogo from "../components/BibliLogo.astro";
import GlobalTTS from "../components/GlobalTTS.astro";
import CatalogDesignSystem from "../components/CatalogDesignSystem.astro";
import DetailDesignSystem from "../components/DetailDesignSystem.astro";
import UtilityDesignSystem from "../components/UtilityDesignSystem.astro";
import BibleDesignSystem from "../components/BibleDesignSystem.astro";
import ContextDock from "../components/ContextDock.astro";
import PersonalActions from "../components/PersonalActions.astro";

type LanguageCode = "es" | "en";

type AlternateLanguage = {
  code: LanguageCode;
  label: string;
  href: string;
};

interface Props {
  title: string;
  description?: string;
  lang?: LanguageCode;
  alternateLanguage?: AlternateLanguage;
  robots?: string;
}

const {
  title,
  lang = "es",
  alternateLanguage,
  robots,
} = Astro.props;

const ui = {
  es: {
    siteName: "BIBLIOTECA BÍBLICA",
    shortName: "Bibli",
    defaultDescription: "Recursos para escudriñar y comprender las Escrituras.",
    searchOpen: "Abrir búsqueda",
    searchAction: "Buscar",
    searchClose: "Cerrar búsqueda",
    searchIcon: "Icono de búsqueda",
    searchLabel: "Búsqueda global",
    searchInputLabel: "Buscar en Bibli",
    searchPlaceholder: "Biblia, lecciones, rutas…",
    searchFilters: "Filtros de búsqueda",
    searchResults: "Resultados de búsqueda",
    searchAll: "Ver todos los resultados →",
    searchEmpty: "Escribe una palabra para comenzar.",
    searchNone: "No se encontraron resultados.",
    searchError: "No pudimos cargar la búsqueda. Revisa tu conexión e inténtalo de nuevo.",
    searchAdvanced: "Búsqueda avanzada",
    searchResultsOne: "1 resultado disponible.",
    searchResultsMany: "{count} resultados disponibles.",
    searchResultsFiltered: "{count} resultados en {filter}.",
    menuOpen: "Abrir menú",
    menuLabel: "Menú principal",
    mainRoute: "Ruta principal",
    study: "Estudiar",
    readBible: "Leer la Biblia",
    resources: "Recursos visuales",
    explore: "Explorar",
    about: "Acerca de Bibli",
    installApp: "Instalar Bibli",
    offlineLibrary: "Sin conexión",
    myBibli: "Mi Bibli",
    connectionOffline: "Sin conexión · usando contenido disponible en este dispositivo",
    connectionOnline: "Conexión restablecida",
    updateLabel: "Actualización de Bibli",
    updateReady: "Hay una nueva versión de Bibli lista.",
    updateNow: "Actualizar ahora",
    updateLater: "Más tarde",
    theme: "Tema",
    themeAuto: "Automático",
    themeLight: "Claro",
    themeDark: "Oscuro",
    themeCycle: "Cambiar tema",
    appearance: "Apariencia",
    accent: "Color de énfasis",
    accentEarth: "Tierra",
    accentOcean: "Azul",
    accentForest: "Bosque",
    accentPlum: "Ciruela",
    accentClay: "Arcilla",
    footerText: "Biblioteca Bíblica · Recursos para escudriñar y comprender las Escrituras.",
    footerLabel: "Navegación secundaria",
    legal: "Avisos legales",
    all: "Todos",
    skipContent: "Saltar al contenido",
  },
  en: {
    siteName: "BIBLICAL LIBRARY",
    shortName: "Bibli",
    defaultDescription: "Resources for studying and understanding the Scriptures.",
    searchOpen: "Open search",
    searchAction: "Search",
    searchClose: "Close search",
    searchIcon: "Search icon",
    searchLabel: "Global search",
    searchInputLabel: "Search Bibli",
    searchPlaceholder: "Search...",
    searchFilters: "Search filters",
    searchResults: "Search results",
    searchAll: "View all results →",
    searchEmpty: "Type a word to begin.",
    searchNone: "No results found.",
    searchError: "We couldn't load search. Check your connection and try again.",
    searchAdvanced: "Advanced search",
    searchResultsOne: "1 result available.",
    searchResultsMany: "{count} results available.",
    searchResultsFiltered: "{count} results in {filter}.",
    menuOpen: "Open menu",
    menuLabel: "Main menu",
    mainRoute: "Main route",
    study: "Study",
    readBible: "Read the Bible",
    resources: "Visual resources",
    explore: "Explore",
    about: "About Bibli",
    installApp: "Install Bibli",
    offlineLibrary: "Offline",
    myBibli: "My Bibli",
    connectionOffline: "Offline · using content available on this device",
    connectionOnline: "Connection restored",
    updateLabel: "Bibli update",
    updateReady: "A new version of Bibli is ready.",
    updateNow: "Update now",
    updateLater: "Later",
    theme: "Theme",
    themeAuto: "Automatic",
    themeLight: "Light",
    themeDark: "Dark",
    themeCycle: "Change theme",
    appearance: "Appearance",
    accent: "Accent color",
    accentEarth: "Earth",
    accentOcean: "Blue",
    accentForest: "Forest",
    accentPlum: "Plum",
    accentClay: "Clay",
    footerText: "Biblical Library · Resources for studying and understanding the Scriptures.",
    footerLabel: "Secondary navigation",
    legal: "Legal notices",
    all: "All",
    skipContent: "Skip to content",
  },
} as const;

const activeUi = ui[lang];
const description = Astro.props.description ?? activeUi.defaultDescription;
const siteName = activeUi.siteName;
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;

const searchDataUrl =
  lang === "en"
    ? sitePath("/en/search/data.json")
    : sitePath("/buscar/datos.json");
const searchPageUrl =
  lang === "en" ? sitePath("/en/search/") : sitePath("/buscar/");
const homeUrl = lang === "en" ? sitePath("/en/") : sitePath("/");
const bibleRootUrl = getBibleRootPath(lang);
const manifestUrl = sitePath("/manifest.webmanifest");
const serviceWorkerUrl = sitePath("/sw.js");
const appleTouchIconUrl = sitePath("/icons/apple-touch-icon.png");
const serviceWorkerEnabled = import.meta.env.PROD;

const normalizePathname = (value: string) => {
  const pathname = new URL(value, Astro.url).pathname;
  return pathname === "/" ? "/" : `${pathname.replace(/\/+$/, "")}/`;
};
const currentPathname = normalizePathname(Astro.url.pathname);
const isLessonDetail = /\/lecciones\/[^/]+\/$/.test(currentPathname);
const isCurrentNavigationItem = (href: string) => {
  const targetPathname = normalizePathname(href);
  return targetPathname === "/"
    ? currentPathname === "/"
    : currentPathname === targetPathname || currentPathname.startsWith(targetPathname);
};

const menuItems =
  lang === "en"
    ? [
        { href: sitePath("/en/my-bibli/"), label: activeUi.myBibli, icon: "bookmark" as const },
        { href: bibleRootUrl, label: activeUi.readBible, icon: "book" as const },
        { href: sitePath("/en/download/"), label: activeUi.offlineLibrary, icon: "download" as const },
      ]
    : [
        { href: bibleRootUrl, label: activeUi.readBible, icon: "book" as const },
        { href: sitePath("/rutas/"), label: activeUi.study, icon: "route" as const },
        { href: sitePath("/explorar/"), label: activeUi.explore, icon: "compass" as const },
        { href: sitePath("/mi-bibli/"), label: activeUi.myBibli, icon: "bookmark" as const },
      ];

const footerItems =
  lang === "en"
    ? [
        { href: sitePath("/en/my-bibli/"), label: activeUi.myBibli },
        { href: bibleRootUrl, label: activeUi.readBible },
        { href: sitePath("/en/download/"), label: activeUi.offlineLibrary },
      ]
    : [
        { href: bibleRootUrl, label: activeUi.readBible },
        { href: sitePath("/rutas/"), label: activeUi.study },
        { href: sitePath("/explorar/"), label: activeUi.explore },
        { href: sitePath("/mi-bibli/"), label: activeUi.myBibli },
        { href: sitePath("/recursos/"), label: activeUi.resources },
        { href: sitePath("/descargar/"), label: activeUi.offlineLibrary },
        { href: sitePath("/acerca/"), label: activeUi.about },
        { href: sitePath("/legal/"), label: activeUi.legal },
      ];

const isNoIndex = /\bnoindex\b/i.test(robots ?? "");
const canonicalHref = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.href;
const alternateHref = alternateLanguage
  ? Astro.site
    ? new URL(alternateLanguage.href, Astro.site).toString()
    : alternateLanguage.href
  : null;
const defaultLanguageHref = alternateLanguage && alternateHref
  ? lang === "es"
    ? canonicalHref
    : alternateLanguage.code === "es"
      ? alternateHref
      : canonicalHref
  : null;
const socialLocale = lang === "en" ? "en_US" : "es_PE";
const alternateSocialLocale = alternateLanguage
  ? alternateLanguage.code === "en" ? "en_US" : "es_PE"
  : null;

const languageTarget = alternateLanguage
  ? { ...alternateLanguage, mode: "equivalent" as const }
  : {
      code: (lang === "es" ? "en" : "es") as LanguageCode,
      label: lang === "es" ? "English" : "Español",
      href: lang === "es" ? sitePath("/en/") : sitePath("/"),
      mode: "fallback" as const,
    };
const languageSwitchLabel =
  languageTarget.mode === "equivalent"
    ? lang === "es"
      ? `Cambiar a ${languageTarget.label}`
      : `Switch to ${languageTarget.label}`
    : lang === "es"
      ? "English · abrir el inicio en inglés"
      : "Español · open Spanish home";
---

<html
  lang={lang}
  data-language-preference={!isNoIndex ? lang : undefined}
  data-lesson-dock={isLessonDetail ? "true" : undefined}
  data-personal-page-title={!isNoIndex ? title : undefined}
  data-personal-page-lang={!isNoIndex ? lang : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <title>{pageTitle}</title>
    {!isNoIndex && <link rel="canonical" href={canonicalHref} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={socialLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {!isNoIndex && alternateLanguage && alternateHref && defaultLanguageHref && (
      <>
        <link rel="alternate" hreflang={lang} href={canonicalHref} />
        <link
          rel="alternate"
          hreflang={alternateLanguage.code}
          href={alternateHref}
        />
        <link rel="alternate" hreflang="x-default" href={defaultLanguageHref} />
        {alternateSocialLocale && (
          <meta property="og:locale:alternate" content={alternateSocialLocale} />
        )}
      </>
    )}
    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} data-dynamic-favicon />
    <link rel="manifest" href={manifestUrl} />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} />
    <meta name="theme-color" content="#f7f8fa" data-theme-color />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Bibli" />

    <style is:inline>
      html[data-theme="dark"] .button {
        background: var(--accent) !important;
        border-color: var(--accent) !important;
        color: var(--accent-contrast) !important;
      }

      html[data-theme="dark"] .button.secondary {
        background: transparent !important;
        border-color: var(--accent-hover) !important;
        color: var(--accent) !important;
      }

      html[data-theme="dark"] .button.secondary:hover {
        background: var(--surface-muted) !important;
        border-color: var(--accent) !important;
        color: var(--heading-color) !important;
      }

      .hero {
        position: relative;
        overflow: hidden;
      }

      .hero::after {
        content: "";
        position: absolute;
        right: -90px;
        bottom: -120px;
        width: 320px;
        height: 320px;
        border-radius: 999px;
        background: radial-gradient(circle, color-mix(in srgb, var(--accent) 16%, transparent), transparent 68%);
        pointer-events: none;
      }

      .hero > * {
        position: relative;
        z-index: 1;
      }

            /*
        Estilo crítico para evitar parpadeo de la línea de tiempo.
        Debe coincidir con el layout final de /linea-de-tiempo/ desde el primer render.
      */
      .timeline-ready .timeline-period,
      .timeline-ready .timeline-card,
      .timeline-ready .timeline-card-header,
      .timeline-ready .timeline-marker,
      .timeline-ready .timeline-marker span,
      .timeline-ready .timeline-date,
      .timeline-ready .timeline-order,
      .timeline-ready .timeline-meta,
      .timeline-ready .timeline-meta span,
      .timeline-ready .timeline-period-header strong {
        box-sizing: border-box;
      }

      .timeline-ready .timeline-period {
        display: grid;
        gap: 18px;
        padding: 22px;
        border-radius: 24px;
      }

      .timeline-ready .timeline-period-header strong {
        display: inline-flex;
        min-height: 34px;
        max-width: 100%;
        align-items: center;
        padding: 7px 12px;
        border-radius: 18px;
        background: var(--surface);
        border: 1px solid var(--border-color);
        color: var(--accent);
        font-size: 0.86rem;
        line-height: 1.22;
        white-space: normal;
        overflow-wrap: anywhere;
      }

      .timeline-ready .timeline-list {
        position: relative;
        display: grid;
        gap: 14px;
      }

      .timeline-ready .timeline-list::before {
        content: "";
        position: absolute;
        top: 12px;
        bottom: 12px;
        left: 13px;
        width: 2px;
        background: var(--border-color);
      }

      .timeline-ready .timeline-item {
        position: relative;
        display: grid;
        grid-template-columns: 28px minmax(0, 1fr);
        gap: 14px;
      }

      .timeline-ready .timeline-marker {
        position: relative;
        display: flex;
        justify-content: center;
        padding-top: 18px;
        z-index: 1;
      }

      .timeline-ready .timeline-marker span {
        width: 12px;
        height: 12px;
        flex: 0 0 12px;
        border-radius: 999px;
        background: var(--accent);
        border: 3px solid var(--surface-elevated);
        box-shadow: 0 0 0 1px var(--border-strong);
      }

      .timeline-ready .timeline-card {
        display: grid;
        gap: 10px;
        min-width: 0;
        padding: 18px;
        border-radius: 20px;
        background: var(--surface);
        border: 1px solid var(--border-color);
      }

      .timeline-ready .timeline-card-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
      }

      .timeline-ready .timeline-date,
      .timeline-ready .timeline-order,
      .timeline-ready .timeline-meta span {
        display: inline-flex;
        min-height: 30px;
        max-width: 100%;
        align-items: center;
        padding: 7px 12px;
        border-radius: 18px;
        background: var(--accent-soft);
        border: 1px solid var(--border-color);
        color: var(--accent);
        line-height: 1.22;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: normal;
      }

      .timeline-ready .timeline-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        min-width: 0;
      }

      html[data-theme="dark"] .timeline-ready .timeline-list::before {
        background: var(--surface-muted);
      }

      html[data-theme="dark"] .timeline-ready .timeline-marker span {
        background: var(--accent);
        border-color: var(--surface-soft);
        box-shadow: 0 0 0 1px var(--accent-hover);
      }

      html[data-theme="dark"] .timeline-ready .timeline-period-header strong,
      html[data-theme="dark"] .timeline-ready .timeline-date,
      html[data-theme="dark"] .timeline-ready .timeline-order,
      html[data-theme="dark"] .timeline-ready .timeline-meta span {
        background: var(--surface);
        border-color: var(--border-color);
        color: var(--accent);
      }

      @media (max-width: 640px) {
        .timeline-ready .timeline-period {
          padding: 18px;
        }

        .timeline-ready .timeline-card {
          padding: 18px;
        }

        .timeline-ready .timeline-card-header {
          flex-direction: column;
          align-items: flex-start;
        }

        .timeline-ready .timeline-date,
        .timeline-ready .timeline-order,
        .timeline-ready .timeline-meta span {
          padding: 8px 12px;
          border-radius: 16px;
          line-height: 1.25;
          letter-spacing: 0.06em;
        }

        .timeline-ready .timeline-date {
          max-width: min(100%, 220px);
        }
      }

      .timeline-page .timeline-date,
      .timeline-page .timeline-order,
      .timeline-page .timeline-meta span {
        background: var(--accent-soft);
        border: 1px solid var(--border-color);
        color: var(--accent);
      }

      .timeline-page .timeline-period-header strong {
        background: var(--surface);
        border: 1px solid var(--border-color);
        color: var(--accent);
      }

      html[data-theme="dark"] .timeline-page .timeline-period-header strong,
      html[data-theme="dark"] .timeline-page .timeline-date,
      html[data-theme="dark"] .timeline-page .timeline-order,
      html[data-theme="dark"] .timeline-page .timeline-meta span {
        background: var(--surface);
        border-color: var(--border-color);
        color: var(--accent);
      }

      @media (max-width: 640px) {
        .timeline-page .timeline-date,
        .timeline-page .timeline-order,
        .timeline-page .timeline-meta span {
          padding: 8px 12px;
          border-radius: 16px;
          line-height: 1.25;
          letter-spacing: 0.06em;
        }

        .timeline-page .timeline-date {
          max-width: min(100%, 220px);
        }

        .timeline-page .timeline-meta span {
          max-width: 100%;
        }
      }
      html[data-theme="dark"] .mini-nav-link {
        background: var(--surface) !important;
        border-color: var(--border-color) !important;
        color: var(--heading-color) !important;
      }
      html[data-theme="dark"] .mini-nav-link span,
      html[data-theme="dark"] .mini-nav-link strong {
        color: inherit;
      }
      html[data-theme="dark"] .mini-nav-link span {
        color: var(--accent) !important;
      }

      html[data-theme="dark"] .mini-nav-link strong {
        color: var(--heading-color) !important;
      }
    </style>

    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        const currentKey = "bibli-theme";
        const accentKey = "bibli-accent";
        const currentLanguage = document.documentElement.dataset.languagePreference;
        if (currentLanguage === "es" || currentLanguage === "en") {
          localStorage.setItem("bibli-language", currentLanguage);
        }
        const storedPreference = localStorage.getItem(currentKey);
        const storedAccent = localStorage.getItem(accentKey);

        const preference =
          storedPreference === "auto" ||
          storedPreference === "light" ||
          storedPreference === "dark"
            ? storedPreference
            : "auto";

        const effectiveTheme =
          preference === "auto"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : preference;

        document.documentElement.dataset.theme = effectiveTheme;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.style.colorScheme = effectiveTheme;

        const themeColor = document.querySelector("[data-theme-color]");
        themeColor?.setAttribute(
          "content",
          effectiveTheme === "dark" ? "#0f1115" : "#f7f8fa",
        );

        const accent = ["earth", "ocean", "forest", "plum", "clay"].includes(storedAccent ?? "")
          ? storedAccent
          : "earth";
        document.documentElement.dataset.accent = accent;

        const faviconPalette = {
          earth: { background: "#7b5439", foreground: "#f6efe9" },
          ocean: { background: "#356da8", foreground: "#eff5fb" },
          forest: { background: "#3f725b", foreground: "#eff6f2" },
          plum: { background: "#765982", foreground: "#f6f0f8" },
          clay: { background: "#a25745", foreground: "#faf0ed" },
        };
        const faviconBodyPath = "M 43.962891 14 L 44.716797 17.769531 C 55.458397 19.826731 57.784403 23.980262 58.283203 34.351562 L 58.283203 49.796875 L 71.851562 49.796875 L 71.851562 23.798828 C 71.871363 21.477528 73.358459 19.275391 77.880859 19.275391 L 91.447266 19.275391 C 98.984566 19.275391 108.0293 23.799469 108.0293 35.105469 C 108.0293 46.411369 98.984566 53.039063 91.447266 53.039062 L 45.470703 53.039062 C 44.901903 53.011563 44.590491 53.007191 43.962891 52.900391 C 40.502591 52.356991 37.575381 51.698594 36.425781 50.933594 L 37.785156 58.322266 C 38.510856 57.912866 40.932491 57.422247 43.962891 56.935547 C 44.544091 56.838247 44.875603 56.818594 45.470703 56.808594 L 94.462891 56.808594 C 105.01519 56.808594 111.79883 68.26915 111.79883 83.34375 C 111.79883 99.92585 105.01447 109.72461 91.447266 109.72461 L 77.880859 109.72461 C 73.358459 109.72461 71.871363 107.52317 71.851562 105.20117 L 71.851562 60.025391 L 58.283203 60.025391 L 58.283203 94.648438 C 57.784403 105.02014 55.458397 109.17347 44.716797 111.23047 L 43.962891 115 L 58.283203 115 L 71.851562 115 L 91.447266 115 C 118.58147 115 127.62695 102.18745 127.62695 83.34375 C 127.62695 69.602081 121.93402 58.611898 107.56445 54.642578 C 116.398 51.707894 121.59766 45.593005 121.59766 35.105469 C 121.59766 19.277069 109.76347 14 91.447266 14 L 71.851562 14 L 58.283203 14 L 43.962891 14 z";
        const faviconSparkPath = "M31.1493 14C31.1493 14 32.8047 48.5236 36.4254 50.9328C40.046 53.342 61.2985 54.7015 61.2985 54.7015C61.2985 54.7015 40.194 56.9627 37.7848 58.3221C35.3756 59.6816 34.1642 61.4851 34.1642 63.7463C34.1642 69.7761 31.1493 115 31.1493 115C31.1493 115 28.1343 69.7761 28.1343 63.7463C28.1343 61.4851 26.9229 59.6816 24.5137 58.3221C22.1045 56.9627 1 54.7015 1 54.7015C1 54.7015 22.2525 53.342 25.8731 50.9328C29.4938 48.5236 31.1493 14 31.1493 14Z";

        function updateDynamicFavicon(nextAccent) {
          const faviconLink = document.querySelector("[data-dynamic-favicon]");
          if (!(faviconLink instanceof HTMLLinkElement)) return;

          const palette = faviconPalette[nextAccent] ?? faviconPalette.earth;
          const faviconGlyphTransform = "translate(9.695422 14.049505) scale(.782178)";
          const glyph = `\x3Cg transform="${faviconGlyphTransform}">\x3Cpath d="${faviconBodyPath}"/>\x3Cpath d="${faviconSparkPath}"/>\x3C/g>`;
          const faviconSvg = `\x3Csvg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128">\x3Crect width="128" height="128" rx="45" fill="${palette.background}"/>\x3Cg fill="${palette.foreground}">${glyph}\x3C/g>\x3C/svg>`;

          faviconLink.setAttribute(
            "href",
            `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`,
          );
        }

        updateDynamicFavicon(accent);
        document.addEventListener("bibli:accent-change", (event) => {
          const nextAccent = event instanceof CustomEvent ? event.detail?.accent : null;
          updateDynamicFavicon(nextAccent);
        });

        const lessonMode = localStorage.getItem("bibli-lesson-mode-v1") === "reading" ? "reading" : "study";
        const compactLessonLayout = window.matchMedia("(max-width: 920px)").matches;
        document.documentElement.dataset.lessonMode = lessonMode;
        // Lesson side panels are deterministic at first paint: visible on desktop, closed on compact layouts.
        // Their temporary open/closed state is intentionally not persisted between page loads.
        document.documentElement.dataset.studyAids = compactLessonLayout ? "hidden" : "visible";
        document.documentElement.dataset.lessonToc = compactLessonLayout ? "hidden" : "visible";

        const storedReaderSize = localStorage.getItem("bibli-reader-size-v1");
        const storedReaderFont = localStorage.getItem("bibli-reader-font-v1");
        const storedReaderAlign = localStorage.getItem("bibli-reader-align-v1");
        const storedReaderSpacing = localStorage.getItem("bibli-reader-spacing-v1");
        document.documentElement.dataset.readerSize = ["small", "large"].includes(storedReaderSize ?? "") ? storedReaderSize : "default";
        document.documentElement.dataset.readerFont = ["sans", "serif"].includes(storedReaderFont ?? "") ? storedReaderFont : "default";
        document.documentElement.dataset.readerAlign = ["left", "justify"].includes(storedReaderAlign ?? "") ? storedReaderAlign : "default";
        document.documentElement.dataset.readerSpacing = ["compact", "relaxed"].includes(storedReaderSpacing ?? "") ? storedReaderSpacing : "default";
        document.documentElement.dataset.verseNumbers = localStorage.getItem("bibli-verse-numbers-v1") === "hidden" ? "hidden" : "visible";
      })();
    </script>
  </head>

