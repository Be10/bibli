---
import { sitePath } from "../lib/site-paths";
import Icon from "../components/Icon.astro";
import BibliLogo from "../components/BibliLogo.astro";

const homeEs = sitePath("/");
const homeEn = sitePath("/en/");
const downloadEs = sitePath("/descargar/");
const downloadEn = sitePath("/en/download/");
---
<!doctype html>
<html lang="es" data-theme="light" data-accent="earth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#7b5439" data-theme-color />
    <meta name="robots" content="noindex" />
    <title>Sin conexión | Biblioteca Bíblica</title>
    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} />
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem("bibli-theme");
        const theme = storedTheme === "dark" || storedTheme === "light"
          ? storedTheme
          : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const storedAccent = localStorage.getItem("bibli-accent");
        const accent = ["earth", "ocean", "forest", "plum", "clay"].includes(storedAccent || "")
          ? storedAccent
          : "earth";
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.accent = accent;
        const accentColors = {
          earth: { light: "#7b5439", dark: "#d0a888" },
          ocean: { light: "#356da8", dark: "#82add6" },
          forest: { light: "#3f725b", dark: "#91b39f" },
          plum: { light: "#765982", dark: "#b7a0bf" },
          clay: { light: "#a25745", dark: "#d99d8d" },
        };
        const themeColor = document.querySelector("[data-theme-color]");
        if (themeColor) themeColor.setAttribute("content", accentColors[accent][theme]);
      })();
    </script>
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --page:#f7f7f8;
        --surface:#fff;
        --text:#25232a;
        --muted:#69636f;
        --border:#ddd8e0;
        --accent:#7b5439;
        --accent-hover:#61412d;
        --accent-soft:#eee1d6;
        --accent-contrast:#fff;
        background:var(--page);
        color:var(--text);
      }
      :root[data-accent="earth"] { --accent:#7b5439; --accent-hover:#61412d; --accent-soft:#eee1d6; }
      :root[data-accent="ocean"] { --accent:#356da8; --accent-hover:#285985; --accent-soft:#dceaf8; }
      :root[data-accent="forest"] { --accent:#3f725b; --accent-hover:#315b48; --accent-soft:#dfede5; }
      :root[data-accent="plum"] { --accent:#765982; --accent-hover:#5f4769; --accent-soft:#eadff0; }
      :root[data-accent="clay"] { --accent:#a25745; --accent-hover:#874737; --accent-soft:#f2dfda; }
      :root[data-theme="dark"] {
        color-scheme:dark;
        --page:#0f1115;
        --surface:#171a1f;
        --text:#f7f9fb;
        --muted:#a6aebb;
        --border:#33353b;
        --accent:#d0a888;
        --accent-hover:#e1ba9a;
        --accent-soft:#362a23;
        --accent-contrast:#111827;
      }
      :root[data-theme="dark"][data-accent="earth"] { --accent:#d0a888; --accent-hover:#e1ba9a; --accent-soft:#362a23; --accent-contrast:#111827; }
      :root[data-theme="dark"][data-accent="ocean"] { --accent:#82add6; --accent-hover:#9bc0e2; --accent-soft:#202f3f; --accent-contrast:#101820; }
      :root[data-theme="dark"][data-accent="forest"] { --accent:#91b39f; --accent-hover:#a8c7b5; --accent-soft:#223129; --accent-contrast:#101a15; }
      :root[data-theme="dark"][data-accent="plum"] { --accent:#b7a0bf; --accent-hover:#cbb6d1; --accent-soft:#312936; --accent-contrast:#19131b; }
      :root[data-theme="dark"][data-accent="clay"] { --accent:#d99d8d; --accent-hover:#e9b2a4; --accent-soft:#382722; --accent-contrast:#1f1411; }
      * { box-sizing:border-box; }
      body {
        min-height:100dvh;
        margin:0;
        display:grid;
        place-items:center;
        padding:max(24px,env(safe-area-inset-top)) max(20px,env(safe-area-inset-right)) max(24px,env(safe-area-inset-bottom)) max(20px,env(safe-area-inset-left));
        background:radial-gradient(circle at top right,var(--accent-soft) 0,transparent 38%),var(--page);
      }
      main { width:min(100%,580px); padding:32px; border:1px solid var(--border); border-radius:22px; background:var(--surface); box-shadow:0 20px 60px rgb(0 0 0 / .1); }
      .brand { display:inline-flex; align-items:center; gap:0; color:var(--accent); text-decoration:none; }
      .brand-word { margin-left:.05rem; font-family:Baskerville,"Baskerville Old Face","Iowan Old Style","Palatino Linotype","Book Antiqua",Georgia,serif; font-size:1.55rem; font-weight:400; font-synthesis:none; line-height:.9; letter-spacing:.01em;transform:translateY(.06em); }
      .network-state { display:flex; align-items:center; gap:8px; margin-top:18px; padding:9px 11px; border:1px solid var(--border); border-radius:12px; background:color-mix(in srgb,var(--accent-soft) 34%,var(--surface)); color:var(--muted); font-size:.78rem; }
      .network-state > span { width:8px; height:8px; flex:0 0 8px; border-radius:50%; background:var(--muted); }
      .network-state.is-online > span { background:var(--accent); }
      .network-state strong { color:var(--text); font-weight:760; }
      h1 { margin:18px 0 10px; color:var(--text); font-size:clamp(2rem,7vw,3.2rem); line-height:1; letter-spacing:-.05em; }
      p { margin:0; color:var(--muted); line-height:1.7; }
      .actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:24px; }
      a,button { min-height:44px; display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:0 16px; border-radius:12px; font:inherit; font-weight:760; text-decoration:none; cursor:pointer; }
      .primary { background:var(--accent); color:var(--accent-contrast); border:1px solid var(--accent); }
      .primary:hover { background:var(--accent-hover); border-color:var(--accent-hover); }
      .secondary,button { background:var(--surface); color:var(--accent); border:1px solid color-mix(in srgb,var(--accent) 42%,var(--border)); }
      small { display:block; margin-top:20px; color:var(--muted); line-height:1.5; }
      [data-offline-copy][hidden] { display:none !important; }
      @media(max-width:520px){ main{padding:24px 18px;border-radius:20px}.actions{display:grid}.actions>*{width:100%} }
      @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
    </style>
  </head>
  <body>
    <main>
      <span class="brand" aria-label="Bibli"><BibliLogo size={30} class="offline-logo" /><span class="brand-word" aria-hidden="true">ibli</span></span>
      <div class="network-state" data-offline-network role="status" aria-live="polite"><span aria-hidden="true"></span><strong></strong></div>

      <h1>
        <span data-offline-copy="es">Estás sin conexión</span>
        <span data-offline-copy="en" lang="en" hidden>You’re offline</span>
      </h1>

      <section data-offline-copy="es">
        <p>Bibli intentará mostrar las páginas y paquetes guardados en este dispositivo. El contenido que todavía no se haya descargado necesitará conexión.</p>
        <div class="actions">
          <a class="primary" href={homeEs}><Icon name="library" size={17} /> Ir al inicio</a>
          <a class="secondary" href={downloadEs}><Icon name="download" size={17} /> Ver contenido descargado</a>
          <button type="button" data-offline-retry><Icon name="arrow-right" size={17} /> Reintentar</button>
        </div>
        <small>Puedes preparar con anticipación la aplicación, tus lecciones y una versión bíblica desde “Sin conexión”.</small>
      </section>

      <section data-offline-copy="en" lang="en" hidden>
        <p>Bibli will try to show pages and packages saved on this device. Content that has not been downloaded yet will require a connection.</p>
        <div class="actions">
          <a class="primary" href={homeEn}><Icon name="library" size={17} /> Go home</a>
          <a class="secondary" href={downloadEn}><Icon name="download" size={17} /> View offline content</a>
          <button type="button" data-offline-retry><Icon name="arrow-right" size={17} /> Try again</button>
        </div>
        <small>You can prepare the app and a Bible version in advance from “Offline”.</small>
      </section>
    </main>

    <script is:inline>
      (() => {
        const storedLanguage = localStorage.getItem("bibli-language");
        const referrerIsEnglish = document.referrer.includes("/en/");
        const browserIsEnglish = navigator.language?.toLowerCase().startsWith("en");
        const language = storedLanguage === "en" || (!storedLanguage && (referrerIsEnglish || browserIsEnglish)) ? "en" : "es";
        document.documentElement.lang = language;
        document.title = language === "en" ? "Offline | Biblical Library" : "Sin conexión | Biblioteca Bíblica";
        document.querySelectorAll("[data-offline-copy]").forEach((section) => {
          section.hidden = section.getAttribute("data-offline-copy") !== language;
        });
        const networkState = document.querySelector("[data-offline-network]");
        const updateNetworkState = () => {
          if (!(networkState instanceof HTMLElement)) return;
          const online = navigator.onLine;
          networkState.classList.toggle("is-online", online);
          const label = networkState.querySelector("strong");
          if (label) {
            label.textContent = language === "en"
              ? (online ? "Connection available" : "Offline mode")
              : (online ? "Conexión disponible" : "Modo sin conexión");
          }
        };
        updateNetworkState();
        addEventListener("online", updateNetworkState);
        addEventListener("offline", updateNetworkState);
        document.querySelectorAll("[data-offline-retry]").forEach((button) => {
          button.addEventListener("click", () => location.reload());
        });
      })();
    </script>
  </body>
</html>
