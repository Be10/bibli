---
import { sitePath } from "../lib/site-paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import HomeStudyVisual from "../components/HomeStudyVisual.astro";
import {
  getAllBibleVersions,
  getLessonsByRouteId,
  getRouteBySlug,
  getRouteModules,
} from "../lib/queries";

const siteTitle = "Biblioteca Bíblica";
const primaryRoute = getRouteBySlug("de-la-creacion-al-pacto");
const primaryModules = primaryRoute ? getRouteModules(primaryRoute.id) : [];
const primaryLessons = primaryRoute ? getLessonsByRouteId(primaryRoute.id) : [];
const bibleVersions = getAllBibleVersions();

const quickLinks = [
  { title: "Rutas de estudio", description: "Avanza por recorridos guiados, organizados en módulos y lecciones.", href: sitePath("/rutas/"), icon: "journey" as const },
  { title: "Explorar Bibli", description: "Descubre personajes, lugares, temas, eventos, mapas y recursos conectados.", href: sitePath("/explorar/"), icon: "compass" as const },
  { title: "Línea de tiempo", description: "Ubica los acontecimientos dentro del desarrollo de la historia bíblica.", href: sitePath("/linea-de-tiempo/"), icon: "timeline" as const },
];

const stats = [
  { value: primaryLessons.length, label: "lecciones", icon: "graduation" as const },
  { value: primaryModules.length, label: "módulos", icon: "layers" as const },
  { value: bibleVersions.length, label: "versiones bíblicas", icon: "bible" as const },
];

const primaryLessonTargets = primaryLessons.map((lesson) => ({
  id: lesson.id,
  href: sitePath(`/lecciones/${lesson.slug}/`),
}));
---

<BaseLayout
  title={siteTitle}
  alternateLanguage={{ code: "en", label: "English", href: sitePath("/en/") }}
>
  <script is:inline define:vars={{ routeId: primaryRoute?.id ?? "", routeLessons: primaryLessonTargets }}>
    (() => {
      let progress = {};
      try { progress = JSON.parse(localStorage.getItem("bibli-learning-progress-v1") || "{}"); } catch {}
      if (!progress || typeof progress !== "object") progress = {};
      const completed = new Set(Array.isArray(progress.completed) ? progress.completed : []);
      const count = routeLessons.filter((lesson) => completed.has(lesson.id)).length;
      const state = routeLessons.length > 0 && count >= routeLessons.length ? "complete" : count > 0 || progress.lastLessonByRoute?.[routeId] ? "started" : "new";
      document.documentElement.dataset.homePrimaryRouteState = state;
    })();
  </script>

  <main class="home-page" data-home-root>
    <section class="home-hero">
      <div class="home-copy">
        <span class="home-kicker"><Icon name="library" size={15} /> Biblioteca Bíblica</span>
        <h1>Estudia la Biblia con claridad</h1>
        <p>Lee y estudia la Biblia en un solo lugar.</p>

        <div class="home-actions">
          <a
            href={sitePath("/rutas/de-la-creacion-al-pacto/")}
            class="home-button primary"
            data-home-continue
            data-route-id={primaryRoute?.id ?? ""}
            data-route-href={sitePath("/rutas/de-la-creacion-al-pacto/")}
            data-route-lessons={JSON.stringify(primaryLessonTargets)}
          >
            <Icon name="journey" size={18} />
            <span class="home-route-label start">Comenzar ruta principal</span>
            <span class="home-route-label continue">Continuar ruta principal</span>
            <span class="home-route-label review">Revisar ruta principal</span>
            <Icon name="arrow-right" size={16} />
          </a>
          <a href={sitePath("/es/biblia/")} class="home-button secondary"><Icon name="bible" size={18} /><span>Leer la Biblia</span></a>
          <a href={sitePath("/explorar/")} class="home-button tertiary"><span>Explorar todo</span><Icon name="arrow-right" size={16} /></a>
        </div>
      </div>

      <HomeStudyVisual lang="es" />
    </section>

    <section class="home-stats" aria-label="Estado actual de Bibli">
      {stats.map((stat) => (
        <div class="home-stat">
          <span class="home-stat-icon"><Icon name={stat.icon} size={18} /></span>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </section>

    <section class="home-grid" aria-label="Áreas principales">
      {quickLinks.map((item) => (
        <a href={item.href} class="home-card">
          <span class="home-card-icon"><Icon name={item.icon} size={20} /></span>
          <div>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
          </div>
          <Icon name="chevron-right" size={18} class="home-card-arrow" />
        </a>
      ))}
    </section>
  </main>
</BaseLayout>

<script>
  const PROGRESS_KEY = "bibli-learning-progress-v1";
  const continueLink = document.querySelector<HTMLAnchorElement>("[data-home-continue]");

  function syncHomeContinuation() {
    if (!continueLink) return;

    const routeId = continueLink.dataset.routeId || "";
    let lessons: Array<{ id: string; href: string }> = [];
    let progress: { completed?: string[]; lastLessonByRoute?: Record<string, string> } = {};

    try { lessons = JSON.parse(continueLink.dataset.routeLessons || "[]"); } catch {}
    try { progress = JSON.parse(localStorage.getItem(PROGRESS_KEY) || "{}"); } catch {}

    const completed = new Set(Array.isArray(progress.completed) ? progress.completed : []);
    const routeCompletedCount = lessons.filter((lesson) => completed.has(lesson.id)).length;
    const lastLessonId = progress.lastLessonByRoute?.[routeId];
    const lastLesson = lessons.find((lesson) => lesson.id === lastLessonId);
    const firstPending = lessons.find((lesson) => !completed.has(lesson.id));
    const target = lastLesson ?? (routeCompletedCount > 0 ? firstPending : undefined);
    const allCompleted = lessons.length > 0 && routeCompletedCount >= lessons.length;
    const routeHref = continueLink.dataset.routeHref || continueLink.href;

    if (allCompleted) {
      continueLink.href = routeHref;
      document.documentElement.dataset.homePrimaryRouteState = "complete";
    } else if (target) {
      continueLink.href = target.href;
      document.documentElement.dataset.homePrimaryRouteState = "started";
    } else {
      continueLink.href = routeHref;
      document.documentElement.dataset.homePrimaryRouteState = "new";
    }

    continueLink.dataset.progressReady = "true";
  }

  syncHomeContinuation();
  window.addEventListener("storage", (event) => {
    if (event.key === PROGRESS_KEY) syncHomeContinuation();
  });
  document.addEventListener("bibli:learning-progress-change", syncHomeContinuation);
  window.addEventListener("pageshow", syncHomeContinuation);
</script>

<style>
  .home-page { width:min(var(--content-max), calc(100% - 32px)); margin:0 auto; padding:18px 0 72px; }
  .home-hero { position:relative; display:grid; grid-template-columns:minmax(0,1.08fr) minmax(360px,.82fr); gap:clamp(1.5rem,3.2vw,3.25rem); align-items:center; min-height:390px; padding:clamp(1.7rem,4vw,3.1rem); border:1px solid var(--border-color); border-radius:28px; overflow:hidden; background:linear-gradient(135deg,var(--surface) 0%,color-mix(in srgb,var(--accent-soft) 34%,var(--surface)) 100%); box-shadow:var(--shadow-sm); }
  .home-hero::before { content:""; position:absolute; width:430px; height:430px; right:-180px; top:-220px; border-radius:50%; background:color-mix(in srgb,var(--accent) 9%,transparent); }
  .home-copy { position:relative; z-index:1; max-width:720px; }
  .home-kicker { display:inline-flex; align-items:center; gap:.45rem; color:var(--accent); font-size:.76rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .home-copy h1 { max-width:760px; margin:.75rem 0 1rem; color:var(--heading-color); font-size:clamp(2.5rem,5vw,4.25rem); line-height:.98; letter-spacing:-.06em; text-wrap:balance; }
  .home-copy > p { max-width:650px; margin:0; color:var(--text-muted); font-size:clamp(1rem,1.8vw,1.16rem); line-height:1.7; }
  .home-route-label { display:none; }
  .home-route-label.start { display:inline; }
  :global(html[data-home-primary-route-state="started"]) .home-route-label.start,
  :global(html[data-home-primary-route-state="complete"]) .home-route-label.start { display:none; }
  :global(html[data-home-primary-route-state="started"]) .home-route-label.continue { display:inline; }
  :global(html[data-home-primary-route-state="complete"]) .home-route-label.review { display:inline; }
  .home-actions { display:flex; flex-wrap:wrap; gap:.65rem; margin-top:1.3rem; }
  .home-button { min-height:46px; display:inline-flex; align-items:center; justify-content:center; gap:.55rem; padding:0 1rem; border-radius:13px; text-decoration:none; font-weight:720; transition:transform 160ms ease,background-color 160ms ease,border-color 160ms ease,box-shadow 160ms ease; }
  .home-button:hover { transform:translateY(-1px); }
  .home-button.primary { background:var(--accent); color:var(--accent-contrast); box-shadow:0 10px 24px color-mix(in srgb,var(--accent) 20%,transparent); }
  .home-button.primary:hover { background:var(--accent-hover); }
  .home-button.secondary { border:1px solid var(--border-color); background:var(--surface); color:var(--heading-color); }
  .home-button.secondary:hover { border-color:var(--border-strong); background:var(--surface-soft); }
  .home-button.tertiary { color:var(--accent); padding-inline:.65rem; }
  .home-button.tertiary:hover { background:var(--accent-soft); }
  .home-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.8rem; margin-top:1rem; }
  .home-stat { display:flex; align-items:center; gap:.65rem; min-height:70px; padding:.85rem 1rem; border:1px solid var(--border-color); border-radius:16px; background:var(--surface); box-shadow:0 8px 24px rgba(15,23,42,.025); }
  .home-stat-icon { width:38px; height:38px; display:grid; place-items:center; flex:0 0 38px; border-radius:11px; background:var(--accent-soft); color:var(--accent); }
  .home-stat strong { color:var(--heading-color); font-size:1.35rem; line-height:1; }
  .home-stat > span:last-child { color:var(--text-muted); font-size:.88rem; }
  .home-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.8rem; margin-top:.8rem; }
  .home-card { position:relative; display:grid; grid-template-columns:auto 1fr auto; gap:.9rem; align-items:start; padding:1.15rem; border:1px solid var(--border-color); border-radius:17px; background:var(--surface); color:inherit; text-decoration:none; box-shadow:0 8px 24px rgba(15,23,42,.035); transition:transform 160ms ease,border-color 160ms ease,box-shadow 160ms ease; }
  .home-card:hover { transform:translateY(-2px); border-color:color-mix(in srgb,var(--accent) 45%,var(--border-color)); box-shadow:var(--shadow-sm); }
  .home-card-icon { width:40px; height:40px; display:grid; place-items:center; border-radius:12px; background:var(--accent-soft); color:var(--accent); }
  .home-card h2 { margin:.05rem 0 .35rem; color:var(--heading-color); font-size:1.08rem; letter-spacing:-.02em; }
  .home-card p { margin:0; color:var(--text-muted); line-height:1.55; font-size:.88rem; }
  .home-card-arrow { align-self:center; color:var(--text-muted); transition:transform 160ms ease,color 160ms ease; }
  .home-card:hover .home-card-arrow { color:var(--accent); transform:translateX(2px); }
  @media (max-width:900px) { .home-hero { grid-template-columns:1fr; min-height:0; } .home-grid { grid-template-columns:1fr; } }
  @media (max-width:680px) { .home-stats { grid-template-columns:1fr; } }
  @media (max-width:600px) { .home-page { width:min(100% - 20px,var(--content-max)); padding-top:10px; } .home-hero { padding:1.35rem; border-radius:20px; } .home-copy h1 { font-size:clamp(2.25rem,12vw,3.35rem); } .home-actions { display:grid; grid-template-columns:1fr; } .home-button { width:100%; box-sizing:border-box; } }
</style>
