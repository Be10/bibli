---
import { sitePath } from "../../lib/site-paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildSearchIndex } from "../../lib/search-index";

const searchItems = buildSearchIndex("es");

const searchStats = [
  { label: "Lecciones", type: "Lección" },
  { label: "Rutas", type: "Ruta" },
  { label: "Libros", type: "Libro" },
  { label: "Pasajes", type: "Pasaje" },
  { label: "Recursos", type: "Recurso" },
  { label: "Versículos", type: "Versículo" },
].map((stat) => ({
  label: stat.label,
  count: searchItems.filter((item) => item.type === stat.type).length,
}));

const searchableTypes = Array.from(
  new Set(searchItems.map((item) => item.type))
);

type ExploreItem = {
  title: string;
  eyebrow: string;
  description: string;
  url: string;
};

const exploreItems: ExploreItem[] = [
  {
    title: "Lecciones",
    eyebrow: "Estudios",
    description: "Encuentra estudios publicados por título, referencia bíblica o contenido.",
    url: sitePath("/lecciones/"),
  },
  {
    title: "Rutas",
    eyebrow: "Recorridos guiados",
    description: "Explora rutas y módulos de estudio organizados progresivamente.",
    url: sitePath("/rutas/"),
  },
  {
    title: "Recursos",
    eyebrow: "Apoyo visual",
    description: "Consulta mapas, cronología, esquemas e infografías conectadas al estudio.",
    url: sitePath("/recursos/"),
  },
  {
    title: "Libros",
    eyebrow: "Biblioteca bíblica",
    description: "Explora los libros de la Biblia por testamento, género y resumen editorial.",
    url: sitePath("/libros/"),
  },
  {
    title: "Temas",
    eyebrow: "Conceptos",
    description: "Revisa temas bíblicos conectados con lecciones, eventos y pasajes.",
    url: sitePath("/temas/"),
  },
  {
    title: "Glosario",
    eyebrow: "Términos",
    description: "Consulta definiciones breves de términos bíblicos importantes.",
    url: sitePath("/glosario/"),
  },
  {
    title: "Mapa",
    eyebrow: "Geografía bíblica",
    description: "Ubica visualmente lugares bíblicos registrados en el mapa.",
    url: sitePath("/mapa/"),
  },
  {
    title: "Personajes",
    eyebrow: "Biografías",
    description: "Explora personas bíblicas y sus conexiones narrativas.",
    url: sitePath("/personajes/"),
  },
  {
    title: "Eventos",
    eyebrow: "Narrativa",
    description: "Sigue acontecimientos bíblicos en orden narrativo e histórico.",
    url: sitePath("/eventos/"),
  },
  {
    title: "Lugares",
    eyebrow: "Ubicaciones",
    description: "Consulta ciudades, regiones, montes y lugares bíblicos.",
    url: sitePath("/lugares/"),
  },
  {
    title: "Pasajes",
    eyebrow: "Referencias",
    description: "Explora pasajes bíblicos destacados y sus conexiones.",
    url: sitePath("/pasajes/"),
  },
];

function getCountByType(type: string) {
  return searchItems.filter((item) => item.type === type).length;
}

function getExploreCount(item: ExploreItem) {
  const typeByTitle: Record<string, string> = {
    Lecciones: "Lección",
    Rutas: "Ruta",
    Recursos: "Recurso",
    Libros: "Libro",
    Temas: "Tema",
    Glosario: "Glosario",
    Personajes: "Personaje",
    Eventos: "Evento",
    Lugares: "Lugar",
    Pasajes: "Pasaje",
  };

  if (item.title === "Mapa") {
    return getCountByType("Lugar");
  }

  const type = typeByTitle[item.title];

  return type ? getCountByType(type) : 0;
}
---

<BaseLayout
  lang="es"
  alternateLanguage={{ code: "en", label: "English", href: sitePath("/en/search/") }}
  title="Búsqueda avanzada"
  description="Busca Biblia, libros, pasajes, lecciones, rutas, recursos, eventos, temas, personajes, lugares y términos del glosario desde un solo índice."
>
  <main class="page advanced-search-page" data-utility-root data-utility-kind="search">
    <div class="breadcrumb">
      <a href={sitePath("/")}>Inicio</a> → Búsqueda avanzada
    </div>

    <section class="hero advanced-search-hero">
      <div class="advanced-search-hero-content">
        <p class="eyebrow">Búsqueda avanzada</p>

        <h1>Buscar en Bibli</h1>

        <p class="subtitle">
          Encuentra Biblia, libros, pasajes, lecciones, rutas, recursos, eventos, temas,
          personajes, lugares y términos del glosario desde un solo lugar.
        </p>

        <div class="actions advanced-search-hero-actions">
          <a href="#busqueda-avanzada" class="button">
            Buscar contenido
          </a>

          <a href={sitePath("/es/biblia/")} class="button secondary">
            Leer la Biblia
          </a>

          <a href={sitePath("/rutas/de-la-creacion-al-pacto/")} class="button secondary">
            Ruta principal
          </a>
        </div>
      </div>

      <aside class="advanced-search-hero-card" aria-label="Resumen del índice de búsqueda">
        <span>Índice local</span>
        <strong>{searchItems.length}</strong>
        <p>
          {searchableTypes.length} tipos de contenido disponibles
        </p>
      </aside>
    </section>

    <section class="section search-section advanced-search-section" id="busqueda-avanzada">
      <div class="section-header">
        <div>
          <p class="eyebrow">Consulta rápida</p>
          <h2>Búsqueda avanzada</h2>
        </div>

        <span class="section-count">
          {searchItems.length} elementos
        </span>
      </div>

      <div class="search-panel enhanced-search-panel">
        <label class="search-label" for="search-input">
          Escribe una palabra, referencia, personaje, lugar o tema
        </label>

        <div class="search-control">
          <input
            id="search-input"
            class="search-input"
            type="search"
            placeholder="Busca: Jesús, Génesis, redención, Jerusalén, en el principio..."
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            enterkeyhint="search"
            aria-controls="search-results"
          />
          <button type="button" class="search-clear" data-search-clear hidden>Limpiar</button>
        </div>
        <p class="search-help">Usa ↑ y ↓ para recorrer resultados. Presiona Esc para limpiar la consulta.</p>
      </div>

      <div id="search-empty" class="search-empty enhanced-search-empty" hidden></div>

      <div
        id="search-filters"
        class="search-filters"
        aria-label="Filtros de búsqueda"
        hidden
      ></div>

      <div id="search-results-summary" class="search-results-summary" role="status" aria-live="polite" aria-atomic="true" hidden></div>

      <div id="search-results" class="search-results enhanced-search-results"></div>

      <section class="advanced-explore-block" aria-label="Explorar por categoría">
        <div class="advanced-explore-header">
          <div>
            <p class="eyebrow">También puedes explorar</p>
            <h3>Explorar por categoría</h3>
          </div>

          <span>
            Recursos visuales y editoriales
          </span>
        </div>

        <div class="advanced-explore-grid">
          {exploreItems.map((item) => (
            <a href={item.url} class="advanced-explore-card">
              <span>{item.eyebrow}</span>
              <strong>{item.title}</strong>
              <p>{item.description}</p>

              <small>
                {getExploreCount(item)} {getExploreCount(item) === 1 ? "elemento" : "elementos"}
              </small>
            </a>
          ))}
        </div>
      </section>
    </section>

    <section class="search-stats" aria-label="Resumen del índice de búsqueda">
      {searchStats.map((stat) => (
        <article class="search-stat-card">
          <span>{stat.label}</span>
          <strong>{stat.count}</strong>
        </article>
      ))}
    </section>

    <script type="application/json" id="search-data" set:html={JSON.stringify(searchItems)} />
  </main>
</BaseLayout>

<script>
  import {
    SEARCH_FILTER_ORDER,
    getAvailableSearchFilters,
    getDisplaySearchResults,
    getSearchCounts,
    getSearchResults,
    normalizeSearchText,
  } from "../../lib/search-engine";

  const dataElement = document.getElementById("search-data");
  const input = document.getElementById("search-input");
  const resultsElement = document.getElementById("search-results");
  const emptyElement = document.getElementById("search-empty");
  const resultsSummaryElement = document.getElementById("search-results-summary");
  const filtersElement = document.getElementById("search-filters");
  const clearButton = document.querySelector("[data-search-clear]");

  const items = dataElement?.textContent
    ? JSON.parse(dataElement.textContent)
    : [];

  const initialParams = new URLSearchParams(window.location.search);
  const initialQuery = initialParams.get("q") ?? "";

  let activeSearchType = "Todos";
  let currentResults = [];

  function normalizeText(value) {
    return normalizeSearchText(value);
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function escapeRegExp(value) {
    return String(value).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  function getHighlightWords(query) {
    return Array.from(
      new Set(
        normalizeText(query)
          .split(/\s+/)
          .filter((word) => word.length >= 3)
      )
    );
  }

  function highlightMatches(value, query) {
    const safeValue = escapeHtml(value);
    const words = getHighlightWords(query);

    if (words.length === 0) {
      return safeValue;
    }

    const pattern = new RegExp(`(${words.map(escapeRegExp).join("|")})`, "gi");

    return safeValue.replace(pattern, "<mark>$1</mark>");
  }

  let searchDebounceTimer;

  function updateUrl(value) {
    const url = new URL(window.location.href);

    if (normalizeText(value)) {
      url.searchParams.set("q", value);
    } else {
      url.searchParams.delete("q");
    }

    window.history.replaceState({}, "", url);
  }

  function getFilteredResults(results) {
    return getDisplaySearchResults(results, activeSearchType, 120);
  }

  function renderFilters(results) {
    if (!filtersElement) return;

    const counts = getSearchCounts(results);

    if (
      activeSearchType !== "Todos" &&
      !SEARCH_FILTER_ORDER.includes(activeSearchType)
    ) {
      activeSearchType = "Todos";
    }

    if (activeSearchType !== "Todos" && !counts[activeSearchType]) {
      activeSearchType = "Todos";
    }

    const filters = getAvailableSearchFilters(results);

    filtersElement.hidden = false;

    filtersElement.innerHTML = [
      `<button type="button" data-search-filter="Todos" aria-pressed="${activeSearchType === "Todos"}">Todos <span>${results.length}</span></button>`,
      ...filters.map(
        ({ type, count }) =>
          `<button type="button" data-search-filter="${escapeHtml(type)}" aria-pressed="${activeSearchType === type}">${escapeHtml(type)} <span>${count}</span></button>`
      ),
    ].join("");

    filtersElement
      .querySelectorAll("[data-search-filter]")
      .forEach((button) => {
        const isActive = button.getAttribute("data-search-filter") === activeSearchType;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));

        button.addEventListener("click", () => {
          activeSearchType =
            button.getAttribute("data-search-filter") ?? "Todos";

          renderFilteredResults();
        });
      });
  }

  function renderResultCard(item) {
    const query = input?.value ?? "";

    return `
      <a href="${escapeHtml(item.url)}" class="search-result">
        <span class="search-result-type">${escapeHtml(item.type)}</span>
        <h3>${highlightMatches(item.title, query)}</h3>
        <p>${highlightMatches(item.summary, query)}</p>
      </a>
    `;
  }

  function renderFilteredResults() {
    if (!resultsElement || !resultsSummaryElement || !filtersElement) return;

    renderFilters(currentResults);

    const filteredResults = getFilteredResults(currentResults);
    const query = input?.value ?? "";

    resultsSummaryElement.hidden = false;
    resultsSummaryElement.textContent =
      activeSearchType === "Todos"
        ? `${currentResults.length} resultado${currentResults.length === 1 ? "" : "s"} para “${query}”`
        : `${filteredResults.length} resultado${filteredResults.length === 1 ? "" : "s"} en ${activeSearchType} para “${query}”`;

    resultsElement.innerHTML = filteredResults.map(renderResultCard).join("");
  }

  function renderResults(query) {
    const normalizedQuery = normalizeText(query);

    if (!resultsElement || !emptyElement || !resultsSummaryElement || !filtersElement) {
      return;
    }

    if (!normalizedQuery) {
      currentResults = [];
      activeSearchType = "Todos";
      resultsElement.innerHTML = "";
      filtersElement.innerHTML = "";
      filtersElement.hidden = true;
      resultsSummaryElement.hidden = true;
      resultsSummaryElement.textContent = "";
      emptyElement.hidden = true;
      emptyElement.textContent = "";
      emptyElement.style.display = "none";
      return;
    }

    const results = getSearchResults(items, query);

    currentResults = results;

    if (results.length === 0) {
      resultsElement.innerHTML = "";
      filtersElement.innerHTML = "";
      filtersElement.hidden = true;
      resultsSummaryElement.hidden = true;
      resultsSummaryElement.textContent = "";
      emptyElement.hidden = false;
      emptyElement.textContent = "No se encontraron resultados para esa búsqueda.";
      emptyElement.style.display = "block";
      return;
    }

    emptyElement.hidden = true;
    emptyElement.style.display = "none";
    renderFilteredResults();
  }


  function syncClearButton(value) {
    if (clearButton instanceof HTMLButtonElement) {
      clearButton.hidden = !normalizeText(value);
    }
  }

  function clearSearch() {
    if (!(input instanceof HTMLInputElement)) return;
    input.value = "";
    activeSearchType = "Todos";
    updateUrl("");
    renderResults("");
    syncClearButton("");
    input.focus();
  }

  function getResultLinks() {
    return resultsElement
      ? [...resultsElement.querySelectorAll<HTMLAnchorElement>("a.search-result")]
      : [];
  }

  input?.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && input instanceof HTMLInputElement && input.value) {
      event.preventDefault();
      clearSearch();
      return;
    }

    if (event.key !== "ArrowDown") return;
    const links = getResultLinks();
    if (links.length === 0) return;
    event.preventDefault();
    links[0]?.focus();
  });

  resultsElement?.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
    const links = getResultLinks();
    const active = document.activeElement;
    const currentIndex = links.indexOf(active as HTMLAnchorElement);
    if (currentIndex === -1) return;

    event.preventDefault();
    if (event.key === "ArrowDown") {
      links[Math.min(currentIndex + 1, links.length - 1)]?.focus();
    } else if (currentIndex === 0) {
      input?.focus();
    } else {
      links[currentIndex - 1]?.focus();
    }
  });

  input?.addEventListener("input", (event) => {
    const value = event.target.value;

    activeSearchType = "Todos";
    updateUrl(value);
    syncClearButton(value);

    window.clearTimeout(searchDebounceTimer);

    searchDebounceTimer = window.setTimeout(() => {
      renderResults(value);
    }, 120);
  });

  clearButton?.addEventListener("click", clearSearch);

  if (input instanceof HTMLInputElement && initialQuery) {
    input.value = initialQuery;
    syncClearButton(initialQuery);
    renderResults(initialQuery);
  } else {
    syncClearButton("");
  }
</script>

<style>
  .advanced-search-hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(230px, 320px);
    gap: 32px;
    align-items: end;
    overflow: hidden;
  }

  .advanced-search-hero-content,
  .advanced-search-hero-card {
    position: relative;
    z-index: 1;
  }

  .advanced-search-hero-content {
    align-self: center;
  }

  .advanced-search-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
    max-width: 100%;
  }

  .advanced-search-hero-actions .button {
    box-sizing: border-box;
    flex: 0 1 auto;
    max-width: 100%;
    min-width: 0;
  }

  .advanced-search-hero-card,
  .search-stat-card,
  .search-result,
  .advanced-explore-card {
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-card);
  }

  .advanced-search-hero-card {
    display: grid;
    gap: 10px;
    padding: 24px;
    border-radius: 24px;
    background: var(--surface);
    box-shadow: var(--shadow-panel);
  }

  .advanced-search-hero-card span,
  .search-stat-card span,
  .search-label,
  .search-result-type,
  .advanced-explore-card span,
  .advanced-explore-header span {
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .advanced-search-hero-card strong {
    color: var(--heading-color);
    font-size: 3rem;
    line-height: 1;
  }

  .advanced-search-hero-card p,
  .search-result p,
  .advanced-explore-card p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .search-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .search-stat-card {
    padding: 22px;
    border-radius: 22px;
    background: var(--surface);
  }

  .search-stat-card span {
    display: block;
    margin-bottom: 10px;
  }

  .search-stat-card strong {
    display: block;
    color: var(--heading-color);
    font-size: 2rem;
    line-height: 1;
  }

  .advanced-search-section {
    margin-top: 24px;
  }

  .enhanced-search-panel {
    padding: 22px;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--border-color);
  }

  .search-label {
    display: block;
  }

  :global(.search-filters) {
    display: flex;
    gap: 8px;
    margin-top: 18px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb,var(--accent) 35%,transparent) transparent;
  }

  :global(.search-filters[hidden]) {
    display: none;
  }

  :global(.search-filters::-webkit-scrollbar) {
    height: 8px;
  }

  :global(.search-filters::-webkit-scrollbar-track) {
    background: transparent;
  }

  :global(.search-filters::-webkit-scrollbar-thumb) {
    border-radius: 999px;
    background: color-mix(in srgb,var(--accent) 35%,transparent);
  }

  :global(.search-filters::-webkit-scrollbar-thumb:hover) {
    background: color-mix(in srgb,var(--accent) 48%,transparent);
  }

  :global(.search-filters button) {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 40px;
    align-items: center;
    gap: 6px;
    padding: 0 11px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--surface);
    color: var(--accent);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
  }

  :global(.search-filters button span) {
    display: inline;
    font: inherit;
    font-weight: 900;
    line-height: 1;
  }

  :global(.search-filters button:hover) {
    border-color: var(--border-strong);
    background: var(--accent-subtle);
  }

  :global(.search-filters button.is-active:hover) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  .advanced-explore-block {
    display: grid;
    gap: 16px;
    margin-top: 32px;
    padding: 20px;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--border-color);
  }

  .advanced-explore-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-start;
  }

  .advanced-explore-header h3 {
    margin: 0;
    color: var(--heading-color);
    font-size: 1.28rem;
  }

  .advanced-explore-header .eyebrow {
    margin-bottom: 6px;
  }

  .advanced-explore-header span {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border-color);
    white-space: nowrap;
  }

  .advanced-explore-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
  }

  .advanced-explore-card {
    display: grid;
    gap: 8px;
    min-height: 170px;
    padding: 18px;
    border-radius: 20px;
    background: var(--surface);
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .advanced-explore-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  .advanced-explore-card strong {
    color: var(--heading-color);
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .advanced-explore-card small {
    align-self: end;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 900;
  }

  .enhanced-search-empty {
    margin-top: 20px;
  }

  .search-results-summary {
    margin-top: 22px;
    color: var(--accent);
    font-weight: 900;
  }

  .enhanced-search-results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 16px;
  }

  .search-result {
    display: grid;
    align-content: start;
    gap: 7px;
    min-height: 138px;
    padding: 15px 16px;
    border-radius: 18px;
    background: var(--surface);
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .search-result:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  .search-result h3 {
    margin: 0;
    color: var(--heading-color);
    font-size: 1rem;
    line-height: 1.28;
  }

  .search-result p {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.94rem;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .search-result mark {
    padding: 0 2px;
    border-radius: 5px;
    background: var(--accent-soft);
    color: var(--heading-color);
    font-weight: 900;
  }

  .search-result-type {
    width: fit-content;
    margin-bottom: 2px;
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--accent-subtle);
    border: 1px solid var(--border-color);
  }

  :global(html[data-theme="dark"]) .advanced-search-hero-card,
  :global(html[data-theme="dark"]) .search-stat-card,
  :global(html[data-theme="dark"]) .search-section {
    background: var(--surface);
    border-color: var(--border-color);
