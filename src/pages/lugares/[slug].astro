---
import { sitePath } from "../../lib/site-paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getAllPlaces,
  getEventsByPlaceId,
  getLessonsByPlaceId,
  getPeopleByPlaceIdViaEvents,
  type DerivedRelatedItem,
  type Event,
  type Lesson,
  type Place,
} from "../../lib/queries";

type Props = {
  place: Place;
  events: Event[];
  lessons: Lesson[];
  people: DerivedRelatedItem[];
};

export function getStaticPaths() {
  const places = getAllPlaces();

  return places
    .filter((place) => place.status !== "Borrador")
    .map((place) => ({
      params: { slug: place.slug },
      props: {
        place,
        events: getEventsByPlaceId(place.id),
        lessons: getLessonsByPlaceId(place.id),
        people: getPeopleByPlaceIdViaEvents(place.id),
      },
    }));
}

const { place, events, lessons, people } = Astro.props as Props;

const hasCoordinates = place.latitude !== null && place.longitude !== null;
const coordinatesLabel = hasCoordinates
  ? `${place.latitude}, ${place.longitude}`
  : "Pendiente";

const certaintyLabel = place.geographical_certainty ?? "Pendiente";
const placeTypeLabel = place.place_type ?? "Lugar bíblico";
const summaryLabel = place.summary ?? "Descripción pendiente.";
const searchUrl = `${sitePath("/buscar/")}?q=${encodeURIComponent(place.name)}`;
---

<BaseLayout
  title={place.name}
  description={place.summary ?? "Lugar de la Biblioteca Bíblica."}
>
  <main class="page" data-detail-root data-detail-kind="place">
    <div class="breadcrumb">
      <a href={sitePath("/")}>Inicio</a> →
      <a href={sitePath("/lugares/")}>Lugares</a> →
      {place.name}
    </div>

    <section class="hero place-hero">
      <div class="place-hero-content">
        <p class="eyebrow">{placeTypeLabel}</p>

        <h1>{place.name}</h1>

        <p class="subtitle">
          {summaryLabel}
        </p>

        <div class="actions">
          {hasCoordinates ? (
            <a href={sitePath(`/mapa/?lugar=${place.slug}`)} class="button">
              Ver en el mapa
            </a>
          ) : (
            <a href={sitePath("/mapa/")} class="button secondary">
              Ver mapa general
            </a>
          )}

          <a href={sitePath("/lugares/")} class="button secondary">
            Todos los lugares
          </a>


          <a href={searchUrl} class="button secondary">
            Buscar conexiones
          </a>
        </div>
      </div>

      <aside class="place-hero-card" aria-label="Resumen rápido del lugar">
        <span>{placeTypeLabel}</span>
        <strong>{place.name}</strong>
        <p>{certaintyLabel}</p>
      </aside>
    </section>

    <section class="place-meta-grid" aria-label="Datos rápidos del lugar">
      <article class="place-meta-card">
        <span>Tipo</span>
        <strong>{placeTypeLabel}</strong>
      </article>

      <article class="place-meta-card">
        <span>Certeza geográfica</span>
        <strong>{certaintyLabel}</strong>
      </article>

      <article class="place-meta-card">
        <span>Coordenadas</span>
        <strong>{coordinatesLabel}</strong>
      </article>

      <article class="place-meta-card">
        <span>Estado editorial</span>
        <strong>{place.status}</strong>
      </article>
    </section>

    <section class="section place-map-panel">
      <div class="section-header">
        <div>
          <p class="eyebrow">Ubicación</p>
          <h2>Mapa del lugar</h2>
        </div>

        {hasCoordinates && (
          <a href={sitePath(`/mapa/?lugar=${place.slug}`)} class="button secondary">
            Abrir mapa enfocado
          </a>
        )}
      </div>

      {hasCoordinates ? (
        <div class="place-map-preview">
          <div>
            <strong>{place.name} en el mapa bíblico</strong>
            <p>
              Este lugar tiene coordenadas registradas. Puedes abrirlo en el mapa
              bíblico con el marcador centrado y el popup enfocado en este lugar.
            </p>
          </div>

          <a href={sitePath(`/mapa/?lugar=${place.slug}`)} class="place-map-link">
            Ver {place.name} en el mapa →
          </a>
        </div>
      ) : (
        <div class="place-empty-map">
          <strong>Coordenadas pendientes</strong>
          <p>
            Este lugar todavía no tiene coordenadas definidas. Puede tratarse de
            una ubicación incierta, simbólica o pendiente de investigación editorial.
          </p>
        </div>
      )}
    </section>

    <section class="section place-importance-section">
      <div class="section-header">
        <div>
          <p class="eyebrow">Síntesis</p>
          <h2>Importancia bíblica</h2>
        </div>
      </div>

      <div class="place-importance-card">
        <p>{summaryLabel}</p>
      </div>
    </section>

    {events.length > 0 ? (
      <section class="section place-events-section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Historia bíblica</p>
            <h2>Eventos relacionados</h2>
          </div>

          <span class="section-count">
            {events.length} {events.length === 1 ? "evento" : "eventos"}
          </span>
        </div>

        <div class="place-events-grid">
          {events.map((event) => (
            <a href={sitePath(`/eventos/${event.slug}/`)} class="place-event-card" data-explicit-connection="event-places">
              <span>{event.approximate_date ?? event.biblical_period ?? "Evento bíblico"}</span>
              <strong>{event.title}</strong>

              {event.summary && (
                <small>{event.summary}</small>
              )}
            </a>
          ))}
        </div>
      </section>
    ) : (
      <section class="section place-empty-section">
        <p class="eyebrow">Historia bíblica</p>
        <h2>Eventos relacionados</h2>
        <p>
          Todavía no hay eventos relacionados registrados para este lugar.
        </p>
      </section>
    )}


    {people.length > 0 ? (
      <section class="section place-people-section" data-derived-connections="person-places-via-events">
        <div class="section-header">
          <div>
            <p class="eyebrow">Conexión derivada · vía eventos</p>
            <h2>Personajes vinculados por eventos</h2>
            <p class="derived-connection-note">
              Estos personajes se obtienen de eventos que relacionan explícitamente al lugar y al personaje; no representan una relación Lugar↔Personaje directa.
            </p>
          </div>

          <span class="section-count">
            {people.length} {people.length === 1 ? "personaje" : "personajes"}
          </span>
        </div>

        <div class="place-people-grid">
          {people.map((person) => (
            <article class="place-person-card">
              <span>Derivado de eventos</span>
              <a
                href={sitePath(`/personajes/${person.slug}/`)}
                class="place-person-primary"
                data-derived-connection="person-places-via-events"
                data-derived-via="event-people,event-places"
                data-derived-evidence-count={person.via_event_count}
              >
                <strong>{person.title}</strong>
              </a>
              {person.summary && <small>{person.summary}</small>}
              <small class="derived-evidence">
                {person.via_event_count} {person.via_event_count === 1 ? "evento compartido" : "eventos compartidos"}
              </small>

              <details
                class="derived-evidence-events"
                data-derived-evidence-events="person-places-via-events"
                data-derived-evidence-count={person.evidence_events.length}
              >
                <summary>
                  Ver {person.evidence_events.length} {person.evidence_events.length === 1 ? "evento de evidencia" : "eventos de evidencia"}
                </summary>
                <ul>
                  {person.evidence_events.map((event) => (
                    <li>
                      <a
                        href={sitePath(`/eventos/${event.slug}/`)}
                        data-derived-evidence-event="person-places-via-events"
                        data-derived-evidence-via="event-people,event-places"
                      >
                        {event.title}
                      </a>
                      {event.approximate_date && <small>{event.approximate_date}</small>}
                    </li>
                  ))}
                </ul>
              </details>
            </article>
          ))}
        </div>
      </section>
    ) : (
      <section class="section place-empty-section">
        <p class="eyebrow">Conexión derivada · vía eventos</p>
        <h2>Personajes vinculados por eventos</h2>
        <p>Todavía no hay personajes derivados de eventos registrados para este lugar.</p>
      </section>
    )}

    {lessons.length > 0 ? (
      <section class="section place-lessons-section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Recorrido guiado</p>
            <h2>Lecciones relacionadas</h2>
          </div>

          <span class="section-count">
            {lessons.length} {lessons.length === 1 ? "lección" : "lecciones"}
          </span>
        </div>

        <div class="place-lessons-grid">
          {lessons.map((lesson) => (
            <a href={sitePath(`/lecciones/${lesson.slug}/`)} class="place-lesson-card" data-explicit-connection="lesson-places">
              <span>Lección {lesson.lesson_number}</span>
              <strong>{lesson.title}</strong>

              {lesson.main_idea && (
                <small>{lesson.main_idea}</small>
              )}
            </a>
          ))}
        </div>
      </section>
    ) : (
      <section class="section place-empty-section">
        <p class="eyebrow">Recorrido guiado</p>
        <h2>Lecciones relacionadas</h2>
        <p>
          Todavía no hay lecciones relacionadas registradas para este lugar.
        </p>
      </section>
    )}

    <section class="section place-footer-nav">
      <div class="actions">
        <a href={sitePath("/lugares/")} class="button secondary">Volver a lugares</a>
        <a href={searchUrl} class="button secondary">Buscar conexiones</a>
        <a href={sitePath("/explorar/")} class="button">Explorar Bibli</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .place-hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(220px, 320px);
    gap: 28px;
    align-items: end;
    overflow: hidden;
  }

  .place-hero::after {
    content: "";
    position: absolute;
    right: -90px;
    bottom: -120px;
    width: 320px;
    height: 320px;
    border-radius: 999px;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 16%, transparent), transparent 68%);
    pointer-events: none;
  }

  .place-hero-content {
    position: relative;
    z-index: 1;
  }

  .place-hero-card {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 10px;
    padding: 24px;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-panel);
  }

  .place-hero-card span {
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .place-hero-card strong {
    color: var(--heading-color);
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .place-hero-card p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .place-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .place-meta-card {
    padding: 22px;
    border-radius: 22px;
    background: var(--surface);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-card);
  }

  .place-meta-card span {
    display: block;
    margin-bottom: 8px;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .place-meta-card strong {
    display: block;
    color: var(--heading-color);
    font-size: 1.02rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .place-map-panel,
  .place-importance-section,
  .place-events-section,
  .place-people-section,
  .place-lessons-section,
  .place-empty-section {
    background: var(--surface);
  }

  .place-map-preview,
  .place-empty-map,
  .place-importance-card {
    display: grid;
    gap: 14px;
    padding: 22px;
    border-radius: 22px;
    background: var(--surface-elevated);
    border: 1px solid var(--border-color);
  }

  .place-map-preview strong,
  .place-empty-map strong {
    display: block;
    color: var(--heading-color);
    font-size: 1.1rem;
    line-height: 1.35;
  }

  .place-map-preview p,
  .place-empty-map p,
  .place-importance-card p,
  .place-empty-section p {
    max-width: 760px;
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .place-map-link {
    display: inline-flex;
    width: fit-content;
    color: var(--accent);
    font-weight: 900;
    text-decoration: none;
  }

  .place-map-link:hover {
    text-decoration: underline;
  }

  .place-events-grid,
  .place-people-grid,
  .place-lessons-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .place-event-card,
  .place-person-card,
  .place-lesson-card {
    display: grid;
    align-content: start;
    gap: 8px;
    min-height: 176px;
    padding: 22px;
    border-radius: 22px;
    background: var(--surface-elevated);
    border: 1px solid var(--border-color);
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .place-event-card:hover,
  .place-person-card:hover,
  .place-lesson-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  .place-event-card span,
  .place-person-card span,
  .place-lesson-card span {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .place-event-card strong,
  .place-person-card strong,
  .place-lesson-card strong {
    color: var(--heading-color);
    font-size: 1.12rem;
    line-height: 1.35;
  }

  .place-event-card small,
  .place-person-card small,
  .place-lesson-card small {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }


  .derived-connection-note {
    max-width: 760px;
    margin: 8px 0 0;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .derived-evidence {
    font-weight: 800;
  }

  .place-person-primary {
    width: fit-content;
    color: inherit;
    text-decoration: none;
  }

  .place-person-primary:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .derived-evidence-events {
    padding-top: 6px;
    border-top: 1px solid var(--border-color);
  }

  .derived-evidence-events summary {
    cursor: pointer;
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 900;
    line-height: 1.4;
  }

  .derived-evidence-events ul {
    display: grid;
    gap: 8px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .derived-evidence-events li {
    display: grid;
    gap: 2px;
  }

  .derived-evidence-events a {
    color: var(--accent);
    font-weight: 800;
    line-height: 1.35;
    text-decoration: none;
  }

  .derived-evidence-events a:hover {
    text-decoration: underline;
  }


  html[data-theme="dark"] .place-hero-card,
  html[data-theme="dark"] .place-meta-card,
  html[data-theme="dark"] .place-map-panel,
  html[data-theme="dark"] .place-importance-section,
  html[data-theme="dark"] .place-events-section,
  html[data-theme="dark"] .place-people-section,
  html[data-theme="dark"] .place-lessons-section,
  html[data-theme="dark"] .place-empty-section {
    background: var(--surface);
    border-color: var(--border-color);
    box-shadow: var(--shadow-panel);
  }

  html[data-theme="dark"] .place-map-preview,
  html[data-theme="dark"] .place-empty-map,
  html[data-theme="dark"] .place-importance-card,
  html[data-theme="dark"] .place-event-card,
  html[data-theme="dark"] .place-person-card,
  html[data-theme="dark"] .place-lesson-card {
    background: var(--surface-soft);
    border-color: var(--border-color);
  }

  html[data-theme="dark"] .place-hero-card span,
  html[data-theme="dark"] .place-meta-card span,
  html[data-theme="dark"] .place-event-card span,
  html[data-theme="dark"] .place-person-card span,
  html[data-theme="dark"] .place-lesson-card span,
  html[data-theme="dark"] .place-map-link {
    color: var(--accent);
  }

  html[data-theme="dark"] .place-hero-card strong,
  html[data-theme="dark"] .place-meta-card strong,
  html[data-theme="dark"] .place-map-preview strong,
  html[data-theme="dark"] .place-empty-map strong,
  html[data-theme="dark"] .place-event-card strong,
  html[data-theme="dark"] .place-person-card strong,
  html[data-theme="dark"] .place-lesson-card strong {
    color: var(--heading-color);
  }

  html[data-theme="dark"] .place-hero-card p,
  html[data-theme="dark"] .place-map-preview p,
  html[data-theme="dark"] .place-empty-map p,
  html[data-theme="dark"] .place-importance-card p,
  html[data-theme="dark"] .place-empty-section p,
  html[data-theme="dark"] .place-event-card small,
  html[data-theme="dark"] .place-person-card small,
  html[data-theme="dark"] .place-lesson-card small {
    color: var(--text-muted);
  }


  @media (max-width: 760px) {
    .place-hero {
      grid-template-columns: 1fr;
    }

    .place-hero-card {
      padding: 20px;
    }

    .place-meta-grid {
      grid-template-columns: 1fr;
    }

    .place-events-grid,
    .place-people-grid,
    .place-lessons-grid {
      grid-template-columns: 1fr;
    }

    .place-event-card,
    .place-person-card,
    .place-lesson-card {
      min-height: auto;
    }

  }
</style>
