---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sitePath } from "../../lib/site-paths";
import { getAllRoutes, getLessonsByRouteId, getRouteModules, type Route } from "../../lib/queries";

type Props = { route: Route };
export function getStaticPaths() {
  return getAllRoutes().filter((route) => route.status !== "Borrador").map((route) => ({ params: { slug: route.slug }, props: { route } }));
}
const { route } = Astro.props;
const modules = getRouteModules(route.id);
const lessons = getLessonsByRouteId(route.id);
const lessonsByModule = new Map(modules.map((module) => [module.id, lessons.filter((lesson) => lesson.module_id === module.id)]));
const firstLesson = lessons[0] ?? null;
const lessonIds = lessons.map((lesson) => lesson.id);
---

<BaseLayout title={route.title} description={route.description ?? route.subtitle ?? "Ruta guiada de estudio bíblico"}>
  <main class="route-page" data-route-shell data-route-id={route.id} data-route-lesson-ids={JSON.stringify(lessonIds)}>
    <nav class="breadcrumb" aria-label="Migas de pan"><a href={sitePath("/")}>Inicio</a><span>›</span><a href={sitePath("/rutas/")}>Rutas</a><span>›</span><span>{route.title}</span></nav>

    <header class="route-hero-modern">
      <div class="route-hero-copy">
        <p class="eyebrow">{route.subtitle ?? "Ruta guiada"}</p>
        <h1>{route.title}</h1>
        <p>{route.description}</p>
        <div class="route-hero-meta">
          <span>{modules.length} módulos</span><span>{lessons.length} lecciones</span><span>{route.estimated_duration ?? "Duración progresiva"}</span><span>{route.level ?? "Progresivo"}</span>
        </div>
      </div>
      <aside class="progress-card">
        <span class="progress-kicker">Tu progreso</span>
        <strong data-progress-percent>0%</strong>
        <div class="progress-track"><span data-progress-bar></span></div>
        <small data-progress-count>0 de {lessons.length} completadas</small>
        {firstLesson && <a class="continue-button" href={sitePath(`/lecciones/${firstLesson.slug}/`)} data-route-continue>Comenzar ruta</a>}
      </aside>
    </header>

    <section class="route-help">
      <div><strong>Cómo funciona</strong><p>Avanza en orden o entra directamente en una lección. Cada módulo agrupa una etapa coherente del estudio y tu progreso es independiente del estado editorial.</p></div>
      <a href={sitePath("/lecciones/")}>Ver todas las lecciones →</a>
    </section>

    <div class="module-stack">
      {modules.map((module, moduleIndex) => {
        const moduleLessons = lessonsByModule.get(module.id) ?? [];
        return (
          <section class="module-card" id={module.slug} data-module-card data-module-lesson-ids={JSON.stringify(moduleLessons.map((lesson) => lesson.id))}>
            <header class="module-header">
              <div class="module-number">{String(moduleIndex + 1).padStart(2, "0")}</div>
              <div><p class="eyebrow">Módulo {moduleIndex + 1}</p><h2>{module.title}</h2><p>{module.description}</p></div>
              <div class="module-progress"><strong data-module-progress>0%</strong><small>{moduleLessons.length} lecciones</small></div>
            </header>
            <ol class="lesson-list">
              {moduleLessons.map((lesson) => (
                <li data-route-lesson-id={lesson.id}>
                  <a href={sitePath(`/lecciones/${lesson.slug}/`)} data-lesson-id={lesson.id}>
                    <span class="lesson-number">{String(lesson.lesson_number).padStart(2, "0")}</span>
                    <span class="lesson-main"><strong>{lesson.title}</strong><small>{lesson.primary_reference} · {lesson.estimated_time}</small></span>
                    <span class="lesson-state" data-lesson-state aria-label="Pendiente">○</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        );
      })}
    </div>
  </main>
</BaseLayout>

<script>
  const PROGRESS_KEY = "bibli-learning-progress-v1";
  function readProgress() { try { return JSON.parse(localStorage.getItem(PROGRESS_KEY) || "{}"); } catch { return {}; } }
  const shell = document.querySelector<HTMLElement>("[data-route-shell]");
  if (shell) {
    const progress = readProgress();
    const completed = new Set(Array.isArray(progress.completed) ? progress.completed : []);
    let ids: string[] = []; try { ids = JSON.parse(shell.dataset.routeLessonIds || "[]"); } catch {}
    const count = ids.filter((id) => completed.has(id)).length;
    const percent = ids.length ? Math.round((count / ids.length) * 100) : 0;
    shell.querySelector<HTMLElement>("[data-progress-percent]")!.textContent = `${percent}%`;
    shell.querySelector<HTMLElement>("[data-progress-bar]")!.style.width = `${percent}%`;
    shell.querySelector<HTMLElement>("[data-progress-count]")!.textContent = `${count} de ${ids.length} completadas`;

    shell.querySelectorAll<HTMLElement>("[data-route-lesson-id]").forEach((row) => {
      const id = row.dataset.routeLessonId || "";
      const state = row.querySelector<HTMLElement>("[data-lesson-state]");
      const done = completed.has(id);
      row.classList.toggle("is-complete", done);
      if (state) { state.textContent = done ? "✓" : "○"; state.setAttribute("aria-label", done ? "Completada" : "Pendiente"); }
    });

    shell.querySelectorAll<HTMLElement>("[data-module-card]").forEach((module) => {
      let moduleIds: string[] = []; try { moduleIds = JSON.parse(module.dataset.moduleLessonIds || "[]"); } catch {}
      const moduleCount = moduleIds.filter((id) => completed.has(id)).length;
      const modulePercent = moduleIds.length ? Math.round((moduleCount / moduleIds.length) * 100) : 0;
      const label = module.querySelector<HTMLElement>("[data-module-progress]"); if (label) label.textContent = `${modulePercent}%`;
    });

    const routeId = shell.dataset.routeId || "";
    const last = progress.lastLessonByRoute?.[routeId];
    const continueButton = shell.querySelector<HTMLAnchorElement>("[data-route-continue]");
    if (last && continueButton) {
      const lessonLink = shell.querySelector<HTMLAnchorElement>(`[data-lesson-id="${CSS.escape(last)}"]`);
      if (lessonLink) { continueButton.href = lessonLink.href; continueButton.textContent = "Continuar donde quedaste"; }
    } else if (count > 0 && count < ids.length && continueButton) {
      const firstPending = ids.find((id) => !completed.has(id));
      const lessonLink = firstPending ? shell.querySelector<HTMLAnchorElement>(`[data-lesson-id="${CSS.escape(firstPending)}"]`) : null;
      if (lessonLink) { continueButton.href = lessonLink.href; continueButton.textContent = "Continuar ruta"; }
    } else if (count === ids.length && ids.length > 0 && continueButton) {
      continueButton.textContent = "Ruta completada ✓";
    }
  }
</script>

<style>
.route-page{max-width:1180px;margin:0 auto;padding:1.5rem 1rem 5rem}.breadcrumb{display:flex;gap:.45rem;align-items:center;font-size:.86rem;opacity:.72;margin-bottom:1.2rem}.route-hero-modern{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:1.2rem;padding:clamp(1.4rem,4vw,3rem);border:1px solid var(--border-color,rgba(100,100,100,.18));border-radius:28px;background:linear-gradient(145deg,var(--surface,#fff),var(--surface-soft,#f5f5f5))}.eyebrow{text-transform:uppercase;letter-spacing:.09em;font-size:.74rem;font-weight:800;opacity:.64}.route-hero-copy h1{font-size:clamp(2rem,5vw,3.6rem);line-height:1.05;margin:.35rem 0 .75rem}.route-hero-copy>p{max-width:720px;line-height:1.7;margin:0}.route-hero-meta{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.2rem}.route-hero-meta span{border:1px solid var(--border-color,rgba(100,100,100,.2));border-radius:999px;padding:.38rem .62rem;font-size:.79rem}.progress-card{border:1px solid var(--border-color,rgba(100,100,100,.18));border-radius:20px;padding:1rem;background:var(--surface,#fff);display:flex;flex-direction:column;gap:.55rem}.progress-kicker{font-size:.76rem;opacity:.7}.progress-card>strong{font-size:2rem}.progress-card small{opacity:.7}.progress-track{height:8px;background:var(--surface-soft,#eceff1);border-radius:999px;overflow:hidden}.progress-track span{display:block;height:100%;width:0;background:currentColor;transition:width .25s}.continue-button{text-align:center;text-decoration:none;font-weight:800;border-radius:12px;padding:.72rem .8rem;border:1px solid currentColor;margin-top:.3rem}.route-help{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin:1rem 0 1.4rem;padding:1rem 1.1rem;border-radius:16px;background:var(--surface-soft,#f5f5f5)}.route-help p{margin:.2rem 0 0;line-height:1.5;opacity:.78}.route-help a{white-space:nowrap}.module-stack{display:grid;gap:1rem}.module-card{border:1px solid var(--border-color,rgba(100,100,100,.18));border-radius:22px;background:var(--surface,#fff);overflow:hidden}.module-header{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:1rem;padding:1.15rem;border-bottom:1px solid var(--border-color,rgba(100,100,100,.14));align-items:start}.module-number{width:2.4rem;height:2.4rem;border-radius:12px;display:grid;place-items:center;background:var(--surface-soft,#f1f3f5);font-weight:850}.module-header h2{margin:.2rem 0 .35rem;font-size:1.25rem}.module-header p{margin:0;line-height:1.5;opacity:.78}.module-progress{display:grid;text-align:right}.module-progress small{opacity:.65}.lesson-list{list-style:none;padding:0;margin:0}.lesson-list li+li{border-top:1px solid var(--border-color,rgba(100,100,100,.11))}.lesson-list a{display:grid;grid-template-columns:3rem minmax(0,1fr) auto;align-items:center;gap:.8rem;padding:.85rem 1.1rem;text-decoration:none;transition:background .15s}.lesson-list a:hover{background:var(--surface-soft,#f7f7f7)}.lesson-number{font-variant-numeric:tabular-nums;font-size:.84rem;opacity:.62}.lesson-main{display:grid;gap:.18rem}.lesson-main small{opacity:.66}.lesson-state{width:1.7rem;height:1.7rem;border-radius:999px;display:grid;place-items:center;border:1px solid var(--border-color,rgba(100,100,100,.25));font-weight:900}.is-complete .lesson-state{background:#203a33;color:#fff}@media(max-width:800px){.route-hero-modern{grid-template-columns:1fr}.progress-card{display:grid;grid-template-columns:1fr auto;align-items:center}.progress-card .progress-track,.progress-card small,.progress-card .continue-button{grid-column:1/-1}.module-header{grid-template-columns:auto 1fr}.module-progress{grid-column:2;text-align:left;display:flex;gap:.5rem;align-items:center}.route-help{align-items:flex-start;flex-direction:column}.lesson-list a{grid-template-columns:2.2rem minmax(0,1fr) auto}}@media(max-width:520px){.route-page{padding-top:1rem}.route-hero-modern{border-radius:20px}.module-card{border-radius:18px}.module-header{gap:.65rem;padding:.9rem}.lesson-list a{padding:.8rem .9rem}.lesson-main strong{font-size:.95rem}.lesson-main small{font-size:.78rem}}
</style>
