---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { sitePath } from "../../lib/site-paths";
import { getAllRoutes, getLessonsByRouteId, getRouteModules, type Route } from "../../lib/queries";

type Props = { route: Route };
export function getStaticPaths() {
  return getAllRoutes().filter((route) => route.status !== "Borrador").map((route) => ({ params: { slug: route.slug }, props: { route } }));
}
const { route } = Astro.props;
const modules = getRouteModules(route.id);
const lessons = getLessonsByRouteId(route.id);
const lessonsByModule = new Map(modules.map((module) => [module.id, lessons.filter((lesson) => lesson.module_id === module.id)]));
const firstLesson = lessons[0] ?? null;
const lessonIds = lessons.map((lesson) => lesson.id);
---

<BaseLayout title={route.title} description={route.description ?? route.subtitle ?? "Ruta guiada de estudio bíblico"}>
  <main class="route-page" data-detail-root data-detail-kind="route" data-route-shell data-persisted-root data-route-id={route.id} data-route-lesson-ids={JSON.stringify(lessonIds)}>
    <nav class="breadcrumb" aria-label="Migas de pan"><a href={sitePath("/")}>Inicio</a><span>›</span><a href={sitePath("/rutas/")}>Rutas</a><span>›</span><span>{route.title}</span></nav>

    <header class="route-hero-modern">
      <div class="route-hero-copy">
        <span class="route-icon"><Icon name="route" size={20} /></span>
        <h1>{route.title}</h1>
        <p>{route.description}</p>
        <div class="route-hero-meta" aria-label="Datos de la ruta">
          <span><Icon name="layers" size={14} />{modules.length} módulos</span>
          <span><Icon name="library" size={14} />{lessons.length} lecciones</span>
          <span><Icon name="clock" size={14} />{route.estimated_duration ?? "Duración progresiva"}</span>
          <span><Icon name="compass" size={14} />{route.level ?? "Progresivo"}</span>
        </div>
      </div>
      <aside class="progress-card" aria-label="Progreso de la ruta" data-persisted-value>
        <div class="progress-card-top"><span>Mi progreso</span><strong data-progress-percent>0%</strong></div>
        <div class="progress-track"><span data-progress-bar></span></div>
        <small data-progress-count>0 de {lessons.length} completadas</small>
        {firstLesson && <a class="continue-button" href={sitePath(`/lecciones/${firstLesson.slug}/`)} data-route-continue><span>Comenzar</span><Icon name="arrow-right" size={16} /></a>}
      </aside>
    </header>

    <section class="route-tools" aria-label="Herramientas de la ruta">
      <nav class="module-jump-nav" aria-label="Ir a un módulo">
        <span class="module-jump-label">Módulos</span>
        <div class="module-jump-list">
          {modules.map((module, moduleIndex) => (
            <a
              href={`#${module.slug}`}
              data-module-jump={module.id}
              title={module.title}
              aria-label={`Ir al módulo ${moduleIndex + 1}: ${module.title}`}
            >
              {String(moduleIndex + 1).padStart(2, "0")}
            </a>
          ))}
        </div>
      </nav>

      <label class="route-filter">
        <span class="sr-only">Buscar una lección en esta ruta</span>
        <Icon name="search" size={17} />
        <input
          type="search"
          placeholder="Buscar por título, referencia o módulo…"
          autocomplete="off"
          data-route-filter
        />
        <span class="route-filter-count" data-route-filter-count aria-live="polite">{lessons.length} lecciones</span>
      </label>
    </section>

    <p class="route-filter-empty" data-route-filter-empty hidden>No hay lecciones que coincidan con esta búsqueda.</p>

    <div class="module-stack">
      {modules.map((module, moduleIndex) => {
        const moduleLessons = lessonsByModule.get(module.id) ?? [];
        return (
          <section class="module-card" id={module.slug} data-module-card data-module-id={module.id} data-module-lesson-ids={JSON.stringify(moduleLessons.map((lesson) => lesson.id))}>
            <header class="module-header">
              <div class="module-number">{String(moduleIndex + 1).padStart(2, "0")}</div>
              <div class="module-copy"><p class="eyebrow">Módulo {moduleIndex + 1}</p><h2>{module.title}</h2><p>{module.description}</p></div>
              <div class="module-progress"><strong data-module-progress data-persisted-value>0%</strong><small>{moduleLessons.length} lecciones</small></div>
            </header>
            <ol class="lesson-list">
              {moduleLessons.map((lesson) => (
                <li data-route-lesson-id={lesson.id}>
                  <a class="lesson-link" href={sitePath(`/lecciones/${lesson.slug}/`)} data-lesson-id={lesson.id}>
                    <span class="lesson-number">{String(lesson.lesson_number).padStart(2, "0")}</span>
                    <span class="lesson-main"><strong>{lesson.title}</strong><small><span>{lesson.primary_reference}</span><span class="lesson-time"><Icon name="clock" size={13} />{lesson.estimated_time}</span></small></span>
                  </a>
                  <button
                    type="button"
                    class="lesson-complete-toggle"
                    data-route-complete-toggle
                    data-complete-lesson-id={lesson.id}
                    data-persisted-value
                    aria-pressed="false"
                    aria-label={`Marcar “${lesson.title}” como completada`}
                    title="Marcar como completada"
                  >
                    <span class="lesson-state" data-lesson-state aria-hidden="true">
                      <span class="state-pending"><Icon name="circle" size={20} /></span>
                      <span class="state-complete"><Icon name="check" size={18} /></span>
                    </span>
                  </button>
                </li>
              ))}
            </ol>
          </section>
        );
      })}
    </div>
  </main>
</BaseLayout>

<script>
  const PROGRESS_KEY = "bibli-learning-progress-v1";
  function readProgress() { try { return JSON.parse(localStorage.getItem(PROGRESS_KEY) || "{}"); } catch { return {}; } }
  function writeProgress(progress) { localStorage.setItem(PROGRESS_KEY, JSON.stringify(progress)); }
  const shell = document.querySelector<HTMLElement>("[data-route-shell]");
  if (shell) {
    let ids: string[] = [];
    try { ids = JSON.parse(shell.dataset.routeLessonIds || "[]"); } catch {}

    function syncRouteProgress() {
      const progress = readProgress();
      const completed = new Set(Array.isArray(progress.completed) ? progress.completed : []);
      const count = ids.filter((id) => completed.has(id)).length;
      const percent = ids.length ? Math.round((count / ids.length) * 100) : 0;
      shell.querySelector<HTMLElement>("[data-progress-percent]")!.textContent = `${percent}%`;
      shell.querySelector<HTMLElement>("[data-progress-bar]")!.style.width = `${percent}%`;
      shell.querySelector<HTMLElement>("[data-progress-count]")!.textContent = `${count} de ${ids.length} completadas`;

      shell.querySelectorAll<HTMLElement>("[data-route-lesson-id]").forEach((row) => {
            const id = row.dataset.routeLessonId || "";
            const button = row.querySelector<HTMLButtonElement>("[data-route-complete-toggle]");
            const lessonTitle = row.querySelector<HTMLElement>(".lesson-main strong")?.textContent?.trim() || "esta lección";
            const done = completed.has(id);
            row.classList.toggle("is-complete", done);
            if (button) {
              button.setAttribute("aria-pressed", String(done));
              button.setAttribute("aria-label", done ? `Desmarcar “${lessonTitle}” como completada` : `Marcar “${lessonTitle}” como completada`);
              button.title = done ? "Desmarcar como completada" : "Marcar como completada";
              button.dataset.persistedReady = "true";
            }
          });

      shell.querySelectorAll<HTMLElement>("[data-module-card]").forEach((module) => {
            let moduleIds: string[] = []; try { moduleIds = JSON.parse(module.dataset.moduleLessonIds || "[]"); } catch {}
            const moduleCount = moduleIds.filter((id) => completed.has(id)).length;
            const modulePercent = moduleIds.length ? Math.round((moduleCount / moduleIds.length) * 100) : 0;
            const label = module.querySelector<HTMLElement>("[data-module-progress]"); if (label) label.textContent = `${modulePercent}%`;
          });

      const routeId = shell.dataset.routeId || "";
      const last = progress.lastLessonByRoute?.[routeId];
      const continueButton = shell.querySelector<HTMLAnchorElement>("[data-route-continue]");
      const continueLabel = continueButton?.querySelector("span");
      if (count === ids.length && ids.length > 0 && continueButton) {
        const firstLessonLink = shell.querySelector<HTMLAnchorElement>("[data-lesson-id]");
        if (firstLessonLink) continueButton.href = firstLessonLink.href;
        if (continueLabel) continueLabel.textContent = "Revisar";
      } else if (last && continueButton) {
        const lessonLink = shell.querySelector<HTMLAnchorElement>(`[data-lesson-id="${CSS.escape(last)}"]`);
        if (lessonLink) { continueButton.href = lessonLink.href; if (continueLabel) continueLabel.textContent = "Continuar"; }
      } else if (count > 0 && continueButton) {
        const firstPending = ids.find((id) => !completed.has(id));
        const lessonLink = firstPending ? shell.querySelector<HTMLAnchorElement>(`[data-lesson-id="${CSS.escape(firstPending)}"]`) : null;
        if (lessonLink) { continueButton.href = lessonLink.href; if (continueLabel) continueLabel.textContent = "Continuar"; }
      } else if (continueButton) {
        if (continueLabel) continueLabel.textContent = "Comenzar";
      }

      shell.dataset.progressReady = "true";
      shell.dataset.persistedReady = "true";
    }

    shell.querySelectorAll<HTMLButtonElement>("[data-route-complete-toggle]").forEach((button) => {
      button.addEventListener("click", () => {
        const lessonId = button.dataset.completeLessonId || "";
        if (!lessonId) return;
        const progress = readProgress();
        const completed = new Set(Array.isArray(progress.completed) ? progress.completed : []);
        if (completed.has(lessonId)) completed.delete(lessonId);
        else completed.add(lessonId);
        progress.completed = [...completed];
        writeProgress(progress);
        syncRouteProgress();
        document.dispatchEvent(new CustomEvent("bibli:learning-progress-change"));
      });
    });

    syncRouteProgress();
    window.addEventListener("storage", (event) => {
      if (event.key === PROGRESS_KEY) syncRouteProgress();
    });
    document.addEventListener("bibli:learning-progress-change", syncRouteProgress);
    window.addEventListener("pageshow", syncRouteProgress);

    const filterInput = shell.querySelector<HTMLInputElement>("[data-route-filter]");
    const filterCount = shell.querySelector<HTMLElement>("[data-route-filter-count]");
    const filterEmpty = shell.querySelector<HTMLElement>("[data-route-filter-empty]");
    const moduleCards = [...shell.querySelectorAll<HTMLElement>("[data-module-card]")];
    const moduleJumpLinks = [...shell.querySelectorAll<HTMLAnchorElement>("[data-module-jump]")];

    const normalize = (value: string) =>
      value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase("es").trim();

    function syncFilterQuery() {
      if (!filterInput) return;
      const url = new URL(window.location.href);
      const rawQuery = filterInput.value.trim();
      if (rawQuery) url.searchParams.set("q", rawQuery);
      else url.searchParams.delete("q");
      window.history.replaceState(window.history.state, "", `${url.pathname}${url.search}${url.hash}`);
    }

    function filterLessons({ syncUrl = true } = {}) {
      const query = normalize(filterInput?.value || "");
      let visibleLessons = 0;

      moduleCards.forEach((module) => {
        const rows = [...module.querySelectorAll<HTMLElement>("[data-route-lesson-id]")];
        const moduleText = normalize(module.querySelector(".module-header")?.textContent || "");
        let visibleInModule = 0;

        rows.forEach((row) => {
          const rowText = normalize(row.textContent || "");
          const matches = !query || rowText.includes(query) || moduleText.includes(query);
          row.hidden = !matches;
          if (matches) { visibleLessons += 1; visibleInModule += 1; }
        });

        module.hidden = visibleInModule === 0;
        const jump = moduleJumpLinks.find((link) => link.dataset.moduleJump === module.dataset.moduleId);
        if (jump) jump.hidden = visibleInModule === 0;
      });

      if (filterCount) {
        filterCount.textContent = query
          ? `${visibleLessons} de ${ids.length} lecciones`
          : `${ids.length} lecciones`;
      }
      if (filterEmpty) filterEmpty.hidden = !query || visibleLessons > 0;
      if (syncUrl) syncFilterQuery();
    }

    const initialFilterQuery = new URL(window.location.href).searchParams.get("q")?.trim() ?? "";
    if (filterInput && initialFilterQuery) filterInput.value = initialFilterQuery;

    filterInput?.addEventListener("input", () => filterLessons());
    filterLessons({ syncUrl: false });

    if ("IntersectionObserver" in window && moduleCards.length > 0) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting && !(entry.target as HTMLElement).hidden)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!visible) return;
        const moduleId = (visible.target as HTMLElement).dataset.moduleId;
        moduleJumpLinks.forEach((link) => {
          const active = link.dataset.moduleJump === moduleId;
          link.classList.toggle("is-current", active);
          if (active) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        });
      }, { rootMargin: "-120px 0px -68% 0px", threshold: 0.01 });
      moduleCards.forEach((module) => observer.observe(module));
    }

  }
</script>

<style>
  .route-page { max-width:var(--content-max); margin:0 auto; padding:14px 1rem 4rem; }
  .breadcrumb { display:flex; flex-wrap:wrap; gap:.42rem; align-items:center; font-size:.8rem; color:var(--text-muted); }
  .route-hero-modern { position:relative; isolation:isolate; display:grid; grid-template-columns:minmax(0,1fr) 280px; gap:1.4rem; align-items:end; padding:clamp(1.4rem,3.2vw,2.45rem); border:1px solid var(--border-color); border-radius:22px; background:linear-gradient(135deg,var(--surface),color-mix(in srgb,var(--accent-soft) 28%,var(--surface))); box-shadow:0 12px 34px rgba(15, 23, 42, .045); overflow:hidden; }
  .route-hero-modern::after { content:""; position:absolute; z-index:0; width:330px; height:330px; right:-165px; top:-190px; border-radius:50%; background:var(--accent-soft); border:1px solid var(--accent-border); opacity:.72; pointer-events:none; }
  .route-hero-copy,.progress-card { position:relative; z-index:1; }
  .route-icon { width:42px; height:42px; display:grid; place-items:center; border-radius:13px; background:var(--accent-soft); color:var(--accent); margin-bottom:.85rem; }
  .route-hero-copy h1 { margin:0 0 .65rem; color:var(--heading-color); font-size:clamp(2.35rem,5.3vw,4rem); line-height:.98; letter-spacing:-.055em; text-wrap:balance; }
  .route-hero-copy > p { max-width:710px; margin:0; color:var(--text-muted); line-height:1.65; }
  .route-hero-meta { display:flex; flex-wrap:wrap; gap:.45rem; margin-top:1.05rem; }
  .route-hero-meta span { display:inline-flex; align-items:center; gap:.35rem; min-height:30px; padding:0 .55rem; border:1px solid var(--border-color); border-radius:10px; background:color-mix(in srgb,var(--surface) 82%,transparent); color:var(--text-muted); font-size:.76rem; }
  .route-hero-meta .bibli-icon { color:var(--accent); }
  .progress-card { display:grid; gap:.6rem; padding:1rem; border:1px solid var(--border-color); border-radius:16px; background:color-mix(in srgb,var(--surface-elevated) 94%,transparent); box-shadow:var(--shadow-sm); backdrop-filter:blur(10px); }
  .progress-card-top { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; }
  .progress-card-top span,.progress-card small { color:var(--text-muted); font-size:.76rem; }
  .progress-card-top strong { color:var(--heading-color); font-size:1.8rem; letter-spacing:-.04em; }
  .progress-track { height:6px; background:var(--surface-soft); border-radius:999px; overflow:hidden; }
  .progress-track span { display:block; height:100%; width:0; border-radius:inherit; background:var(--accent); transition:width .28s ease; }
  .continue-button { min-height:42px; display:flex; align-items:center; justify-content:space-between; gap:.7rem; padding:0 .8rem; border:1px solid var(--border-color); border-radius:11px; background:var(--surface); color:var(--heading-color); text-decoration:none; font-weight:720; transition:transform 150ms ease,border-color 150ms ease,background-color 150ms ease; }
  .continue-button:hover { transform:translateY(-1px); border-color:color-mix(in srgb,var(--accent) 45%,var(--border-color)); background:var(--accent-soft); }
  .route-tools { position:sticky; top:calc(var(--header-height,62px) + 8px); z-index:24; display:grid; grid-template-columns:minmax(0,1fr) minmax(280px,360px); gap:.75rem; align-items:center; margin-top:1rem; padding:.65rem; border:1px solid var(--border-color); border-radius:16px; background:color-mix(in srgb,var(--page-bg) 90%,transparent); box-shadow:0 8px 24px rgba(15,23,42,.045); backdrop-filter:blur(16px) saturate(1.1); -webkit-backdrop-filter:blur(16px) saturate(1.1); }
  .module-jump-nav { min-width:0; display:flex; align-items:center; gap:.65rem; }
  .module-jump-label { flex:0 0 auto; color:var(--text-muted); font-size:.7rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .module-jump-list { min-width:0; display:flex; gap:.35rem; overflow-x:auto; padding:2px 1px 4px; scrollbar-width:none; }
  .module-jump-list::-webkit-scrollbar { display:none; }
  .module-jump-list a { flex:0 0 auto; width:34px; height:34px; display:grid; place-items:center; border:1px solid var(--border-color); border-radius:10px; background:var(--surface); color:var(--text-muted); font-size:.72rem; font-weight:780; font-variant-numeric:tabular-nums; text-decoration:none; transition:background-color 150ms ease,border-color 150ms ease,color 150ms ease; }
  .module-jump-list a:hover { border-color:var(--accent-border); color:var(--accent); background:var(--accent-soft); }
  .module-jump-list a.is-current { border-color:var(--accent); background:var(--accent); color:var(--accent-contrast); }
  .route-filter { min-width:0; height:42px; display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:.55rem; align-items:center; padding:0 .75rem; border:1px solid var(--border-color); border-radius:12px; background:var(--surface); color:var(--text-muted); }
  .route-filter:focus-within { border-color:var(--accent); box-shadow:0 0 0 4px var(--focus-ring); }
  .route-filter input { min-width:0; width:100%; border:0; outline:0; background:transparent; color:var(--text-color); font-size:.84rem; }
  .route-filter input::placeholder { color:var(--text-muted); }
  .route-filter-count { white-space:nowrap; color:var(--text-muted); font-size:.72rem; }
  .module-stack { display:grid; gap:1rem; margin-top:1rem; padding-top:1rem; border-top:1px solid var(--border-color); }
  .module-card { overflow:hidden; scroll-margin-top:calc(var(--header-height,62px) + 78px); border:1px solid var(--border-color); border-radius:18px; background:var(--surface); box-shadow:0 8px 26px rgba(15, 23, 42, .035); }
  .module-header { display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:.9rem; align-items:start; padding:1.05rem 1.15rem; border-bottom:1px solid var(--border-color); }
  .module-number { width:2.35rem; height:2.35rem; display:grid; place-items:center; border-radius:11px; background:var(--accent-soft); color:var(--accent); font-size:.82rem; font-weight:850; font-variant-numeric:tabular-nums; }
  .module-copy .eyebrow { margin:0; color:var(--accent); font-size:.68rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .module-copy h2 { margin:.18rem 0 .3rem; color:var(--heading-color); font-size:1.22rem; letter-spacing:-.02em; }
  .module-copy p { margin:0; color:var(--text-muted); line-height:1.5; }
  .module-progress { display:grid; text-align:right; }
  .module-progress strong { color:var(--heading-color); }
  .module-progress small { color:var(--text-muted); }
  .lesson-list { list-style:none; padding:0; margin:0; }
  .lesson-list li { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:stretch; }
  .lesson-list li + li { border-top:1px solid var(--border-color); }
  .lesson-list .lesson-link { display:grid; grid-template-columns:2.5rem minmax(0,1fr); align-items:center; gap:.9rem; min-height:72px; padding:.55rem .45rem .55rem 1.15rem; color:inherit; text-decoration:none; transition:background-color 150ms ease; }
  .lesson-list li:hover { background:color-mix(in srgb,var(--accent-soft) 32%,var(--surface)); }
  .lesson-complete-toggle { align-self:center; width:44px; height:44px; margin-right:.75rem; display:grid; place-items:center; border:1px solid transparent; border-radius:13px; background:transparent; color:var(--text-muted); cursor:pointer; transition:background-color 150ms ease,border-color 150ms ease,color 150ms ease,transform 150ms ease; }
  .lesson-complete-toggle:hover { border-color:var(--accent-border); background:var(--accent-soft); color:var(--accent); transform:scale(1.04); }
  .lesson-complete-toggle[aria-pressed="true"] { border-color:var(--accent-border); background:var(--accent-soft); color:var(--accent); }
  .lesson-number { color:var(--text-muted); font-size:.78rem; font-variant-numeric:tabular-nums; }
  .lesson-main { display:grid; gap:.18rem; }
  .lesson-main strong { color:var(--heading-color); line-height:1.3; }
  .lesson-main small { display:flex; flex-wrap:wrap; align-items:center; gap:.35rem .55rem; color:var(--text-muted); font-size:.78rem; }
  .lesson-time { display:inline-flex; align-items:center; gap:.3rem; white-space:nowrap; }
  .lesson-time .bibli-icon { color:var(--accent); }
  .lesson-state { width:30px; height:30px; display:grid; place-items:center; border-radius:10px; color:inherit; }
  [data-route-lesson-id][hidden], [data-module-card][hidden], [data-module-jump][hidden], .route-filter-empty[hidden] { display:none !important; }
  .route-filter-empty { margin:1rem 0 0; padding:1rem; border:1px dashed var(--border-color); border-radius:14px; background:var(--surface-soft); color:var(--text-muted); text-align:center; font-size:.86rem; }
  .state-complete { display:none; }
  .is-complete .state-pending { display:none; }
  .is-complete .state-complete { display:grid; color:var(--accent); }
  .lesson-list li:hover .lesson-state { color:var(--accent); }
  @media(max-width:800px){ .route-hero-modern{grid-template-columns:1fr;} .progress-card{max-width:none;} .route-tools{top:calc(var(--header-height,62px) + 6px);grid-template-columns:1fr;gap:.5rem;} .module-header{grid-template-columns:auto 1fr;} .module-progress{grid-column:2;text-align:left;display:flex;gap:.5rem;} .module-card{scroll-margin-top:calc(var(--header-height,62px) + 126px);} }
  @media(max-width:520px){ .route-page{padding:10px .7rem 3rem;} .route-hero-modern{padding:1.2rem;border-radius:18px;} .route-tools{margin-inline:-.1rem;padding:.5rem;border-radius:14px;} .module-jump-label{display:none;} .route-filter-count{display:none;} .module-card{border-radius:15px;} .module-header{gap:.65rem;padding:.9rem;} .lesson-list .lesson-link{grid-template-columns:2rem minmax(0,1fr);padding:.55rem .35rem .55rem .9rem;} .lesson-complete-toggle{margin-right:.45rem;} .lesson-main strong{font-size:.94rem;} }
</style>
