---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { sitePath } from "../../lib/site-paths";
import { getAllRoutes, getLessonsByRouteId, getRouteModules } from "../../lib/queries";

const routes = getAllRoutes().filter((route) => route.status !== "Borrador");
const routeCards = routes.map((route) => ({
  route,
  lessons: getLessonsByRouteId(route.id),
  modules: getRouteModules(route.id),
}));
const totalModules = routeCards.reduce((total, item) => total + item.modules.length, 0);
const totalLessons = new Set(routeCards.flatMap((item) => item.lessons.map((lesson) => lesson.id))).size;
---

<BaseLayout title="Rutas de estudio" description="Recorridos guiados para estudiar la Biblia progresivamente.">
  <main class="page route-index-page" data-catalog-root data-catalog-variant="learning">
    <nav class="breadcrumb" aria-label="Migas de pan"><a href={sitePath("/")}>Inicio</a><span>›</span><span>Rutas</span></nav>

    <header class="route-index-header catalog-index-hero">
      <div>
        <span class="route-index-icon"><Icon name="route" size={20} /></span>
        <p class="eyebrow">Aprendizaje guiado</p>
        <h1>Rutas de estudio</h1>
        <p>Recorridos organizados para estudiar la Biblia paso a paso.</p>
      </div>

      <aside class="catalog-learning-summary" aria-label="Resumen de rutas de estudio">
        <span>Rutas disponibles</span>
        <strong>{routes.length}</strong>
        <small>{totalModules} módulos · {totalLessons} lecciones</small>
      </aside>
    </header>

    <section class="route-grid" aria-label="Rutas disponibles">
      {routeCards.map(({ route, lessons, modules }) => (
        <article class="route-card" data-catalog-item data-route-card data-persisted-root data-route-id={route.id} data-route-lesson-ids={JSON.stringify(lessons.map((lesson) => lesson.id))} data-route-lesson-map={JSON.stringify(lessons.map((lesson) => ({ id: lesson.id, href: sitePath(`/lecciones/${lesson.slug}/`) })))}>
          <div class="route-card-top">
            <div class="route-card-icon"><Icon name="layers" size={20} /></div>
            <span class="route-count">{modules.length} módulos · {lessons.length} lecciones</span>
          </div>
          <div class="route-card-copy">
            <span class="route-badge">{route.level ?? "Progresivo"}</span>
            <h2><a href={sitePath(`/rutas/${route.slug}/`)}>{route.title}</a></h2>
            <p>{route.description ?? route.subtitle}</p>
          </div>
          <div class="route-progress-row">
            <span>{route.estimated_duration ?? "Duración progresiva"}</span>
            <strong data-progress-label data-persisted-value>0%</strong>
          </div>
          <div class="progress-track" role="progressbar" aria-label="Progreso personal" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-progress-track><span data-progress-bar></span></div>
          <div class="route-actions">
            <a class="primary" href={sitePath(`/rutas/${route.slug}/`)}><span>Abrir ruta</span><Icon name="arrow-right" size={16} /></a>
            {lessons[0] && <a class="secondary" href={sitePath(`/lecciones/${lessons[0].slug}/`)} data-continue-link data-persisted-value>Comenzar</a>}
          </div>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<script>
  const PROGRESS_KEY = "bibli-learning-progress-v1";
  const routeCards = [...document.querySelectorAll<HTMLElement>("[data-route-card]")];

  function readProgress() {
    try { return JSON.parse(localStorage.getItem(PROGRESS_KEY) || "{}"); } catch { return {}; }
  }

  function refreshRouteProgress() {
    const progress = readProgress();
    const completed = new Set(Array.isArray(progress.completed) ? progress.completed : []);

    routeCards.forEach((card) => {
      let ids: string[] = [];
      try { ids = JSON.parse(card.dataset.routeLessonIds || "[]"); } catch {}
      const count = ids.filter((id) => completed.has(id)).length;
      const percent = ids.length ? Math.round((count / ids.length) * 100) : 0;
      const bar = card.querySelector<HTMLElement>("[data-progress-bar]");
      const label = card.querySelector<HTMLElement>("[data-progress-label]");
      const track = card.querySelector<HTMLElement>("[data-progress-track]");
      if (bar) bar.style.width = `${percent}%`;
      if (label) {
        label.textContent = `${percent}%`;
        label.dataset.persistedReady = "true";
      }
      if (track) track.setAttribute("aria-valuenow", String(percent));
      card.dataset.progressState = percent >= 100 ? "complete" : percent > 0 ? "started" : "new";

      const routeId = card.dataset.routeId || "";
      const lastLesson = progress.lastLessonByRoute?.[routeId];
      const continueLink = card.querySelector<HTMLAnchorElement>("[data-continue-link]");
      let lessonMap: Array<{ id: string; href: string }> = [];
      try { lessonMap = JSON.parse(card.dataset.routeLessonMap || "[]"); } catch {}

      if (continueLink) {
        const lastTarget = lastLesson ? lessonMap.find((item) => item.id === lastLesson) : null;
        const firstPending = lessonMap.find((item) => !completed.has(item.id));
        const target = lastTarget ?? (count > 0 && count < ids.length ? firstPending : null);
        if (target?.href) continueLink.href = target.href;
        continueLink.textContent = ids.length > 0 && count >= ids.length ? "Revisar" : count > 0 ? "Continuar" : "Comenzar";
        continueLink.dataset.persistedReady = "true";
      }

      card.dataset.progressReady = "true";
      card.dataset.persistedReady = "true";
    });
  }

  refreshRouteProgress();
  requestAnimationFrame(refreshRouteProgress);
  window.addEventListener("storage", (event) => {
    if (event.key === PROGRESS_KEY) refreshRouteProgress();
  });
  window.addEventListener("bibli:learning-progress-change", refreshRouteProgress);
  window.addEventListener("pageshow", refreshRouteProgress);
</script>

<style>
  .route-index-page { max-width:var(--content-max); margin:0 auto; padding:14px 1rem 4rem; }
  .breadcrumb { display:flex; gap:.42rem; align-items:center; font-size:.8rem; color:var(--text-muted); }
  .route-index-header { display:flex; align-items:end; justify-content:space-between; gap:1rem; padding:1.15rem 0 1.3rem; }
  .route-index-header > div { max-width:680px; }
  .route-index-icon { width:42px; height:42px; display:grid; place-items:center; border-radius:13px; background:var(--accent-soft); color:var(--accent); margin-bottom:.85rem; }
  .eyebrow { margin:0; color:var(--text-muted); font-size:.72rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .route-index-header h1 { margin:.25rem 0 .45rem; color:var(--heading-color); font-size:clamp(2.15rem,5vw,3.45rem); line-height:1; letter-spacing:-.05em; }
  .route-index-header p:last-child { margin:0; color:var(--text-muted); font-size:1rem; line-height:1.55; }
  .route-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr)); gap:.9rem; }
  .route-card { display:grid; gap:1rem; padding:1.25rem; border:1px solid var(--border-color); border-radius:18px; background:var(--surface); box-shadow:0 10px 30px rgba(15, 23, 42, .04); transition:transform 170ms ease,border-color 170ms ease,box-shadow 170ms ease; }
  .route-card:hover { transform:translateY(-2px); border-color:color-mix(in srgb,var(--accent) 42%,var(--border-color)); box-shadow:var(--shadow-sm); }
  .route-card-top { display:flex; align-items:center; justify-content:space-between; gap:.8rem; }
  .route-card-icon { width:42px; height:42px; display:grid; place-items:center; border-radius:12px; background:var(--accent-soft); color:var(--accent); }
  .route-count { color:var(--text-muted); font-size:.78rem; }
  .route-card-copy { display:grid; gap:.42rem; }
  .route-badge { width:max-content; color:var(--accent); font-size:.7rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase; }
  .route-card h2 { margin:0; font-size:1.42rem; line-height:1.15; letter-spacing:-.025em; }
  .route-card h2 a { color:var(--heading-color); text-decoration:none; }
  .route-card p { margin:0; color:var(--text-muted); line-height:1.6; }
  .route-progress-row { display:flex; justify-content:space-between; gap:1rem; color:var(--text-muted); font-size:.78rem; }
  .route-progress-row strong { color:var(--heading-color); }
  .progress-track { height:6px; background:var(--surface-soft); border-radius:999px; overflow:hidden; }
  .progress-track span { display:block; height:100%; width:0; border-radius:inherit; background:var(--accent); transition:width .28s ease; }
  .route-actions { display:flex; align-items:center; justify-content:space-between; gap:.65rem; }
  .route-actions a { min-height:42px; display:inline-flex; align-items:center; justify-content:center; gap:.45rem; padding:0 .85rem; border-radius:11px; text-decoration:none; font-weight:720; transition:transform 150ms ease,background-color 150ms ease,border-color 150ms ease; }
  .route-actions a:hover { transform:translateY(-1px); }
  .route-actions .primary { background:var(--accent); color:var(--accent-contrast); }
  .route-actions .primary:hover { background:var(--accent-hover); }
  .route-actions .secondary { border:1px solid var(--border-color); color:var(--text-color); background:transparent; }
  .route-actions .secondary:hover { background:var(--surface-soft); border-color:var(--border-strong); }
  @media(max-width:600px){ .route-index-page{padding:10px .7rem 3rem;} .route-index-header{padding:.8rem 0 1rem;} .route-actions{align-items:stretch;} .route-actions a{flex:1;} }
</style>
