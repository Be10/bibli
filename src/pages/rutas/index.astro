---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sitePath } from "../../lib/site-paths";
import { getAllRoutes, getLessonsByRouteId, getRouteModules } from "../../lib/queries";

const routes = getAllRoutes().filter((route) => route.status !== "Borrador");
const routeCards = routes.map((route) => ({
  route,
  lessons: getLessonsByRouteId(route.id),
  modules: getRouteModules(route.id),
}));
---

<BaseLayout title="Rutas de estudio" description="Recorridos guiados para estudiar la Biblia progresivamente.">
  <main class="route-index-page">
    <nav class="breadcrumb" aria-label="Migas de pan"><a href={sitePath("/")}>Inicio</a><span>›</span><span>Rutas</span></nav>

    <header class="route-index-hero">
      <p class="eyebrow">Aprendizaje guiado</p>
      <h1>Rutas de estudio</h1>
      <p>Avanza por recorridos organizados en módulos. Tu progreso se guarda en este dispositivo y cada lección puede formar parte de más de una ruta sin duplicar su contenido.</p>
    </header>

    <section class="route-grid" aria-label="Rutas disponibles">
      {routeCards.map(({ route, lessons, modules }) => (
        <article class="route-card" data-route-card data-route-id={route.id} data-route-lesson-ids={JSON.stringify(lessons.map((lesson) => lesson.id))} data-route-lesson-map={JSON.stringify(lessons.map((lesson) => ({ id: lesson.id, href: sitePath(`/lecciones/${lesson.slug}/`) })))}>
          <div class="route-card-top">
            <span class="route-badge">{route.level ?? "Progresivo"}</span>
            <span class="route-count">{modules.length} módulos · {lessons.length} lecciones</span>
          </div>
          <h2><a href={sitePath(`/rutas/${route.slug}/`)}>{route.title}</a></h2>
          <p>{route.description ?? route.subtitle}</p>
          <div class="route-meta"><span>{route.estimated_duration ?? "Duración progresiva"}</span><strong data-progress-label>0%</strong></div>
          <div class="progress-track" aria-label="Progreso personal"><span data-progress-bar></span></div>
          <div class="route-actions">
            <a class="primary" href={sitePath(`/rutas/${route.slug}/`)}>Abrir ruta</a>
            {lessons[0] && <a class="secondary" href={sitePath(`/lecciones/${lessons[0].slug}/`)} data-continue-link>Comenzar</a>}
          </div>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<script>
  const PROGRESS_KEY = "bibli-learning-progress-v1";
  function readProgress() {
    try { return JSON.parse(localStorage.getItem(PROGRESS_KEY) || "{}"); } catch { return {}; }
  }
  document.querySelectorAll<HTMLElement>("[data-route-card]").forEach((card) => {
    const progress = readProgress();
    const completed = new Set(Array.isArray(progress.completed) ? progress.completed : []);
    let ids: string[] = [];
    try { ids = JSON.parse(card.dataset.routeLessonIds || "[]"); } catch {}
    const count = ids.filter((id) => completed.has(id)).length;
    const percent = ids.length ? Math.round((count / ids.length) * 100) : 0;
    const bar = card.querySelector<HTMLElement>("[data-progress-bar]");
    const label = card.querySelector<HTMLElement>("[data-progress-label]");
    if (bar) bar.style.width = `${percent}%`;
    if (label) label.textContent = `${percent}%`;

    const routeId = card.dataset.routeId || "";
    const lastLesson = progress.lastLessonByRoute?.[routeId];
    const continueLink = card.querySelector<HTMLAnchorElement>("[data-continue-link]");
    let lessonMap: Array<{ id: string; href: string }> = [];
    try { lessonMap = JSON.parse(card.dataset.routeLessonMap || "[]"); } catch {}
    if (lastLesson && continueLink) {
      const target = lessonMap.find((item) => item.id === lastLesson);
      if (target?.href) continueLink.href = target.href;
      continueLink.textContent = "Continuar";
    } else if (count > 0 && count < ids.length && continueLink) {
      const firstPending = lessonMap.find((item) => !completed.has(item.id));
      if (firstPending?.href) continueLink.href = firstPending.href;
      continueLink.textContent = "Continuar";
    }
  });
</script>

<style>
  .route-index-page{max-width:1180px;margin:0 auto;padding:1.5rem 1rem 5rem}.breadcrumb{display:flex;gap:.45rem;align-items:center;font-size:.86rem;opacity:.72;margin-bottom:1.2rem}.route-index-hero{padding:clamp(1.5rem,4vw,3rem);border:1px solid var(--border-color,rgba(100,100,100,.18));border-radius:28px;background:linear-gradient(145deg,var(--surface,#fff),var(--surface-soft,#f5f5f5));margin-bottom:1.5rem}.eyebrow{text-transform:uppercase;letter-spacing:.09em;font-size:.76rem;font-weight:800;opacity:.65}.route-index-hero h1{font-size:clamp(2rem,5vw,3.5rem);margin:.35rem 0 .7rem}.route-index-hero p{max-width:760px;font-size:1.05rem;line-height:1.7;margin:0}.route-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:1rem}.route-card{display:flex;flex-direction:column;gap:.8rem;border:1px solid var(--border-color,rgba(100,100,100,.18));border-radius:22px;padding:1.25rem;background:var(--surface,#fff)}.route-card-top,.route-meta,.route-actions{display:flex;justify-content:space-between;align-items:center;gap:.8rem;flex-wrap:wrap}.route-badge{font-size:.75rem;font-weight:800;padding:.32rem .55rem;border-radius:999px;background:var(--surface-soft,#f1f3f5)}.route-count,.route-meta{font-size:.82rem;opacity:.72}.route-card h2{margin:.1rem 0;font-size:1.35rem}.route-card h2 a{text-decoration:none}.route-card p{margin:0;line-height:1.6;opacity:.84}.progress-track{height:8px;background:var(--surface-soft,#eceff1);border-radius:999px;overflow:hidden}.progress-track span{display:block;height:100%;width:0;background:currentColor;transition:width .25s ease}.route-actions a{text-decoration:none;border-radius:12px;padding:.65rem .9rem;font-weight:750}.route-actions .primary{background:#203a33;color:#fff}.route-actions .primary::first-line{color:inherit}.route-actions .secondary{border:1px solid var(--border-color,rgba(100,100,100,.25))}@media(max-width:600px){.route-index-page{padding-top:1rem}.route-index-hero{border-radius:20px}.route-card{border-radius:18px}.route-actions{align-items:stretch}.route-actions a{flex:1;text-align:center}}
</style>
