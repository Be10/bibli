---
import { sitePath } from "../../../../../lib/site-paths";

import {
  getBibleBookPath,
  getBibleChapterPath,
  getBibleVersionPath,
} from "../../../../../lib/bible-routes";

import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import BibleVersionSwitcher from "../../../../../components/BibleVersionSwitcher.astro";
import ReaderPreferences from "../../../../../components/ReaderPreferences.astro";

import {
  getAllBooksByLanguage,
  getBibleChaptersByBookId,
  getBibleVersesByChapter,
  getBibleVersionsByLanguage,
  type BibleChapter,
  type BibleVerse,
  type BibleVersion,
  type Book,
} from "../../../../../lib/queries";

import {
  getDefaultBibleVersionId,
} from "../../../../../lib/bible-config";

type Props = {
  version: BibleVersion;
  book: Book;
  chapter: BibleChapter;
  chapters: BibleChapter[];
  verses: BibleVerse[];
};

export function getStaticPaths() {
  const versions = getBibleVersionsByLanguage("es");

  const books = getAllBooksByLanguage("es").filter(
    (book) =>
      book.status !== "Borrador" &&
      book.usfm_code
  );

  return versions.flatMap((version) =>
    books.flatMap((book) => {
      const chapters =
        getBibleChaptersByBookId(book.id);

      return chapters.map((chapter) => ({
        params: {
          versionId: version.id,
          bookCode: book.usfm_code.toLowerCase(),
          chapter: String(chapter.chapter_number),
        },

        props: {
          version,
          book,
          chapter,
          chapters,

          verses: getBibleVersesByChapter(
            book.id,
            chapter.chapter_number,
            version.id
          ),
        },
      }));
    })
  );
}

const {
  version,
  book,
  chapter,
  chapters,
  verses,
} = Astro.props as Props;

const currentChapterNumber =
  chapter.chapter_number;

const versionLabel =
  version.abbreviation;

const previousChapter = chapters.find(
  (item) =>
    item.chapter_number === currentChapterNumber - 1
);

const nextChapter = chapters.find(
  (item) =>
    item.chapter_number === currentChapterNumber + 1
);

const firstVerse = verses[0];
const lastVerse = verses[verses.length - 1];

const chapterReference =
  `${book.name} ${currentChapterNumber}`;

const verseRange =
  firstVerse && lastVerse
    ? `${firstVerse.verse_number}–${lastVerse.verse_number}`
    : "Pendiente";

const englishVersionId =
  getDefaultBibleVersionId("en");
const availableVersions =
  getBibleVersionsByLanguage("es");

const searchUrl = `${sitePath("/buscar/")}?q=${encodeURIComponent(chapterReference)}`;
---

<BaseLayout
  lang="es"
  alternateLanguage={{
    code: "en",
    label: "English",
    href: getBibleChapterPath(
      "en",
      getDefaultBibleVersionId("en"),
      book.usfm_code,
      currentChapterNumber
    ),
  }}
  title={`${book.name} ${currentChapterNumber}`}
  description={`Lee ${book.name} capítulo ${currentChapterNumber} en la versión ${versionLabel}.`}
>
  <main class="page">
    <div class="bible-version-toolbar">
      <BibleVersionSwitcher
        language="es"
        versions={availableVersions}
        currentVersionId={version.id}
        bookCode={book.usfm_code}
        chapterNumber={currentChapterNumber}
      />
    </div>
    <div class="breadcrumb">
      <a href={sitePath("/")}>Inicio</a> →

      <a href={getBibleVersionPath("es", version.id)}>
        Biblia
      </a> →

      <a
        href={getBibleBookPath(
          "es",
          version.id,
          book.usfm_code
        )}
      >
        {book.name}
      </a> →

      Capítulo {currentChapterNumber}
    </div>

    <section class="hero bible-chapter-hero">
      <div class="bible-chapter-hero-content">
        <p class="eyebrow">
          Lectura bíblica · {versionLabel}
        </p>

        <h1>{chapterReference}</h1>

        <p class="subtitle">
          Lee el capítulo {currentChapterNumber} de {book.name}
          {" "}en la versión {versionLabel}.
        </p>

        <div class="actions">
          <a
            href={getBibleBookPath(
              "es",
              version.id,
              book.usfm_code
            )}
            class="button secondary"
          >
            Ver capítulos de {book.name}
          </a>

          <a
            href={sitePath(`/libros/${book.slug}/`)}
            class="button secondary"
          >
            Ver ficha del libro
          </a>

          <a href="#lectura" class="button">
            Ir a la lectura
          </a>

          <a
            href={getBibleChapterPath(
              "en",
              englishVersionId,
              book.usfm_code,
              currentChapterNumber
            )}
            class="button secondary"
          >
            Read in English
          </a>

          <a href={searchUrl} class="button secondary">
            Buscar conexiones
          </a>
        </div>
      </div>

      <aside
        class="bible-chapter-hero-card"
        aria-label="Resumen del capítulo"
      >
        <span>{versionLabel}</span>

        <strong>{verses.length}</strong>

        <p>
          {verses.length === 1
            ? "versículo"
            : "versículos"}
          {" "}· rango {verseRange}
        </p>
      </aside>
    </section>

    <section
      class="bible-chapter-meta-grid"
      aria-label="Datos rápidos del capítulo"
    >
      <article class="bible-chapter-meta-card">
        <span>Libro</span>
        <strong>{book.name}</strong>
      </article>

      <article class="bible-chapter-meta-card">
        <span>Capítulo</span>
        <strong>{currentChapterNumber}</strong>
      </article>

      <article class="bible-chapter-meta-card">
        <span>Versículos</span>
        <strong>{verses.length}</strong>
      </article>

      <article class="bible-chapter-meta-card">
        <span>Versión</span>
        <strong>{versionLabel}</strong>
      </article>
    </section>

    <nav class="bible-chapter-jump" aria-label="Ir a otro capítulo">
      <a
        href={previousChapter
          ? getBibleChapterPath("es", version.id, book.usfm_code, previousChapter.chapter_number)
          : getBibleBookPath("es", version.id, book.usfm_code)}
        class:list={["bible-chapter-jump-button", !previousChapter && "is-disabled"]}
        aria-disabled={!previousChapter ? "true" : undefined}
      >
        ←
      </a>

      <label for="chapter-jump-select">Capítulo</label>
      <select id="chapter-jump-select" data-chapter-jump>
        {chapters.map((item) => (
          <option
            value={getBibleChapterPath("es", version.id, book.usfm_code, item.chapter_number)}
            selected={item.chapter_number === currentChapterNumber}
          >
            {item.chapter_number}
          </option>
        ))}
      </select>

      <a
        href={nextChapter
          ? getBibleChapterPath("es", version.id, book.usfm_code, nextChapter.chapter_number)
          : getBibleBookPath("es", version.id, book.usfm_code)}
        class:list={["bible-chapter-jump-button", !nextChapter && "is-disabled"]}
        aria-disabled={!nextChapter ? "true" : undefined}
      >
        →
      </a>
      <ReaderPreferences lang="es" compact />
    </nav>

    <section
      class="section bible-chapter-reader-section"
      id="lectura"
    >
      <div class="section-header">
        <div>
          <p class="eyebrow">Texto bíblico</p>
          <h2>{chapterReference}</h2>
        </div>

        <span class="section-count">
          {verses.length}{" "}
          {verses.length === 1
            ? "versículo"
            : "versículos"}
        </span>
      </div>

      {verses.length > 0 ? (
        <div class="bible-chapter-reader-card">
          <div class="bible-reader" data-reader-content data-reader-surface="bible">
            {verses.map((verse) => (
              <article
                class="verse bible-chapter-verse"
                id={`v${verse.verse_number}`}
              >
                <span class="verse-number">
                  <a
                    href={`#v${verse.verse_number}`}
                    class="verse-ref-link"
                  >
                    {verse.verse_number}
                  </a>
                </span>

                <p class="verse-text">
                  {verse.verse_text}
                </p>
              </article>
            ))}
          </div>
        </div>
      ) : (
        <div class="bible-chapter-empty-card">
          <strong>Texto no disponible</strong>

          <p>
            No hay texto bíblico disponible para este capítulo
            en la versión seleccionada.
          </p>
        </div>
      )}

      <nav
        class="bible-chapter-nav"
        aria-label="Navegación entre capítulos"
      >
        {previousChapter ? (
          <a
            href={getBibleChapterPath(
              "es",
              version.id,
              book.usfm_code,
              previousChapter.chapter_number
            )}
            class="bible-chapter-nav-card"
          >
            <span>← Anterior</span>

            <strong>
              Capítulo {previousChapter.chapter_number}
            </strong>
          </a>
        ) : (
          <span class="bible-chapter-nav-card disabled">
            <span>Inicio</span>
            <strong>Primer capítulo</strong>
          </span>
        )}

        <a
          href={getBibleBookPath(
            "es",
            version.id,
            book.usfm_code
          )}
          class="bible-chapter-nav-card center"
        >
          <span>Libro</span>
          <strong>{book.name}</strong>
        </a>

        {nextChapter ? (
          <a
            href={getBibleChapterPath(
              "es",
              version.id,
              book.usfm_code,
              nextChapter.chapter_number
            )}
            class="bible-chapter-nav-card next"
          >
            <span>Siguiente →</span>

            <strong>
              Capítulo {nextChapter.chapter_number}
            </strong>
          </a>
        ) : (
          <span
            class="bible-chapter-nav-card disabled next"
          >
            <span>Final</span>
            <strong>Último capítulo</strong>
          </span>
        )}
      </nav>
    </section>

    {version.copyright_notice && (
      <section
        class="copyright-box bible-chapter-copyright-box"
      >
        {version.copyright_notice}
      </section>
    )}

    <section class="section bible-chapter-footer-nav">
      <a
        href={getBibleVersionPath("es", version.id)}
        class="button secondary"
      >
        Volver a Biblia
      </a>

      <a
        href={getBibleBookPath(
          "es",
          version.id,
          book.usfm_code
        )}
        class="button secondary"
      >
        Ver capítulos
      </a>

      <a
        href={sitePath(`/libros/${book.slug}/`)}
        class="button"
      >
        Ver ficha de {book.name}
      </a>
    </section>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLSelectElement>("[data-chapter-jump]").forEach((select) => {
    select.addEventListener("change", () => {
      if (select.value) window.location.href = select.value;
    });
  });
</script>

<style>
  .bible-chapter-jump {
    position:sticky;
    top:calc(var(--header-height,62px) + 8px);
    z-index:12;
    width:max-content;
    max-width:100%;
    display:flex;
    align-items:center;
    gap:.45rem;
    margin:24px auto 0;
    padding:.45rem;
    border:1px solid var(--border-color);
    border-radius:14px;
    background:color-mix(in srgb,var(--surface) 92%,transparent);
    box-shadow:var(--shadow-sm);
    backdrop-filter:blur(12px);
  }
  .bible-chapter-jump label { color:var(--text-muted); font-size:.72rem; font-weight:800; text-transform:uppercase; letter-spacing:.05em; }
  .bible-chapter-jump select { min-width:74px; min-height:44px; border:1px solid var(--border-color); border-radius:10px; background:var(--surface-soft); color:var(--heading-color); padding:0 .55rem; font:inherit; font-weight:800; }
  .bible-chapter-jump-button { width:44px; height:44px; display:grid; place-items:center; border:1px solid var(--border-color); border-radius:10px; background:var(--surface-soft); color:var(--accent); text-decoration:none; font-weight:900; }
  .bible-chapter-jump-button:hover { border-color:var(--accent-border); background:var(--accent-soft); }
  .bible-chapter-jump-button.is-disabled { pointer-events:none; opacity:.38; }

  .bible-chapter-hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(220px, 320px);
    gap: 28px;
    align-items: end;
    overflow: hidden;
  }

  .bible-chapter-hero::after {
    content: "";
    position: absolute;
    right: -90px;
    bottom: -120px;
    width: 320px;
    height: 320px;
    border-radius: 999px;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 16%, transparent), transparent 68%);
    pointer-events: none;
  }

  .bible-chapter-hero-content,
  .bible-chapter-hero-card {
    position: relative;
    z-index: 1;
  }

  .bible-chapter-hero-card,
  .bible-chapter-meta-card,
  .bible-chapter-reader-card,
  .bible-chapter-empty-card,
  .bible-chapter-nav-card {
    border: 1px solid var(--border-color);
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
  }

  .bible-chapter-hero-card {
    display: grid;
    gap: 10px;
    padding: 24px;
    border-radius: 24px;
    background: var(--surface-elevated);
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.1);
  }

  .bible-chapter-hero-card span,
  .bible-chapter-meta-card span,
  .bible-chapter-nav-card span {
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bible-chapter-hero-card strong {
    color: var(--text-color);
    font-size: 3rem;
    line-height: 1;
  }

  .bible-chapter-hero-card p,
  .bible-chapter-empty-card p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .bible-chapter-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .bible-chapter-meta-card {
    padding: 22px;
    border-radius: 22px;
    background: var(--surface-elevated);
  }

  .bible-chapter-meta-card span {
    display: block;
    margin-bottom: 8px;
  }

  .bible-chapter-meta-card strong {
    display: block;
    color: var(--text-color);
    font-size: 1.16rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .bible-chapter-reader-card,
  .bible-chapter-empty-card {
    padding: 22px;
    border-radius: 22px;
    background: var(--surface-soft);
  }

  .bible-chapter-empty-card {
    display: grid;
    gap: 8px;
  }

  .bible-chapter-empty-card strong {
    color: var(--text-color);
    font-size: 1.1rem;
  }

  .bible-chapter-verse {
    border-color: var(--border-color);
  }

  .bible-chapter-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 28px;
  }

  .bible-chapter-nav-card {
    display: grid;
    align-content: center;
    gap: 6px;
    min-height: 108px;
    padding: 20px;
    border-radius: 22px;
    background: var(--surface-elevated);
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  a.bible-chapter-nav-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent-border);
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
  }

  .bible-chapter-nav-card strong {
    color: var(--text-color);
    font-size: 1.08rem;
    line-height: 1.35;
  }

  .bible-chapter-nav-card.center {
    text-align: center;
    background: var(--accent);
  }

  .bible-chapter-nav-card.center span,
  .bible-chapter-nav-card.center strong {
    color: var(--accent-contrast);
  }

  .bible-chapter-nav-card.next {
    text-align: right;
  }

  .bible-chapter-nav-card.disabled {
    background: var(--surface-muted);
    color: var(--text-muted);
  }

  .bible-chapter-nav-card.disabled strong {
    color: var(--text-muted);
  }

  .bible-chapter-copyright-box {
    margin-top: 32px;
  }

  .bible-chapter-footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  :global(html[data-theme="dark"]) .bible-chapter-hero-card,
  :global(html[data-theme="dark"]) .bible-chapter-meta-card,
  :global(html[data-theme="dark"]) .bible-chapter-reader-section,
  :global(html[data-theme="dark"]) .bible-chapter-footer-nav {
    background: var(--surface);
    border-color: var(--border-color);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.28);
  }

  :global(html[data-theme="dark"]) .bible-chapter-reader-card,
  :global(html[data-theme="dark"]) .bible-chapter-empty-card,
  :global(html[data-theme="dark"]) .bible-chapter-nav-card {
    background: var(--surface-soft);
    border-color: var(--border-color);
  }

  :global(html[data-theme="dark"]) .bible-chapter-hero-card span,
  :global(html[data-theme="dark"]) .bible-chapter-meta-card span,
  :global(html[data-theme="dark"]) .bible-chapter-nav-card span,
  :global(html[data-theme="dark"]) .verse-number,
  :global(html[data-theme="dark"]) .verse-ref-link {
    color: var(--accent);
  }

  :global(html[data-theme="dark"]) .bible-chapter-hero-card strong,
  :global(html[data-theme="dark"]) .bible-chapter-meta-card strong,
  :global(html[data-theme="dark"]) .bible-chapter-empty-card strong,
  :global(html[data-theme="dark"]) .bible-chapter-nav-card strong {
    color: var(--heading-color);
  }

  :global(html[data-theme="dark"]) .bible-chapter-hero-card p,
  :global(html[data-theme="dark"]) .bible-chapter-empty-card p,
  :global(html[data-theme="dark"]) .verse-text {
    color: var(--text-muted);
  }

  :global(html[data-theme="dark"]) .bible-chapter-verse {
    border-color: var(--border-color);
  }

  :global(html[data-theme="dark"]) .bible-chapter-nav-card.center {
    background: var(--accent);
    border-color: var(--accent);
  }

  :global(html[data-theme="dark"]) .bible-chapter-nav-card.center span,
  :global(html[data-theme="dark"]) .bible-chapter-nav-card.center strong {
    color: var(--accent-contrast);
  }

  :global(html[data-theme="dark"]) .bible-chapter-nav-card.disabled {
    background: var(--surface-muted);
    border-color: var(--border-color);
  }

  :global(html[data-theme="dark"]) .bible-chapter-nav-card.disabled span,
  :global(html[data-theme="dark"]) .bible-chapter-nav-card.disabled strong {
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .bible-chapter-hero {
      grid-template-columns: 1fr;
    }

    .bible-chapter-meta-grid,
    .bible-chapter-nav {
      grid-template-columns: 1fr;
    }

    .bible-chapter-nav-card,
    .bible-chapter-nav-card.next,
    .bible-chapter-nav-card.center {
      text-align: left;
    }
  }

  @media (max-width: 640px) {
    .bible-chapter-reader-card,
    .bible-chapter-empty-card {
      padding: 18px;
    }

    .bible-chapter-nav-card {
      min-height: auto;
    }
  }
</style>
<style>
  .bible-version-toolbar {
    display: flex;
    justify-content: flex-end;
    min-height: 1px;
    margin-bottom: 10px;
  }
</style>
