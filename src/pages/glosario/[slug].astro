---
import { sitePath } from "../../lib/site-paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import {
  getAllGlossaryTerms,
  type GlossaryTerm,
} from "../../lib/queries";

type Props = { term: GlossaryTerm };

export function getStaticPaths() {
  return getAllGlossaryTerms()
    .filter((term) => term.status !== "Borrador")
    .map((term) => ({ params: { slug: term.slug }, props: { term } }));
}

const { term } = Astro.props as Props;
const definition = term.definition ?? "Definición pendiente.";
const searchUrl = `${sitePath("/buscar/")}?q=${encodeURIComponent(term.term)}`;
---

<BaseLayout title={term.term} description={definition}>
  <main class="page glossary-detail-page" data-detail-root data-detail-kind="glossary">
    <div class="breadcrumb">
      <a href={sitePath("/")}>Inicio</a> →
      <a href={sitePath("/glosario/")}>Glosario</a> →
      {term.term}
    </div>

    <section class="hero glossary-detail-hero">
      <div class="glossary-detail-content">
        <p class="eyebrow">Término bíblico</p>
        <h1>{term.term}</h1>
        <p class="subtitle">{definition}</p>
        <div class="actions">
          <a href={sitePath("/glosario/")} class="button secondary">Todos los términos</a>
          <a href={searchUrl} class="button">Buscar conexiones</a>
        </div>
      </div>

      <aside class="glossary-detail-card" aria-label="Estado del término">
        <span class="glossary-detail-icon"><Icon name="book" size={20} /></span>
        <small>Estado editorial</small>
        <strong>{term.status}</strong>
        <p>Busca este término en toda la red de Bibli para encontrar pasajes, lecciones, rutas y otras conexiones.</p>
      </aside>
    </section>

    <section class="section glossary-definition-section">
      <div class="section-header">
        <div>
          <p class="eyebrow">Definición</p>
          <h2>Qué significa {term.term}</h2>
        </div>
      </div>
      <article class="glossary-definition-card">
        <p>{definition}</p>
      </article>
    </section>

    <section class="section glossary-detail-footer">
      <div class="actions">
        <a href={sitePath("/glosario/")} class="button secondary">Volver al glosario</a>
        <a href={sitePath("/explorar/")} class="button secondary">Explorar Bibli</a>
        <a href={searchUrl} class="button">Buscar “{term.term}”</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .glossary-detail-hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(230px,320px); gap:32px; align-items:end; }
  .glossary-detail-card { display:grid; gap:9px; padding:24px; border:1px solid var(--border-color); border-radius:24px; background:var(--surface); box-shadow:0 18px 42px rgba(15,23,42,.08); }
  .glossary-detail-icon { width:42px; height:42px; display:grid; place-items:center; border-radius:13px; background:var(--accent-soft); color:var(--accent); }
  .glossary-detail-card small { color:var(--accent); font-size:.72rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
  .glossary-detail-card strong { color:var(--heading-color); font-size:1.4rem; }
  .glossary-detail-card p { margin:0; color:var(--text-muted); line-height:1.6; }
  .glossary-definition-card { padding:28px; border:1px solid var(--border-color); border-radius:22px; background:var(--surface-soft); }
  .glossary-definition-card p { max-width:900px; margin:0; color:var(--text-color); font-size:1.12rem; line-height:1.85; }
  :global(html[data-theme="dark"]) .glossary-detail-card,:global(html[data-theme="dark"]) .glossary-definition-card { background:var(--surface-soft); border-color:var(--border-color); }
  @media(max-width:820px){ .glossary-detail-hero{grid-template-columns:1fr} }
</style>
