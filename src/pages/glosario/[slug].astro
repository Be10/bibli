---
import { sitePath } from "../../lib/site-paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { bibliImgMediaUrl, getIntegratedGlossaryEntry } from "../../lib/bibli-images";
import {
  getAllGlossaryTerms,
  getLessonsByGlossaryId,
  type GlossaryTerm,
  type Lesson,
} from "../../lib/queries";

type Props = { term: GlossaryTerm; lessons: Lesson[] };

export function getStaticPaths() {
  return getAllGlossaryTerms()
    .filter((term) => term.status !== "Borrador")
    .map((term) => ({
      params: { slug: term.slug },
      props: { term, lessons: getLessonsByGlossaryId(term.id) },
    }));
}

const { term, lessons } = Astro.props as Props;
const editorialEntry = getIntegratedGlossaryEntry(term.slug);
const localizedEditorial = editorialEntry?.locales["es-419"];
const definition = localizedEditorial?.definition ?? term.definition ?? "Definición pendiente.";
const heroSummary = term.definition ?? localizedEditorial?.definition ?? "Definición pendiente.";
const primaryReferences = editorialEntry?.biblicalReferences.primary["es-419"] ?? [];
const additionalReferences = editorialEntry?.biblicalReferences.additional["es-419"] ?? [];
const searchUrl = `${sitePath("/buscar/")}?q=${encodeURIComponent(term.term)}`;
---

<BaseLayout title={term.term} description={heroSummary}>
  <main class="page glossary-detail-page" data-detail-root data-detail-kind="glossary">
    <div class="breadcrumb">
      <a href={sitePath("/")}>Inicio</a> →
      <a href={sitePath("/glosario/")}>Glosario</a> →
      {term.term}
    </div>

    <section class:list={["hero", "glossary-detail-hero", { "has-editorial-media": Boolean(editorialEntry) }]}>
      <div class="glossary-detail-content">
        <p class="eyebrow">Término bíblico</p>
        <h1>{term.term}</h1>
        <p class="subtitle">{heroSummary}</p>
        <div class="actions">
          <a href={sitePath("/glosario/")} class="button secondary">Todos los términos</a>
          {lessons[0] && (
            <a href="#lecciones-relacionadas" class="button">Ver lecciones relacionadas</a>
          )}
          <a href={searchUrl} class="button secondary">Buscar conexiones</a>
        </div>
      </div>

      {editorialEntry && localizedEditorial && (
        <figure
          class="glossary-editorial-figure"
          data-bibli-img-entry={editorialEntry.entityKey}
          data-bibli-img-version={editorialEntry.visual.version}
          data-bibli-img-status={editorialEntry.sourceStatus}
          data-bibli-img-certainty={editorialEntry.historical.certainty}
        >
          <img
            src={bibliImgMediaUrl(editorialEntry.visual.optimizedPath)}
            srcset={`${bibliImgMediaUrl(editorialEntry.visual.optimizedPath)} ${editorialEntry.visual.optimizedWidth}w, ${bibliImgMediaUrl(editorialEntry.visual.highPath)} ${editorialEntry.visual.highWidth}w`}
            sizes="(max-width: 820px) 72vw, 280px"
            width={editorialEntry.visual.optimizedWidth}
            height={editorialEntry.visual.optimizedHeight}
            alt={localizedEditorial.alt_text}
            loading="eager"
            decoding="async"
          />
          <figcaption>
            Ilustración editorial · {editorialEntry.historical.certainty === "plausible_reconstruction" ? "reconstrucción histórica plausible; no pretende reproducir el rostro real" : editorialEntry.historical.certainty}
          </figcaption>
        </figure>
      )}

      <aside class="glossary-detail-card" aria-label="Estado del término">
        <span class="glossary-detail-icon"><Icon name="book" size={20} /></span>
        <small>Estado editorial</small>
        <strong>{term.status}</strong>
        <p>Esta ficha muestra únicamente conexiones editoriales registradas explícitamente en Bibli.</p>
        <div class="glossary-detail-count">
          <span>Lecciones relacionadas</span>
          <strong>{lessons.length}</strong>
        </div>
        {editorialEntry && (
          <div class="glossary-detail-count">
            <span>Paquete visual</span>
            <strong>v{String(editorialEntry.visual.version).padStart(3, "0")}</strong>
          </div>
        )}
      </aside>
    </section>

    <section class="section glossary-definition-section">
      <div class="section-header">
        <div>
          <p class="eyebrow">Definición</p>
          <h2>Qué significa {term.term}</h2>
        </div>
      </div>
      <article class="glossary-definition-card">
        <p>{definition}</p>
      </article>
    </section>

    {editorialEntry && localizedEditorial && (
      <section
        class="section glossary-editorial-section"
        data-bibli-img-content={editorialEntry.entityKey}
        data-bibli-img-source-path={editorialEntry.sourcePath}
      >
        <div class="section-header">
          <div>
            <p class="eyebrow">Contexto editorial verificado</p>
            <h2>Contexto de {localizedEditorial.display_name}</h2>
          </div>
        </div>

        <div class="glossary-editorial-grid">
          {localizedEditorial.historical_context && (
            <article class="glossary-editorial-card">
              <h3>Contexto histórico y sociocultural</h3>
              <p>{localizedEditorial.historical_context}</p>
              {(editorialEntry.historical.period || editorialEntry.historical.region) && (
                <dl class="glossary-editorial-meta">
                  {editorialEntry.historical.period && (
                    <>
                      <dt>Periodo</dt>
                      <dd>{editorialEntry.historical.period}</dd>
                    </>
                  )}
                  {editorialEntry.historical.region && (
                    <>
                      <dt>Región</dt>
                      <dd>{editorialEntry.historical.region}</dd>
                    </>
                  )}
                </dl>
              )}
            </article>
          )}

          {localizedEditorial.original_language_note && (
            <article class="glossary-editorial-card">
              <h3>Nombre original y significado</h3>
              <p>{localizedEditorial.original_language_note}</p>
              {editorialEntry.originalTerms.length > 0 && (
                <ul class="glossary-original-terms">
                  {editorialEntry.originalTerms.map((originalTerm) => (
                    <li>
                      {originalTerm.script && <span class="original-script">{originalTerm.script}</span>}
                      {originalTerm.transliteration && <strong>{originalTerm.transliteration}</strong>}
                    </li>
                  ))}
                </ul>
              )}
            </article>
          )}
        </div>

        {primaryReferences.length > 0 && (
          <article class="glossary-references-card">
            <div>
              <p class="eyebrow">Base bíblica</p>
              <h3>Referencias principales</h3>
            </div>
            <ul>
              {primaryReferences.map((reference) => <li>{reference}</li>)}
            </ul>
            {additionalReferences.length > 0 && (
              <details>
                <summary>Ver {additionalReferences.length} referencias adicionales</summary>
                <ul>
                  {additionalReferences.map((reference) => <li>{reference}</li>)}
                </ul>
              </details>
            )}
          </article>
        )}
      </section>
    )}

    <section class="section glossary-lessons-section" id="lecciones-relacionadas" data-explicit-connections="lesson-glossary">
      <div class="section-header">
        <div>
          <p class="eyebrow">Conexión editorial explícita</p>
          <h2>Lecciones relacionadas</h2>
        </div>
        <span class="glossary-relation-count">
          {lessons.length} {lessons.length === 1 ? "lección" : "lecciones"}
        </span>
      </div>

      {lessons.length > 0 ? (
        <div class="glossary-lessons-grid">
          {lessons.map((lesson) => (
            <a
              href={sitePath(`/lecciones/${lesson.slug}/`)}
              class="glossary-lesson-card"
              data-explicit-connection="lesson-glossary"
            >
              <span>Lección {lesson.lesson_number}</span>
              <strong>{lesson.title}</strong>
              <small>{lesson.main_idea ?? lesson.summary ?? "Resumen pendiente."}</small>
            </a>
          ))}
        </div>
      ) : (
        <div class="content">
          <p>Todavía no hay lecciones relacionadas registradas explícitamente para este término.</p>
        </div>
      )}
    </section>

    <section class="section glossary-detail-footer">
      <div class="actions">
        <a href={sitePath("/glosario/")} class="button secondary">Volver al glosario</a>
        <a href={sitePath("/explorar/")} class="button secondary">Explorar Bibli</a>
        <a href={searchUrl} class="button">Buscar “{term.term}”</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .glossary-detail-hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(230px,320px); gap:32px; align-items:end; }
  .glossary-detail-hero.has-editorial-media { grid-template-columns:minmax(0,1fr) minmax(220px,280px) minmax(220px,290px); align-items:center; }
  .glossary-editorial-figure { display:grid; gap:10px; margin:0; min-width:0; align-self:stretch; padding:16px; border:1px solid var(--border-color); border-radius:24px; background:var(--surface-soft); box-shadow:var(--shadow-sm); }
  .glossary-editorial-figure img { display:block; width:100%; height:min(390px,52vh); object-fit:contain; object-position:center bottom; }
  .glossary-editorial-figure figcaption { color:var(--text-muted); font-size:.76rem; line-height:1.45; text-align:center; }
  .glossary-detail-card { display:grid; gap:9px; padding:24px; border:1px solid var(--border-color); border-radius:24px; background:var(--surface); box-shadow:0 18px 42px rgba(15,23,42,.08); }
  .glossary-detail-icon { width:42px; height:42px; display:grid; place-items:center; border-radius:13px; background:var(--accent-soft); color:var(--accent); }
  .glossary-detail-card small { color:var(--accent); font-size:.72rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
  .glossary-detail-card strong { color:var(--heading-color); font-size:1.4rem; }
  .glossary-detail-card p { margin:0; color:var(--text-muted); line-height:1.6; }
  .glossary-detail-count { display:flex; align-items:center; justify-content:space-between; gap:12px; padding-top:12px; margin-top:4px; border-top:1px solid var(--border-color); }
  .glossary-detail-count span { color:var(--text-muted); font-size:.82rem; }
  .glossary-detail-count strong { font-size:1.15rem; }
  .glossary-relation-count { color:var(--text-muted); font-size:.85rem; font-weight:750; }
  .glossary-lessons-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
  .glossary-lesson-card { display:grid; gap:7px; min-width:0; padding:18px; border:1px solid var(--border-color); border-radius:18px; background:var(--surface); color:inherit; text-decoration:none; box-shadow:var(--shadow-sm); }
  .glossary-lesson-card:hover { border-color:color-mix(in srgb,var(--accent) 42%,var(--border-color)); background:var(--accent-soft); }
  .glossary-lesson-card span { color:var(--accent); font-size:.72rem; font-weight:850; letter-spacing:.06em; text-transform:uppercase; }
  .glossary-lesson-card strong { color:var(--heading-color); line-height:1.3; }
  .glossary-lesson-card small { color:var(--text-muted); line-height:1.55; }
  .glossary-definition-card { padding:28px; border:1px solid var(--border-color); border-radius:22px; background:var(--surface-soft); }
  .glossary-definition-card p { max-width:1000px; margin:0; color:var(--text-color); font-size:1.08rem; line-height:1.82; }
  .glossary-editorial-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
  .glossary-editorial-card,.glossary-references-card { padding:24px; border:1px solid var(--border-color); border-radius:22px; background:var(--surface); box-shadow:var(--shadow-sm); }
  .glossary-editorial-card { display:grid; align-content:start; gap:12px; }
  .glossary-editorial-card h3,.glossary-references-card h3 { margin:0; color:var(--heading-color); font-size:1.08rem; }
  .glossary-editorial-card p { margin:0; color:var(--text-color); line-height:1.75; }
  .glossary-editorial-meta { display:grid; grid-template-columns:auto minmax(0,1fr); gap:6px 12px; margin:4px 0 0; padding-top:14px; border-top:1px solid var(--border-color); }
  .glossary-editorial-meta dt { color:var(--text-muted); font-size:.76rem; font-weight:800; text-transform:uppercase; letter-spacing:.05em; }
  .glossary-editorial-meta dd { margin:0; color:var(--text-color); font-size:.86rem; }
  .glossary-original-terms { display:flex; flex-wrap:wrap; gap:8px; margin:2px 0 0; padding:0; list-style:none; }
  .glossary-original-terms li { display:flex; gap:8px; align-items:center; padding:8px 10px; border:1px solid var(--border-color); border-radius:12px; background:var(--surface-soft); }
  .original-script { font-size:1.1rem; }
  .glossary-original-terms strong { font-size:.82rem; color:var(--heading-color); }
  .glossary-references-card { display:grid; gap:14px; margin-top:16px; }
  .glossary-references-card ul { display:grid; gap:6px; margin:0; padding-left:20px; color:var(--text-color); }
  .glossary-references-card details { padding-top:12px; border-top:1px solid var(--border-color); }
  .glossary-references-card summary { cursor:pointer; color:var(--accent); font-weight:800; }
  :global(html[data-theme="dark"]) .glossary-detail-card,:global(html[data-theme="dark"]) .glossary-definition-card,:global(html[data-theme="dark"]) .glossary-editorial-figure,:global(html[data-theme="dark"]) .glossary-editorial-card,:global(html[data-theme="dark"]) .glossary-references-card { background:var(--surface-soft); border-color:var(--border-color); }
  @media(max-width:1100px){ .glossary-detail-hero.has-editorial-media{grid-template-columns:minmax(0,1fr) minmax(220px,280px)} .glossary-detail-hero.has-editorial-media .glossary-detail-card{grid-column:1/-1} }
  @media(max-width:820px){ .glossary-detail-hero,.glossary-detail-hero.has-editorial-media{grid-template-columns:1fr} .glossary-detail-hero.has-editorial-media .glossary-detail-card{grid-column:auto} .glossary-editorial-figure{max-width:360px;width:100%;justify-self:center} .glossary-lessons-grid,.glossary-editorial-grid{grid-template-columns:1fr} }
</style>
