---
import { sitePath } from "../../lib/site-paths";
import { glossaryCanonicalPath } from "../../lib/glossary-routes";
import { getAllGlossaryTerms } from "../../lib/queries";

type Props = {
  target: string;
};

export function getStaticPaths() {
  return getAllGlossaryTerms()
    .filter(
      (term) =>
        term.status !== "Borrador"
    )
    .map((term) => ({
      params: {
        slug: term.slug,
      },
      props: {
        target: sitePath(
          glossaryCanonicalPath(
            term.slug
          )
        ),
      },
    }));
}

const { target } =
  Astro.props as Props;

return Astro.redirect(target);
---
