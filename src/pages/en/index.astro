---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import HomeStudyVisual from "../../components/HomeStudyVisual.astro";
import { sitePath } from "../../lib/site-paths";
import { getAllBooksByLanguage, getBibleVersionsByLanguage } from "../../lib/queries";

const versions = getBibleVersionsByLanguage("en");
const books = getAllBooksByLanguage("en").filter((book) => book.status !== "Borrador");
---

<BaseLayout
  title="Biblical Library"
  lang="en"
  alternateLanguage={{ code: "es", label: "Español", href: sitePath("/") }}
>
  <main class="en-home-page" data-home-root>
    <section class="en-home-hero">
      <div class="en-home-copy">
        <span class="en-home-kicker"><Icon name="library" size={15} /> Biblical Library</span>
        <h1>Study Scripture with clarity</h1>
        <p>Read and search the Bible in one place.</p>

        <div class="en-home-actions">
          <a href={sitePath("/en/bible/")} class="en-home-button primary"><Icon name="bible" size={18} /><span>Read the Bible</span><Icon name="arrow-right" size={16} /></a>
          <a href={sitePath("/en/search/")} class="en-home-button secondary"><Icon name="search" size={18} /><span>Search Scripture</span></a>
        </div>
      </div>

      <HomeStudyVisual lang="en" />
    </section>

    <section class="en-home-stats" aria-label="English Bible content">
      <article><span><Icon name="book" size={18} /></span><strong>{books.length}</strong><small>books</small></article>
      <article><span><Icon name="bible" size={18} /></span><strong>{versions.length}</strong><small>{versions.length === 1 ? "Bible version" : "Bible versions"}</small></article>
    </section>

    <section class="en-home-grid" aria-label="English areas">
      <a href={sitePath("/en/bible/")} class="en-home-card">
        <span class="en-home-card-icon"><Icon name="bible" size={21} /></span>
        <div><h2>Bible</h2><p>Choose an English Bible version, book and chapter, then read with chapter navigation and reading preferences.</p></div>
        <Icon name="chevron-right" size={18} />
      </a>
      <a href={sitePath("/en/search/")} class="en-home-card">
        <span class="en-home-card-icon"><Icon name="search" size={21} /></span>
        <div><h2>Search</h2><p>Search English books and Bible verses without mixing in untranslated Spanish editorial content.</p></div>
        <Icon name="chevron-right" size={18} />
      </a>
    </section>

    <aside class="en-home-note">
      <Icon name="info" size={18} />
      <p><strong>English availability:</strong> this section currently focuses on Bible reading and Scripture search. Study routes and other editorial resources remain in Spanish until they are translated.</p>
    </aside>
  </main>
</BaseLayout>

<style>
  .en-home-page{width:min(var(--content-max),calc(100% - 32px));margin:0 auto;padding:18px 0 72px}
  .en-home-hero{position:relative;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(340px,.72fr);gap:clamp(1.5rem,3.2vw,3.25rem);align-items:center;min-height:360px;padding:clamp(1.7rem,4vw,3.1rem);border:1px solid var(--border-color);border-radius:22px;overflow:hidden;background:linear-gradient(135deg,var(--surface) 0%,color-mix(in srgb,var(--accent-soft) 34%,var(--surface)) 100%);box-shadow:var(--shadow-sm)}
  .en-home-copy{position:relative;z-index:1;max-width:720px}.en-home-kicker{display:inline-flex;align-items:center;gap:.45rem;color:var(--accent);font-size:.76rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .en-home-copy h1{max-width:760px;margin:.75rem 0 1rem;color:var(--heading-color);font-size:clamp(2.55rem,5vw,4.3rem);line-height:.98;letter-spacing:-.06em;text-wrap:balance}.en-home-copy>p{max-width:650px;margin:0;color:var(--text-muted);font-size:clamp(1rem,1.8vw,1.16rem);line-height:1.7}
  .en-home-actions{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.3rem}.en-home-button{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:.55rem;padding:0 1rem;border-radius:12px;text-decoration:none;font-weight:750}.en-home-button.primary{background:var(--accent);color:var(--accent-contrast);box-shadow:0 10px 24px color-mix(in srgb,var(--accent) 20%,transparent)}.en-home-button.secondary{border:1px solid var(--border-color);background:var(--surface);color:var(--heading-color)}
  .en-home-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin-top:1rem}.en-home-stats article{display:flex;align-items:center;gap:.65rem;min-height:70px;padding:.85rem 1rem;border:1px solid var(--border-color);border-radius:16px;background:var(--surface)}.en-home-stats article>span{width:38px;height:38px;display:grid;place-items:center;border-radius:11px;background:var(--accent-soft);color:var(--accent)}.en-home-stats strong{color:var(--heading-color);font-size:1.35rem}.en-home-stats small{color:var(--text-muted);font-size:.88rem}
  .en-home-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1rem}.en-home-card{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:.9rem;padding:1.15rem;border:1px solid var(--border-color);border-radius:16px;background:var(--surface);color:var(--text-color);text-decoration:none;box-shadow:0 8px 24px rgba(15,23,42,.025)}.en-home-card:hover{border-color:var(--accent-border);background:color-mix(in srgb,var(--accent-soft) 18%,var(--surface))}.en-home-card-icon{width:44px;height:44px;display:grid;place-items:center;border-radius:12px;background:var(--accent-soft);color:var(--accent)}.en-home-card h2{margin:0;color:var(--heading-color);font-size:1rem}.en-home-card p{margin:.3rem 0 0;color:var(--text-muted);font-size:.82rem;line-height:1.55}
  .en-home-note{display:flex;align-items:flex-start;gap:.65rem;margin-top:1rem;padding:1rem 1.1rem;border:1px solid var(--border-color);border-radius:16px;background:var(--surface-soft);color:var(--text-muted)}.en-home-note>.bibli-icon{flex:0 0 auto;color:var(--accent);margin-top:.12rem}.en-home-note p{margin:0;font-size:.84rem;line-height:1.6}.en-home-note strong{color:var(--heading-color)}
  @media(max-width:800px){.en-home-hero{grid-template-columns:1fr;min-height:0}.en-home-copy h1{font-size:clamp(2.35rem,12vw,3.5rem)}.en-home-grid{grid-template-columns:1fr}}
  @media(max-width:560px){.en-home-page{width:min(100% - 20px,var(--content-max));padding-top:10px}.en-home-hero{padding:1.25rem;border-radius:18px}.en-home-actions{display:grid}.en-home-button{width:100%}.en-home-stats{grid-template-columns:1fr}}
</style>
