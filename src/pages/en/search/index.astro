---
import { sitePath } from "../../../lib/site-paths";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildSearchIndex } from "../../../lib/search-index";

const searchItems = buildSearchIndex("en");
const searchDataUrl = sitePath("/en/search/data.json");
---

<BaseLayout
  lang="en"
  title="Advanced search"
  description="Search English Bible books and KJV verses in Bibli."
  alternateLanguage={{
    code: "es",
    label: "Spanish",
    href: sitePath("/buscar/"),
  }}
>
  <main class="page advanced-search-page" data-utility-root data-utility-kind="search">
    <div class="breadcrumb">
      <a href={sitePath("/en/bible/")}>Bible</a> → Advanced search
    </div>

    <section class="hero advanced-search-hero">
      <div>
        <p class="eyebrow">Advanced search</p>
        <h1>Search the English Bible</h1>
        <p class="subtitle">
          Search KJV verses and localized English book names without falling back
          to untranslated Spanish editorial content.
        </p>
        <div class="actions">
          <a href={sitePath("/en/bible/")} class="button">Read the Bible</a>
          <a href={sitePath("/buscar/")} class="button secondary">Search in Spanish</a>
        </div>
      </div>

      <aside class="search-summary-card advanced-search-hero-card" aria-label="Search index summary">
        <span>Local index</span>
        <strong>{searchItems.length}</strong>
        <p>English Bible entries</p>
      </aside>
    </section>

    <section class="section" id="advanced-search" data-search-page data-search-url={searchDataUrl}>
      <label class="search-label" for="search-input">
        Enter a word, phrase, book, or Bible reference
      </label>

      <div class="search-control">
        <input
          id="search-input"
          class="search-input"
          type="search"
          placeholder="Try: John 3:16, grace, Genesis, in the beginning..."
          autocomplete="off"
          autocapitalize="none"
          spellcheck="false"
          enterkeyhint="search"
          aria-controls="search-results"
        />
        <button type="button" class="search-clear" data-search-clear hidden>Clear</button>
      </div>
      <p class="search-help">Use ↑ and ↓ to move through results. Press Esc to clear the query.</p>

      <div id="search-empty" class="search-state" hidden></div>
      <div id="search-filters" class="search-filters" hidden></div>
      <div id="search-results-summary" class="search-results-summary" role="status" aria-live="polite" aria-atomic="true" hidden></div>
      <div id="search-results" class="search-results"></div>

    </section>
  </main>
</BaseLayout>

<script>
  import {
    SEARCH_FILTER_ORDER,
    decodeSearchIndexPayload,
    getAvailableSearchFilters,
    getDisplaySearchResults,
    getSearchCounts,
    getSearchResults,
    normalizeSearchText,
  } from "../../../lib/search-engine";

  const ALL_TYPE = "Todos";
  const searchRoot = document.querySelector("[data-search-page]");
  const input = document.getElementById("search-input");
  const resultsElement = document.getElementById("search-results");
  const emptyElement = document.getElementById("search-empty");
  const resultsSummaryElement = document.getElementById("search-results-summary");
  const filtersElement = document.getElementById("search-filters");
  const clearButton = document.querySelector("[data-search-clear]");

  let items = null;
  let searchLoadPromise = null;
  let searchLoadFailed = false;
  let searchRenderGeneration = 0;

  async function loadSearchItems() {
    if (items) return items;
    if (searchLoadPromise) return searchLoadPromise;

    const searchUrl = searchRoot?.getAttribute("data-search-url");
    if (!searchUrl) {
      searchLoadFailed = true;
      return [];
    }

    searchLoadPromise = (async () => {
      try {
        const response = await fetch(searchUrl);
        if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
        const payload = await response.json();
        items = decodeSearchIndexPayload(payload);
        searchLoadFailed = false;
        return items;
      } catch {
        searchLoadFailed = true;
        items = null;
        return [];
      } finally {
        searchLoadPromise = null;
      }
    })();

    return searchLoadPromise;
  }

  const initialParams = new URLSearchParams(window.location.search);
  const initialQuery = initialParams.get("q") ?? "";
  let activeSearchType = ALL_TYPE;
  let currentResults = [];
  let searchDebounceTimer;

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function escapeRegExp(value) {
    return String(value).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  function getHighlightWords(query) {
    return Array.from(
      new Set(
        normalizeSearchText(query)
          .split(/\s+/)
          .filter((word) => word.length >= 3)
      )
    );
  }

  function highlightMatches(value, query) {
    const safeValue = escapeHtml(value);
    const words = getHighlightWords(query);
    if (words.length === 0) return safeValue;
    const pattern = new RegExp(`(${words.map(escapeRegExp).join("|")})`, "gi");
    return safeValue.replace(pattern, "<mark>$1</mark>");
  }

  function updateUrl(value) {
    const url = new URL(window.location.href);

    if (normalizeSearchText(value)) {
      url.searchParams.set("q", value);
    } else {
      url.searchParams.delete("q");
    }

    window.history.replaceState({}, "", url);
  }

  function getTypeLabel(type) {
    return items?.find((item) => item.type === type)?.typeLabel ?? type;
  }

  function renderFilters(results) {
    if (!filtersElement) return;

    const counts = getSearchCounts(results);

    if (
      activeSearchType !== ALL_TYPE &&
      !SEARCH_FILTER_ORDER.includes(activeSearchType)
    ) {
      activeSearchType = ALL_TYPE;
    }

    if (activeSearchType !== ALL_TYPE && !counts[activeSearchType]) {
      activeSearchType = ALL_TYPE;
    }

    const filters = getAvailableSearchFilters(results);
    filtersElement.hidden = false;
    filtersElement.innerHTML = [
      `<button type="button" data-search-filter="${ALL_TYPE}" aria-pressed="${activeSearchType === ALL_TYPE}">All <span>${results.length}</span></button>`,
      ...filters.map(
        ({ type, count }) =>
          `<button type="button" data-search-filter="${escapeHtml(type)}" aria-pressed="${activeSearchType === type}">${escapeHtml(getTypeLabel(type))} <span>${count}</span></button>`
      ),
    ].join("");

    filtersElement.querySelectorAll("[data-search-filter]").forEach((button) => {
      const isActive = button.getAttribute("data-search-filter") === activeSearchType;
      button.classList.toggle("is-active", isActive);
      button.setAttribute("aria-pressed", String(isActive));

      button.addEventListener("click", () => {
        activeSearchType =
          button.getAttribute("data-search-filter") ?? ALL_TYPE;
        renderFilteredResults();
      });
    });
  }

  function renderResultCard(item) {
    const query = input?.value ?? "";
    return `
      <a href="${escapeHtml(item.url)}" class="search-result">
        <span class="search-result-type">${escapeHtml(item.typeLabel ?? item.type)}</span>
        <strong>${highlightMatches(item.title, query)}</strong>
        <p>${highlightMatches(item.summary, query)}</p>
      </a>
    `;
  }

  function renderFilteredResults() {
    if (!resultsElement || !resultsSummaryElement || !filtersElement) return;

    renderFilters(currentResults);
    const filteredResults = getDisplaySearchResults(
      currentResults,
      activeSearchType,
      120
    );
    const query = input?.value ?? "";

    resultsSummaryElement.hidden = false;
    resultsSummaryElement.textContent =
      activeSearchType === ALL_TYPE
        ? `${currentResults.length} result${currentResults.length === 1 ? "" : "s"} for “${query}”`
        : `${filteredResults.length} result${filteredResults.length === 1 ? "" : "s"} in ${getTypeLabel(activeSearchType)} for “${query}”`;

    resultsElement.innerHTML = filteredResults.map(renderResultCard).join("");
  }

  async function renderResults(query) {
    const renderGeneration = ++searchRenderGeneration;
    if (!resultsElement || !emptyElement || !resultsSummaryElement || !filtersElement) {
      return;
    }

    if (!normalizeSearchText(query)) {
      currentResults = [];
      activeSearchType = ALL_TYPE;
      resultsElement.innerHTML = "";
      filtersElement.innerHTML = "";
      filtersElement.hidden = true;
      resultsSummaryElement.hidden = true;
      emptyElement.hidden = true;
      return;
    }

    resultsSummaryElement.hidden = false;
    resultsSummaryElement.textContent = "Loading search index…";
    const loadedItems = await loadSearchItems();

    if (renderGeneration !== searchRenderGeneration) return;

    if (searchLoadFailed) {
      currentResults = [];
      resultsElement.innerHTML = "";
      filtersElement.innerHTML = "";
      filtersElement.hidden = true;
      resultsSummaryElement.hidden = true;
      emptyElement.hidden = false;
      emptyElement.textContent = "The search index could not be loaded. Please try again.";
      return;
    }

    currentResults = getSearchResults(loadedItems, query);

    if (currentResults.length === 0) {
      resultsElement.innerHTML = "";
      filtersElement.innerHTML = "";
      filtersElement.hidden = true;
      resultsSummaryElement.hidden = true;
      emptyElement.hidden = false;
      emptyElement.textContent = "No results found for that search.";
      return;
    }

    emptyElement.hidden = true;
    renderFilteredResults();
  }


  function syncClearButton(value) {
    if (clearButton instanceof HTMLButtonElement) {
      clearButton.hidden = !normalizeSearchText(value);
    }
  }

  function clearSearch() {
    if (!(input instanceof HTMLInputElement)) return;
    input.value = "";
    activeSearchType = ALL_TYPE;
    updateUrl("");
    void renderResults("");
    syncClearButton("");
    input.focus();
  }

  function getResultLinks() {
    return resultsElement
      ? [...resultsElement.querySelectorAll<HTMLAnchorElement>("a.search-result")]
      : [];
  }

  input?.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && input instanceof HTMLInputElement && input.value) {
      event.preventDefault();
      clearSearch();
      return;
    }
    if (event.key !== "ArrowDown") return;
    const links = getResultLinks();
    if (links.length === 0) return;
    event.preventDefault();
    links[0]?.focus();
  });

  resultsElement?.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
    const links = getResultLinks();
    const active = document.activeElement;
    const currentIndex = links.indexOf(active as HTMLAnchorElement);
    if (currentIndex === -1) return;

    event.preventDefault();
    if (event.key === "ArrowDown") {
      links[Math.min(currentIndex + 1, links.length - 1)]?.focus();
    } else if (currentIndex === 0) {
      input?.focus();
    } else {
      links[currentIndex - 1]?.focus();
    }
  });

  input?.addEventListener("input", (event) => {
    const value = event.target.value;
    activeSearchType = ALL_TYPE;
    updateUrl(value);
    syncClearButton(value);
    window.clearTimeout(searchDebounceTimer);
    searchDebounceTimer = window.setTimeout(() => void renderResults(value), 120);
  });

  clearButton?.addEventListener("click", clearSearch);

  if (input instanceof HTMLInputElement && initialQuery) {
    input.value = initialQuery;
    syncClearButton(initialQuery);
    void renderResults(initialQuery);
  } else {
    syncClearButton("");
  }
</script>

<style>
  .advanced-search-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
    gap: 28px;
    align-items: end;
  }

  .search-summary-card {
    display: grid;
    gap: 8px;
    padding: 24px;
    border: 1px solid var(--border-color);
    border-radius: 22px;
    background: var(--surface);
  }

  .search-summary-card span,
  .search-result span {
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .search-summary-card strong {
    font-size: 2rem;
  }

  .search-summary-card p,
  .search-result p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .search-label {
    display: block;
    margin-bottom: 10px;
    font-weight: 850;
  }

  .search-input {
    width: 100%;
    box-sizing: border-box;
    min-height: 50px;
    padding: 0 16px;
    border: 1px solid var(--accent-border);
    border-radius: 16px;
    background: var(--surface-soft);
    color: var(--text-color);
    font: inherit;
    font-size: 1rem;
  }

  :global(.search-filters) {
    display: flex;
    gap: 8px;
    margin-top: 18px;
    overflow-x: auto;
  }

  :global(.search-filters[hidden]) {
    display: none;
  }

  :global(.search-filters button) {
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--surface-soft);
    color: var(--accent);
    font: inherit;
    font-weight: 850;
    cursor: pointer;
  }

  :global(.search-filters button.is-active) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  .search-results-summary,
  .search-state {
    margin-top: 18px;
    color: var(--text-muted);
  }

  .search-results {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }

  :global(.search-result) {
    display: grid;
    gap: 6px;
    padding: 16px;
    border: 1px solid var(--border-color);
    border-radius: 18px;
    background: var(--surface-soft);
    text-decoration: none;
  }

  :global(.search-result strong) {
    color: var(--text-color);
  }

  :global(html[data-theme="dark"] .search-summary-card),
  :global(html[data-theme="dark"] .search-input),
  :global(html[data-theme="dark"] .search-result),
  :global(html[data-theme="dark"] .search-filters button) {
    background: var(--surface);
    border-color: var(--border-strong);
    color: var(--heading-color);
  }

  :global(html[data-theme="dark"] .search-result strong) {
    color: var(--heading-color);
  }

  :global(html[data-theme="dark"] .search-result p),
  :global(html[data-theme="dark"] .search-results-summary),
  :global(html[data-theme="dark"] .search-state) {
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .advanced-search-hero {
      grid-template-columns: 1fr;
    }

    :global(.search-filters button) {
      min-height: 44px;
    }
  }
</style>

<style is:global>
  /* BIBLI_UI_AUDIT_2026_10: advanced search follows the shared utility rhythm. */
  [data-utility-kind="search"] .advanced-search-hero { gap: clamp(1.1rem, 2.6vw, 1.75rem); }
  [data-utility-kind="search"] :is(.advanced-search-hero-card,.search-summary-card) {
    padding: var(--ui-card-pad, 1rem) !important;
    border-radius: var(--ui-card-radius, 16px) !important;
    box-shadow: var(--ui-shadow-card, var(--shadow-sm)) !important;
  }
  [data-utility-kind="search"] :is(.enhanced-search-panel,.advanced-explore-block) {
    padding: var(--ui-panel-pad, 1rem) !important;
    border-radius: var(--ui-panel-radius, 18px) !important;
  }
  [data-utility-kind="search"] :is(.search-stat-card,.search-result,.advanced-explore-card) {
    border-radius: var(--ui-card-radius, 16px) !important;
    box-shadow: var(--ui-shadow-card, var(--shadow-sm)) !important;
  }
  [data-utility-kind="search"] .advanced-explore-grid,
  [data-utility-kind="search"] .enhanced-search-results { gap: var(--ui-card-gap, .8rem) !important; }
  @media (max-width: 680px) {
    [data-utility-kind="search"] .advanced-search-hero { gap: .8rem; }
    [data-utility-kind="search"] :is(.enhanced-search-panel,.advanced-explore-block) { padding: .9rem !important; border-radius: 16px !important; }
    [data-utility-kind="search"] :is(.advanced-search-hero-card,.search-summary-card,.search-stat-card,.search-result,.advanced-explore-card) { border-radius: 14px !important; }
  }
</style>
