---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sitePath } from "../../lib/site-paths";
import { getAllRoutes, getLessonsByRouteId, getRouteModules } from "../../lib/queries";

const routes = getAllRoutes().filter((route) => route.status !== "Borrador");
const sections = routes.map((route) => ({ route, modules: getRouteModules(route.id), lessons: getLessonsByRouteId(route.id) }));
const totalUnique = new Set(sections.flatMap((section) => section.lessons.map((lesson) => lesson.id))).size;
---

<BaseLayout title="Lecciones" description="Lecciones bíblicas canónicas organizadas en rutas y módulos de aprendizaje.">
  <main class="lesson-index-page">
    <nav class="breadcrumb" aria-label="Migas de pan"><a href={sitePath("/")}>Inicio</a><span>›</span><span>Lecciones</span></nav>
    <header class="lesson-index-hero">
      <div><p class="eyebrow">Biblioteca de aprendizaje</p><h1>Lecciones</h1><p>{totalUnique} estudios canónicos disponibles. Cada lección existe una sola vez y puede reutilizarse en diferentes rutas sin duplicar contenido.</p></div>
      <a href={sitePath("/rutas/")} class="route-button">Explorar rutas</a>
    </header>

    {sections.map(({ route, modules, lessons }) => (
      <section class="route-section">
        <header><div><p class="eyebrow">Ruta</p><h2><a href={sitePath(`/rutas/${route.slug}/`)}>{route.title}</a></h2><p>{route.description}</p></div><span>{lessons.length} lecciones</span></header>
        <div class="lesson-catalog">
          {lessons.map((lesson) => (
            <a href={sitePath(`/lecciones/${lesson.slug}/`)} class="lesson-catalog-card" data-lesson-id={lesson.id}>
              <span class="lesson-no">{String(lesson.lesson_number).padStart(2,"0")}</span>
              <span class="lesson-copy"><strong>{lesson.title}</strong><small>{lesson.module_title} · {lesson.primary_reference} · {lesson.estimated_time}</small></span>
              <span class="completion-dot" data-completion-dot>○</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<script>
  const PROGRESS_KEY = "bibli-learning-progress-v1";
  let completed = new Set<string>();
  try { const value = JSON.parse(localStorage.getItem(PROGRESS_KEY) || "{}"); completed = new Set(Array.isArray(value.completed) ? value.completed : []); } catch {}
  document.querySelectorAll<HTMLElement>("[data-lesson-id]").forEach((card) => {
    const done = completed.has(card.dataset.lessonId || "");
    card.classList.toggle("is-complete", done);
    const dot = card.querySelector<HTMLElement>("[data-completion-dot]");
    if (dot) dot.textContent = done ? "✓" : "○";
  });
</script>

<style>
.lesson-index-page{max-width:1120px;margin:0 auto;padding:1.5rem 1rem 5rem}.breadcrumb{display:flex;gap:.45rem;align-items:center;font-size:.86rem;opacity:.72;margin-bottom:1.2rem}.lesson-index-hero{display:flex;justify-content:space-between;align-items:end;gap:1.2rem;padding:clamp(1.4rem,4vw,2.5rem);border:1px solid var(--border-color,rgba(100,100,100,.18));border-radius:26px;background:linear-gradient(145deg,var(--surface,#fff),var(--surface-soft,#f5f5f5));margin-bottom:1.2rem}.lesson-index-hero h1{font-size:clamp(2rem,5vw,3.4rem);margin:.3rem 0 .6rem}.lesson-index-hero p{max-width:700px;margin:0;line-height:1.65}.eyebrow{text-transform:uppercase;letter-spacing:.09em;font-size:.74rem;font-weight:800;opacity:.64}.route-button{white-space:nowrap;text-decoration:none;border:1px solid currentColor;border-radius:12px;padding:.72rem .9rem;font-weight:800}.route-section{margin-top:1rem;border:1px solid var(--border-color,rgba(100,100,100,.18));border-radius:22px;overflow:hidden;background:var(--surface,#fff)}.route-section>header{display:flex;justify-content:space-between;gap:1rem;padding:1.1rem;border-bottom:1px solid var(--border-color,rgba(100,100,100,.14))}.route-section h2{margin:.15rem 0 .35rem}.route-section h2 a{text-decoration:none}.route-section header p{margin:0;max-width:720px;line-height:1.5;opacity:.78}.route-section>header>span{font-size:.8rem;opacity:.65;white-space:nowrap}.lesson-catalog{display:grid}.lesson-catalog-card{display:grid;grid-template-columns:3rem minmax(0,1fr) auto;gap:.8rem;align-items:center;padding:.8rem 1.1rem;text-decoration:none}.lesson-catalog-card+.lesson-catalog-card{border-top:1px solid var(--border-color,rgba(100,100,100,.1))}.lesson-catalog-card:hover{background:var(--surface-soft,#f7f7f7)}.lesson-no{font-size:.82rem;opacity:.6;font-variant-numeric:tabular-nums}.lesson-copy{display:grid;gap:.18rem}.lesson-copy small{opacity:.66}.completion-dot{font-weight:900}.is-complete .completion-dot{font-size:1.05rem}@media(max-width:650px){.lesson-index-page{padding-top:1rem}.lesson-index-hero{align-items:flex-start;flex-direction:column;border-radius:20px}.route-section{border-radius:18px}.route-section>header{flex-direction:column}.lesson-catalog-card{grid-template-columns:2.1rem minmax(0,1fr) auto;padding:.75rem .85rem}.lesson-copy strong{font-size:.94rem}.lesson-copy small{font-size:.76rem}}
</style>
