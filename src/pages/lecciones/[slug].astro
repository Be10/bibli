---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudyAids from "../../components/learning/StudyAids.astro";
import Icon from "../../components/Icon.astro";
import ReaderPreferences from "../../components/ReaderPreferences.astro";
import { sitePath } from "../../lib/site-paths";
import { getBibleChapterPath } from "../../lib/bible-routes";
import { getStudyIntro, getStudySlug, getStudyTitle } from "../../lib/studies";
import { parseStudyReference } from "../../lib/study-reference";
import {
  getAllRoutes,
  getBookById,
  getBibleVersesForRange,
  getEventsByLessonId,
  getGlossaryByLessonId,
  getLessonBySlug,
  getLessonsByRouteId,
  getPeopleByLessonId,
  getRoutesByLessonId,
  getRouteModules,
  getStudyPlacesByLessonId,
  getTopicsByLessonId,
  getVisualResourcesByLessonId,
  resolveBibleVersionId,
} from "../../lib/queries";

export async function getStaticPaths() {
  const entries = await getCollection("studies");
  return entries.map((entry) => ({
    params: { slug: getStudySlug(entry) },
    props: { entryId: entry.id },
  }));
}

const { slug } = Astro.params;
const { entryId } = Astro.props;
const entry = await getEntry("studies", entryId);
if (!entry || !slug) throw new Error(`Lección no encontrada: ${slug ?? entryId}`);

const lesson = getLessonBySlug(slug);
if (!lesson) throw new Error(`La lección ${slug} no está indexada. Ejecuta npm run studies:import.`);

const { Content, headings } = await render(entry);
const title = getStudyTitle(entry);
const intro = getStudyIntro(entry);
const routes = getRoutesByLessonId(lesson.id);
const route = routes[0];
const routeLessons = route ? getLessonsByRouteId(route.id) : [];
const routeIndex = routeLessons.findIndex((item) => item.id === lesson.id);
const previousLesson = routeIndex > 0 ? routeLessons[routeIndex - 1] : null;
const nextLesson = routeIndex >= 0 ? routeLessons[routeIndex + 1] ?? null : null;
const moduleTitle = routeIndex >= 0 ? routeLessons[routeIndex]?.module_title : null;
const routeModules = route ? getRouteModules(route.id) : [];
const currentRouteLesson = routeIndex >= 0 ? routeLessons[routeIndex] : null;
const currentModule = currentRouteLesson ? routeModules.find((item) => item.id === currentRouteLesson.module_id) : null;
const currentModuleIndex = currentModule ? routeModules.findIndex((item) => item.id === currentModule.id) : -1;
const routeOptions = getAllRoutes()
  .filter((item) => item.status !== "Borrador")
  .map((item) => ({
    ...item,
    lessonCount: getLessonsByRouteId(item.id).length,
    href: sitePath(`/rutas/${item.slug}/`),
  }));

const glossary = getGlossaryByLessonId(lesson.id);
const people = getPeopleByLessonId(lesson.id);
const places = getStudyPlacesByLessonId(lesson.id);
const topics = getTopicsByLessonId(lesson.id);
const events = getEventsByLessonId(lesson.id);
const visualResources = getVisualResourcesByLessonId(lesson.id);
const studyAidCount = glossary.length + people.length + places.length + topics.length + events.length + visualResources.filter((resource) => Boolean(resource.url)).length;
const hasStudyAids = studyAidCount > 0;

const range = parseStudyReference(entry.data.primary_reference);
const book = getBookById(`book-${entry.data.book_id}`);
const versionId = resolveBibleVersionId(entry.data.translation) ?? "rvr1960";
const verses = range && book
  ? getBibleVersesForRange(book.id, range.startChapter, range.startVerse, range.endChapter, range.endVerse, versionId)
  : [];
const verseGroups = new Map<number, typeof verses>();
for (const verse of verses) {
  const group = verseGroups.get(verse.chapter_number) ?? [];
  group.push(verse);
  verseGroups.set(verse.chapter_number, group);
}
const bibleHref = range && book?.usfm_code
  ? getBibleChapterPath("es", versionId, book.usfm_code, range.startChapter)
  : null;
const referenceLabel = range && book
  ? `${book.name} ${range.startChapter}:${range.startVerse}${range.endChapter === range.startChapter ? `–${range.endVerse}` : `–${range.endChapter}:${range.endVerse}`}`
  : entry.data.primary_reference;
const toc = headings.filter((heading) => heading.depth === 2);
const cleanHeadingLabel = (value: string) => value.replace(/^[^\p{L}\p{N}]+/u, "").trim();
const routeHref = route ? sitePath(`/rutas/${route.slug}/`) : sitePath("/rutas/");
const moduleHref = currentModule ? `${routeHref}#${currentModule.slug}` : routeHref;
---

<BaseLayout title={title} description={intro || `Estudio de ${entry.data.primary_reference}`}>
  <main class="learning-page" data-detail-root data-detail-kind="lesson" data-learning-shell data-persisted-root data-lesson-id={lesson.id} data-route-id={route?.id ?? ""} data-total-lessons={routeLessons.length} data-route-lesson-ids={JSON.stringify(routeLessons.map((item) => item.id))} data-has-aids={hasStudyAids ? "true" : "empty"}>
    <script is:inline>
      (() => {
        const script = document.currentScript;
        const shell = script?.parentElement;
        if (!(shell instanceof HTMLElement) || !shell.matches("[data-learning-shell]")) return;
        let routeLessonIds = [];
        try { routeLessonIds = JSON.parse(shell.dataset.routeLessonIds || "[]"); } catch {}
        let progress = {};
        try { progress = JSON.parse(localStorage.getItem("bibli-learning-progress-v1") || "{}"); } catch {}
        const completed = new Set(Array.isArray(progress.completed) ? progress.completed : []);
        const lessonId = shell.dataset.lessonId || "";
        const routeId = shell.dataset.routeId || "";
        const total = Number(shell.dataset.totalLessons || 0);
        const count = routeId ? routeLessonIds.filter((id) => completed.has(id)).length : (completed.has(lessonId) ? 1 : 0);
        const percent = total > 0 ? Math.round((count / total) * 100) : 0;
        const done = completed.has(lessonId);

        const hydrate = (node) => {
          if (!(node instanceof Element)) return;
          const root = node;
          const all = (selector) => {
            const result = [];
            if (root.matches?.(selector)) result.push(root);
            result.push(...root.querySelectorAll?.(selector) || []);
            return result;
          };
          all("[data-route-progress-value]").forEach((element) => { element.textContent = `${percent}%`; });
          all("[data-route-progress-bar]").forEach((element) => {
            element.style.transition = "none";
            element.style.width = `${percent}%`;
          });
          all("[data-route-progress-track]").forEach((element) => element.setAttribute("aria-valuenow", String(percent)));
          all("[data-complete-lesson]").forEach((button) => {
            button.classList.toggle("is-complete", done);
            button.setAttribute("aria-pressed", String(done));
            const label = button.querySelector("[data-complete-label]");
            if (label) label.textContent = done ? "Lección completada" : "Marcar como completada";
          });
        };
        const observer = new MutationObserver((mutations) => {
          for (const mutation of mutations) mutation.addedNodes.forEach((node) => hydrate(node));
        });
        observer.observe(shell, { childList: true, subtree: true });
        queueMicrotask(() => hydrate(shell));
        window.addEventListener("DOMContentLoaded", () => {
          hydrate(shell);
          shell.querySelectorAll("[data-route-progress-bar]").forEach((bar) => bar.style.removeProperty("transition"));
          observer.disconnect();
        }, { once: true });
      })();
    </script>
    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>

    <nav class="lesson-mobile-dock" data-lesson-mobile-dock aria-label="Navegador de la lección">
      <div class="lesson-dock-more" id="lesson-dock-more" data-lesson-dock-more hidden>
        <button type="button" data-dock-mode="study" aria-pressed="true"><Icon name="graduation" size={17} /><span>Estudio</span></button>
        <button type="button" data-dock-mode="reading" aria-pressed="false"><Icon name="book" size={17} /><span>Lectura</span></button>
        <a href={routeHref}><Icon name="route" size={17} /><span>Ruta</span></a>
      </div>
      <div class="lesson-dock-primary">
        {previousLesson ? <a href={sitePath(`/lecciones/${previousLesson.slug}/`)} class="lesson-dock-action lesson-dock-step" aria-label={`Lección anterior: ${previousLesson.title}`} title={`Anterior: ${previousLesson.title}`}><Icon name="chevron-left" size={19} /></a> : <span class="lesson-dock-action lesson-dock-step is-disabled" aria-hidden="true"><Icon name="chevron-left" size={19} /></span>}
        <a href={sitePath("/")} class="lesson-dock-action" aria-label="Ir al inicio" title="Inicio"><Icon name="home" size={19} /></a>
        <button type="button" class="lesson-dock-action" data-dock-action="search" aria-label="Buscar" title="Buscar" aria-expanded="false" aria-pressed="false"><Icon name="search" size={19} /></button>
        {toc.length > 0 && <button type="button" class="lesson-dock-action" data-dock-action="toc" aria-label="Contenido" title="Contenido" aria-pressed="true"><Icon name="panel-left" size={19} /></button>}
        <button type="button" class="lesson-dock-action" data-dock-action="reader" aria-label="Estilos de texto" title="Estilos de texto" aria-pressed="false"><Icon name="type" size={19} /></button>
        <button type="button" class="lesson-dock-action" data-dock-action="tts" aria-label="Escuchar" title="Escuchar" aria-pressed="false"><Icon name="volume" size={19} /></button>
        <button type="button" class="lesson-dock-action" data-dock-action="aids" aria-label={`Ayudas de estudio: ${studyAidCount}`} title="Ayudas de estudio" aria-pressed="true"><Icon name="sparkles" size={19} /></button>
        <button type="button" class="lesson-dock-action" data-dock-more-toggle aria-expanded="false" aria-controls="lesson-dock-more" aria-label="Más opciones" title="Más opciones"><Icon name="grid" size={19} /></button>
        {nextLesson ? <a href={sitePath(`/lecciones/${nextLesson.slug}/`)} class="lesson-dock-action lesson-dock-step" aria-label={`Siguiente lección: ${nextLesson.title}`} title={`Siguiente: ${nextLesson.title}`}><Icon name="chevron-right" size={19} /></a> : <a href={routeHref} class="lesson-dock-action lesson-dock-step" aria-label="Finalizar y volver a la ruta" title="Finalizar"><Icon name="chevron-right" size={19} /></a>}
      </div>
    </nav>

    <script is:inline>
      (() => {
        const script = document.currentScript;
        const dock = script?.previousElementSibling;
        if (!(dock instanceof HTMLElement) || !dock.matches("[data-lesson-mobile-dock]")) return;
        const root = document.documentElement;
        const mode = root.dataset.lessonMode === "reading" ? "reading" : "study";
        const tocVisible = mode === "study" && root.dataset.lessonToc === "visible";
        const aidsVisible = mode === "study" && root.dataset.studyAids === "visible";
        dock.querySelectorAll("[data-dock-mode]").forEach((button) => {
          if (button instanceof HTMLButtonElement) button.setAttribute("aria-pressed", String(button.dataset.dockMode === mode));
        });
        const tocButton = dock.querySelector('[data-dock-action="toc"]');
        if (tocButton instanceof HTMLButtonElement) tocButton.setAttribute("aria-pressed", String(tocVisible));
        const aidsButton = dock.querySelector('[data-dock-action="aids"]');
        if (aidsButton instanceof HTMLButtonElement) aidsButton.setAttribute("aria-pressed", String(aidsVisible));
      })();
    </script>

    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href={sitePath("/")}>Inicio</a>
      <span>›</span>
      <a href={routeHref}>{route?.title ?? "Rutas"}</a>
      {currentModule && (
        <>
          <span>›</span>
          <a href={moduleHref}>Módulo {currentModuleIndex + 1}</a>
        </>
      )}
      <span>›</span>
      <span aria-current="page">Lección {lesson.lesson_number}</span>
    </nav>

    <header class="learning-header">
      <div class="lesson-position">
        {currentModule && (
          <a class="lesson-module-context" href={moduleHref}>
            <Icon name="layers" size={15} />
            <span>Módulo {currentModuleIndex + 1} de {routeModules.length}</span>
            <strong>{moduleTitle}</strong>
          </a>
        )}
        <div class="lesson-position-line">
          <strong>Lección {lesson.lesson_number}{routeLessons.length ? ` de ${routeLessons.length}` : ""}</strong>
        </div>
      </div>
      <div class="completion-summary" aria-live="polite">
        <div class="completion-summary-copy">
          <span data-route-progress-label>Mi progreso</span>
          <strong data-route-progress-value>0%</strong>
        </div>
        <div class="completion-track" role="progressbar" aria-label="Progreso de la ruta" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-route-progress-track>
          <span data-route-progress-bar></span>
        </div>
      </div>
    </header>

    <div class="mode-toolbar" role="toolbar" aria-label="Herramientas de la lección">
      <div class="toolbar-left">
        {toc.length > 0 && (
          <button type="button" class="toolbar-action toc-toggle" data-toc-toggle aria-expanded="true" aria-controls="lesson-toc-panel">
            <Icon name="panel-left" size={17} />
            <span>Contenido</span>
          </button>
        )}
        <div class="segmented" role="tablist" aria-label="Modo de lectura">
          <button type="button" data-mode-button="study" role="tab" aria-selected="true"><Icon name="graduation" size={17} /><span>Estudio</span></button>
          <button type="button" data-mode-button="reading" role="tab" aria-selected="false"><Icon name="book" size={17} /><span>Lectura</span></button>
        </div>
      </div>

      {toc.length > 0 && (
        <div class="current-section-status" data-current-section aria-live="polite" aria-atomic="true">
          <span class="current-section-label">Sección</span>
          <strong data-current-section-text>{cleanHeadingLabel(toc[0]?.text ?? "Inicio")}</strong>
          <span class="current-section-index" data-current-section-index>{`1/${toc.length}`}</span>
        </div>
      )}

      <div class="toolbar-right">
        <ReaderPreferences compact />
        <div class="lesson-step-nav" aria-label="Navegación rápida entre lecciones">
          {previousLesson ? (
            <a class="step-button icon-only" href={sitePath(`/lecciones/${previousLesson.slug}/`)} title={`Anterior: ${previousLesson.title}`} aria-label={`Lección anterior: ${previousLesson.title}`}><Icon name="chevron-left" size={17} /></a>
          ) : (
            <span class="step-button icon-only is-disabled" aria-hidden="true"><Icon name="chevron-left" size={17} /></span>
          )}
          <button type="button" class="step-button routes-toggle" data-routes-toggle aria-expanded="false" aria-controls="lesson-routes-panel"><Icon name="route" size={16} /><span>Rutas</span></button>
          {nextLesson ? (
            <a class="step-button next-step" href={sitePath(`/lecciones/${nextLesson.slug}/`)} title={`Siguiente: ${nextLesson.title}`}><span>Siguiente</span><Icon name="chevron-right" size={17} /></a>
          ) : route ? (
            <a class="step-button next-step" href={routeHref}><span>Ruta</span><Icon name="chevron-right" size={17} /></a>
          ) : null}
        </div>
        <button type="button" class="toolbar-action aids-toggle" data-aids-toggle aria-pressed="true" aria-expanded="true" aria-controls="lesson-aids-panel" aria-label="Mostrar u ocultar ayudas de estudio">
          <Icon name="panel-right" size={17} /><span>Ayudas</span>
        </button>
      </div>

      <div class="lesson-routes-popover" id="lesson-routes-panel" data-routes-popover hidden>
        <header>
          <div><span class="popover-eyebrow">Rutas de estudio</span><strong>Explora otros recorridos</strong></div>
          <a href={sitePath("/rutas/")}>Ver todas</a>
        </header>
        <div class="route-option-list">
          {routeOptions.map((item) => (
            <a href={item.href} class:list={["route-option", route?.id === item.id && "is-current"]}>
              <span class="route-option-icon"><Icon name="route" size={17} /></span>
              <span class="route-option-copy"><strong>{item.title}</strong><small>{item.description ?? item.subtitle ?? "Ruta guiada"}</small><em>{item.lessonCount} lecciones{route?.id === item.id ? " · Ruta actual" : ""}</em></span>
              <Icon name="chevron-right" size={16} />
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="learning-grid" data-learning-grid>
      {toc.length > 0 && (
        <>
          <aside class="lesson-toc-column" id="lesson-toc-panel" data-toc-panel aria-label="Contenido de la lección">
            <div class="lesson-toc-card">
              <header class="toc-heading">
                <div class="toc-heading-copy">
                  <span class="toc-heading-icon" aria-hidden="true"><Icon name="list" size={16} /></span>
                  <span class="toc-heading-text"><strong>Contenido</strong><small>{toc.length} secciones</small></span>
                </div>
                <button type="button" class="toc-close" data-toc-close aria-label="Ocultar contenido"><Icon name="close" size={16} /></button>
              </header>
              <nav class="lesson-toc">
                {toc.map((heading, index) => (
                  <a href={`#${heading.slug}`} data-toc-link={`#${heading.slug}`}>
                    <span class="toc-number">{String(index + 1).padStart(2, "0")}</span>
                    <span>{cleanHeadingLabel(heading.text)}</span>
                  </a>
                ))}
              </nav>
            </div>
          </aside>
          <button type="button" class="toc-backdrop" data-toc-backdrop aria-label="Cerrar contenido"></button>
        </>
      )}

      <div class="lesson-stage">
        <section data-mode-panel="study">
          <header class="study-header">
            <h1 data-tts-lesson-title>{title}</h1>
            <button type="button" class="study-reference" data-open-reading data-tts-lesson-reference aria-label={`Abrir la lectura bíblica: ${referenceLabel}, ${entry.data.translation}`}>
              <span class="study-reference-main"><Icon name="book" size={17} /><span><strong>Lectura:</strong> {referenceLabel}, {entry.data.translation}</span></span>
              <span class="study-reference-meta"><span class="study-duration"><Icon name="clock" size={15} />{lesson.estimated_time}</span><Icon name="chevron-right" size={17} /></span>
            </button>
          </header>
          <article class="study-content" data-study-content data-reader-content aria-busy="true">
            <Content />
          </article>
          <script is:inline>
            (() => {
              const script = document.currentScript;
              const study = script?.previousElementSibling;
              if (!(study instanceof HTMLElement) || !study.matches("[data-study-content]") || study.dataset.enhanced === "true") return;

              const headingKind = (label) => {
                if (/^dónde estamos/i.test(label)) return "location";
                if (/oración/i.test(label)) return "prayer";
                if (/encontrando a jesús|jesús|cristo/i.test(label)) return "jesus";
                if (/hilo invisible|conectar/i.test(label)) return "connection";
                if (/aplicación/i.test(label)) return "application";
                if (/meditar|reflex/i.test(label)) return "reflection";
                if (/resumen/i.test(label)) return "summary";
                return "explanation";
              };
              const svgPaths = {
                location: '<path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle>',
                explanation: '<path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path><path d="M5.5 8H8M5.5 12H8M16 8h2.5M16 12h2.5"></path>',
                jesus: '<path d="M12 2v20"></path><path d="M5 8h14"></path>',
                connection: '<circle cx="5" cy="5" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="19" cy="19" r="2"></circle><path d="M6.7 6.7 10.3 10.3M13.7 13.7l3.6 3.6"></path><path d="M7 17c3-1 4-3 5-5"></path>',
                application: '<circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1"></circle>',
                reflection: '<path d="M9 18h6"></path><path d="M10 22h4"></path><path d="M8.3 14.8A7 7 0 1 1 15.7 14.8c-.8.6-1.2 1.2-1.4 2.2h-4.6c-.2-1-.6-1.6-1.4-2.2Z"></path>',
                summary: '<path d="m3 6 2 2 4-4"></path><path d="M11 6h10"></path><path d="m3 12 2 2 4-4"></path><path d="M11 12h10"></path><path d="m3 18 2 2 4-4"></path><path d="M11 18h10"></path>',
                prayer: '<path d="M11.8 22c-1.2-1.7-3.2-3.2-5.2-4.8C4.8 15.8 4 14 4 12V8a1.5 1.5 0 0 1 3 0v4l2-7.5a1.5 1.5 0 0 1 2.8.5v17"></path><path d="M12.2 22c1.2-1.7 3.2-3.2 5.2-4.8C19.2 15.8 20 14 20 12V8a1.5 1.5 0 0 0-3 0v4l-2-7.5a1.5 1.5 0 0 0-2.8.5v17"></path><path d="M8 15c1.5 1 2.8 2 4 3M16 15c-1.5 1-2.8 2-4 3"></path>',
              };
              const enhanceHeading = (heading) => {
                if (!(heading instanceof HTMLElement) || heading.dataset.iconEnhanced === "true") return;
                const clean = (heading.textContent || "").replace(/^[^\p{L}\p{N}]+/u, "").trim();
                heading.textContent = clean;
                const kind = headingKind(clean);
                const icon = document.createElement("span");
                icon.className = "lesson-heading-icon";
                icon.dataset.kind = kind;
                icon.setAttribute("aria-hidden", "true");
                const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                svg.setAttribute("viewBox", "0 0 24 24");
                svg.setAttribute("fill", "none");
                svg.setAttribute("stroke", "currentColor");
                svg.setAttribute("stroke-width", "2.15");
                svg.setAttribute("stroke-linecap", "round");
                svg.setAttribute("stroke-linejoin", "round");
                svg.setAttribute("aria-hidden", "true");
                svg.setAttribute("focusable", "false");
                svg.innerHTML = svgPaths[kind] || svgPaths.explanation;
                icon.appendChild(svg);
                heading.prepend(icon);
                heading.dataset.iconEnhanced = "true";
              };

              const headings = [...study.querySelectorAll(":scope > h2")];
              headings.forEach((heading, index) => {
                enhanceHeading(heading);
                const wrapper = document.createElement("section");
                wrapper.className = "lesson-section";
                const label = heading.textContent?.trim() || "";
                if (label.includes("Encontrando a Jesús")) wrapper.classList.add("is-jesus");
                if (label.includes("Para meditar")) wrapper.classList.add("is-reflection");
                if (label.includes("Aplicación")) wrapper.classList.add("is-application");
                if (label.includes("Resumen")) wrapper.classList.add("is-summary");
                if (label.includes("Oración")) wrapper.classList.add("is-prayer");
                study.insertBefore(wrapper, heading);
                wrapper.appendChild(heading);
                let cursor = wrapper.nextSibling;
                const nextHeading = headings[index + 1];
                while (cursor && cursor !== nextHeading) {
                  const next = cursor.nextSibling;
                  wrapper.appendChild(cursor);
                  cursor = next;
                }
              });
              study.querySelectorAll("h3").forEach(enhanceHeading);
              study.dataset.enhanced = "true";
              study.setAttribute("aria-busy", "false");
            })();
          </script>
        </section>

        <section data-mode-panel="reading">
          <article class="reading-card" data-reading-card>
            <header class="reading-card-header">
              <div class="reading-heading-copy">
                <div class="reading-kicker"><p class="eyebrow">Lectura bíblica</p><span class="reading-version">{entry.data.translation}</span></div>
                <h1>{referenceLabel}</h1>
              </div>
              {bibleHref && <a class="open-bible-icon" href={bibleHref} aria-label="Abrir en el lector bíblico" title="Abrir en el lector bíblico"><Icon name="book" size={18} /></a>}
            </header>

            {verseGroups.size > 0 ? (
              <div class="verse-reader" data-reader-content>
                {[...verseGroups.entries()].map(([chapter, chapterVerses]) => (
                  <section class="chapter-block">
                    {verseGroups.size > 1 && <h2>Capítulo {chapter}</h2>}
                    <p>
                      {chapterVerses.map((verse) => (
                        <span class="verse" id={`reading-v${chapter}-${verse.verse_number}`}>
                          <sup>{verse.verse_number}</sup>{verse.verse_text}{" "}
                        </span>
                      ))}
                    </p>
                  </section>
                ))}
              </div>
            ) : (
              <p class="reading-empty">El texto no pudo resolverse desde la versión bíblica local. Puedes abrir la referencia en el lector.</p>
            )}
          </article>
        </section>

        <section class="lesson-finish">
          <div>
            <p class="eyebrow">Progreso</p>
            <h2>¿Terminaste esta lección?</h2>
            <p>Márcala como completada para actualizar tu avance.</p>
          </div>
          <button type="button" class="complete-button" data-complete-lesson data-persisted-value><Icon name="check" size={17} /><span data-complete-label>Marcar como completada</span></button>
        </section>

      </div>

      <>
        <div class="aids-column" id="lesson-aids-panel" data-aids-column>
          <button type="button" class="aids-mobile-close" data-aids-close aria-label="Cerrar ayudas de estudio"><Icon name="close" size={17} /></button>
          <StudyAids
            glossary={glossary}
            people={people}
            places={places}
            topics={topics}
            events={events}
            visualResources={visualResources}
          />
        </div>
        <button type="button" class="aids-backdrop" data-aids-backdrop aria-label="Cerrar ayudas de estudio"></button>
      </>
    </div>

    <button type="button" class="back-to-top" data-back-to-top aria-label="Volver al inicio de la lección" title="Volver arriba">
      <Icon name="arrow-up" size={18} />
    </button>
  </main>
</BaseLayout>

<script>
  document.documentElement.dataset.lessonDock = "true";
  const PROGRESS_KEY = "bibli-learning-progress-v1";
  const MODE_KEY = "bibli-lesson-mode-v1";

  function readProgress() {
    try {
      const value = JSON.parse(localStorage.getItem(PROGRESS_KEY) || "{}");
      return {
        completed: Array.isArray(value.completed) ? value.completed : [],
        lastLessonByRoute: value.lastLessonByRoute && typeof value.lastLessonByRoute === "object" ? value.lastLessonByRoute : {},
      };
    } catch {
      return { completed: [], lastLessonByRoute: {} };
    }
  }

  function writeProgress(progress) {
    localStorage.setItem(PROGRESS_KEY, JSON.stringify(progress));
  }

  document.querySelectorAll<HTMLElement>("[data-learning-shell]").forEach((shell) => {
    const lessonId = shell.dataset.lessonId || "";
    const routeId = shell.dataset.routeId || "";
    const total = Number(shell.dataset.totalLessons || 0);
    let routeLessonIds: string[] = [];
    try { routeLessonIds = JSON.parse(shell.dataset.routeLessonIds || "[]"); } catch { routeLessonIds = []; }

    const completeButton = shell.querySelector<HTMLButtonElement>("[data-complete-lesson]");
    const progressValue = shell.querySelector<HTMLElement>("[data-route-progress-value]");
    const progressBar = shell.querySelector<HTMLElement>("[data-route-progress-bar]");
    const progressTrack = shell.querySelector<HTMLElement>("[data-route-progress-track]");

    function updateProgressUi() {
      const progress = readProgress();
      const completed = new Set(progress.completed);
      const count = routeId ? routeLessonIds.filter((id) => completed.has(id)).length : (completed.has(lessonId) ? 1 : 0);
      const percent = total > 0 ? Math.round((count / total) * 100) : 0;
      if (progressValue) {
        progressValue.textContent = `${percent}%`;
        progressValue.dataset.persistedReady = "true";
      }
      if (progressBar) progressBar.style.width = `${percent}%`;
      if (progressTrack) progressTrack.setAttribute("aria-valuenow", String(percent));
      if (completeButton) {
        const done = completed.has(lessonId);
        completeButton.classList.toggle("is-complete", done);
        const label = completeButton.querySelector<HTMLElement>("[data-complete-label]");
        if (label) label.textContent = done ? "Lección completada" : "Marcar como completada";
        completeButton.setAttribute("aria-pressed", String(done));
        completeButton.dataset.persistedReady = "true";
      }
    }

    const progress = readProgress();
    if (routeId) progress.lastLessonByRoute[routeId] = lessonId;
    writeProgress(progress);
    completeButton?.addEventListener("click", () => {
      const next = readProgress();
      const completed = new Set(next.completed);
      if (completed.has(lessonId)) completed.delete(lessonId); else completed.add(lessonId);
      next.completed = [...completed];
      writeProgress(next);
      updateProgressUi();
      document.dispatchEvent(new CustomEvent("bibli:learning-progress-change"));
    });
    updateProgressUi();
    shell.dataset.progressReady = "true";
    shell.dataset.persistedReady = "true";
    window.addEventListener("storage", (event) => {
      if (event.key === PROGRESS_KEY) updateProgressUi();
    });
    window.addEventListener("pageshow", updateProgressUi);

    const modeButtons = [...shell.querySelectorAll<HTMLButtonElement>("[data-mode-button]")];
    const aidsToggle = shell.querySelector<HTMLButtonElement>("[data-aids-toggle]");
    const aidsClose = shell.querySelector<HTMLButtonElement>("[data-aids-close]");
    const aidsBackdrop = shell.querySelector<HTMLButtonElement>("[data-aids-backdrop]");
    const tocToggle = shell.querySelector<HTMLButtonElement>("[data-toc-toggle]");
    const tocClose = shell.querySelector<HTMLButtonElement>("[data-toc-close]");
    const tocBackdrop = shell.querySelector<HTMLButtonElement>("[data-toc-backdrop]");
    const routesToggle = shell.querySelector<HTMLButtonElement>("[data-routes-toggle]");
    const routesPopover = shell.querySelector<HTMLElement>("[data-routes-popover]");
    const tocMedia = window.matchMedia("(max-width: 920px)");
    const aidsMedia = window.matchMedia("(max-width: 920px)");
    const mobileDock = shell.querySelector<HTMLElement>("[data-lesson-mobile-dock]");
    const dockMore = shell.querySelector<HTMLElement>("[data-lesson-dock-more]");
    const dockMoreToggle = shell.querySelector<HTMLButtonElement>("[data-dock-more-toggle]");
    const dockModeButtons = [...shell.querySelectorAll<HTMLButtonElement>("[data-dock-mode]")];
    const openReading = shell.querySelector<HTMLButtonElement>("[data-open-reading]");

    let dockMoreCloseTimer = 0;
    const setDockMore = (open: boolean) => {
      if (!dockMore || !dockMoreToggle) return;
      window.clearTimeout(dockMoreCloseTimer);
      if (open) {
        document.dispatchEvent(new CustomEvent("bibli:reader-preferences-close"));
        document.dispatchEvent(new CustomEvent("bibli:tts-close"));
        if (tocMedia.matches) setToc(false, false);
        if (aidsMedia.matches) setAids(false, false);
        dockMore.hidden = false;
        requestAnimationFrame(() => dockMore.classList.add("is-open"));
      } else {
        dockMore.classList.remove("is-open");
        dockMoreCloseTimer = window.setTimeout(() => {
          if (!dockMore.classList.contains("is-open")) dockMore.hidden = true;
        }, 180);
      }
      dockMoreToggle.setAttribute("aria-expanded", String(open));
      mobileDock?.classList.toggle("is-expanded", open);
    };

    const syncLessonSheetState = () => {
      const open = (tocMedia.matches && document.documentElement.dataset.lessonToc === "visible")
        || (aidsMedia.matches && document.documentElement.dataset.studyAids === "visible");
      if (open) document.documentElement.dataset.lessonSheetOpen = "true";
      else delete document.documentElement.dataset.lessonSheetOpen;
    };

    function setAids(visible: boolean, _persist = false, closeTransient = true) {
      if (visible && aidsMedia.matches && document.documentElement.dataset.lessonToc === "visible") {
        document.documentElement.dataset.lessonToc = "hidden";
        tocToggle?.setAttribute("aria-expanded", "false");
        shell.querySelector<HTMLButtonElement>('[data-dock-action="toc"]')?.setAttribute("aria-pressed", "false");
      }
      document.documentElement.dataset.studyAids = visible ? "visible" : "hidden";
      if (aidsToggle) {
        aidsToggle.setAttribute("aria-pressed", String(visible));
        aidsToggle.setAttribute("aria-expanded", String(visible));
        aidsToggle.setAttribute("aria-label", visible ? "Ocultar ayudas de estudio" : "Mostrar ayudas de estudio");
      }
      shell.querySelector<HTMLButtonElement>('[data-dock-action="aids"]')?.setAttribute("aria-pressed", String(visible));
      if (visible) {
        if (closeTransient) {
          document.dispatchEvent(new CustomEvent("bibli:reader-preferences-close"));
          document.dispatchEvent(new CustomEvent("bibli:tts-close"));
        }
        setDockMore(false);
      }
      syncLessonSheetState();
    }

    function setMode(mode: string) {
      const normalized = mode === "reading" ? "reading" : "study";
      document.documentElement.dataset.lessonMode = normalized;
      modeButtons.forEach((button) => {
        const active = button.dataset.modeButton === normalized;
        button.setAttribute("aria-selected", String(active));
      });
      dockModeButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.dockMode === normalized)));
      if (aidsToggle) aidsToggle.hidden = normalized !== "study";
      if (tocToggle) tocToggle.hidden = normalized !== "study";
      if (normalized === "reading") {
        setAids(false, false, false);
        setToc(false, false, false);
      } else {
        // Restoring the desktop study sidebars is part of the mode transition, not
        // a request to dismiss transient tools such as the TTS player.
        setAids(aidsMedia.matches ? false : true, false, false);
        setToc(tocMedia.matches ? false : true, false, false);
      }
      localStorage.setItem(MODE_KEY, normalized);
      document.dispatchEvent(new CustomEvent("bibli:lesson-mode-change", { detail: { mode: normalized } }));
    }

    function setToc(visible: boolean, _persist = false, closeTransient = true) {
      if (visible && tocMedia.matches && document.documentElement.dataset.studyAids === "visible") {
        document.documentElement.dataset.studyAids = "hidden";
        if (aidsToggle) {
          aidsToggle.setAttribute("aria-pressed", "false");
          aidsToggle.setAttribute("aria-expanded", "false");
          aidsToggle.setAttribute("aria-label", "Mostrar ayudas de estudio");
        }
        shell.querySelector<HTMLButtonElement>('[data-dock-action="aids"]')?.setAttribute("aria-pressed", "false");
      }
      document.documentElement.dataset.lessonToc = visible ? "visible" : "hidden";
      tocToggle?.setAttribute("aria-expanded", String(visible));
      shell.querySelector<HTMLButtonElement>('[data-dock-action="toc"]')?.setAttribute("aria-pressed", String(visible));
      if (visible) {
        if (closeTransient) {
          document.dispatchEvent(new CustomEvent("bibli:reader-preferences-close"));
          document.dispatchEvent(new CustomEvent("bibli:tts-close"));
        }
        setDockMore(false);
      }
      syncLessonSheetState();
    }

    modeButtons.forEach((button) => button.addEventListener("click", () => setMode(button.dataset.modeButton || "study")));
    dockModeButtons.forEach((button) => button.addEventListener("click", () => { setMode(button.dataset.dockMode || "study"); setDockMore(false); }));
    openReading?.addEventListener("click", () => {
      setMode("reading");
      requestAnimationFrame(() => shell.querySelector<HTMLElement>("[data-reading-card]")?.scrollIntoView({ block: "start", behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" }));
    });
    dockMoreToggle?.addEventListener("click", (event) => {
      event.stopPropagation();
      document.dispatchEvent(new CustomEvent("bibli:global-search-close"));
      setDockMore(dockMoreToggle.getAttribute("aria-expanded") !== "true");
    });
    shell.querySelectorAll<HTMLButtonElement>("[data-dock-action]").forEach((button) => {
      button.addEventListener("click", (event) => {
        event.stopPropagation();
        const action = button.dataset.dockAction;
        if (action !== "search") document.dispatchEvent(new CustomEvent("bibli:global-search-close"));
        if (action === "toc") setToc(document.documentElement.dataset.lessonToc !== "visible", false);
        if (action === "aids") setAids(document.documentElement.dataset.studyAids !== "visible", false);
        if (action === "reader") {
          if (tocMedia.matches) setToc(false, false);
          if (aidsMedia.matches) setAids(false, false);
          setDockMore(false);
          const open = button.getAttribute("aria-pressed") === "true";
          document.dispatchEvent(new CustomEvent(open ? "bibli:reader-preferences-close" : "bibli:reader-preferences-open"));
        }
        if (action === "tts") {
          if (tocMedia.matches) setToc(false, false);
          if (aidsMedia.matches) setAids(false, false);
          setDockMore(false);
          document.dispatchEvent(new CustomEvent("bibli:tts-toggle"));
        }
        if (action === "search") {
          if (tocMedia.matches) setToc(false, false);
          if (aidsMedia.matches) setAids(false, false);
          setDockMore(false);
          document.dispatchEvent(new CustomEvent("bibli:global-search-toggle", { detail: { trigger: button } }));
        }
      });
    });
    aidsToggle?.addEventListener("click", () => {
      const nextVisible = document.documentElement.dataset.studyAids !== "visible";
      setAids(nextVisible);
      if (nextVisible && aidsMedia.matches) requestAnimationFrame(() => aidsClose?.focus());
    });
    const focusAidsTrigger = () => (aidsMedia.matches ? shell.querySelector<HTMLButtonElement>('[data-dock-action="aids"]') : aidsToggle)?.focus();
    const focusTocTrigger = () => (tocMedia.matches ? shell.querySelector<HTMLButtonElement>('[data-dock-action="toc"]') : tocToggle)?.focus();
    aidsClose?.addEventListener("click", () => { setAids(false, false); focusAidsTrigger(); });
    aidsBackdrop?.addEventListener("click", () => { setAids(false, false); focusAidsTrigger(); });
    tocToggle?.addEventListener("click", () => {
      const nextVisible = document.documentElement.dataset.lessonToc !== "visible";
      setToc(nextVisible);
      if (nextVisible && tocMedia.matches) requestAnimationFrame(() => tocClose?.focus());
    });
    tocClose?.addEventListener("click", () => { setToc(false, false); focusTocTrigger(); });
    tocBackdrop?.addEventListener("click", () => { setToc(false, false); focusTocTrigger(); });

    function setRoutesPopover(open: boolean, returnFocus = false) {
      if (!routesPopover || !routesToggle) return;
      routesPopover.hidden = !open;
      routesToggle.setAttribute("aria-expanded", String(open));
      if (!open && returnFocus) routesToggle.focus();
    }
    routesToggle?.addEventListener("click", (event) => {
      event.stopPropagation();
      setRoutesPopover(Boolean(routesPopover?.hidden));
    });
    document.addEventListener("click", (event) => {
      if (!routesPopover || routesPopover.hidden) return;
      const target = event.target as Node;
      if (!routesPopover.contains(target) && !routesToggle?.contains(target)) setRoutesPopover(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (dockMore && !dockMore.hidden) setDockMore(false);
      if (routesPopover && !routesPopover.hidden) setRoutesPopover(false, true);
      if (aidsMedia.matches && document.documentElement.dataset.studyAids === "visible") { setAids(false, false); focusAidsTrigger(); }
      if (tocMedia.matches && document.documentElement.dataset.lessonToc === "visible") { setToc(false, false); focusTocTrigger(); }
    });

    document.addEventListener("bibli:reader-preferences-opening", () => {
      if (tocMedia.matches) setToc(false, false);
      if (aidsMedia.matches) setAids(false, false);
      setDockMore(false);
    });
    document.addEventListener("bibli:tts-opening", () => {
      if (tocMedia.matches) setToc(false, false);
      if (aidsMedia.matches) setAids(false, false);
      setDockMore(false);
    });
    document.addEventListener("bibli:global-search-opening", () => {
      if (tocMedia.matches) setToc(false, false);
      if (aidsMedia.matches) setAids(false, false);
      setDockMore(false);
    });
    document.addEventListener("bibli:reader-preferences-state", (event) => {
      const open = event instanceof CustomEvent && event.detail?.open === true;
      shell.querySelector<HTMLButtonElement>('[data-dock-action="reader"]')?.setAttribute("aria-pressed", String(open));
    });
    document.addEventListener("bibli:tts-state", (event) => {
      const open = event instanceof CustomEvent && event.detail?.open === true;
      const active = event instanceof CustomEvent && event.detail?.active === true;
      const collapsed = event instanceof CustomEvent && event.detail?.collapsed === true;
      shell.querySelector<HTMLButtonElement>('[data-dock-action="tts"]')?.setAttribute("aria-pressed", String(open || active || collapsed));
    });
    document.addEventListener("bibli:global-search-state", (event) => {
      const open = event instanceof CustomEvent && event.detail?.open === true;
      const searchDockButton = shell.querySelector<HTMLButtonElement>('[data-dock-action="search"]');
      searchDockButton?.setAttribute("aria-pressed", String(open));
      searchDockButton?.setAttribute("aria-expanded", String(open));
    });
    document.addEventListener("click", (event) => {
      if (!mobileDock || !mobileDock.classList.contains("is-expanded")) return;
      if (!mobileDock.contains(event.target as Node)) setDockMore(false);
    });

    setMode(document.documentElement.dataset.lessonMode === "reading" ? "reading" : "study");
    tocMedia.addEventListener("change", (event) => {
      if (document.documentElement.dataset.lessonMode === "study") setToc(event.matches ? false : true, false);
    });
    aidsMedia.addEventListener("change", (event) => {
      if (document.documentElement.dataset.lessonMode === "study") setAids(event.matches ? false : true, false);
    });

    shell.querySelectorAll<HTMLAnchorElement>("[data-toc-link]").forEach((link) => {
      link.addEventListener("click", () => { if (tocMedia.matches) setToc(false, false); });
    });

    const study = shell.querySelector<HTMLElement>("[data-study-content]");
    const headingKind = (label: string) => {
      if (/^dónde estamos/i.test(label)) return "location";
      if (/oración/i.test(label)) return "prayer";
      if (/encontrando a jesús|jesús|cristo/i.test(label)) return "jesus";
      if (/hilo invisible|conectar/i.test(label)) return "connection";
      if (/aplicación/i.test(label)) return "application";
      if (/meditar|reflex/i.test(label)) return "reflection";
      if (/resumen/i.test(label)) return "summary";
      return "explanation";
    };
    const enhanceHeading = (heading: Element) => {
      if (!(heading instanceof HTMLElement) || heading.dataset.iconEnhanced === "true") return;
      const clean = (heading.textContent || "").replace(/^[^\p{L}\p{N}]+/u, "").trim();
      heading.textContent = clean;
      const kind = headingKind(clean);
      const icon = document.createElement("span");
      icon.className = "lesson-heading-icon";
      icon.dataset.kind = kind;
      icon.setAttribute("aria-hidden", "true");
      const svgPaths: Record<string, string> = {
        location: '<path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle>',
        explanation: '<path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path><path d="M5.5 8H8M5.5 12H8M16 8h2.5M16 12h2.5"></path>',
        jesus: '<path d="M12 2v20"></path><path d="M5 8h14"></path>',
        connection: '<circle cx="5" cy="5" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="19" cy="19" r="2"></circle><path d="M6.7 6.7 10.3 10.3M13.7 13.7l3.6 3.6"></path><path d="M7 17c3-1 4-3 5-5"></path>',
        application: '<circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1"></circle>',
        reflection: '<path d="M9 18h6"></path><path d="M10 22h4"></path><path d="M8.3 14.8A7 7 0 1 1 15.7 14.8c-.8.6-1.2 1.2-1.4 2.2h-4.6c-.2-1-.6-1.6-1.4-2.2Z"></path>',
        summary: '<path d="m3 6 2 2 4-4"></path><path d="M11 6h10"></path><path d="m3 12 2 2 4-4"></path><path d="M11 12h10"></path><path d="m3 18 2 2 4-4"></path><path d="M11 18h10"></path>',
        prayer: '<path d="M11.8 22c-1.2-1.7-3.2-3.2-5.2-4.8C4.8 15.8 4 14 4 12V8a1.5 1.5 0 0 1 3 0v4l2-7.5a1.5 1.5 0 0 1 2.8.5v17"></path><path d="M12.2 22c1.2-1.7 3.2-3.2 5.2-4.8C19.2 15.8 20 14 20 12V8a1.5 1.5 0 0 0-3 0v4l-2-7.5a1.5 1.5 0 0 0-2.8.5v17"></path><path d="M8 15c1.5 1 2.8 2 4 3M16 15c-1.5 1-2.8 2-4 3"></path>',
      };

      const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                svg.setAttribute("viewBox", "0 0 24 24");
                svg.setAttribute("fill", "none");
                svg.setAttribute("stroke", "currentColor");
                svg.setAttribute("stroke-width", "2.15");
                svg.setAttribute("stroke-linecap", "round");
                svg.setAttribute("stroke-linejoin", "round");
                svg.setAttribute("aria-hidden", "true");
                svg.setAttribute("focusable", "false");
                svg.innerHTML = svgPaths[kind] || svgPaths.explanation;
                icon.appendChild(svg);
      heading.prepend(icon);
      heading.dataset.iconEnhanced = "true";
    };
    if (study && !study.dataset.enhanced) {
      const headings = [...study.querySelectorAll(":scope > h2")];
      headings.forEach((heading, index) => {
        enhanceHeading(heading);
        const wrapper = document.createElement("section");
        wrapper.className = "lesson-section";
        const label = heading.textContent?.trim() || "";
        if (label.includes("Encontrando a Jesús")) wrapper.classList.add("is-jesus");
        if (label.includes("Para meditar")) wrapper.classList.add("is-reflection");
        if (label.includes("Aplicación")) wrapper.classList.add("is-application");
        if (label.includes("Resumen")) wrapper.classList.add("is-summary");
        if (label.includes("Oración")) wrapper.classList.add("is-prayer");
        study.insertBefore(wrapper, heading);
        wrapper.appendChild(heading);
        let cursor = wrapper.nextSibling;
        const nextHeading = headings[index + 1];
        while (cursor && cursor !== nextHeading) {
          const next = cursor.nextSibling;
          wrapper.appendChild(cursor);
          cursor = next;
        }
      });
      study.querySelectorAll("h3").forEach(enhanceHeading);
      study.dataset.enhanced = "true";
      study.setAttribute("aria-busy", "false");
      study.style.visibility = "";
    }

    if (study?.dataset.enhanced) study.style.visibility = "";

    const tocLinks = [...shell.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
    const currentSectionText = shell.querySelector<HTMLElement>("[data-current-section-text]");
    const currentSectionIndex = shell.querySelector<HTMLElement>("[data-current-section-index]");
    const setCurrentSection = (targetId: string) => {
      const index = tocLinks.findIndex((link) => link.dataset.tocLink === `#${targetId}`);
      if (index < 0) return;
      const label = (tocLinks[index]?.querySelector("span:last-child") as HTMLElement | null)?.textContent?.trim() || "Sección";
      if (currentSectionText) currentSectionText.textContent = label;
      if (currentSectionIndex) currentSectionIndex.textContent = `${index + 1}/${tocLinks.length}`;
    };
    const observedHeadings = tocLinks.map((link) => {
      const selector = link.dataset.tocLink;
      return selector ? shell.querySelector<HTMLElement>(selector) : null;
    }).filter(Boolean) as HTMLElement[];
    if ("IntersectionObserver" in window && observedHeadings.length) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!visible) return;
        tocLinks.forEach((link) => link.classList.toggle("is-active", link.dataset.tocLink === `#${visible.target.id}`));
        setCurrentSection((visible.target as HTMLElement).id);
      }, { rootMargin: "-18% 0px -70% 0px", threshold: 0 });
      observedHeadings.forEach((heading) => observer.observe(heading));
    }

    const scrollProgress = shell.querySelector<HTMLElement>("[data-scroll-progress]");
    const backToTop = shell.querySelector<HTMLButtonElement>("[data-back-to-top]");
    const updateScroll = () => {
      const rect = shell.getBoundingClientRect();
      const totalHeight = Math.max(1, shell.offsetHeight - window.innerHeight);
      const traveled = Math.min(totalHeight, Math.max(0, -rect.top));
      if (scrollProgress) scrollProgress.style.width = `${Math.round((traveled / totalHeight) * 100)}%`;
      backToTop?.classList.toggle("is-visible", window.scrollY > 720);
    };
    backToTop?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    });
    updateScroll();
    window.addEventListener("scroll", updateScroll, { passive: true });
  });
