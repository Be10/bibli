---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudyAids from "../../components/learning/StudyAids.astro";
import { sitePath } from "../../lib/site-paths";
import { getBibleChapterPath } from "../../lib/bible-routes";
import { getStudyIntro, getStudySlug, getStudyTitle } from "../../lib/studies";
import { parseStudyReference } from "../../lib/study-reference";
import {
  getBookById,
  getBibleVersesForRange,
  getEventsByLessonId,
  getGlossaryByLessonId,
  getLessonBySlug,
  getLessonsByRouteId,
  getPeopleByLessonId,
  getRoutesByLessonId,
  getStudyPlacesByLessonId,
  getTopicsByLessonId,
  getVisualResourcesByLessonId,
  resolveBibleVersionId,
} from "../../lib/queries";

export async function getStaticPaths() {
  const entries = await getCollection("studies");
  return entries.map((entry) => ({
    params: { slug: getStudySlug(entry) },
    props: { entryId: entry.id },
  }));
}

const { slug } = Astro.params;
const { entryId } = Astro.props;
const entry = await getEntry("studies", entryId);
if (!entry || !slug) throw new Error(`Lección no encontrada: ${slug ?? entryId}`);

const lesson = getLessonBySlug(slug);
if (!lesson) throw new Error(`La lección ${slug} no está indexada. Ejecuta npm run studies:import.`);

const { Content, headings } = await render(entry);
const title = getStudyTitle(entry);
const intro = getStudyIntro(entry);
const routes = getRoutesByLessonId(lesson.id);
const route = routes[0];
const routeLessons = route ? getLessonsByRouteId(route.id) : [];
const routeIndex = routeLessons.findIndex((item) => item.id === lesson.id);
const previousLesson = routeIndex > 0 ? routeLessons[routeIndex - 1] : null;
const nextLesson = routeIndex >= 0 ? routeLessons[routeIndex + 1] ?? null : null;
const moduleTitle = routeIndex >= 0 ? routeLessons[routeIndex]?.module_title : null;

const glossary = getGlossaryByLessonId(lesson.id);
const people = getPeopleByLessonId(lesson.id);
const places = getStudyPlacesByLessonId(lesson.id);
const topics = getTopicsByLessonId(lesson.id);
const events = getEventsByLessonId(lesson.id);
const visualResources = getVisualResourcesByLessonId(lesson.id);

const range = parseStudyReference(entry.data.primary_reference);
const book = getBookById(`book-${entry.data.book_id}`);
const versionId = resolveBibleVersionId(entry.data.translation) ?? "rvr1960";
const verses = range && book
  ? getBibleVersesForRange(book.id, range.startChapter, range.startVerse, range.endChapter, range.endVerse, versionId)
  : [];
const verseGroups = new Map<number, typeof verses>();
for (const verse of verses) {
  const group = verseGroups.get(verse.chapter_number) ?? [];
  group.push(verse);
  verseGroups.set(verse.chapter_number, group);
}
const bibleHref = range && book?.usfm_code
  ? getBibleChapterPath("es", versionId, book.usfm_code, range.startChapter)
  : null;
const toc = headings.filter((heading) => heading.depth === 2);
const routeHref = route ? sitePath(`/rutas/${route.slug}/`) : sitePath("/rutas/");
---

<BaseLayout title={title} description={intro || `Estudio de ${entry.data.primary_reference}`}>
  <main class="learning-page" data-learning-shell data-lesson-id={lesson.id} data-route-id={route?.id ?? ""} data-total-lessons={routeLessons.length} data-route-lesson-ids={JSON.stringify(routeLessons.map((item) => item.id))}>
    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>

    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href={sitePath("/")}>Inicio</a>
      <span>›</span>
      <a href={routeHref}>{route?.title ?? "Rutas"}</a>
      <span>›</span>
      <span>Lección {lesson.lesson_number}</span>
    </nav>

    <header class="learning-header">
      <div>
        <p class="eyebrow">{moduleTitle ?? route?.subtitle ?? "Estudio bíblico"}</p>
        <p class="position-label">Lección {lesson.lesson_number}{routeLessons.length ? ` de ${routeLessons.length}` : ""} · {lesson.estimated_time}</p>
      </div>
      <div class="completion-summary" aria-live="polite">
        <span data-route-progress-label>Progreso personal</span>
        <strong data-route-progress-value>0%</strong>
      </div>
    </header>

    <div class="mode-toolbar" role="toolbar" aria-label="Modo de la lección">
      <div class="segmented" role="tablist" aria-label="Modo de lectura">
        <button type="button" class="is-active" data-mode-button="study" role="tab" aria-selected="true">🎓 Estudio</button>
        <button type="button" data-mode-button="reading" role="tab" aria-selected="false">📖 Lectura bíblica</button>
      </div>
      <button type="button" class="aids-toggle" data-aids-toggle aria-pressed="true">🧭 Ayudas: visibles</button>
    </div>

    <section class="route-progress" aria-label="Progreso personal en la ruta">
      <div class="route-progress-track"><span data-route-progress-bar></span></div>
    </section>

    <div class="learning-grid">
      <aside class="lesson-nav" aria-label="Navegación de la lección">
        <div class="lesson-nav-card">
          <span class="nav-kicker">En esta lección</span>
          <nav class="lesson-toc">
            {toc.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
          </nav>
        </div>
      </aside>

      <div class="lesson-stage">
        <section data-mode-panel="study">
          <article class="study-content" data-study-content>
            <Content />
          </article>
        </section>

        <section data-mode-panel="reading" hidden>
          <article class="reading-card">
            <header>
              <p class="eyebrow">Texto bíblico</p>
              <h1>{entry.data.primary_reference}</h1>
              <p>{entry.data.translation}</p>
              {bibleHref && <a class="open-bible" href={bibleHref}>Abrir en el lector bíblico ↗</a>}
            </header>

            {verseGroups.size > 0 ? (
              <div class="verse-reader">
                {[...verseGroups.entries()].map(([chapter, chapterVerses]) => (
                  <section class="chapter-block">
                    {verseGroups.size > 1 && <h2>Capítulo {chapter}</h2>}
                    <p>
                      {chapterVerses.map((verse) => (
                        <span class="verse" id={`reading-v${chapter}-${verse.verse_number}`}>
                          <sup>{verse.verse_number}</sup>{verse.verse_text}{" "}
                        </span>
                      ))}
                    </p>
                  </section>
                ))}
              </div>
            ) : (
              <p class="reading-empty">El texto no pudo resolverse desde la versión bíblica local. Puedes abrir la referencia en el lector.</p>
            )}
          </article>
        </section>

        <section class="lesson-finish">
          <div>
            <p class="eyebrow">Tu progreso</p>
            <h2>¿Terminaste esta lección?</h2>
            <p>Marcarla como completada solo afecta tu progreso en este dispositivo por ahora.</p>
          </div>
          <button type="button" class="complete-button" data-complete-lesson>✓ Marcar como completada</button>
        </section>

        <nav class="lesson-pagination" aria-label="Lección anterior y siguiente">
          {previousLesson ? (
            <a href={sitePath(`/lecciones/${previousLesson.slug}/`)} class="prev"><span>← Anterior</span><strong>{previousLesson.title}</strong></a>
          ) : <span></span>}
          {nextLesson ? (
            <a href={sitePath(`/lecciones/${nextLesson.slug}/`)} class="next"><span>Siguiente →</span><strong>{nextLesson.title}</strong></a>
          ) : route && (
            <a href={routeHref} class="next"><span>Ruta</span><strong>Volver al recorrido</strong></a>
          )}
        </nav>
      </div>

      <div class="aids-column" data-aids-column>
        <StudyAids
          glossary={glossary}
          people={people}
          places={places}
          topics={topics}
          events={events}
          visualResources={visualResources}
        />
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const PROGRESS_KEY = "bibli-learning-progress-v1";
  const MODE_KEY = "bibli-lesson-mode-v1";
  const AIDS_KEY = "bibli-study-aids-v1";

  function readProgress() {
    try {
      const value = JSON.parse(localStorage.getItem(PROGRESS_KEY) || "{}");
      return {
        completed: Array.isArray(value.completed) ? value.completed : [],
        lastLessonByRoute: value.lastLessonByRoute && typeof value.lastLessonByRoute === "object" ? value.lastLessonByRoute : {},
      };
    } catch {
      return { completed: [], lastLessonByRoute: {} };
    }
  }

  function writeProgress(progress) {
    localStorage.setItem(PROGRESS_KEY, JSON.stringify(progress));
  }

  document.querySelectorAll<HTMLElement>("[data-learning-shell]").forEach((shell) => {
    const lessonId = shell.dataset.lessonId || "";
    const routeId = shell.dataset.routeId || "";
    const total = Number(shell.dataset.totalLessons || 0);
    let routeLessonIds: string[] = [];
    try {
      routeLessonIds = JSON.parse(shell.dataset.routeLessonIds || "[]");
    } catch {
      routeLessonIds = [];
    }
    const completeButton = shell.querySelector<HTMLButtonElement>("[data-complete-lesson]");
    const progressBar = shell.querySelector<HTMLElement>("[data-route-progress-bar]");
    const progressValue = shell.querySelector<HTMLElement>("[data-route-progress-value]");

    function updateProgressUi() {
      const progress = readProgress();
      const completed = new Set(progress.completed);
      const completedOnRoute = routeId
        ? routeLessonIds.filter((id) => completed.has(id)).length
        : 0;
      const fallbackCompleted = completed.has(lessonId) ? 1 : 0;
      const count = routeId ? completedOnRoute : fallbackCompleted;
      const percent = total > 0 ? Math.round((count / total) * 100) : 0;
      if (progressBar) progressBar.style.width = `${percent}%`;
      if (progressValue) progressValue.textContent = `${percent}%`;
      if (completeButton) {
        const done = completed.has(lessonId);
        completeButton.classList.toggle("is-complete", done);
        completeButton.textContent = done ? "✓ Lección completada" : "✓ Marcar como completada";
        completeButton.setAttribute("aria-pressed", String(done));
      }
    }

    const progress = readProgress();
    if (routeId) progress.lastLessonByRoute[routeId] = lessonId;
    writeProgress(progress);

    completeButton?.addEventListener("click", () => {
      const next = readProgress();
      const completed = new Set(next.completed);
      if (completed.has(lessonId)) completed.delete(lessonId);
      else completed.add(lessonId);
      next.completed = [...completed];
      writeProgress(next);
      updateProgressUi();
    });
    updateProgressUi();

    const modeButtons = [...shell.querySelectorAll<HTMLButtonElement>("[data-mode-button]")];
    const modePanels = [...shell.querySelectorAll<HTMLElement>("[data-mode-panel]")];
    const aidsColumn = shell.querySelector<HTMLElement>("[data-aids-column]");
    const aidsToggle = shell.querySelector<HTMLButtonElement>("[data-aids-toggle]");

    function setAids(visible: boolean) {
      if (aidsColumn) aidsColumn.hidden = !visible;
      if (aidsToggle) {
        aidsToggle.setAttribute("aria-pressed", String(visible));
        aidsToggle.textContent = visible ? "🧭 Ayudas: visibles" : "🧭 Ayudas: ocultas";
      }
      localStorage.setItem(AIDS_KEY, visible ? "visible" : "hidden");
    }

    function setMode(mode: string) {
      modeButtons.forEach((button) => {
        const active = button.dataset.modeButton === mode;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-selected", String(active));
      });
      modePanels.forEach((panel) => { panel.hidden = panel.dataset.modePanel !== mode; });
      if (aidsToggle) aidsToggle.hidden = mode !== "study";
      if (aidsColumn) aidsColumn.hidden = mode !== "study" || localStorage.getItem(AIDS_KEY) === "hidden";
      localStorage.setItem(MODE_KEY, mode);
    }

    modeButtons.forEach((button) => button.addEventListener("click", () => setMode(button.dataset.modeButton || "study")));
    aidsToggle?.addEventListener("click", () => setAids(aidsColumn?.hidden ?? false));
    const aidsVisible = localStorage.getItem(AIDS_KEY) !== "hidden";
    setAids(aidsVisible);
    setMode(localStorage.getItem(MODE_KEY) === "reading" ? "reading" : "study");

    const study = shell.querySelector<HTMLElement>("[data-study-content]");
    if (study && !study.dataset.enhanced) {
      const headings = [...study.querySelectorAll(":scope > h2")];
      headings.forEach((heading, index) => {
        const wrapper = document.createElement("section");
        wrapper.className = "lesson-section";
        const label = heading.textContent?.trim() || "";
        if (label.includes("Encontrando a Jesús")) wrapper.classList.add("is-jesus");
        if (label.includes("Para meditar")) wrapper.classList.add("is-reflection");
        if (label.includes("Aplicación")) wrapper.classList.add("is-application");
        if (label.includes("Resumen")) wrapper.classList.add("is-summary");
        if (label.includes("Oración")) wrapper.classList.add("is-prayer");
        study.insertBefore(wrapper, heading);
        wrapper.appendChild(heading);
        let cursor = wrapper.nextSibling;
        const nextHeading = headings[index + 1];
        while (cursor && cursor !== nextHeading) {
          const next = cursor.nextSibling;
          wrapper.appendChild(cursor);
          cursor = next;
        }
      });
      study.dataset.enhanced = "true";
    }

    const scrollProgress = shell.querySelector<HTMLElement>("[data-scroll-progress]");
    const updateScroll = () => {
      if (!scrollProgress) return;
      const rect = shell.getBoundingClientRect();
      const totalHeight = Math.max(1, shell.offsetHeight - window.innerHeight);
      const traveled = Math.min(totalHeight, Math.max(0, -rect.top));
      scrollProgress.style.width = `${Math.round((traveled / totalHeight) * 100)}%`;
    };
    updateScroll();
    window.addEventListener("scroll", updateScroll, { passive: true });
  });
</script>

<style>
  .learning-page { width: min(1500px, calc(100% - 2rem)); margin: 0 auto; padding: 1rem 0 5rem; }
  .scroll-progress { position: fixed; inset: 0 0 auto; height: 3px; z-index: 100; pointer-events: none; }
  .scroll-progress span { display: block; width: 0; height: 100%; background: currentColor; opacity: .7; }
  .breadcrumb { display: flex; flex-wrap: wrap; gap: .4rem; font-size: .82rem; opacity: .72; margin: .5rem 0 1.2rem; }
  .learning-header { display: flex; align-items: end; justify-content: space-between; gap: 1rem; padding: 1rem 0; }
  .learning-header p { margin: 0; }
  .eyebrow { text-transform: uppercase; letter-spacing: .09em; font-size: .72rem; font-weight: 800; opacity: .62; }
  .position-label { margin-top: .35rem !important; font-size: .92rem; }
  .completion-summary { text-align: right; display: grid; gap: .15rem; font-size: .8rem; }
  .completion-summary strong { font-size: 1.35rem; }
  .mode-toolbar { position: sticky; top: .6rem; z-index: 20; display: flex; justify-content: space-between; gap: .75rem; align-items: center; padding: .6rem; border: 1px solid var(--border-color, rgba(100,100,100,.18)); border-radius: 16px; background: color-mix(in srgb, var(--page-bg, #fff) 88%, transparent); backdrop-filter: blur(16px); }
  .segmented { display: inline-flex; gap: .25rem; padding: .2rem; border-radius: 12px; background: var(--surface-soft, rgba(100,100,100,.08)); }
  .segmented button, .aids-toggle, .complete-button { border: 0; font: inherit; cursor: pointer; }
  .segmented button { padding: .55rem .8rem; border-radius: 9px; background: transparent; }
  .segmented button.is-active { background: var(--surface, #fff); box-shadow: 0 1px 5px rgba(0,0,0,.09); font-weight: 750; }
  .aids-toggle { padding: .55rem .75rem; border-radius: 10px; background: transparent; }
  .route-progress { margin: .75rem 0 1.2rem; }
  .route-progress-track { height: 6px; background: var(--surface-soft, rgba(100,100,100,.12)); border-radius: 99px; overflow: hidden; }
  .route-progress-track span { display: block; width: 0; height: 100%; background: currentColor; opacity: .65; transition: width .25s ease; }
  .learning-grid { display: grid; grid-template-columns: minmax(180px, 230px) minmax(0, 760px) minmax(260px, 340px); gap: 1.25rem; align-items: start; justify-content: center; }
  .lesson-nav, .aids-column { position: sticky; top: 5.3rem; max-height: calc(100vh - 6rem); overflow: auto; }
  .lesson-nav-card { border: 1px solid var(--border-color, rgba(100,100,100,.18)); border-radius: 16px; padding: .85rem; }
  .nav-kicker { font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; opacity: .6; }
  .lesson-toc { display: grid; gap: .18rem; margin-top: .6rem; }
  .lesson-toc a { color: inherit; text-decoration: none; font-size: .82rem; line-height: 1.35; padding: .42rem .5rem; border-radius: 8px; }
  .lesson-toc a:hover, .lesson-toc a:focus-visible { background: var(--surface-soft, rgba(100,100,100,.08)); }
  .lesson-stage { min-width: 0; }
  .study-content { font-size: 1.03rem; line-height: 1.75; }
  .study-content > :global(p:first-child) { text-transform: uppercase; letter-spacing: .07em; font-size: .78rem; opacity: .65; }
  .study-content > :global(h1) { font-size: clamp(2rem, 5vw, 3.35rem); line-height: 1.08; margin: .45rem 0 1rem; text-wrap: balance; }
  .study-content > :global(p:nth-of-type(2)) { font-weight: 650; padding: .8rem 1rem; border-radius: 12px; background: var(--surface-soft, rgba(100,100,100,.07)); }
  .study-content :global(.lesson-section) { margin: 1.15rem 0; padding: clamp(1rem, 3vw, 1.5rem); border: 1px solid var(--border-color, rgba(100,100,100,.16)); border-radius: 18px; background: var(--surface, transparent); box-shadow: 0 10px 30px rgba(0,0,0,.025); }
  .study-content :global(.lesson-section h2) { margin: 0 0 .8rem; font-size: 1.4rem; line-height: 1.25; }
  .study-content :global(.lesson-section h3) { margin-top: 1.4rem; font-size: 1.08rem; }
  .study-content :global(.lesson-section p:last-child) { margin-bottom: 0; }
  .study-content :global(.lesson-section.is-jesus) { border-left: 4px solid currentColor; }
  .study-content :global(.lesson-section.is-reflection), .study-content :global(.lesson-section.is-application) { background: var(--surface-soft, rgba(100,100,100,.055)); }
  .study-content :global(.lesson-section.is-prayer) { text-align: center; font-style: italic; }
  .study-content :global(blockquote) { margin-inline: 0; padding: .7rem 1rem; border-left: 3px solid currentColor; background: var(--surface-soft, rgba(100,100,100,.05)); }
  .reading-card { border: 1px solid var(--border-color, rgba(100,100,100,.18)); border-radius: 20px; padding: clamp(1rem, 4vw, 2rem); }
  .reading-card header { border-bottom: 1px solid var(--border-color, rgba(100,100,100,.15)); padding-bottom: 1rem; margin-bottom: 1.2rem; }
  .reading-card h1 { margin: .25rem 0; font-size: clamp(1.8rem, 5vw, 2.7rem); }
  .open-bible { display: inline-block; margin-top: .5rem; }
  .verse-reader { font-family: Georgia, "Times New Roman", serif; font-size: 1.15rem; line-height: 1.9; }
  .chapter-block h2 { font-family: inherit; font-size: .95rem; text-transform: uppercase; letter-spacing: .08em; opacity: .65; }
  .verse sup { font-family: system-ui, sans-serif; font-size: .62em; font-weight: 800; margin-right: .18rem; opacity: .65; }
  .lesson-finish { margin-top: 1.4rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-radius: 18px; padding: 1rem 1.15rem; background: var(--surface-soft, rgba(100,100,100,.07)); }
  .lesson-finish h2 { margin: .2rem 0; font-size: 1.2rem; }
  .lesson-finish p { margin: 0; }
  .complete-button { flex: 0 0 auto; border-radius: 12px; padding: .7rem 1rem; background: #203a33; color: #fff; }
  .complete-button.is-complete { opacity: .65; }
  .lesson-pagination { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; margin-top: 1rem; }
  .lesson-pagination a { color: inherit; text-decoration: none; border: 1px solid var(--border-color, rgba(100,100,100,.16)); border-radius: 14px; padding: .9rem; display: grid; gap: .25rem; }
  .lesson-pagination .next { text-align: right; }
  .lesson-pagination span { font-size: .76rem; opacity: .62; }
  [hidden] { display: none !important; }
  @media (max-width: 1120px) {
    .learning-grid { grid-template-columns: minmax(0, 760px) minmax(250px, 320px); }
    .lesson-nav { display: none; }
  }
  @media (max-width: 820px) {
    .learning-page { width: min(100% - 1rem, 760px); }
    .learning-grid { grid-template-columns: 1fr; }
    .aids-column { position: static; max-height: none; order: 2; }
    .mode-toolbar { top: .25rem; }
    .learning-header { align-items: start; }
    .lesson-finish { align-items: stretch; flex-direction: column; }
    .complete-button { width: 100%; }
  }
  @media (max-width: 560px) {
    .mode-toolbar { align-items: stretch; flex-direction: column; }
    .segmented { display: grid; grid-template-columns: 1fr 1fr; width: 100%; }
    .aids-toggle { width: 100%; }
    .completion-summary { display: none; }
    .lesson-pagination { grid-template-columns: 1fr; }
    .lesson-pagination .next { text-align: left; }
    .study-content { font-size: .99rem; }
  }
</style>
