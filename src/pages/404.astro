---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { sitePath } from "../lib/site-paths";

const homeUrl = sitePath("/");
const searchUrl = sitePath("/buscar/");
const exploreUrl = sitePath("/explorar/");
const bibleUrl = sitePath("/es/biblia/");
const routesUrl = sitePath("/rutas/");
const englishUrl = sitePath("/en/");
---

<BaseLayout
  title="Página no encontrada"
  description="La página solicitada no existe o cambió de ubicación. Continúa explorando Bibli desde la búsqueda, la Biblia o las rutas de estudio."
  robots="noindex, follow"
>
  <main class="not-found-shell">
    <section class="not-found-card" aria-labelledby="not-found-title">
      <div class="error-code" aria-hidden="true">404</div>
      <p class="eyebrow">Página no encontrada</p>
      <h1 id="not-found-title">No encontramos esta página</h1>
      <p class="lead">
        El enlace puede haber cambiado o la dirección puede estar incompleta. Puedes buscar el contenido por nombre,
        referencia bíblica, lección, ruta o tema.
      </p>

      <form class="recovery-search" action={searchUrl} method="get" role="search">
        <label for="not-found-search">Buscar en Bibli</label>
        <div class="search-row">
          <div class="search-field">
            <Icon name="search" size={19} />
            <input
              id="not-found-search"
              name="q"
              type="search"
              autocomplete="off"
              placeholder="Ej. Éxodo 12, Moisés, Lección 110…"
            />
          </div>
          <button type="submit">Buscar</button>
        </div>
      </form>

      <nav class="recovery-grid" aria-label="Opciones para continuar">
        <a href={homeUrl} class="recovery-card">
          <span class="recovery-icon"><Icon name="library" size={20} /></span>
          <span><strong>Inicio</strong><small>Volver a la portada de Bibli</small></span>
          <Icon name="chevron-right" size={18} />
        </a>
        <a href={exploreUrl} class="recovery-card">
          <span class="recovery-icon"><Icon name="compass" size={20} /></span>
          <span><strong>Explorar</strong><small>Libros, temas, eventos y más</small></span>
          <Icon name="chevron-right" size={18} />
        </a>
        <a href={bibleUrl} class="recovery-card">
          <span class="recovery-icon"><Icon name="book" size={20} /></span>
          <span><strong>Leer la Biblia</strong><small>Versiones y libros disponibles</small></span>
          <Icon name="chevron-right" size={18} />
        </a>
        <a href={routesUrl} class="recovery-card">
          <span class="recovery-icon"><Icon name="route" size={20} /></span>
          <span><strong>Rutas de estudio</strong><small>Continúa tu recorrido bíblico</small></span>
          <Icon name="chevron-right" size={18} />
        </a>
      </nav>

      <aside class="english-note" aria-label="English">
        <Icon name="globe" size={18} />
        <span><strong>Looking for the English site?</strong> Bible reading and search are available in English.</span>
        <a href={englishUrl}>Go to English <Icon name="arrow-right" size={16} /></a>
      </aside>
    </section>
  </main>
</BaseLayout>

<style>
  .not-found-shell {
    width: min(100% - 32px, 960px);
    margin: 0 auto;
    padding: clamp(48px, 8vw, 96px) 0 clamp(64px, 9vw, 112px);
  }

  .not-found-card {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 5vw, 56px);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--surface-elevated);
    box-shadow: var(--shadow-md);
  }

  .error-code {
    position: absolute;
    top: -0.22em;
    right: 0.05em;
    color: var(--accent-subtle);
    font-size: clamp(7rem, 24vw, 14rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.08em;
    pointer-events: none;
    user-select: none;
  }

  .eyebrow,
  h1,
  .lead,
  .recovery-search,
  .recovery-grid,
  .english-note {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 680px;
    margin: 0;
    color: var(--text-color);
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .lead {
    max-width: 680px;
    margin: 18px 0 0;
    color: var(--text-muted);
    font-size: clamp(1rem, 2vw, 1.12rem);
    line-height: 1.7;
  }

  .recovery-search {
    max-width: 720px;
    margin-top: 30px;
  }

  .recovery-search > label {
    display: block;
    margin-bottom: 8px;
    color: var(--text-color);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .search-row {
    display: flex;
    gap: 10px;
  }

  .search-field {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 48px;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text-muted);
  }

  .search-field:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-subtle);
  }

  .search-field input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text-color);
    font: inherit;
  }

  .search-field input::placeholder {
    color: var(--text-muted);
  }

  .search-row button {
    min-height: 48px;
    padding: 0 20px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--accent-contrast);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .search-row button:hover {
    background: var(--accent-hover);
  }

  .recovery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 30px;
  }

  .recovery-card {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto;
    min-width: 0;
    min-height: 82px;
    align-items: center;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text-color);
    text-decoration: none;
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .recovery-card:hover {
    border-color: var(--accent-border);
    background: var(--accent-subtle);
    transform: translateY(-1px);
  }

  .recovery-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--accent-subtle);
    color: var(--accent);
  }

  .recovery-card span:nth-child(2) {
    min-width: 0;
  }

  .recovery-card strong,
  .recovery-card small {
    display: block;
  }

  .recovery-card strong {
    font-size: 0.96rem;
  }

  .recovery-card small {
    margin-top: 3px;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .english-note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .english-note > svg {
    flex: 0 0 auto;
    color: var(--accent);
  }

  .english-note span {
    flex: 1 1 auto;
    min-width: 0;
  }

  .english-note strong {
    color: var(--text-color);
  }

  .english-note a {
    display: inline-flex;
    min-height: 44px;
    flex: 0 0 auto;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-weight: 750;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .not-found-shell {
      width: min(100% - 20px, 960px);
      padding-top: 28px;
    }

    .not-found-card {
      padding: 24px 18px;
    }

    .error-code {
      top: -0.05em;
      right: 0.02em;
      font-size: clamp(6rem, 34vw, 9rem);
    }

    .search-row {
      flex-direction: column;
    }

    .search-row button {
      width: 100%;
    }

    .recovery-grid {
      grid-template-columns: 1fr;
    }

    .english-note {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .english-note a {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recovery-card {
      transition: none;
    }
  }
</style>
