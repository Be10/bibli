---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudyRoomGramophone from "../../components/study-room/StudyRoomGramophone.astro";
import { sitePath } from "../../lib/site-paths";

type StudyRoomAction = {
  label: string;
  href: string;
};

type StudyRoomZone = {
  id: string;
  title: string;
  eyebrow: string;
  description: string;
  href?: string;
  objectName: string;
  icon: string;
  x: string;
  y: string;
  width: string;
  height: string;
  tone: "wood" | "paper" | "map" | "gold" | "ink" | "copper";
  status?: "active" | "soon";
  actions?: StudyRoomAction[];
};

const studyRoomZones: StudyRoomZone[] = [
  {
    id: "biblioteca",
    title: "Biblioteca Bíblica",
    eyebrow: "Libros y pasajes",
    description:
      "Explora los libros de la Biblia, pasajes destacados y la lectura bíblica completa.",
    href: sitePath("/es/biblia/"),
    objectName: "Gran librero con libros, rollos y cartas",
    icon: "📚",
    x: "5%",
    y: "10%",
    width: "24%",
    height: "39%",
    tone: "wood",
    status: "active",
    actions: [
      { label: "Leer Biblia", href: sitePath("/es/biblia/") },
      { label: "Ver libros", href: sitePath("/libros/") },
      { label: "Ver pasajes", href: sitePath("/pasajes/") },
    ],
  },
  {
    id: "linea-tiempo",
    title: "Línea de Tiempo",
    eyebrow: "Historia bíblica",
    description:
      "Recorre la historia bíblica en orden, desde la creación hasta la iglesia primitiva.",
    href: sitePath("/linea-de-tiempo/"),
    objectName: "Pergamino horizontal en la pared",
    icon: "📜",
    x: "34%",
    y: "8%",
    width: "28%",
    height: "18%",
    tone: "paper",
    status: "active",
    actions: [
      { label: "Ver línea de tiempo", href: sitePath("/linea-de-tiempo/") },
      { label: "Ver eventos", href: sitePath("/eventos/") },
    ],
  },
  {
    id: "mapas",
    title: "Mapas Bíblicos",
    eyebrow: "Lugares y regiones",
    description:
      "Ubica lugares, regiones, rutas y acontecimientos dentro del mundo bíblico.",
    href: sitePath("/mapa/"),
    objectName: "Caballete con mapa antiguo y globo",
    icon: "🗺️",
    x: "69%",
    y: "9%",
    width: "26%",
    height: "40%",
    tone: "map",
    status: "active",
    actions: [
      { label: "Abrir mapa", href: sitePath("/mapa/") },
      { label: "Ver lugares", href: sitePath("/lugares/") },
    ],
  },
  {
    id: "glosario",
    title: "Glosario Visual",
    eyebrow: "Términos y conceptos",
    description:
      "Consulta términos bíblicos con explicaciones breves, conexiones y enfoque visual.",
    href: sitePath("/glosario/"),
    objectName: "Fichero antiguo con tarjetas ilustradas",
    icon: "🗃️",
    x: "7%",
    y: "53%",
    width: "21%",
    height: "18%",
    tone: "copper",
    status: "active",
    actions: [
      { label: "Abrir glosario", href: sitePath("/glosario/") },
      { label: "Explorar temas", href: sitePath("/temas/") },
    ],
  },
  {
    id: "genealogias-personajes",
    title: "Genealogías y Personajes",
    eyebrow: "Linajes y biografías",
    description:
      "Explora personajes bíblicos, relaciones familiares, linajes y conexiones narrativas.",
    href: sitePath("/personajes/"),
    objectName: "Árbol genealógico mural con retratos",
    icon: "🌳",
    x: "38%",
    y: "31%",
    width: "25%",
    height: "22%",
    tone: "paper",
    status: "active",
    actions: [
      { label: "Ver personajes", href: sitePath("/personajes/") },
      { label: "Explorar eventos", href: sitePath("/eventos/") },
    ],
  },
  {
    id: "escenas-infografias",
    title: "Escenas e Infografías",
    eyebrow: "Recursos visuales",
    description:
      "Reúne escenas bíblicas, láminas, diagramas, imágenes e infografías de estudio.",
    href: sitePath("/recursos/"),
    objectName: "Caballete de pintura y láminas visuales",
    icon: "🖼️",
    x: "70%",
    y: "53%",
    width: "24%",
    height: "18%",
    tone: "gold",
    status: "active",
    actions: [
      { label: "Ver recursos", href: sitePath("/recursos/") },
      { label: "Explorar Bibli", href: sitePath("/explorar/") },
    ],
  },
  {
    id: "rutas",
    title: "Rutas de Estudio",
    eyebrow: "Lecciones guiadas",
    description:
      "Continúa tus rutas, lecciones, estudios cortos, escritura guiada y oración guiada.",
    href: sitePath("/lecciones/"),
    objectName: "Bitácora abierta sobre la mesa central",
    icon: "📖",
    x: "33%",
    y: "61%",
    width: "34%",
    height: "25%",
    tone: "paper",
    status: "active",
    actions: [
      { label: "Ver lecciones", href: sitePath("/lecciones/") },
      {
        label: "Ruta principal",
        href: sitePath("/rutas/panorama-visual-de-la-biblia/"),
      },
    ],
  },
  {
    id: "audio",
    title: "Audio Bíblico",
    eyebrow: "Escucha y medita",
    description:
      "Futura zona para escuchar la Biblia, rutas narradas, glosario narrado y recursos de audio.",
    objectName: "Gramófono antiguo",
    icon: "🎧",
    x: "6%",
    y: "76%",
    width: "20%",
    height: "15%",
    tone: "gold",
    status: "soon",
  },
  {
    id: "estructuras",
    title: "Estructuras Bíblicas",
    eyebrow: "Modelos y planos",
    description:
      "Futura zona para explorar el tabernáculo, templos, ciudades, objetos y estructuras bíblicas.",
    href: sitePath("/recursos/"),
    objectName: "Mesa de maquetas y planos arquitectónicos",
    icon: "🏛️",
    x: "42%",
    y: "87%",
    width: "22%",
    height: "10%",
    tone: "wood",
    status: "soon",
    actions: [{ label: "Ver recursos actuales", href: sitePath("/recursos/") }],
  },
  {
    id: "notas",
    title: "Mis Anotaciones",
    eyebrow: "Notas y favoritos",
    description:
      "Futura zona personal para notas, favoritos, progreso, marcas y reflexiones del usuario.",
    objectName: "Máquina de escribir y tablero de notas",
    icon: "📝",
    x: "73%",
    y: "76%",
    width: "22%",
    height: "16%",
    tone: "ink",
    status: "soon",
  },
];

const defaultZone = studyRoomZones.find((zone) => zone.id === "rutas") ?? studyRoomZones[0];

const quickAccess = [
  {
    title: "Continuar estudio",
    description: "Ir a las lecciones",
    href: sitePath("/lecciones/"),
    icon: "⏱️",
  },
  {
    title: "Buscar",
    description: "Todo el contenido de Bibli",
    href: sitePath("/buscar/"),
    icon: "🔎",
  },
  {
    title: "Mapa",
    description: "Lugares bíblicos",
    href: sitePath("/mapa/"),
    icon: "🗺️",
  },
  {
    title: "Biblia",
    description: "RVR1960",
    href: sitePath("/es/biblia/"),
    icon: "📖",
  },
];
---

<BaseLayout
  title="Estudio Bíblico Visual"
  description="Sala de estudio antique interactiva para explorar la Biblioteca Bíblica por módulos, rutas, mapas, Biblia, glosario y recursos visuales."
>
  <main class="study-page">
    <section class="study-hero" aria-labelledby="study-room-title">
      <div class="study-hero__content">
        <p class="study-eyebrow">Prototipo visual interactivo</p>
        <h1 id="study-room-title">Estudio Bíblico Visual</h1>
        <p>
          Una sala privada de estudio con estética antique/victoriana para explorar la Biblia,
          rutas, mapas, recursos visuales, personajes, glosario y futuras herramientas personales.
        </p>
      </div>

      <form class="study-search" action={sitePath("/buscar/")} method="get">
        <label for="study-search-input">Buscar en Bibli</label>
        <div class="study-search__control">
          <input
            id="study-search-input"
            type="search"
            name="q"
            placeholder="Buscar libro, tema, lugar, pasaje..."
          />
          <button type="submit">Buscar</button>
        </div>
      </form>
    </section>

    <section class="study-room-shell" aria-labelledby="study-room-map-title">
      <div class="study-room-header">
        <div>
          <p class="study-eyebrow">Sala interactiva</p>
          <h2 id="study-room-map-title">Explora por objetos de estudio</h2>
        </div>

        <div class="study-version-badge" aria-label="Versión bíblica objetivo">
          RVR1960
        </div>
      </div>

      <div class="study-room-layout">
        <div class="study-room" aria-label="Mapa visual de la sala de estudio">
          <div class="study-room__background" aria-hidden="true">
            <span class="wall-light wall-light--left"></span>
            <span class="wall-light wall-light--right"></span>
            <span class="floor-shadow"></span>
          </div>

          {
            studyRoomZones.map((zone) => {
              const zoneStyle = `--zone-x:${zone.x};--zone-y:${zone.y};--zone-width:${zone.width};--zone-height:${zone.height};`;

              return (
                <article
                  class:list={[
                    "study-zone",
                    `study-zone--${zone.tone}`,
                    zone.status === "soon" && "study-zone--soon",
                  ]}
                  style={zoneStyle}
                >
                  <button
                    type="button"
                    class="study-zone__button"
                    data-zone-id={zone.id}
                    aria-label={`Seleccionar ${zone.title}`}
                  >
                    <div class="study-zone__object" aria-hidden="true">
  {
    zone.id === "audio" ? (
      <StudyRoomGramophone />
    ) : (
      <>
        <span class="study-zone__icon">{zone.icon}</span>
        <span class="study-zone__object-name">{zone.objectName}</span>
      </>
    )
  }
</div>
                  </button>

                  <div class="study-zone__tooltip" role="tooltip">
                    <p>{zone.eyebrow}</p>
                    <h3>{zone.title}</h3>
                    <span>{zone.description}</span>
                    <strong>
                      {zone.status === "soon"
                        ? "Próximamente"
                        : "Haz clic para ver opciones"}
                    </strong>
                  </div>
                </article>
              );
            })
          }
        </div>

        <aside class="study-context-panel" aria-live="polite">
          <div class="study-context-panel__top">
            <span id="study-panel-icon" aria-hidden="true">{defaultZone.icon}</span>

            <div>
              <p id="study-panel-eyebrow">{defaultZone.eyebrow}</p>
              <h3 id="study-panel-title">{defaultZone.title}</h3>
            </div>
          </div>

          <p id="study-panel-description">{defaultZone.description}</p>

          <dl>
            <div>
              <dt>Objeto visual</dt>
              <dd id="study-panel-object">{defaultZone.objectName}</dd>
            </div>

            <div>
              <dt>Estado</dt>
              <dd id="study-panel-status">
                {defaultZone.status === "soon" ? "Próximamente" : "Activo"}
              </dd>
            </div>
          </dl>

          <div class="study-context-panel__actions" id="study-panel-actions">
            {
              defaultZone.actions && defaultZone.actions.length > 0 ? (
                defaultZone.actions.map((action) => <a href={action.href}>{action.label}</a>)
              ) : (
                <span>Se conectará en una fase posterior</span>
              )
            }
          </div>

          <p class="study-context-panel__hint">
            Selecciona un objeto de la sala para ver sus accesos principales.
          </p>
        </aside>
      </div>

      <div class="study-room-mobile">
        {
          studyRoomZones.map((zone) => (
            <article
              class:list={[
                "study-mobile-card",
                zone.status === "soon" && "study-mobile-card--soon",
              ]}
            >
              <div class="study-mobile-card__icon" aria-hidden="true">
                {zone.icon}
              </div>

              <div>
                <p>{zone.eyebrow}</p>
                <h3>{zone.title}</h3>
                <span>{zone.description}</span>

                <div class="study-mobile-card__actions">
                  {
                    zone.status === "soon" ? (
                      <strong>Próximamente</strong>
                    ) : (
                      <a href={zone.href}>Abrir sección</a>
                    )
                  }
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="study-detail-grid" aria-label="Detalle de zonas de estudio">
      {
        studyRoomZones.map((zone) => (
          <article class="study-detail-card">
            <div class="study-detail-card__header">
              <span aria-hidden="true">{zone.icon}</span>
              <div>
                <p>{zone.eyebrow}</p>
                <h2>{zone.title}</h2>
              </div>
            </div>

            <p>{zone.description}</p>

            <dl>
              <div>
                <dt>Objeto visual</dt>
                <dd>{zone.objectName}</dd>
              </div>

              <div>
                <dt>Estado</dt>
                <dd>{zone.status === "soon" ? "Próximamente" : "Activo"}</dd>
              </div>
            </dl>

            {
              zone.actions && zone.actions.length > 0 ? (
                <div class="study-detail-card__actions">
                  {zone.actions.map((action) => (
                    <a href={action.href}>{action.label}</a>
                  ))}
                </div>
              ) : (
                <div class="study-detail-card__actions">
                  <span>Se conectará en una fase posterior</span>
                </div>
              )
            }
          </article>
        ))
      }
    </section>

    <section class="study-quick-access" aria-label="Accesos rápidos">
      <div>
        <p class="study-eyebrow">Acceso rápido</p>
        <h2>Entradas principales</h2>
      </div>

      <div class="study-quick-access__grid">
        {
          quickAccess.map((item) => (
            <a href={item.href} class="study-quick-link">
              <span aria-hidden="true">{item.icon}</span>
              <strong>{item.title}</strong>
              <small>{item.description}</small>
            </a>
          ))
        }
      </div>
    </section>
  </main>

  <script type="application/json" id="study-room-zones-data" set:html={JSON.stringify(studyRoomZones)} />

  <script>
    const zonesDataElement = document.getElementById("study-room-zones-data");
    const zoneButtons = document.querySelectorAll("[data-zone-id]");

    const panelIcon = document.getElementById("study-panel-icon");
    const panelEyebrow = document.getElementById("study-panel-eyebrow");
    const panelTitle = document.getElementById("study-panel-title");
    const panelDescription = document.getElementById("study-panel-description");
    const panelObject = document.getElementById("study-panel-object");
    const panelStatus = document.getElementById("study-panel-status");
    const panelActions = document.getElementById("study-panel-actions");

    const zones = zonesDataElement?.textContent ? JSON.parse(zonesDataElement.textContent) : [];

    function clearSelectedZones() {
      zoneButtons.forEach((button) => {
        button.removeAttribute("aria-pressed");
        button.closest(".study-zone")?.classList.remove("study-zone--selected");
      });
    }

    function renderActions(zone) {
  if (!panelActions) return;

  panelActions.innerHTML = "";

  if (zone.id === "audio") {
    const playButton = document.createElement("button");
    playButton.type = "button";
    playButton.textContent = "Reproducir demo";
    playButton.setAttribute("data-gramophone-panel-toggle", "true");

    const changeButton = document.createElement("button");
    changeButton.type = "button";
    changeButton.textContent = "Cambiar disco demo";
    changeButton.setAttribute("data-gramophone-panel-change", "true");

    playButton.addEventListener("click", () => {
      const gramophone = document.querySelector("[data-gramophone]");
      if (!gramophone) return;

      const isPlaying = gramophone.classList.toggle("is-playing");
      playButton.textContent = isPlaying ? "Pausar demo" : "Reproducir demo";
    });

    changeButton.addEventListener("click", () => {
      const gramophone = document.querySelector("[data-gramophone]");
      if (!gramophone) return;

      gramophone.classList.add("is-changing-record");

      window.setTimeout(() => {
        gramophone.classList.remove("is-changing-record");
      }, 220);
    });

    panelActions.appendChild(playButton);
    panelActions.appendChild(changeButton);

    return;
  }

  if (!zone.actions || zone.actions.length === 0) {
    const soon = document.createElement("span");
    soon.textContent =
      zone.status === "soon"
        ? "Se conectará en una fase posterior"
        : "Sin accesos configurados";
    panelActions.appendChild(soon);
    return;
  }

  zone.actions.forEach((action) => {
    const link = document.createElement("a");
    link.href = action.href;
    link.textContent = action.label;
    panelActions.appendChild(link);
  });
}

    function selectZone(zoneId) {
      const zone = zones.find((item) => item.id === zoneId);
      if (!zone) return;

      if (panelIcon) panelIcon.textContent = zone.icon;
      if (panelEyebrow) panelEyebrow.textContent = zone.eyebrow;
      if (panelTitle) panelTitle.textContent = zone.title;
      if (panelDescription) panelDescription.textContent = zone.description;
      if (panelObject) panelObject.textContent = zone.objectName;
      if (panelStatus) panelStatus.textContent = zone.status === "soon" ? "Próximamente" : "Activo";

      renderActions(zone);
      clearSelectedZones();

      const selectedButton = document.querySelector(`[data-zone-id="${zoneId}"]`);
      selectedButton?.setAttribute("aria-pressed", "true");
      selectedButton?.closest(".study-zone")?.classList.add("study-zone--selected");
    }

    zoneButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const zoneId = button.getAttribute("data-zone-id");
        if (!zoneId) return;

        selectZone(zoneId);
      });
    });

    selectZone("rutas");
  </script>
</BaseLayout>

<style>
  .study-page {
    --study-bg: #1f1710;
    --study-wood: #5c351b;
    --study-gold: #c9a24d;
    --study-gold-soft: #e6c979;
    --study-paper: #f1e2bf;
    --study-muted: #bfa983;
    --study-line: rgba(201, 162, 77, 0.32);
    --study-radius-lg: 32px;

    display: grid;
    gap: 24px;
    color: var(--study-paper);
  }

  .study-page * {
    box-sizing: border-box;
  }

  .study-eyebrow {
    margin: 0 0 8px;
    color: var(--study-gold-soft);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .study-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 22px;
    align-items: stretch;
    padding: clamp(24px, 4vw, 42px);
    border: 1px solid var(--study-line);
    border-radius: var(--study-radius-lg);
    background:
      radial-gradient(circle at 12% 18%, rgba(201, 162, 77, 0.2), transparent 36%),
      linear-gradient(135deg, #2a180d, #120d08 58%, #25170d);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.28);
    overflow: hidden;
  }

  .study-hero__content {
    max-width: 820px;
  }

  .study-hero h1 {
    margin: 0;
    color: #fff5dd;
    font-size: clamp(2.1rem, 6vw, 4.8rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .study-hero p:not(.study-eyebrow) {
    max-width: 720px;
    margin: 18px 0 0;
    color: #d8c39d;
    font-size: clamp(1rem, 1.8vw, 1.18rem);
    line-height: 1.75;
  }

  .study-search {
    align-self: center;
    display: grid;
    gap: 10px;
    padding: 18px;
    border: 1px solid rgba(201, 162, 77, 0.35);
    border-radius: 24px;
    background: rgba(12, 9, 6, 0.58);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .study-search label {
    color: var(--study-gold-soft);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .study-search__control {
    display: flex;
    gap: 10px;
  }

  .study-search input {
    width: 100%;
    min-width: 0;
    border: 1px solid rgba(201, 162, 77, 0.28);
    border-radius: 16px;
    background: rgba(255, 245, 221, 0.08);
    color: #fff5dd;
    padding: 12px 14px;
    outline: none;
  }

  .study-search input::placeholder {
    color: rgba(241, 226, 191, 0.6);
  }

  .study-search input:focus {
    border-color: var(--study-gold);
    box-shadow: 0 0 0 4px rgba(201, 162, 77, 0.14);
  }

  .study-search button {
    border: 1px solid var(--study-gold);
    border-radius: 16px;
    background: var(--study-gold);
    color: #1d1309;
    padding: 0 16px;
    font-weight: 900;
    cursor: pointer;
  }

  .study-room-shell {
    display: grid;
    gap: 18px;
    padding: clamp(16px, 2.5vw, 24px);
    border: 1px solid var(--study-line);
    border-radius: var(--study-radius-lg);
    background:
      linear-gradient(180deg, rgba(255, 245, 221, 0.05), transparent 26%),
      #120d08;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.28);
  }

  .study-room-header {
    display: flex;
    gap: 18px;
    justify-content: space-between;
    align-items: center;
  }

  .study-room-header h2,
  .study-quick-access h2 {
    margin: 0;
    color: #fff5dd;
    font-size: clamp(1.4rem, 2.8vw, 2.3rem);
    letter-spacing: -0.04em;
  }

  .study-version-badge {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 112px;
    padding: 12px 18px;
    border: 1px solid rgba(201, 162, 77, 0.55);
    border-radius: 999px;
    background:
      radial-gradient(circle at 50% 0%, rgba(230, 201, 121, 0.22), transparent 70%),
      rgba(43, 28, 16, 0.9);
    color: var(--study-gold-soft);
    font-size: 1.05rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .study-room-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 18px;
    align-items: stretch;
  }

  .study-room {
    position: relative;
    display: block;
    min-height: clamp(540px, 58vw, 760px);
    border: 1px solid rgba(201, 162, 77, 0.28);
    border-radius: 30px;
    overflow: hidden;
    background:
      linear-gradient(
        180deg,
        rgba(62, 41, 24, 0.75) 0%,
        rgba(44, 27, 14, 0.78) 54%,
        rgba(28, 16, 8, 0.95) 55%,
