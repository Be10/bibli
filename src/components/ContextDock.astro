---
import { sitePath } from "../lib/site-paths";
import { getBibleRootPath } from "../lib/bible-routes";
import Icon from "./Icon.astro";

type LanguageCode = "es" | "en";
interface Props {
  lang?: LanguageCode;
  currentPath?: string;
}

const { lang = "es", currentPath = Astro.url.pathname } = Astro.props;
const home = lang === "en" ? sitePath("/en/") : sitePath("/");
const bible = getBibleRootPath(lang);

const contextualItem = lang === "es"
  ? currentPath.includes("/mapa")
    ? { href: sitePath("/linea-de-tiempo/"), label: "Cronología", icon: "timeline" as const }
    : currentPath.includes("/linea-de-tiempo")
      ? { href: sitePath("/mapa/"), label: "Mapa", icon: "map" as const }
      : currentPath.includes("/rutas/")
        ? { href: sitePath("/lecciones/"), label: "Lecciones", icon: "list" as const }
        : null
  : null;

const items = lang === "en"
  ? [
      { href: home, label: "Home", icon: "home" as const },
      { href: bible, label: "Bible", icon: "book" as const },
      { href: sitePath("/en/download/"), label: "Offline", icon: "download" as const },
    ]
  : [
      { href: home, label: "Inicio", icon: "home" as const },
      { href: bible, label: "Biblia", icon: "book" as const },
      { href: sitePath("/rutas/"), label: "Rutas", icon: "route" as const },
      { href: sitePath("/explorar/"), label: "Explorar", icon: "compass" as const },
      ...(contextualItem ? [contextualItem] : []),
    ];

const normalize = (value: string) => value === "/" ? "/" : `${value.replace(/\/+$/, "")}/`;
const activePath = normalize(currentPath);
const homePath = normalize(new URL(home, Astro.url).pathname);
const isCurrent = (href: string) => {
  const target = normalize(new URL(href, Astro.url).pathname);
  if (target === homePath) return activePath === homePath;
  return activePath === target || activePath.startsWith(target);
};
const searchLabel = lang === "en" ? "Search" : "Buscar";
---

<nav class="context-dock" data-context-dock aria-label={lang === "en" ? "Bibli quick navigation" : "Navegación rápida de Bibli"}>
  {items.map((item) => {
    const current = isCurrent(item.href);
    return (
      <a href={item.href} class:list={["context-dock-action", current && "is-current"]} aria-label={item.label} title={item.label} aria-current={current ? "page" : undefined}>
        <Icon name={item.icon} size={19} />
      </a>
    );
  })}
  <button
    type="button"
    class="context-dock-action context-dock-search"
    data-context-search
    aria-label={searchLabel}
    title={searchLabel}
    aria-expanded="false"
    aria-controls="bibli-global-search"
  >
    <Icon name="search" size={19} />
  </button>
</nav>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-context-search]").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      document.dispatchEvent(new CustomEvent("bibli:global-search-toggle", { detail: { trigger: button } }));
    });
  });
</script>

<style>
  .context-dock {
    position: fixed;
    z-index: 90;
    left: 50%;
    bottom: max(12px, env(safe-area-inset-bottom));
    width: fit-content;
    max-width: calc(100vw - 20px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px;
    border: 1px solid color-mix(in srgb, var(--border-color) 88%, transparent);
    border-radius: 18px;
    background: var(--surface-elevated);
    box-shadow: 0 8px 24px rgba(15,23,42,.10);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transform: translateX(-50%);
    transition: background-color 160ms ease;
  }
  .context-dock-action {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--text-muted);
    text-decoration: none;
    font: inherit;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, box-shadow 160ms ease;
  }
  .context-dock-action:hover,
  .context-dock-action.is-current,
  .context-dock-action[aria-expanded="true"] {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .context-dock-action:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .context-dock-action:active {
    transform:none;
    background:var(--accent-soft);
    color:var(--accent);
    box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent) 30%,transparent);
  }
  /* All dock glyphs keep identical geometry while state changes. */
  .context-dock-action :global(.bibli-icon) { transform:none !important; }
  .context-dock-search :global(.bibli-icon) { width:19px; height:19px; flex:0 0 19px; }
  :global(body:has([data-global-menu]:not([hidden]))) .context-dock {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  :global(.site-footer) {
    padding-bottom: calc(5.8rem + env(safe-area-inset-bottom));
  }
  @media (max-width: 430px) {
    .context-dock { bottom: max(8px, env(safe-area-inset-bottom)); padding: 5px; gap: 2px; border-radius: 16px; }
    .context-dock-action { width: 42px; height: 42px; flex-basis: 42px; }
  }

  @media (hover: none), (pointer: coarse) {
    .context-dock-action:hover:not(.is-current):not([aria-expanded="true"]) {
      background: transparent;
      color: var(--text-muted);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .context-dock, .context-dock-action { transition: none; }
  }
</style>
