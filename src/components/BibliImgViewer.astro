---
type Props = {
  id?: string;
  lang?: "es" | "en";
};

const {
  id = "study-aid-bibli-img-viewer",
  lang = "es",
} = Astro.props;

const copy = lang === "en"
  ? {
      dialog: "Expanded image",
      close: "Close expanded image",
      unavailable: "The expanded image is not available offline.",
    }
  : {
      dialog: "Vista ampliada",
      close: "Cerrar imagen ampliada",
      unavailable: "La imagen ampliada no está disponible sin conexión.",
    };
---

<dialog
  id={id}
  class="bibli-img-dialog"
  data-bibli-img-dialog
  aria-label={copy.dialog}
>
  <div class="bibli-img-dialog-shell">
    <button
      type="button"
      class="bibli-img-dialog-close"
      data-bibli-img-close
      aria-label={copy.close}
    >
      ×
    </button>

    <div class="bibli-img-dialog-media">
      <img
        data-bibli-img-dialog-image
        alt=""
        decoding="async"
        hidden
      />

      <p
        class="bibli-img-dialog-status"
        data-bibli-img-dialog-status
        role="status"
        aria-live="polite"
        hidden
      >
        {copy.unavailable}
      </p>
    </div>

    <p
      class="bibli-img-dialog-caption"
      data-bibli-img-dialog-caption
      hidden
    ></p>
  </div>
</dialog>

<style>
  :global(html.bibli-img-dialog-open) {
    overflow: hidden;
  }

  .bibli-img-dialog {
    width: min(96vw, 1120px);
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 1px solid var(--border-color);
    border-radius: 24px;
    background: var(--surface);
    color: var(--text-color);
    box-shadow: 0 28px 80px rgba(2, 6, 23, .34);
  }

  .bibli-img-dialog::backdrop {
    background: rgba(2, 6, 23, .78);
    backdrop-filter: blur(4px);
  }

  .bibli-img-dialog-shell {
    position: relative;
    display: grid;
    gap: 12px;
    max-height: 92vh;
    padding: 18px;
    overflow: auto;
  }

  .bibli-img-dialog-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    color: var(--heading-color);
    font-size: 1.7rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    touch-action: manipulation;
  }

  .bibli-img-dialog-close:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent) 72%, white);
    outline-offset: 2px;
  }

  .bibli-img-dialog-media {
    display: grid;
    place-items: center;
    min-height: min(70vh, 760px);
    padding: 28px;
    border-radius: 18px;
    background: var(--surface-soft);
  }

  .bibli-img-dialog-media img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 78vh;
    object-fit: contain;
  }

  .bibli-img-dialog-status {
    margin: 0;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.6;
  }

  .bibli-img-dialog-caption {
    margin: 0;
    color: var(--text-muted);
    font-size: .82rem;
    text-align: center;
  }

  @media (max-width: 820px) {
    .bibli-img-dialog {
      width: 100vw;
      height: 100dvh;
      max-width: 100vw;
      max-height: 100dvh;
      border: 0;
      border-radius: 0;
    }

    .bibli-img-dialog-shell {
      min-height: 100dvh;
      max-height: 100dvh;
      padding: 64px 12px 12px;
    }

    .bibli-img-dialog-media {
      min-height: 0;
      height: calc(100dvh - 128px);
      padding: 12px;
    }

    .bibli-img-dialog-media img {
      max-height: 100%;
    }
  }
</style>

<script>
  const dialog =
    document.querySelector("[data-bibli-img-dialog]");

  if (dialog instanceof HTMLDialogElement) {
    const closeButton =
      dialog.querySelector("[data-bibli-img-close]");

    const image =
      dialog.querySelector("[data-bibli-img-dialog-image]");

    const status =
      dialog.querySelector("[data-bibli-img-dialog-status]");

    const caption =
      dialog.querySelector("[data-bibli-img-dialog-caption]");

    let activeTrigger = null;

    const openViewer = (trigger) => {
      const highUrl = trigger.dataset.bibliImgHigh;

      if (
        !highUrl ||
        !(closeButton instanceof HTMLButtonElement) ||
        !(image instanceof HTMLImageElement) ||
        !(status instanceof HTMLElement) ||
        !(caption instanceof HTMLElement)
      ) {
        return;
      }

      activeTrigger = trigger;

      image.alt =
        trigger.dataset.bibliImgAlt ?? "";

      caption.textContent =
        trigger.dataset.bibliImgCaption ?? "";

      caption.hidden =
        caption.textContent.length === 0;

      status.hidden = true;
      image.hidden = false;

      image.src = highUrl;

      document.documentElement.classList.add(
        "bibli-img-dialog-open"
      );

      dialog.showModal();
      closeButton.focus();
    };

    document.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Element)) return;

      const trigger =
        target.closest("[data-bibli-img-open]");

      if (!(trigger instanceof HTMLElement)) return;

      if (
        trigger.getAttribute("aria-controls") !== dialog.id
      ) {
        return;
      }

      event.preventDefault();
      openViewer(trigger);
    });

    closeButton?.addEventListener(
      "click",
      () => dialog.close()
    );

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });

    image?.addEventListener("load", () => {
      image.hidden = false;

      if (status instanceof HTMLElement) {
        status.hidden = true;
      }
    });

    image?.addEventListener("error", () => {
      image.hidden = true;

      if (status instanceof HTMLElement) {
        status.hidden = false;
      }
    });

    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove(
        "bibli-img-dialog-open"
      );

      if (image instanceof HTMLImageElement) {
        image.removeAttribute("src");
        image.hidden = true;
      }

      if (status instanceof HTMLElement) {
        status.hidden = true;
      }

      if (activeTrigger instanceof HTMLElement) {
        activeTrigger.focus();
      }

      activeTrigger = null;
    });
  }
</script>
