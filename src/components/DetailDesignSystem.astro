---
// Shared visual system for entity detail pages and learning detail shells.
// No markup: BaseLayout hoists this global stylesheet once.
---

<style is:global>
  /* Detail design system --------------------------------------------------- */
  main[data-detail-root] {
    --detail-gap: clamp(.9rem, 1.8vw, 1.3rem);
    --detail-pad: clamp(1rem, 2.3vw, 1.6rem);
    --detail-radius: 18px;
    --detail-card-radius: 15px;
    --detail-border: color-mix(in srgb, var(--border-color) 88%, var(--accent) 12%);
  }

  main.page[data-detail-root] {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  main.page[data-detail-root] > .breadcrumb {
    margin-bottom: 14px !important;
  }

  main.page[data-detail-root] > .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(190px, 250px);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: stretch;
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--detail-border);
    border-radius: clamp(18px, 2vw, 24px);
    overflow: hidden;
  }

  main.page[data-detail-root] > .hero > :first-child {
    align-self: center;
    min-width: 0;
    max-width: 780px;
  }

  main.page[data-detail-root] > .hero h1 {
    margin: .28rem 0 .65rem;
    max-width: 18ch;
    font-size: clamp(2.05rem, 5vw, 3.45rem);
    line-height: .98;
    letter-spacing: -.052em;
  }

  main.page[data-detail-root] > .hero .subtitle {
    max-width: 68ch;
    margin: 0;
    font-size: clamp(.96rem, 1.4vw, 1.04rem);
    line-height: 1.65;
  }

  main.page[data-detail-root] > .hero .actions {
    display: flex;
    flex-wrap: wrap;
    gap: .58rem;
    margin-top: 1.05rem;
  }

  main.page[data-detail-root] > .hero .actions .button {
    min-height: 44px;
    justify-content: center;
  }

  main.page[data-detail-root] > .hero :is(
    .book-hero-card,
    .person-hero-card,
    .topic-hero-card,
    .event-hero-card,
    .place-hero-card,
    .passage-hero-card,
    .visual-resource-status-card
  ) {
    position: relative;
    isolation: isolate;
    min-width: 0;
    min-height: 158px;
    display: grid;
    align-content: center;
    gap: .34rem;
    padding: clamp(1rem, 2vw, 1.3rem);
    border: 1px solid var(--accent-border);
    border-radius: 18px;
    background: linear-gradient(145deg, color-mix(in srgb, var(--accent-soft) 58%, var(--surface)), var(--surface));
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 24%, transparent);
    overflow: hidden;
  }

  main.page[data-detail-root] > .hero :is(
    .book-hero-card,
    .person-hero-card,
    .topic-hero-card,
    .event-hero-card,
    .place-hero-card,
    .passage-hero-card,
    .visual-resource-status-card
  )::after {
    content: "";
    position: absolute;
    z-index: -1;
    right: -34px;
    bottom: -42px;
    width: 126px;
    height: 126px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 18%, transparent), transparent 68%);
    pointer-events: none;
  }

  main.page[data-detail-root] > :is(
    .book-meta-grid,
    .person-meta-grid,
    .topic-meta-grid,
    .event-meta-grid,
    .place-meta-grid,
    .passage-meta-grid
  ) {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: .7rem;
    margin: var(--detail-gap) 0 0;
  }

  main.page[data-detail-root] > :is(
    .book-meta-grid,
    .person-meta-grid,
    .topic-meta-grid,
    .event-meta-grid,
    .place-meta-grid,
    .passage-meta-grid
  ) > :is(
    .book-meta-card,
    .person-meta-card,
    .topic-meta-card,
    .event-meta-card,
    .place-meta-card,
    .passage-meta-card
  ) {
    min-width: 0;
    min-height: 102px;
    display: grid;
    align-content: center;
    gap: .3rem;
    padding: 1rem;
    border: 1px solid var(--detail-border);
    border-radius: var(--detail-card-radius);
    background: var(--surface);
    box-shadow: 0 8px 22px rgba(15, 23, 42, .035);
  }

  main.page[data-detail-root] > :is(
    .book-meta-grid,
    .person-meta-grid,
    .topic-meta-grid,
    .event-meta-grid,
    .place-meta-grid,
    .passage-meta-grid
  ) > :is(
    .book-meta-card,
    .person-meta-card,
    .topic-meta-card,
    .event-meta-card,
    .place-meta-card,
    .passage-meta-card
  ) > span {
    color: var(--text-muted);
    font-size: .72rem;
    font-weight: 760;
    line-height: 1.35;
  }

  main.page[data-detail-root] > :is(
    .book-meta-grid,
    .person-meta-grid,
    .topic-meta-grid,
    .event-meta-grid,
    .place-meta-grid,
    .passage-meta-grid
  ) > :is(
    .book-meta-card,
    .person-meta-card,
    .topic-meta-card,
    .event-meta-card,
    .place-meta-card,
    .passage-meta-card
  ) > strong {
    color: var(--heading-color);
    font-size: clamp(1.25rem, 2.7vw, 1.7rem);
    line-height: 1.08;
    font-variant-numeric: tabular-nums;
  }

  main.page[data-detail-root] > .section,
  main.page[data-detail-root] > .visual-resource-preview-section,
  main.page[data-detail-root] > .route-overview {
    margin: var(--detail-gap) 0 0;
    padding: var(--detail-pad);
    border: 1px solid var(--detail-border);
    border-radius: var(--detail-radius);
    background: color-mix(in srgb, var(--surface) 94%, var(--accent-soft) 6%);
  }

  main.page[data-detail-root] .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: .8rem 1rem;
    margin-bottom: 1rem;
  }

  main.page[data-detail-root] .section-header > :first-child {
    min-width: 0;
  }

  main.page[data-detail-root] .section-header h2 {
    margin: 0;
    font-size: clamp(1.22rem, 2.6vw, 1.62rem);
    line-height: 1.12;
    letter-spacing: -.025em;
  }

  main.page[data-detail-root] .section-count {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    min-height: 2rem;
    padding: .28rem .58rem;
    border: 1px solid var(--accent-border);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: .72rem;
    font-weight: 850;
    font-variant-numeric: tabular-nums;
  }

  main.page[data-detail-root] :is(
    .book-summary-card,
    .person-bio-card,
    .topic-definition-card,
    .event-story-card,
    .place-importance-card,
    .passage-summary-card,
    .passage-reader-card
  ) {
    padding: clamp(1rem, 2.2vw, 1.35rem);
    border: 1px solid var(--detail-border);
    border-radius: var(--detail-card-radius);
    background: var(--surface);
  }

  main.page[data-detail-root] :is(
    .book-chapter-grid,
    .book-passages-grid,
    .book-lessons-grid,
    .book-events-grid,
    .person-events-grid,
    .person-places-grid,
    .person-lessons-grid,
    .topic-lessons-grid,
    .topic-events-grid,
    .event-visibility-grid,
    .event-scripture-grid,
    .event-places-grid,
    .event-connections-grid,
    .event-lessons-grid,
    .place-events-grid,
    .place-lessons-grid,
    .passage-lessons-grid,
    .passage-events-grid
  ) {
    gap: .72rem;
  }

  main.page[data-detail-root] :is(
    .book-event-card,
    .book-lesson-card,
    .book-passage-card,
    .person-event-card,
    .person-place-card,
    .person-lesson-card,
    .topic-event-card,
    .topic-lesson-card,
    .event-visibility-card,
    .event-place-card,
    .event-lesson-card,
    .place-event-card,
    .place-lesson-card,
    .passage-event-card,
    .passage-lesson-card,
    .lesson-track-card
  ) {
    border: 1px solid var(--detail-border);
    border-radius: var(--detail-card-radius);
    background: var(--surface);
    box-shadow: 0 6px 18px rgba(15, 23, 42, .028);
  }

  main.page[data-detail-root] :is(
    .book-empty-section,
    .person-empty-section,
    .topic-empty-section,
    .event-empty-section,
    .place-empty-section,
    .passage-empty-section,
    .passage-empty-card
  ) {
    border-style: dashed;
    background: color-mix(in srgb, var(--surface-soft) 82%, transparent);
  }

  main.page[data-detail-root] :is(
    .book-footer-nav,
    .person-footer-nav,
    .topic-footer-nav,
    .event-footer-nav,
    .place-footer-nav,
    .passage-footer-nav,
    .visual-resource-footer-nav
  ) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .7rem;
  }

  main.page[data-detail-root] :is(
    .book-footer-nav,
    .person-footer-nav,
    .topic-footer-nav,
    .event-footer-nav,
    .place-footer-nav,
    .passage-footer-nav,
    .visual-resource-footer-nav
  ) a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  main:is(.route-page, .learning-page)[data-detail-root] {
    --detail-border: color-mix(in srgb, var(--border-color) 88%, var(--accent) 12%);
  }

  main.route-page[data-detail-root] > .breadcrumb,
  main.learning-page[data-detail-root] > .breadcrumb {
    scroll-margin-top: calc(var(--header-height, 72px) + 16px);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    main.page[data-detail-root] :is(
      .book-event-card,
      .book-lesson-card,
      .book-passage-card,
      .person-event-card,
      .person-place-card,
      .person-lesson-card,
      .topic-event-card,
      .topic-lesson-card,
      .event-place-card,
      .event-lesson-card,
      .place-event-card,
      .place-lesson-card,
      .passage-event-card,
      .passage-lesson-card,
      .lesson-track-card
    ) {
      transition: transform var(--motion-fast, 150ms) var(--ease-out, ease), border-color var(--motion-fast, 150ms) ease, box-shadow var(--motion-fast, 150ms) ease;
    }

    main.page[data-detail-root] a:is(
      .book-event-card,
      .book-lesson-card,
      .book-passage-card,
      .person-event-card,
      .person-place-card,
      .person-lesson-card,
      .topic-event-card,
      .topic-lesson-card,
      .event-place-card,
      .event-lesson-card,
      .place-event-card,
      .place-lesson-card,
      .passage-event-card,
      .passage-lesson-card,
      .lesson-track-card
    ):hover {
      transform: translateY(-2px);
      border-color: var(--accent-border);
      box-shadow: 0 12px 26px rgba(15, 23, 42, .07);
    }
  }

  html[data-theme="dark"] main.page[data-detail-root] > .section,
  html[data-theme="dark"] main.page[data-detail-root] > .visual-resource-preview-section,
  html[data-theme="dark"] main.page[data-detail-root] > .route-overview,
  html[data-theme="dark"] main.page[data-detail-root] :is(
    .book-summary-card,
    .person-bio-card,
    .topic-definition-card,
    .event-story-card,
    .place-importance-card,
    .passage-summary-card,
    .passage-reader-card
  ) {
    background: color-mix(in srgb, var(--surface) 94%, var(--accent-soft) 6%);
  }

  @media (max-width: 900px) {
    main.page[data-detail-root] > .hero {
      grid-template-columns: minmax(0, 1fr) minmax(170px, 210px);
    }

    main.page[data-detail-root] > :is(
      .book-meta-grid,
      .person-meta-grid,
      .topic-meta-grid,
      .event-meta-grid,
      .place-meta-grid,
      .passage-meta-grid
    ) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    main.page[data-detail-root] {
      --detail-gap: .78rem;
      --detail-pad: .95rem;
      --detail-radius: 16px;
      --detail-card-radius: 14px;
    }

    main.page[data-detail-root] > .breadcrumb {
      margin-bottom: 10px !important;
    }

    main.page[data-detail-root] > .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: .9rem;
      padding: 1.05rem;
      border-radius: 18px;
    }

    main.page[data-detail-root] > .hero h1 {
      max-width: none;
      font-size: clamp(1.95rem, 10vw, 2.65rem);
    }

    main.page[data-detail-root] > .hero :is(
      .book-hero-card,
      .person-hero-card,
      .topic-hero-card,
      .event-hero-card,
      .place-hero-card,
      .passage-hero-card,
      .visual-resource-status-card
    ) {
      min-height: 0;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      align-content: initial;
      column-gap: .7rem;
      padding: .9rem 1rem;
    }

    main.page[data-detail-root] > :is(
      .book-meta-grid,
      .person-meta-grid,
      .topic-meta-grid,
      .event-meta-grid,
      .place-meta-grid,
      .passage-meta-grid
    ) {
      gap: .55rem;
    }

    main.page[data-detail-root] > :is(
      .book-meta-grid,
      .person-meta-grid,
      .topic-meta-grid,
      .event-meta-grid,
      .place-meta-grid,
      .passage-meta-grid
    ) > :is(
      .book-meta-card,
      .person-meta-card,
      .topic-meta-card,
      .event-meta-card,
      .place-meta-card,
      .passage-meta-card
    ) {
      min-height: 88px;
      padding: .82rem;
    }

    main.page[data-detail-root] .section-header {
      align-items: flex-start;
    }

    main.page[data-detail-root] :is(
      .book-footer-nav,
      .person-footer-nav,
      .topic-footer-nav,
      .event-footer-nav,
      .place-footer-nav,
      .passage-footer-nav,
      .visual-resource-footer-nav
    ) a {
      flex: 1 1 150px;
    }
  }

  @media (max-width: 430px) {
    main.page[data-detail-root] > :is(
      .book-meta-grid,
      .person-meta-grid,
      .topic-meta-grid,
      .event-meta-grid,
      .place-meta-grid,
      .passage-meta-grid
    ) {
      grid-template-columns: minmax(0, 1fr);
    }

    main.page[data-detail-root] > .hero .actions .button {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    main[data-detail-root] *,
    main[data-detail-root] *::before,
    main[data-detail-root] *::after {
      scroll-behavior: auto !important;
    }
  }

  @media (forced-colors: active) {
    main.page[data-detail-root] > .hero,
    main.page[data-detail-root] > .section,
    main.page[data-detail-root] > :is(
      .book-meta-grid,
      .person-meta-grid,
      .topic-meta-grid,
      .event-meta-grid,
      .place-meta-grid,
      .passage-meta-grid
    ) > * {
      border-color: CanvasText;
    }
  }
</style>
