---
import { sitePath } from "../../lib/site-paths";
import { getGlossaryCanonicalPath, glossaryCanonicalPath } from "../../lib/glossary-routes";
import Icon from "../Icon.astro";
import LessonMap from "./LessonMap.astro";
import BibliImgViewer from "../BibliImgViewer.astro";
import {
  bibliImgMediaUrl,
  getIntegratedGlossaryEntry,
} from "../../lib/bibli-images";
import type { Book, Event, Passage, RelatedItem, StudyPlace, VisualResource } from "../../lib/queries";

type Props = {
  books: Book[];
  passages: Passage[];
  glossary: RelatedItem[];
  people: RelatedItem[];
  places: StudyPlace[];
  topics: RelatedItem[];
  events: Event[];
  visualResources: VisualResource[];
};
const { books, passages, glossary, people, places, topics, events, visualResources } = Astro.props;
const count = books.length + passages.length + glossary.length + people.length + places.length + topics.length + events.length + visualResources.length;

const glossaryAids = glossary.map((item) => {
  const media = getIntegratedGlossaryEntry(item.slug);

  return {
    item,
    media,
    localized: media?.locales["es-419"],
  };
});

const peopleAids = people.map((item) => {
  const candidate =
    getIntegratedGlossaryEntry(item.slug);

  const media =
    candidate?.group === "personajes"
      ? candidate
      : undefined;

  return {
    item,
    media,
    localized: media?.locales["es-419"],
  };
});
---

<aside class="study-aids" data-study-aids-panel aria-label="Ayudas de estudio">
  <div class="study-aids-heading">
    <div><span class="heading-icon"><Icon name="sparkles" size={17} /></span><h2>Ayudas de estudio</h2></div>
    <span class="count" aria-label={`${count} ayudas disponibles`}>{count}</span>
  </div>

  {count === 0 && (
    <div class="study-aids-empty" role="status">
      <Icon name="info" size={18} />
      <div>
        <strong>Sin ayudas relacionadas</strong>
        <p>Esta lección todavía no tiene lugares, personajes, temas o recursos vinculados.</p>
      </div>
    </div>
  )}

  {(books.length > 0 || passages.length > 0) && (
    <details data-explicit-connections="lesson-scripture">
      <summary><span class="summary-main"><Icon name="book-text" size={17} />Base bíblica</span><span class="summary-meta"><span>{books.length + passages.length}</span><Icon name="chevron-down" size={15} class="summary-chevron" /></span></summary>
      <div class="scripture-connections">
        {books.length > 0 && (
          <div>
            <span class="connection-label">Libro</span>
            <div class="chips">{books.map((book) => <a href={sitePath(`/libros/${book.slug}/`)} data-explicit-connection="lesson-books">{book.name}</a>)}</div>
          </div>
        )}
        {passages.length > 0 && (
          <div>
            <span class="connection-label">Pasaje</span>
            <div class="chips">{passages.map((passage) => <a href={sitePath(`/pasajes/${passage.slug}/`)} data-explicit-connection="lesson-passages">{passage.display_reference}</a>)}</div>
          </div>
        )}
      </div>
    </details>
  )}

  {places.length > 0 && (
    <details open>
      <summary><span class="summary-main"><Icon name="map" size={17} />Lugares y mapa</span><span class="summary-meta"><span>{places.length}</span><Icon name="chevron-down" size={15} class="summary-chevron" /></span></summary>
      <LessonMap places={places} />
      <ul class="aid-list">
        {places.map((place) => (
          <li>
            <a href={sitePath(`/lugares/${place.slug}/`)} data-explicit-connection="lesson-places"><strong>{place.title}</strong></a>
            {place.summary && <p>{place.summary}</p>}
          </li>
        ))}
      </ul>
    </details>
  )}

  {glossary.length > 0 && (
    <details data-study-aid-section="glossary">
      <summary><span class="summary-main"><Icon name="library" size={17} />Glosario</span><span class="summary-meta"><span>{glossary.length}</span><Icon name="chevron-down" size={15} class="summary-chevron" /></span></summary>
      <div class="definition-list">
        {glossaryAids.map(({ item: term, media, localized }) => (
          <article class:list={["aid-entity", { "has-media": Boolean(media && localized) }]}>
            {media && localized && (
              <button
                type="button"
                class="aid-media-button"
                data-bibli-img-open
                data-bibli-img-aid={media.entityKey}
                data-bibli-img-high={bibliImgMediaUrl(media.visual.highPath)}
                data-bibli-img-alt={localized.alt_text}
                data-bibli-img-caption={`${localized.display_name} · Ilustración editorial`}
                aria-label={`Ampliar imagen de ${term.title}`}
                aria-haspopup="dialog"
                aria-controls="study-aid-bibli-img-viewer"
              >
                <img
                  src={bibliImgMediaUrl(media.visual.optimizedPath)}
                  width={media.visual.optimizedWidth}
                  height={media.visual.optimizedHeight}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
              </button>
            )}
            <div class="aid-entity-copy">
              <a href={sitePath(glossaryCanonicalPath(term.slug))} data-explicit-connection="lesson-glossary"><strong>{term.title}</strong></a>
              {term.definition && <p>{term.definition}</p>}
            </div>
          </article>
        ))}
      </div>
    </details>
  )}

  {people.length > 0 && (
    <details data-study-aid-section="people">
      <summary><span class="summary-main"><Icon name="users" size={17} />Personajes</span><span class="summary-meta"><span>{people.length}</span><Icon name="chevron-down" size={15} class="summary-chevron" /></span></summary>
      <div class="people-aid-list">
        {peopleAids.map(({ item: person, media, localized }) => (
          <article class:list={["aid-entity", { "has-media": Boolean(media && localized) }]}>
            {media && localized && (
              <button
                type="button"
                class="aid-media-button"
                data-bibli-img-open
                data-bibli-img-aid={media.entityKey}
                data-bibli-img-high={bibliImgMediaUrl(media.visual.highPath)}
                data-bibli-img-alt={localized.alt_text}
                data-bibli-img-caption={`${localized.display_name} · Ilustración editorial`}
                aria-label={`Ampliar imagen de ${person.title}`}
                aria-haspopup="dialog"
                aria-controls="study-aid-bibli-img-viewer"
              >
                <img
                  src={bibliImgMediaUrl(media.visual.optimizedPath)}
                  width={media.visual.optimizedWidth}
                  height={media.visual.optimizedHeight}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
              </button>
            )}
            <div class="aid-entity-copy">
              <a href={sitePath(getGlossaryCanonicalPath(person.slug) ?? `/personajes/${person.slug}/`)} data-explicit-connection="lesson-people"><strong>{person.title}</strong></a>
            </div>
          </article>
        ))}
      </div>
    </details>
  )}

  {topics.length > 0 && (
    <details>
      <summary><span class="summary-main"><Icon name="tag" size={17} />Temas</span><span class="summary-meta"><span>{topics.length}</span><Icon name="chevron-down" size={15} class="summary-chevron" /></span></summary>
      <div class="chips">{topics.map((topic) => <a href={sitePath(`/temas/${topic.slug}/`)} data-explicit-connection="lesson-topics">{topic.title}</a>)}</div>
    </details>
  )}

  {events.length > 0 && (
    <details>
      <summary><span class="summary-main"><Icon name="timeline" size={17} />Eventos</span><span class="summary-meta"><span>{events.length}</span><Icon name="chevron-down" size={15} class="summary-chevron" /></span></summary>
      <ul class="aid-list compact">{events.map((event) => <li><a href={sitePath(`/eventos/${event.slug}/`)} data-explicit-connection="lesson-events">{event.title}</a></li>)}</ul>
    </details>
  )}

  {visualResources.length > 0 && (
    <details>
      <summary><span class="summary-main"><Icon name="image" size={17} />Recursos visuales</span><span class="summary-meta"><span>{visualResources.length}</span><Icon name="chevron-down" size={15} class="summary-chevron" /></span></summary>
      <div class="visual-grid">
        {visualResources.map((resource) => (
          <a href={sitePath(`/recursos/${resource.slug}/`)} class="visual-card" data-explicit-connection="lesson-visual-resources">
            {resource.url ? (
              <img src={resource.url} alt={resource.alt_text ?? resource.title} loading="lazy" />
            ) : (
              <span class="visual-placeholder" aria-label={`Imagen pendiente · ${resource.status}`}>
                <Icon name="image" size={20} />
                <small>{resource.status === "Idea" ? "En preparación" : resource.status}</small>
              </span>
            )}
            <strong>{resource.title}</strong>
          </a>
        ))}
      </div>
    </details>
  )}
</aside>

<BibliImgViewer id="study-aid-bibli-img-viewer" />

<style>
  .study-aids { display:grid; gap:6px; }
  .study-aids-heading { min-height:34px; display:flex; align-items:center; justify-content:space-between; gap:.7rem; padding:0 .1rem .35rem; }
  .study-aids-heading > div { display:flex; align-items:center; gap:.5rem; }
  .heading-icon { width:28px; height:28px; display:grid; place-items:center; border-radius:9px; background:var(--accent-soft); color:var(--accent); }
  .study-aids-heading h2 { margin:0; color:var(--heading-color); font-size:.95rem; letter-spacing:-.02em; }
  .count { min-width:24px; height:24px; padding:0 5px; display:grid; place-items:center; border-radius:8px; background:var(--surface-soft); color:var(--text-muted); font-size:.68rem; font-weight:800; }
  .study-aids-empty { display:grid; grid-template-columns:auto minmax(0,1fr); gap:.65rem; align-items:start; padding:.8rem; border:1px dashed var(--border-color); border-radius:13px; background:var(--surface-soft); color:var(--text-muted); }
  .study-aids-empty > .bibli-icon { color:var(--accent); margin-top:.08rem; }
  .study-aids-empty strong { display:block; margin-bottom:.15rem; color:var(--heading-color); font-size:.8rem; }
  .study-aids-empty p { margin:0; font-size:.75rem; line-height:1.45; }
  details { border:1px solid var(--border-color); border-radius:13px; overflow:hidden; background:var(--surface); box-shadow:0 5px 18px rgba(15, 23, 42, .03); }
  summary { min-height:44px; box-sizing:border-box; cursor:pointer; padding:.65rem .75rem; display:flex; align-items:center; justify-content:space-between; gap:.6rem; color:var(--heading-color); font-size:.82rem; font-weight:700; list-style:none; transition:background-color 140ms ease; }
  summary::-webkit-details-marker { display:none; }
  .summary-main { display:flex; align-items:center; gap:.55rem; }
  .summary-main .bibli-icon { color:var(--accent); }
  .summary-meta { display:inline-flex; align-items:center; gap:.32rem; color:var(--text-muted); font-size:.7rem; }
  .summary-chevron { transition:transform 160ms ease; }
  details[open] .summary-chevron { transform:rotate(180deg); }
  summary:hover { background:var(--surface-soft); }
  details[open] summary { border-bottom:1px solid var(--border-color); background:color-mix(in srgb,var(--accent-soft) 24%,var(--surface)); }
  details > :global(:not(summary)) { margin-left:.75rem; margin-right:.75rem; }
  .aid-list { list-style:none; padding:0 0 .7rem; margin-top:.7rem; display:grid; gap:.6rem; }
  .aid-list a,.definition-list a { color:var(--heading-color); text-underline-offset:.18em; }
  .aid-list p,.definition-list p { margin:.18rem 0 0; color:var(--text-muted); font-size:.81rem; line-height:1.5; }
  .aid-list.compact { gap:.32rem; }
  .scripture-connections { display:grid; gap:.7rem; padding:.7rem 0; }
  .scripture-connections > div { display:grid; gap:.28rem; }
  .connection-label { color:var(--text-muted); font-size:.68rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase; }
  .definition-list { display:grid; gap:.65rem; padding:.7rem 0; }
  .definition-list article + article { border-top:1px solid var(--border-color); padding-top:.6rem; }

  .aid-entity {
    display:grid;
    grid-template-columns:minmax(0,1fr);
    gap:.58rem;
    align-items:start;
    min-width:0;
  }

  .aid-entity.has-media {
    grid-template-columns:54px minmax(0,1fr);
  }

  .aid-entity-copy {
    min-width:0;
  }

  .aid-entity-copy > a {
    color:var(--heading-color);
    text-underline-offset:.18em;
  }

  .aid-media-button {
    width:54px;
    height:62px;
    display:grid;
    place-items:center;
    padding:3px;
    border:1px solid var(--border-color);
    border-radius:10px;
    background:var(--surface-soft);
    cursor:zoom-in;
    overflow:hidden;
    touch-action:manipulation;
    transition:
      background-color 140ms ease,
      border-color 140ms ease;
  }

  .aid-media-button img {
    display:block;
    width:100%;
    height:100%;
    object-fit:contain;
  }

  .aid-media-button:hover {
    background:var(--accent-soft);
    border-color:
      color-mix(
        in srgb,
        var(--accent) 40%,
        var(--border-color)
      );
  }

  .aid-media-button:focus-visible {
    outline:3px solid
      color-mix(in srgb,var(--accent) 72%,white);
    outline-offset:2px;
  }

  .people-aid-list {
    display:grid;
    gap:.5rem;
    padding:.7rem 0;
  }

  .people-aid-list .aid-entity {
    align-items:center;
    min-height:38px;
  }

  .people-aid-list .aid-entity + .aid-entity {
    border-top:1px solid var(--border-color);
    padding-top:.5rem;
  }

  .people-aid-list .aid-entity-copy > a {
    font-size:.78rem;
    text-decoration:none;
  }

  .people-aid-list .aid-entity-copy > a:hover {
    text-decoration:underline;
  }
  .chips { display:flex; flex-wrap:wrap; gap:.35rem; padding:.7rem 0; }
  .chips a { padding:.36rem .55rem; border:1px solid var(--border-color); border-radius:9px; background:var(--surface-soft); color:var(--text-color); text-decoration:none; font-size:.76rem; transition:background-color 140ms ease,border-color 140ms ease; }
  .chips a:hover { background:var(--accent-soft); border-color:color-mix(in srgb,var(--accent) 40%,var(--border-color)); }
  .visual-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.6rem; padding:.7rem 0; }
  .visual-card { display:grid; gap:.35rem; color:var(--text-color); text-decoration:none; }
  .visual-card img { width:100%; aspect-ratio:16/10; object-fit:cover; border-radius:9px; }
  .visual-placeholder { width:100%; aspect-ratio:16/10; display:grid; place-items:center; align-content:center; gap:.35rem; border:1px dashed var(--border-color); border-radius:9px; background:var(--surface-soft); color:var(--accent); }
  .visual-placeholder small { color:var(--text-muted); font-size:.68rem; font-weight:700; }
  .visual-card strong { font-size:.78rem; }
  @media(max-width:700px){ .visual-grid{grid-template-columns:1fr;} }
  @media(prefers-reduced-motion:reduce){ .summary-chevron{transition:none;} }
</style>
