---
import type { ContextualGlossaryTerm, StructuredLesson } from "../../lib/queries";

interface Props {
  lesson: StructuredLesson;
  id?: string;
  locale?: "es" | "en";
  labelledBy?: string;
}

const {
  lesson,
  id = "study-presentation-dynamic",
  locale = "es",
  labelledBy = "study-presentation-tab-dynamic",
} = Astro.props;

const language = locale === "en" ? "en" : "es";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const copy = {
  es: {
    eyebrow: "Aprendizaje dinámico",
    block: "Bloque",
    of: "de",
    previous: "Anterior",
    next: "Siguiente",
    finish: "Último bloque",
    progress: "Progreso dentro de la lección",
    objectivesEyebrow: "Objetivos de aprendizaje",
    objectivesTitle: "Al terminar este estudio podrás",
    glossaryEyebrow: "Glosario contextual",
    glossaryClose: "Cerrar definición",
    glossaryHint: "Término del glosario. Activa para ver una definición breve.",
    microcheckEyebrow: "Comprueba tu comprensión",
    microcheckHint: "Comprobación breve · no bloquea tu avance",
    correct: "Correcto",
    incorrect: "Revisa esta idea",
    evidence: "Evidencia",
    review: "Revisar este punto",
    retry: "Puedes elegir otra respuesta para volver a comprobarlo.",
    summaryEyebrow: "Cierre de aprendizaje",
    summaryTitle: "Lo esencial de esta lección",
    summaryEstimate: "Comprensión estimada",
    summaryEstimatePending: "Completa las comprobaciones para obtener una estimación basada en evidencia.",
    summaryEstimateNote: "Estimación basada en las comprobaciones de esta lección; no mide tu aprendizaje de forma absoluta.",
    summaryUnderstood: "Conceptos comprendidos",
    summaryReinforce: "Por reforzar",
    summaryPending: "Aún sin evidencia",
    summaryReview: "Revisar concepto",
    visualUnavailable: "Recurso visual en preparación",
    roles: {
      title: "Inicio",
      "primary-reading": "Lectura principal",
      context: "Contexto",
      exposition: "Explicación",
      "revelation-about-god": "Qué revela acerca de Dios",
      "revelation-about-humanity": "Qué revela acerca de nosotros",
      "christ-connection": "Encontrando a Jesús",
      "canonical-thread": "Hilo bíblico",
      application: "Aplicación",
      reflection: "Para meditar",
      summary: "Resumen",
      prayer: "Oración",
    },
  },
  en: {
    eyebrow: "Dynamic learning",
    block: "Block",
    of: "of",
    previous: "Previous",
    next: "Next",
    finish: "Last block",
    progress: "Progress within the lesson",
    objectivesEyebrow: "Learning objectives",
    objectivesTitle: "By the end of this study, you will be able to",
    glossaryEyebrow: "Contextual glossary",
    glossaryClose: "Close definition",
    glossaryHint: "Glossary term. Activate to view a short definition.",
    microcheckEyebrow: "Check your understanding",
    microcheckHint: "Short check · does not block your progress",
    correct: "Correct",
    incorrect: "Review this idea",
    evidence: "Evidence",
    review: "Review this point",
    retry: "You can choose another answer and check again.",
    summaryEyebrow: "Learning close",
    summaryTitle: "What matters most from this lesson",
    summaryEstimate: "Estimated understanding",
    summaryEstimatePending: "Complete the checks to receive an evidence-based estimate.",
    summaryEstimateNote: "Estimate based on this lesson's checks; it does not measure your learning absolutely.",
    summaryUnderstood: "Concepts understood",
    summaryReinforce: "Worth reinforcing",
    summaryPending: "Not yet evidenced",
    summaryReview: "Review concept",
    visualUnavailable: "Visual resource in preparation",
    roles: {
      title: "Start",
      "primary-reading": "Primary reading",
      context: "Context",
      exposition: "Explanation",
      "revelation-about-god": "What this reveals about God",
      "revelation-about-humanity": "What this reveals about us",
      "christ-connection": "Finding Jesus",
      "canonical-thread": "Biblical thread",
      application: "Application",
      reflection: "Reflect",
      summary: "Summary",
      prayer: "Prayer",
    },
  },
}[language];

const blocks = lesson.blocks;
const objectives = lesson.objectives ?? [];
const contextualGlossary = lesson.contextual_glossary ?? [];
const microchecks = lesson.microchecks ?? [];
const interactiveBlocks = lesson.interactive_blocks ?? [];
const concepts = lesson.concepts ?? [];
const roleLabel = (role: string) => copy.roles[role as keyof typeof copy.roles] ?? (language === "en" ? "Study" : "Estudio");
const textParts = (value: string) => String(value ?? "").split(/\n+/).map((part) => part.trim()).filter(Boolean);
const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const glossaryByBlock = new Map<string, ContextualGlossaryTerm[]>();
for (const term of contextualGlossary) {
  const items = glossaryByBlock.get(term.block_id) ?? [];
  items.push(term);
  glossaryByBlock.set(term.block_id, items);
}
const microchecksByBlock = new Map<string, typeof microchecks>();
for (const check of microchecks) {
  const items = microchecksByBlock.get(check.trigger_block_id) ?? [];
  items.push(check);
  microchecksByBlock.set(check.trigger_block_id, items);
}
const interactionsByBlock = new Map<string, typeof interactiveBlocks>();
for (const interaction of interactiveBlocks) {
  const items = interactionsByBlock.get(interaction.anchor_block_id) ?? [];
  items.push(interaction);
  interactionsByBlock.set(interaction.anchor_block_id, items);
}
const blockByKey = new Map(blocks.map((block) => [block.block_key, block]));

const glossaryPanelId = (blockKey: string, slug: string) =>
  `${id}-glossary-${blockKey}-${slug}`.replace(/[^a-zA-Z0-9_-]/g, "-");

const splitGlossaryText = (value: string, terms: ContextualGlossaryTerm[], claimed: Set<string>) => {
  const usable = [...terms]
    .filter((term) => term.term.trim())
    .sort((a, b) => b.term.length - a.term.length);
  if (usable.length === 0) return [{ text: value, glossary: null as ContextualGlossaryTerm | null }];
  const regex = new RegExp(`(${usable.map((term) => escapeRegExp(term.term)).join("|")})`, "giu");
  return value.split(regex).filter(Boolean).map((part) => {
    const glossary = usable.find((term) => term.term.toLocaleLowerCase(language) === part.toLocaleLowerCase(language)) ?? null;
    if (!glossary || claimed.has(glossary.glossary_id)) {
      return { text: part, glossary: null as ContextualGlossaryTerm | null };
    }
    claimed.add(glossary.glossary_id);
    return { text: part, glossary };
  });
};
---

<section
  id={id}
  class="dynamic-lesson-renderer"
  data-study-presentation-panel="dynamic"
  data-lesson-renderer="dynamic"
  data-dynamic-lesson
  data-tts-dynamic-reader
  data-lesson-id={lesson.lesson_id}
  data-locale={language}
  data-block-count={blocks.length}
  data-objective-count={objectives.length}
  data-glossary-count={contextualGlossary.length}
  data-microcheck-count={microchecks.length}
  data-interactive-count={interactiveBlocks.length}
  data-concept-count={concepts.length}
  role="tabpanel"
  aria-labelledby={labelledBy}
  hidden
>
  <header class="dynamic-shell-heading">
    <div>
      <p class="dynamic-eyebrow">{copy.eyebrow}</p>
      <h2>{lesson.title}</h2>
    </div>
    <div class="dynamic-counter" aria-live="polite" aria-atomic="true">
      <span data-dynamic-current>1</span>
      <span aria-hidden="true">/</span>
      <span data-dynamic-total>{blocks.length}</span>
    </div>
  </header>

  {objectives.length > 0 && (
    <aside class="dynamic-objectives" data-learning-objectives>
      <div class="dynamic-objectives-heading">
        <p>{copy.objectivesEyebrow}</p>
        <h3>{copy.objectivesTitle}</h3>
      </div>
      <ol>
        {objectives.map((objective) => (
          <li
            data-learning-objective
            data-objective-id={objective.objective_id}
            data-concept-ids={objective.concept_ids.join(",")}
            data-evidence-blocks={objective.evidence_block_keys.join(",")}
          >
            {objective.objective_text}
          </li>
        ))}
      </ol>
    </aside>
  )}

  <div
    class="dynamic-progress"
    role="progressbar"
    aria-label={copy.progress}
    aria-valuemin="1"
    aria-valuemax={blocks.length}
    aria-valuenow="1"
    data-dynamic-progress
  >
    <span data-dynamic-progress-bar style={`width:${blocks.length ? 100 / blocks.length : 100}%`}></span>
  </div>

  <div class="dynamic-block-stack" data-dynamic-block-stack>
    {blocks.map((block, index) => {
      const blockGlossary = glossaryByBlock.get(block.block_id) ?? [];
      const blockChecks = microchecksByBlock.get(block.block_id) ?? [];
      const blockInteractions = interactionsByBlock.get(block.block_id) ?? [];
      const claimedGlossary = new Set<string>();
      return (
        <article
          class:list={["dynamic-block", `is-${block.block_type}`, `role-${block.semantic_role}`]}
          data-dynamic-block
          data-block-id={block.block_id}
          data-block-key={block.block_key}
          data-semantic-role={block.semantic_role}
          data-block-position={block.position}
          tabindex="-1"
          aria-hidden={index === 0 ? "false" : "true"}
          hidden={index !== 0}
        >
          <header class="dynamic-block-header">
            <span class="dynamic-role">{roleLabel(block.semantic_role)}</span>
            <span class="dynamic-block-number">{copy.block} {block.position} {copy.of} {blocks.length}</span>
          </header>

          {block.heading && block.semantic_role !== "title" && <h3>{block.heading.replace(/^[^\p{L}\p{N}]+/u, "").trim()}</h3>}
          {block.semantic_role === "title" ? (
            <h3 class="dynamic-title">{block.content_text}</h3>
          ) : block.semantic_role === "primary-reading" ? (
            <div class="dynamic-scripture-reference">
              <strong>{block.bible_reference ?? lesson.primary_reference}</strong>
              <span>{block.bible_translation ?? lesson.translation}</span>
            </div>
          ) : (
            <div class="dynamic-copy">
              {textParts(block.content_text).map((part) => (
                <p>
                  {splitGlossaryText(part, blockGlossary, claimedGlossary).map((segment) => segment.glossary ? (
                    <button
                      type="button"
                      class="dynamic-glossary-trigger"
                      data-glossary-trigger
                      data-glossary-id={segment.glossary.glossary_id}
                      aria-controls={glossaryPanelId(block.block_key, segment.glossary.slug)}
                      aria-expanded="false"
                      title={copy.glossaryHint}
                    >
                      {segment.text}
                    </button>
                  ) : segment.text)}
                </p>
              ))}
            </div>
          )}

          {blockInteractions.map((interaction) => (
            <section
              class:list={["dynamic-interaction", `interaction-${interaction.interaction_type}`, `presentation-${interaction.presentation}`]}
              data-learning-interaction
              data-interaction-id={interaction.interaction_id}
              data-interaction-type={interaction.interaction_type}
              data-interaction-presentation={interaction.presentation}
              data-anchor-block={interaction.anchor_block_key}
              data-concept-ids={interaction.concept_ids.join(",")}
            >
              <header class="dynamic-interaction-heading">
                {interaction.eyebrow && <p>{interaction.eyebrow}</p>}
                <h4>{interaction.title}</h4>
                <div class="dynamic-interaction-body">{interaction.body}</div>
              </header>

              {interaction.interaction_type === "comparison" && (
                <div class="dynamic-comparison" data-comparison>
                  <div class="dynamic-comparison-controls" role="group" aria-label={interaction.title}>
                    {interaction.items.map((item, itemIndex) => (
                      <button
                        type="button"
                        data-comparison-option
                        data-item-key={item.item_key}
                        aria-pressed={itemIndex === 0 ? "true" : "false"}
                      >
                        {item.label || item.title}
                      </button>
                    ))}
                  </div>
                  <div class="dynamic-comparison-items">
                    {interaction.items.map((item, itemIndex) => (
                      <article
                        data-comparison-item
                        data-item-key={item.item_key}
                        data-selected={itemIndex === 0 ? "true" : "false"}
                      >
                        {item.label && <span>{item.label}</span>}
                        <h5>{item.title}</h5>
                        <p>{item.body}</p>
                      </article>
                    ))}
                  </div>
                </div>
              )}

              {interaction.interaction_type === "visual-resource" && (
                <figure class="dynamic-visual-resource" data-visual-resource data-resource-id={interaction.resource_id ?? undefined}>
                  {interaction.resource_url ? (
                    <img
                      src={interaction.resource_url}
                      alt={interaction.resource_alt_text || interaction.resource_title || interaction.title}
                      loading="lazy"
                    />
                  ) : (
                    <div class="dynamic-visual-resource-placeholder" role="status">{copy.visualUnavailable}</div>
                  )}
                  {(interaction.resource_title || interaction.resource_description) && (
                    <figcaption>
                      {interaction.resource_title && <strong>{interaction.resource_title}</strong>}
                      {interaction.resource_description && <span>{interaction.resource_description}</span>}
                    </figcaption>
                  )}
                </figure>
              )}

              {interaction.instruction && <p class="dynamic-interaction-instruction">{interaction.instruction}</p>}
            </section>
          ))}

          {blockGlossary.map((term) => (
            <aside
              id={glossaryPanelId(block.block_key, term.slug)}
              class="dynamic-glossary-panel"
              data-glossary-panel
              data-glossary-id={term.glossary_id}
              data-glossary-popover
              role="dialog"
              aria-live="polite"
              hidden
            >
              <div class="dynamic-glossary-panel-heading">
                <div>
                  <span>{copy.glossaryEyebrow}</span>
                  <h4>{term.term}</h4>
                </div>
                <button type="button" data-glossary-close aria-label={copy.glossaryClose}>×</button>
              </div>
              <p>{term.definition}</p>
              {language === "es" && (
                <a href={`${baseUrl}/glosario/${term.slug}`}>Ver término completo</a>
              )}
            </aside>
          ))}

          {blockChecks.map((check) => (
            <section
              class="dynamic-microcheck"
              data-microcheck
              data-check-id={check.check_id}
              data-objective-id={check.objective_id}
              data-concept-ids={check.concept_ids.join(",")}
              data-trigger-block={check.trigger_block_key}
              data-correct-label={copy.correct}
              data-incorrect-label={copy.incorrect}
            >
              <header class="dynamic-microcheck-heading">
                <div>
                  <p>{copy.microcheckEyebrow}</p>
                  <span>{copy.microcheckHint}</span>
                </div>
                <span class="dynamic-microcheck-number">{check.position}/{microchecks.length}</span>
              </header>
              <h4>{check.prompt}</h4>
              <div class="dynamic-microcheck-options" role="group" aria-label={check.prompt}>
                {check.options.map((option) => (
                  <button
                    type="button"
                    data-microcheck-option
                    data-option-id={option.option_id}
                    data-option-key={option.option_key}
                    data-is-correct={String(option.is_correct)}
                    data-rationale={option.rationale}
                    aria-pressed="false"
                  >
                    <span class="dynamic-option-marker" aria-hidden="true">{String.fromCharCode(64 + option.position)}</span>
                    <span>{option.option_text}</span>
                  </button>
                ))}
              </div>
              <div class="dynamic-microcheck-feedback" data-microcheck-feedback role="status" aria-live="polite" hidden>
                <p class="dynamic-microcheck-result" data-microcheck-result></p>
                <p data-microcheck-rationale></p>
                <div class="dynamic-microcheck-evidence" data-microcheck-evidence>
                  <span>{copy.evidence}</span>
                  <ul>
                    {check.evidence.map((item) => {
                      const evidenceBlock = blockByKey.get(item.block_key);
                      return (
                        <li>
                          {item.bible_reference && <strong>{item.bible_reference}</strong>}
                          <span>{evidenceBlock?.heading?.replace(/^[^\p{L}\p{N}]+/u, "").trim() || roleLabel(evidenceBlock?.semantic_role ?? "exposition")}</span>
                        </li>
                      );
                    })}
                  </ul>
                </div>
                <div class="dynamic-microcheck-actions">
                  <button type="button" data-review-block-key={check.evidence[0]?.block_key}>{copy.review}</button>
                  <span>{copy.retry}</span>
                </div>
              </div>
            </section>
          ))}
        </article>
      );
    })}
  </div>

  {concepts.length > 0 && (
    <section
      class="dynamic-learning-summary"
      data-learning-summary
      data-estimate-ready-label={copy.summaryEstimateNote}
      data-estimate-pending-label={copy.summaryEstimatePending}
      hidden
    >
      <header class="dynamic-learning-summary-heading">
        <p>{copy.summaryEyebrow}</p>
        <h3>{copy.summaryTitle}</h3>
      </header>

      <div class="dynamic-understanding-estimate" data-understanding-estimate>
        <span>{copy.summaryEstimate}</span>
        <strong data-understanding-estimate-value>—</strong>
        <p data-understanding-estimate-note>{copy.summaryEstimatePending}</p>
      </div>

      <div class="dynamic-summary-groups">
        <section data-summary-group="understood" hidden>
          <h4>{copy.summaryUnderstood} <span data-summary-count>0</span></h4>
          <ul data-summary-list="understood"></ul>
        </section>
        <section data-summary-group="reinforce" hidden>
          <h4>{copy.summaryReinforce} <span data-summary-count>0</span></h4>
          <ul data-summary-list="reinforce"></ul>
        </section>
        <section data-summary-group="pending">
          <h4>{copy.summaryPending} <span data-summary-count>{concepts.length}</span></h4>
          <ul data-summary-list="pending">
            {concepts.map((concept) => (
              <li
                data-learning-summary-concept
                data-concept-id={concept.concept_id}
                data-concept-importance={concept.importance}
                data-summary-state="pending"
              >
                <div>
                  <strong data-summary-concept-label>{concept.label}</strong>
                  <p>{concept.short_description}</p>
                </div>
                {concept.review_block_key && (
                  <button type="button" data-review-block-key={concept.review_block_key}>{copy.summaryReview}</button>
                )}
              </li>
            ))}
          </ul>
        </section>
      </div>
    </section>
  )}

  <nav class="dynamic-navigation" aria-label={language === "en" ? "Dynamic lesson navigation" : "Navegación de la lección dinámica"}>
    <button type="button" data-dynamic-previous disabled>{copy.previous}</button>
    <span class="dynamic-navigation-status" data-dynamic-status>{blocks.length > 1 ? roleLabel(blocks[0]?.semantic_role ?? "title") : copy.finish}</span>
    <button type="button" data-dynamic-next disabled={blocks.length <= 1}>{copy.next}</button>
  </nav>
</section>

<script>
  import { seedReviewFromLessonCheck } from "../../lib/learning-review";

  document.querySelectorAll<HTMLElement>("[data-dynamic-lesson]").forEach((root) => {
    if (root.dataset.dynamicMounted === "true") return;
    const blocks = [...root.querySelectorAll<HTMLElement>("[data-dynamic-block]")];
    const previous = root.querySelector<HTMLButtonElement>("[data-dynamic-previous]");
    const next = root.querySelector<HTMLButtonElement>("[data-dynamic-next]");
    const current = root.querySelector<HTMLElement>("[data-dynamic-current]");
    const progress = root.querySelector<HTMLElement>("[data-dynamic-progress]");
    const progressBar = root.querySelector<HTMLElement>("[data-dynamic-progress-bar]");
    const status = root.querySelector<HTMLElement>("[data-dynamic-status]");
    const objectives = root.querySelector<HTMLElement>("[data-learning-objectives]");
    const learningSummary = root.querySelector<HTMLElement>("[data-learning-summary]");
    const checkElements = [...root.querySelectorAll<HTMLElement>("[data-microcheck]")];
    const conceptItems = [...root.querySelectorAll<HTMLElement>("[data-learning-summary-concept]")];
    const answerStorageKey = `bibli-learning-check-answers-v1:${root.dataset.lessonId || "unknown"}`;
    let index = 0;
    let lastGlossaryTrigger: HTMLButtonElement | null = null;
    let lastGlossaryPanel: HTMLElement | null = null;

    const positionGlossary = (trigger: HTMLButtonElement, panel: HTMLElement) => {
      const margin = 12;
      const gap = 10;
      panel.style.visibility = "hidden";
      panel.style.left = `${margin}px`;
      panel.style.top = `${margin}px`;
      const triggerRect = trigger.getBoundingClientRect();
      const initialPanelRect = panel.getBoundingClientRect();
      const availableBelow = window.innerHeight - triggerRect.bottom - margin;
      const availableAbove = triggerRect.top - margin;
      const placeBelow = availableBelow >= initialPanelRect.height + gap || availableBelow >= availableAbove;
      const availableOnSide = Math.max(96, (placeBelow ? availableBelow : availableAbove) - gap);
      panel.style.maxHeight = `${Math.floor(availableOnSide)}px`;
      const panelRect = panel.getBoundingClientRect();
      const left = Math.min(
        Math.max(margin, triggerRect.left + triggerRect.width / 2 - panelRect.width / 2),
        Math.max(margin, window.innerWidth - panelRect.width - margin),
      );
      const top = placeBelow
        ? triggerRect.bottom + gap
        : triggerRect.top - panelRect.height - gap;
      panel.style.left = `${Math.round(left)}px`;
      panel.style.top = `${Math.round(top)}px`;
      panel.dataset.placement = placeBelow ? "below" : "above";
      panel.style.visibility = "visible";
    };

    const repositionGlossary = () => {
      if (lastGlossaryTrigger && lastGlossaryPanel && !lastGlossaryPanel.hidden) {
        positionGlossary(lastGlossaryTrigger, lastGlossaryPanel);
      }
    };

    const closeGlossary = (restoreFocus = false) => {
      root.querySelectorAll<HTMLElement>("[data-glossary-panel]").forEach((panel) => {
        panel.hidden = true;
        panel.style.removeProperty("left");
        panel.style.removeProperty("top");
        panel.style.removeProperty("visibility");
        panel.style.removeProperty("max-height");
        delete panel.dataset.placement;
      });
      root.querySelectorAll<HTMLButtonElement>("[data-glossary-trigger]").forEach((trigger) => {
        trigger.setAttribute("aria-expanded", "false");
      });
      if (restoreFocus && lastGlossaryTrigger) lastGlossaryTrigger.focus({ preventScroll: true });
      lastGlossaryTrigger = null;
      lastGlossaryPanel = null;
    };

    root.querySelectorAll<HTMLButtonElement>("[data-glossary-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const targetId = trigger.getAttribute("aria-controls");
        const target = targetId ? document.getElementById(targetId) : null;
        const wasOpen = trigger.getAttribute("aria-expanded") === "true";
        closeGlossary(false);
        if (!target || wasOpen) return;
        target.hidden = false;
        trigger.setAttribute("aria-expanded", "true");
        lastGlossaryTrigger = trigger;
        lastGlossaryPanel = target;
        positionGlossary(trigger, target);
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-glossary-close]").forEach((button) => {
      button.addEventListener("click", () => closeGlossary(true));
    });

    window.addEventListener("resize", repositionGlossary, { passive: true });
    window.addEventListener("scroll", repositionGlossary, { passive: true, capture: true });

    root.querySelectorAll<HTMLElement>("[data-comparison]").forEach((comparison) => {
      const controls = [...comparison.querySelectorAll<HTMLButtonElement>("[data-comparison-option]")];
      const items = [...comparison.querySelectorAll<HTMLElement>("[data-comparison-item]")];
      const select = (itemKey: string) => {
        controls.forEach((control) => {
          const selected = control.dataset.itemKey === itemKey;
          control.setAttribute("aria-pressed", String(selected));
          control.classList.toggle("is-selected", selected);
        });
        items.forEach((item) => {
          const selected = item.dataset.itemKey === itemKey;
          item.dataset.selected = String(selected);
          item.classList.toggle("is-selected", selected);
        });
      };
      controls.forEach((control) => {
        control.addEventListener("click", () => select(control.dataset.itemKey || ""));
      });
      const initial = controls.find((control) => control.getAttribute("aria-pressed") === "true") ?? controls[0];
      if (initial) select(initial.dataset.itemKey || "");
    });

    let persistedAnswers: Record<string, string> = {};
    try {
      const stored = localStorage.getItem(answerStorageKey);
      persistedAnswers = stored ? JSON.parse(stored) : {};
    } catch {
      persistedAnswers = {};
    }

    const saveAnswers = () => {
      try {
        localStorage.setItem(answerStorageKey, JSON.stringify(persistedAnswers));
      } catch {
        // Local persistence is progressive enhancement; lesson interaction remains available.
      }
    };

    const updateSummary = () => {
      if (!learningSummary) return;
      const lists = new Map<string, HTMLElement>();
      ["understood", "reinforce", "pending"].forEach((state) => {
        const list = learningSummary.querySelector<HTMLElement>(`[data-summary-list="${state}"]`);
        if (list) lists.set(state, list);
      });

      const counts = { understood: 0, reinforce: 0, pending: 0 };
      let assessedConcepts = 0;
      let understoodAssessedConcepts = 0;

      conceptItems.forEach((item) => {
        const conceptId = item.dataset.conceptId || "";
        const relatedChecks = checkElements.filter((check) =>
          (check.dataset.conceptIds || "").split(",").filter(Boolean).includes(conceptId)
        );
        let state: "understood" | "reinforce" | "pending" = "pending";

        if (relatedChecks.length > 0) {
          assessedConcepts += 1;
          const answered = relatedChecks.filter((check) => Boolean(check.dataset.result));
          if (answered.some((check) => check.dataset.result === "incorrect")) {
            state = "reinforce";
          } else if (answered.length === relatedChecks.length) {
            state = "understood";
            understoodAssessedConcepts += 1;
          }
        }

        item.dataset.summaryState = state;
        counts[state] += 1;
        lists.get(state)?.appendChild(item);
      });

      (["understood", "reinforce", "pending"] as const).forEach((state) => {
        const group = learningSummary.querySelector<HTMLElement>(`[data-summary-group="${state}"]`);
        const count = group?.querySelector<HTMLElement>("[data-summary-count]");
        if (count) count.textContent = String(counts[state]);
        if (group) group.hidden = counts[state] === 0;
      });

      const estimateValue = learningSummary.querySelector<HTMLElement>("[data-understanding-estimate-value]");
      const estimateNote = learningSummary.querySelector<HTMLElement>("[data-understanding-estimate-note]");
      const answeredChecks = checkElements.filter((check) => Boolean(check.dataset.result)).length;
      const estimateReady = checkElements.length > 0 && answeredChecks === checkElements.length && assessedConcepts > 0;

      if (estimateReady) {
        const estimate = Math.round((understoodAssessedConcepts / assessedConcepts) * 100);
        learningSummary.dataset.understandingEstimate = String(estimate);
        learningSummary.dataset.estimateStatus = "ready";
        if (estimateValue) estimateValue.textContent = `${estimate}%`;
        if (estimateNote) estimateNote.textContent = learningSummary.dataset.estimateReadyLabel || "";
      } else {
        delete learningSummary.dataset.understandingEstimate;
        learningSummary.dataset.estimateStatus = "pending";
        if (estimateValue) estimateValue.textContent = "—";
        if (estimateNote) estimateNote.textContent = learningSummary.dataset.estimatePendingLabel || "";
      }
    };

    const applyAnswer = (check: HTMLElement, option: HTMLButtonElement, persist = true) => {
      const feedback = check.querySelector<HTMLElement>("[data-microcheck-feedback]");
      const result = check.querySelector<HTMLElement>("[data-microcheck-result]");
      const rationale = check.querySelector<HTMLElement>("[data-microcheck-rationale]");
      const options = [...check.querySelectorAll<HTMLButtonElement>("[data-microcheck-option]")];
      const correct = option.dataset.isCorrect === "true";

      options.forEach((item) => {
        item.setAttribute("aria-pressed", String(item === option));
        item.classList.toggle("is-selected", item === option);
        item.classList.toggle("is-correct", item === option && correct);
        item.classList.toggle("is-incorrect", item === option && !correct);
      });
      check.dataset.result = correct ? "correct" : "incorrect";
      check.dataset.selectedOptionKey = option.dataset.optionKey || "";
      if (result) result.textContent = correct ? check.dataset.correctLabel || "Correct" : check.dataset.incorrectLabel || "Review";
      if (rationale) rationale.textContent = option.dataset.rationale || "";
      if (feedback) feedback.hidden = false;

      const checkId = check.dataset.checkId || "";
      if (persist && checkId) {
        persistedAnswers[checkId] = option.dataset.optionKey || "";
        saveAnswers();
        seedReviewFromLessonCheck({
          lessonId: root.dataset.lessonId || "",
          checkId,
          conceptIds: (check.dataset.conceptIds || "").split(",").filter(Boolean),
          correct,
        });
      }
      updateSummary();
    };

    checkElements.forEach((check) => {
      const options = [...check.querySelectorAll<HTMLButtonElement>("[data-microcheck-option]")];
      options.forEach((option) => {
        option.addEventListener("click", () => applyAnswer(check, option, true));
      });

      const savedOptionKey = persistedAnswers[check.dataset.checkId || ""];
      const savedOption = savedOptionKey
        ? options.find((option) => option.dataset.optionKey === savedOptionKey)
        : undefined;
      if (savedOption) applyAnswer(check, savedOption, false);
    });
    updateSummary();

    root.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && root.querySelector("[data-glossary-panel]:not([hidden])")) {
        event.preventDefault();
        closeGlossary(true);
      }
    });

    const show = (requested: number, focus = false, source = "ui") => {
      if (blocks.length === 0) return;
      closeGlossary(false);
      index = Math.max(0, Math.min(requested, blocks.length - 1));
      blocks.forEach((block, blockIndex) => {
        const active = blockIndex === index;
        block.hidden = !active;
        block.setAttribute("aria-hidden", String(!active));
      });
      if (objectives) objectives.hidden = index !== 0;
      if (learningSummary) learningSummary.hidden = index !== blocks.length - 1;
      if (previous) previous.disabled = index === 0;
      if (next) next.disabled = index === blocks.length - 1;
      if (current) current.textContent = String(index + 1);
      if (progress) progress.setAttribute("aria-valuenow", String(index + 1));
      if (progressBar) progressBar.style.width = `${((index + 1) / blocks.length) * 100}%`;
      if (status) {
        const active = blocks[index];
        const label = active?.querySelector<HTMLElement>(".dynamic-role")?.textContent?.trim();
        status.textContent = label || `${index + 1}/${blocks.length}`;
      }
      root.dataset.activeBlock = blocks[index]?.dataset.blockKey || "";
      document.dispatchEvent(new CustomEvent("bibli:dynamic-block-change", {
        detail: {
          lessonId: root.dataset.lessonId || "",
          blockId: blocks[index]?.dataset.blockId || "",
          blockKey: blocks[index]?.dataset.blockKey || "",
          position: index + 1,
          total: blocks.length,
          source,
        },
      }));
      if (focus) blocks[index]?.focus?.({ preventScroll: true });
    };

    root.querySelectorAll<HTMLButtonElement>("[data-review-block-key]").forEach((button) => {
      button.addEventListener("click", () => {
        const blockKey = button.dataset.reviewBlockKey || "";
        const targetIndex = blocks.findIndex((block) => block.dataset.blockKey === blockKey);
        if (targetIndex >= 0) show(targetIndex, true, "review");
      });
    });

    previous?.addEventListener("click", () => show(index - 1, false, "ui"));
    next?.addEventListener("click", () => show(index + 1, false, "ui"));
    root.addEventListener("bibli:dynamic-reset", () => show(0, false, "reset"));
    document.addEventListener("bibli:tts-dynamic-navigate", (event) => {
      if (!(event instanceof CustomEvent)) return;
      const detail = event.detail || {};
      if (detail.lessonId && detail.lessonId !== (root.dataset.lessonId || "")) return;
      if (detail.direction === "next") show(index + 1, false, "tts");
      if (detail.direction === "previous") show(index - 1, false, "tts");
    });

    root.dataset.dynamicMounted = "true";
    const requestedBlockKey = new URLSearchParams(window.location.search).get("block") || "";
    const requestedIndex = requestedBlockKey
      ? blocks.findIndex((block) => block.dataset.blockKey === requestedBlockKey)
      : -1;
    show(requestedIndex >= 0 ? requestedIndex : 0, false, requestedIndex >= 0 ? "deeplink" : "initial");
  });
</script>

