---
import { sitePath } from "../lib/site-paths";
import {
  getAllPeople,
  getEventsByPersonId,
  getLessonsByPersonId,
  getPlacesByPersonIdViaEvents,
} from "../lib/queries";

type Props = {
  slug: string;
};

const { slug } = Astro.props as Props;

const person =
  getAllPeople().find(
    (candidate) =>
      candidate.slug === slug &&
      candidate.status !== "Borrador"
  ) ?? null;

const events = person
  ? getEventsByPersonId(person.id)
  : [];

const lessons = person
  ? getLessonsByPersonId(person.id)
  : [];

const places = person
  ? getPlacesByPersonIdViaEvents(person.id)
  : [];
---

{person && (
  <div
    class="person-entity-connections"
    data-person-entity-connections={person.slug}
  >
    {events.length > 0 && (
      <section
        class="section person-events-section"
        data-explicit-connections="event-people"
      >
        <div class="section-header">
          <div>
            <p class="eyebrow">
              Conexión explícita · personaje
            </p>

            <h2>Eventos relacionados</h2>

            <p class="connection-note">
              Eventos vinculados explícitamente con
              {` ${person.name} `}
              como personaje bíblico.
            </p>
          </div>

          <span class="section-count">
            {events.length}
          </span>
        </div>

        <div class="person-events-grid">
          {events.map((event) => (
            <a
              href={sitePath(
                `/eventos/${event.slug}/`
              )}
              class="person-event-card"
              data-explicit-connection="event-people"
            >
              <span>
                {event.biblical_period ??
                  event.event_type ??
                  "Evento bíblico"}
              </span>

              <strong>
                {event.title}
              </strong>

              {event.summary && (
                <small>
                  {event.summary}
                </small>
              )}

              <div class="person-card-badges">
                {event.approximate_date && (
                  <em>
                    {event.approximate_date}
                  </em>
                )}

                {event.appears_on_timeline && (
                  <em>Línea de tiempo</em>
                )}

                {event.appears_on_map && (
                  <em>Mapa</em>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {places.length > 0 && (
      <section
        class="section person-places-section"
        data-derived-connections="person-places-via-events"
      >
        <div class="section-header">
          <div>
            <p class="eyebrow">
              Conexión derivada · vía eventos
            </p>

            <h2>
              Lugares vinculados por eventos
            </h2>

            <p class="connection-note">
              Estos lugares proceden de eventos
              que relacionan explícitamente al
              personaje y al lugar. No representan
              una relación Persona↔Lugar directa.
            </p>
          </div>

          <span class="section-count">
            {places.length}
          </span>
        </div>

        <div class="person-places-grid">
          {places.map((place) => {
            const hasCoordinates =
              place.latitude !== null &&
              place.longitude !== null;

            return (
              <article class="person-place-card">
                <span>
                  {place.place_type ?? "Lugar"}
                </span>

                <strong>
                  {place.title}
                </strong>

                {place.summary && (
                  <p>
                    {place.summary}
                  </p>
                )}

                {place.geographical_certainty && (
                  <small>
                    Certeza:
                    {` ${place.geographical_certainty}`}
                  </small>
                )}

                <small class="derived-evidence">
                  Derivado de
                  {` ${place.via_event_count} `}
                  {place.via_event_count === 1
                    ? "evento compartido"
                    : "eventos compartidos"}
                </small>

                <details
                  class="derived-evidence-events"
                  data-derived-evidence-events="person-places-via-events"
                  data-derived-evidence-count={
                    place.evidence_events.length
                  }
                >
                  <summary>
                    Ver
                    {` ${place.evidence_events.length} `}
                    {place.evidence_events.length === 1
                      ? "evento de evidencia"
                      : "eventos de evidencia"}
                  </summary>

                  <ul>
                    {place.evidence_events.map(
                      (event) => (
                        <li>
                          <a
                            href={sitePath(
                              `/eventos/${event.slug}/`
                            )}
                            data-derived-evidence-event="person-places-via-events"
                            data-derived-evidence-via="event-people,event-places"
                          >
                            {event.title}
                          </a>

                          {event.approximate_date && (
                            <small>
                              {event.approximate_date}
                            </small>
                          )}
                        </li>
                      )
                    )}
                  </ul>
                </details>

                <div class="person-card-actions">
                  <a
                    href={sitePath(
                      `/lugares/${place.slug}/`
                    )}
                    data-derived-connection="person-places-via-events"
                    data-derived-via="event-people,event-places"
                    data-derived-evidence-count={
                      place.via_event_count
                    }
                  >
                    Ver lugar
                  </a>

                  {hasCoordinates && (
                    <a
                      href={sitePath(
                        `/mapa/?lugar=${place.slug}`
                      )}
                    >
                      Ver en mapa
                    </a>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    {lessons.length > 0 && (
      <section
        class="section person-lessons-section"
        data-explicit-connections="lesson-people"
      >
        <div class="section-header">
          <div>
            <p class="eyebrow">
              Conexión explícita · personaje
            </p>

            <h2>
              Lecciones relacionadas como personaje
            </h2>

            <p class="connection-note">
              Esta relación procede de
              lesson_people y se conserva separada
              de las relaciones propias del Glosario.
            </p>
          </div>

          <span class="section-count">
            {lessons.length}
          </span>
        </div>

        <div class="person-lessons-grid">
          {lessons.map((lesson) => (
            <a
              href={sitePath(
                `/lecciones/${lesson.slug}/`
              )}
              class="person-lesson-card"
              data-explicit-connection="lesson-people"
            >
              <span>
                Lección {lesson.lesson_number}
              </span>

              <strong>
                {lesson.title}
              </strong>

              {lesson.main_idea && (
                <small>
                  {lesson.main_idea}
                </small>
              )}
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
)}

<style>
  .person-entity-connections {
    display: grid;
    gap: 24px;
  }

  .connection-note {
    max-width: 760px;
    margin: 8px 0 0;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .person-events-grid,
  .person-places-grid,
  .person-lessons-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .person-event-card,
  .person-place-card,
  .person-lesson-card {
    display: grid;
    align-content: start;
    gap: 10px;
    min-height: 190px;
    padding: 22px;
    border: 1px solid var(--border-color);
    border-radius: 22px;
    background: var(--surface-soft);
    color: inherit;
    text-decoration: none;
    box-shadow:
      0 14px 34px
      rgba(15, 23, 42, 0.05);
  }

  .person-event-card span,
  .person-place-card span,
  .person-lesson-card span {
    color: var(--accent);
    font-size: .76rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .person-event-card strong,
  .person-place-card strong,
  .person-lesson-card strong {
    color: var(--heading-color);
    font-size: 1.12rem;
    line-height: 1.35;
  }

  .person-event-card small,
  .person-place-card small,
  .person-lesson-card small,
  .person-place-card p {
    color: var(--text-muted);
    font-size: .92rem;
    line-height: 1.55;
  }

  .person-place-card p {
    margin: 0;
  }

  .derived-evidence {
    font-weight: 800;
  }

  .derived-evidence-events {
    padding-top: 4px;
    border-top:
      1px solid var(--border-color);
  }

  .derived-evidence-events summary {
    cursor: pointer;
    color: var(--accent);
    font-size: .88rem;
    font-weight: 900;
    line-height: 1.4;
  }

  .derived-evidence-events ul {
    display: grid;
    gap: 8px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .derived-evidence-events li {
    display: grid;
    gap: 2px;
  }

  .derived-evidence-events a,
  .person-card-actions a {
    color: var(--accent);
    font-weight: 800;
    text-decoration: none;
  }

  .derived-evidence-events a:hover,
  .person-card-actions a:hover {
    text-decoration: underline;
  }

  .person-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .person-card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .person-card-badges em {
    padding: 6px 9px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--surface);
    color: var(--accent);
    font-size: .76rem;
    font-style: normal;
    font-weight: 900;
  }

  @media(max-width: 900px) {
    .person-events-grid,
    .person-places-grid,
    .person-lessons-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
