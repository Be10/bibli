  .tts-mini-indicator i:nth-child(2) { height:15px; animation-delay:-.35s; }
  .tts-mini-indicator i:nth-child(3) { height:11px; animation-delay:-.6s; }
  .global-tts.is-paused .tts-mini-indicator i { animation-play-state:paused; opacity:.55; }
  @keyframes tts-bars { from { transform:scaleY(.45); } to { transform:scaleY(1); } }
  .tts-player-head { display:flex; align-items:flex-start; justify-content:space-between; gap:.75rem; }
  .tts-player-copy { display:grid; min-width:0; gap:.12rem; }
  .tts-eyebrow { color:var(--text-muted); font-size:.64rem; font-weight:850; letter-spacing:.08em; text-transform:uppercase; }
  .tts-player-copy strong { min-width:0; color:var(--heading-color); font-size:.84rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .tts-estimate { min-height:1em; display:inline-flex; align-items:center; gap:.32rem; color:var(--text-muted); font-size:.68rem; font-weight:700; }
  .tts-estimate :global(.bibli-icon) { color:var(--accent); flex:0 0 auto; }
  .tts-close,.tts-control { display:grid; place-items:center; border:1px solid var(--border-color); background:var(--surface-soft); color:var(--text-color); cursor:pointer; }
  .tts-close { width:44px; height:44px; flex:0 0 auto; border-radius:10px; }
  .tts-controls { display:flex; align-items:center; justify-content:center; gap:.4rem; }
  .tts-control { width:44px; height:44px; border-radius:12px; }
  .tts-control:hover,.tts-close:hover { border-color:var(--accent-border); background:var(--accent-soft); color:var(--accent); }
  .tts-play { width:48px; height:48px; border-color:var(--accent); background:var(--accent); color:var(--accent-contrast); }
  .tts-play:hover { background:var(--accent-hover); color:var(--accent-contrast); }
  .tts-options { display:grid; grid-template-columns:110px minmax(0,1fr); gap:.55rem; }
  .tts-options label { display:grid; gap:.25rem; min-width:0; }
  .tts-options label > span { color:var(--text-muted); font-size:.64rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; }
  .tts-options select { min-width:0; width:100%; height:44px; border:1px solid var(--border-color); border-radius:10px; background:var(--surface-soft); color:var(--heading-color); padding:0 .55rem; font:inherit; font-size:.72rem; font-weight:700; }
  :global(.dynamic-block.tts-active-block) { border-color:color-mix(in srgb,var(--accent) 48%,var(--border-color)); box-shadow:0 0 0 2px color-mix(in srgb,var(--accent) 12%,transparent),var(--shadow-sm); }
  :global(.tts-active-source) { outline:2px solid color-mix(in srgb,var(--accent) 48%,transparent); outline-offset:5px; border-radius:8px; background-color:color-mix(in srgb,var(--accent-soft) 28%,transparent); }
  @media(max-width:600px){
    .global-tts { left:10px; right:10px; bottom:calc(82px + env(safe-area-inset-bottom)); display:flex; justify-content:flex-end; }
    .tts-player { width:100%; max-height:calc(100dvh - 20px); overflow:auto; overscroll-behavior:contain; box-shadow:0 -8px 24px rgba(15,23,42,.10); }
    .tts-launcher span { display:none; }
    .tts-launcher { width:48px; min-height:48px; padding:0; justify-content:center; }
    .tts-options { grid-template-columns:92px minmax(0,1fr); }
    .tts-mini { width:auto; min-width:0; max-width:min(228px,calc(100vw - 24px)); min-height:44px; gap:.4rem; padding:.3rem .42rem; border-radius:13px; box-shadow:0 -6px 18px rgba(15,23,42,.09); }
    .tts-mini-indicator { width:26px; height:26px; flex-basis:26px; border-radius:8px; }
    .tts-mini-indicator i { width:2px; }
    .tts-mini-copy { gap:0; }
    .tts-mini-copy strong { display:none; }
    .tts-mini-copy small { max-width:142px; font-size:.62rem; font-weight:720; }
    .tts-mini > :global(.bibli-icon) { width:15px; height:15px; }
  }
  :global(html[data-theme="dark"]) .tts-player,
  :global(html[data-theme="dark"]) .tts-mini { box-shadow:0 -10px 30px rgba(0,0,0,.18); }
  @media(prefers-reduced-motion:reduce){ :global(.tts-active-source){ scroll-behavior:auto; } .tts-mini-indicator i{animation:none;} }

  :global(html[data-lesson-dock="true"]) .tts-launcher { display:none !important; }
</style>
