---
import Icon from "./Icon.astro";
import ttsLexicon from "../../content/learning/tts-lexicon.json";

type LanguageCode = "es" | "en";
interface Props { lang?: LanguageCode; }
const { lang = "es" } = Astro.props;
const copy = lang === "en"
  ? {
      launcher: "Read aloud",
      title: "Read aloud",
      ready: "Ready to read",
      part: "Part",
      block: "Block",
      of: "of",
      previous: "Previous part",
      play: "Play",
      pause: "Pause",
      next: "Next part",
      stop: "Stop",
      close: "Minimize reader",
      voice: "Voice",
      automaticVoice: "Bibli · Automatic",
      bibliVoices: "English voices",
      femaleVoices: "Female voices",
      maleVoices: "Male voices",
      femaleOne: "Bibli · Grace",
      femaleTwo: "Bibli · Emma",
      maleOne: "Bibli · James",
      maleTwo: "Bibli · Daniel",
      verse: "Verse",
      speed: "Speed",
      unavailable: "Text to speech is not available in this browser.",
      noContent: "There is no readable content on this page.",
      estimatedTime: "Estimated",
      minuteApprox: "min approx.",
    }
  : {
      launcher: "Escuchar",
      title: "Lectura en voz alta",
      ready: "Listo para leer",
      part: "Fragmento",
      block: "Bloque",
      of: "de",
      previous: "Fragmento anterior",
      play: "Reproducir",
      pause: "Pausar",
      next: "Fragmento siguiente",
      stop: "Detener",
      close: "Minimizar lector",
      voice: "Voz",
      automaticVoice: "Bibli · Automática",
      bibliVoices: "Voces en español",
      femaleVoices: "Voces femeninas",
      maleVoices: "Voces masculinas",
      femaleOne: "Bibli · Clara",
      femaleTwo: "Bibli · Serena",
      maleOne: "Bibli · Mateo",
      maleTwo: "Bibli · Samuel",
      verse: "Versículo",
      speed: "Velocidad",
      unavailable: "La lectura en voz alta no está disponible en este navegador.",
      noContent: "No hay contenido de lectura en esta página.",
      estimatedTime: "Duración",
      minuteApprox: "min aprox.",
    };
const ttsCopyPayload = JSON.stringify(copy);
const ttsLexiconPayload = JSON.stringify(ttsLexicon);
---

<div class="global-tts" data-global-tts data-tts-lang={lang} data-tts-copy={ttsCopyPayload} data-tts-lexicon={ttsLexiconPayload} data-tts-provider-default="browser-web-speech" data-tts-rules-version={ttsLexicon.rules_version} data-tts-cache-version={ttsLexicon.cache_version} data-tts-dynamic-sync="block-v1" hidden>
  <button type="button" class="tts-launcher" data-tts-launcher aria-label={copy.launcher} title={copy.launcher}>
    <Icon name="volume" size={19} />
    <span>{copy.launcher}</span>
  </button>

  <section class="tts-player" data-tts-player hidden aria-label={copy.title}>
    <header class="tts-player-head">
      <div class="tts-player-copy">
        <span class="tts-eyebrow">{copy.title}</span>
        <strong data-tts-status role="status" aria-live="polite" aria-atomic="true">{copy.ready}</strong>
        <small class="tts-estimate"><Icon name="clock" size={13} /><span data-tts-estimate></span></small>
      </div>
      <button type="button" class="tts-close" data-tts-close aria-label={copy.close} title={copy.close}>
        <Icon name="close" size={17} />
      </button>
    </header>

    <div class="tts-controls" role="group" aria-label={copy.title}>
      <button type="button" class="tts-control" data-tts-previous aria-label={copy.previous} title={copy.previous}>
        <Icon name="skip-back" size={18} />
      </button>
      <button type="button" class="tts-control tts-play" data-tts-play aria-label={copy.play} title={copy.play}>
        <span data-tts-play-icon><Icon name="play" size={20} /></span>
        <span data-tts-pause-icon hidden><Icon name="pause" size={20} /></span>
      </button>
      <button type="button" class="tts-control" data-tts-next aria-label={copy.next} title={copy.next}>
        <Icon name="skip-forward" size={18} />
      </button>
      <button type="button" class="tts-control" data-tts-stop aria-label={copy.stop} title={copy.stop}>
        <Icon name="square" size={16} />
      </button>
    </div>

    <div class="tts-options">
      <label>
        <span>{copy.speed}</span>
        <select data-tts-rate aria-label={copy.speed}>
          <option value="0.75">0.75×</option>
          <option value="1" selected>1×</option>
          <option value="1.25">1.25×</option>
          <option value="1.5">1.5×</option>
        </select>
      </label>
      <label class="tts-voice-label">
        <span>{copy.voice}</span>
        <select data-tts-voice aria-label={copy.voice}>
          <option value="profile:auto">{copy.automaticVoice}</option>
        </select>
      </label>
    </div>
  </section>

  <button type="button" class="tts-mini" data-tts-mini hidden aria-label={copy.launcher} title={copy.launcher}>
    <span class="tts-mini-indicator" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="tts-mini-copy"><strong>{copy.title}</strong><small data-tts-mini-status>{copy.ready}</small></span>
    <Icon name="arrow-up" size={17} />
  </button>
</div>

<script>
  import {
    buildTtsCacheKey,
    createBrowserSpeechProvider,
    createSpeechNormalizer,
    inferTtsSemanticRole,
    normalizeWhitespace,
  } from "../lib/tts/index.js";

  (() => {
    const root = document.querySelector("[data-global-tts]");
    if (!(root instanceof HTMLElement)) return;

    const lang = root.dataset.ttsLang === "en" ? "en" : "es";
    const copy = JSON.parse(root.dataset.ttsCopy || "{}");
    const lexicon = JSON.parse(root.dataset.ttsLexicon || "{}");
    const speechNormalizer = createSpeechNormalizer(lexicon, lang);
    const speechProvider = createBrowserSpeechProvider(window);
    const pageSpeechLang = speechNormalizer.speechLocale;
    const voiceKey = `bibli-tts-voice-${lang}-v1`;
    const rateKey = "bibli-tts-rate-v1";
    root.dataset.ttsProvider = speechProvider.id;

    const launcher = root.querySelector("[data-tts-launcher]");
    const player = root.querySelector("[data-tts-player]");
    const close = root.querySelector("[data-tts-close]");
    const previous = root.querySelector("[data-tts-previous]");
    const play = root.querySelector("[data-tts-play]");
    const next = root.querySelector("[data-tts-next]");
    const stop = root.querySelector("[data-tts-stop]");
    const status = root.querySelector("[data-tts-status]");
    const estimate = root.querySelector("[data-tts-estimate]");
    const mini = root.querySelector("[data-tts-mini]");
    const miniStatus = root.querySelector("[data-tts-mini-status]");
    const rateSelect = root.querySelector("[data-tts-rate]");
    const voiceSelect = root.querySelector("[data-tts-voice]");
    const playIcon = root.querySelector("[data-tts-play-icon]");
    const pauseIcon = root.querySelector("[data-tts-pause-icon]");

    if (!speechProvider.available || !(launcher instanceof HTMLButtonElement) || !(player instanceof HTMLElement)) {
      root.hidden = true;
      return;
    }

    let chunks = [];
    let currentIndex = 0;
    let activeSource = null;
    let activeDynamicBlock = null;
    let dynamicState = { lessonId: "", blockId: "", blockKey: "", position: 0, total: 0 };
    let session = 0;
    let playing = false;
    let paused = false;
    // The mini player is a surface state, not only a playback state. Keeping this
    // separate lets a minimized player survive Study/Reading source changes while
    // the old audio is deliberately stopped.
    let keepMiniVisible = false;
    let voices = [];
    let resumeAfterVisibility = false;
    let foregroundRecoveryTimer = 0;
    let semanticPauseTimer = 0;

    let mediaSession = null;
    let audioSession = null;
    try {
      mediaSession = "mediaSession" in navigator ? navigator.mediaSession : null;
    } catch {
      mediaSession = null;
    }
    try {
      audioSession = navigator.audioSession ?? null;
    } catch {
      audioSession = null;
    }
    const prepareAudioSession = () => {
      try {
        if (audioSession) audioSession.type = "playback";
      } catch {}
    };
    prepareAudioSession();

    const lessonDockActive = () => document.documentElement.dataset.lessonDock === "true";
    const syncCollapsedSurface = () => {
      const expanded = !player.hidden;
      const miniVisible = !expanded && (playing || keepMiniVisible);
      if (mini instanceof HTMLButtonElement) mini.hidden = !miniVisible;
      root.classList.toggle("is-mini", miniVisible);
      if (launcher instanceof HTMLButtonElement) launcher.hidden = expanded || miniVisible || playing || lessonDockActive();
      document.documentElement.dataset.ttsActive = playing ? "true" : "false";
      document.documentElement.dataset.ttsMiniVisible = miniVisible ? "true" : "false";
    };

    const syncFloatingUiOffset = () => {
      const rootElement = document.documentElement;
      if (player.hidden) {
        delete rootElement.dataset.ttsPlayerOpen;
        rootElement.style.setProperty("--tts-player-offset", "0px");
        return;
      }
      const height = Math.ceil(player.getBoundingClientRect().height + 12);
      rootElement.dataset.ttsPlayerOpen = "true";
      rootElement.style.setProperty("--tts-player-offset", `${height}px`);
    };

    const normalize = normalizeWhitespace;
    const prepareSpeechText = (value) => speechNormalizer.normalize(value);

    const isVisible = (element) => {
      if (!(element instanceof HTMLElement)) return false;
      const style = getComputedStyle(element);
      return style.display !== "none" && style.visibility !== "hidden" && element.getClientRects().length > 0;
    };

    const splitLongText = (text, source, semanticRole = inferTtsSemanticRole(source)) => {
      const clean = prepareSpeechText(text);
      const makePart = (part) => ({ text: part, source, semanticRole });
      if (clean.length <= 520) return clean ? [makePart(clean)] : [];
      const sentences = clean.match(/[^.!?…]+[.!?…]+|[^.!?…]+$/g) ?? [clean];
      const parts = [];
      let buffer = "";
      for (const sentence of sentences) {
        const nextValue = normalize(`${buffer} ${sentence}`);
        if (buffer && nextValue.length > 520) {
          parts.push(makePart(buffer));
          buffer = normalize(sentence);
        } else {
          buffer = nextValue;
        }
      }
      if (buffer) parts.push(makePart(buffer));
      return parts;
    };

    const isDynamicPresentation = () =>
      document.documentElement.dataset.lessonMode === "study"
      && document.documentElement.dataset.studyPresentation === "dynamic";

    const getDynamicRoot = () => {
      const candidates = Array.from(document.querySelectorAll("[data-dynamic-lesson]"));
      return candidates.find((element) => element instanceof HTMLElement && isVisible(element)) ?? null;
    };

    const syncDynamicStateFromBlock = (dynamicRoot, block) => {
      if (!(dynamicRoot instanceof HTMLElement) || !(block instanceof HTMLElement)) return;
      dynamicState = {
        lessonId: dynamicRoot.dataset.lessonId || "",
        blockId: block.dataset.blockId || "",
        blockKey: block.dataset.blockKey || "",
        position: Number(block.dataset.blockPosition) || 0,
        total: Number(dynamicRoot.dataset.blockCount) || 0,
      };
      root.dataset.ttsDynamicBlockKey = dynamicState.blockKey;
      root.dataset.ttsDynamicBlockPosition = String(dynamicState.position || 0);
      root.dataset.ttsDynamicBlockTotal = String(dynamicState.total || 0);
    };

    const getDynamicSemanticRole = (source, block) => {
      if (source instanceof Element && source.closest("[data-microcheck]")) return "question";
      if (source instanceof Element && source.matches("h3,h4,h5")) {
        return block?.dataset.semanticRole === "title" ? "title" : "heading";
      }
      const role = block?.dataset.semanticRole || "";
      if (role === "title") return "title";
      if (role === "primary-reading") return "bible-reading";
      if (role === "application") return "application";
      if (role === "reflection") return "reflection";
      if (role === "summary") return "summary";
      if (role === "prayer") return "prayer";
      return "explanation";
    };

    const buildDynamicChunks = () => {
      const dynamicRoot = getDynamicRoot();
      if (!(dynamicRoot instanceof HTMLElement)) return [];
      const activeBlock = dynamicRoot.querySelector("[data-dynamic-block]:not([hidden])");
      if (!(activeBlock instanceof HTMLElement)) return [];
      syncDynamicStateFromBlock(dynamicRoot, activeBlock);

      const selectors = [
        ":scope > h3",
        ":scope > .dynamic-scripture-reference > strong",
        ":scope > .dynamic-scripture-reference > span",
        ":scope > .dynamic-copy > p",
        ":scope > [data-learning-interaction] .dynamic-interaction-heading h4",
        ":scope > [data-learning-interaction] .dynamic-interaction-body",
        ":scope > [data-learning-interaction] [data-comparison-item] > span",
        ":scope > [data-learning-interaction] [data-comparison-item] > h5",
        ":scope > [data-learning-interaction] [data-comparison-item] > p",
        ":scope > [data-learning-interaction] .dynamic-interaction-instruction",
        ":scope > [data-microcheck] > h4",
        ":scope > [data-microcheck] [data-microcheck-option] > span:last-child",
      ];
      const candidates = Array.from(activeBlock.querySelectorAll(selectors.join(",")));
      const parts = candidates.flatMap((element) => {
        if (!(element instanceof HTMLElement) || !isVisible(element)) return [];
        return splitLongText(element.textContent, element, getDynamicSemanticRole(element, activeBlock));
      });
      if (parts.length) return parts;
      return splitLongText(activeBlock.textContent, activeBlock, getDynamicSemanticRole(activeBlock, activeBlock));
    };

    const getActiveReader = () => {
      const readers = Array.from(document.querySelectorAll("[data-reader-content]"));
      return readers.find((element) => isVisible(element)) ?? readers[0] ?? null;
    };

    const buildChunks = () => {
      if (isDynamicPresentation()) return buildDynamicChunks();

      const reader = getActiveReader();
      if (!(reader instanceof HTMLElement)) return [];

      const lessonIntro = [];
      if (reader.matches("[data-study-content]")) {
        const title = document.querySelector("[data-tts-lesson-title]");
        const reference = document.querySelector("[data-tts-lesson-reference]");
        if (title instanceof HTMLElement && isVisible(title)) lessonIntro.push(...splitLongText(title.textContent, title));
        if (reference instanceof HTMLElement && isVisible(reference)) lessonIntro.push(...splitLongText(reference.textContent, reference));
      }

      const bibleVerses = Array.from(reader.querySelectorAll(".bible-chapter-verse"));
      if (bibleVerses.length) {
        return [...lessonIntro, ...bibleVerses.flatMap((verse) => {
          const number = normalize(verse.querySelector(".verse-number")?.textContent);
          const text = normalize(verse.querySelector(".verse-text")?.textContent ?? verse.textContent);
          return splitLongText(number ? `${copy.verse} ${number}. ${text}` : text, verse);
        })];
      }

      const readingVerses = Array.from(reader.querySelectorAll(".verse[id^='reading-v']"));
      if (readingVerses.length) {
        return [...lessonIntro, ...readingVerses.flatMap((verse) => {
          const number = normalize(verse.querySelector("sup")?.textContent);
          const text = normalize(verse.textContent?.replace(number, ""));
          return splitLongText(number ? `${copy.verse} ${number}. ${text}` : text, verse);
        })];
      }

      const candidates = Array.from(reader.querySelectorAll("h2, h3, p, li"));
      const bodyChunks = candidates.flatMap((element) => {
        if (!isVisible(element)) return [];
        if (element.matches("p") && element.closest("li")) return [];
        return splitLongText(element.textContent, element);
      });
      return [...lessonIntro, ...bodyChunks];
    };

    const syncMediaSession = () => {
      if (!mediaSession) return;
      try {
        mediaSession.playbackState = playing ? (paused ? "paused" : "playing") : "none";
      } catch {}
      try {
        if (typeof MediaMetadata !== "undefined") {
          const pageTitle = normalize(document.querySelector("h1")?.textContent) || document.title || "Bibli";
          const partLabel = chunks.length ? `${copy.part} ${currentIndex + 1} ${copy.of} ${chunks.length}` : copy.ready;
          mediaSession.metadata = new MediaMetadata({
            title: pageTitle,
            artist: partLabel,
            album: lang === "en" ? "Bibli · Biblical Library" : "Bibli · Biblioteca Bíblica",
          });
        }
      } catch {}
    };

    const setStatus = () => {
      syncEstimatedTime();
      if (!(status instanceof HTMLElement)) return;
      if (!chunks.length) {
        status.textContent = copy.ready;
        if (miniStatus instanceof HTMLElement) miniStatus.textContent = copy.ready;
        syncMediaSession();
        return;
      }
      const partLabel = `${copy.part} ${currentIndex + 1} ${copy.of} ${chunks.length}`;
      const label = isDynamicPresentation() && dynamicState.position > 0
        ? `${copy.block} ${dynamicState.position} ${copy.of} ${dynamicState.total} · ${partLabel}`
        : partLabel;
      status.textContent = label;
      if (miniStatus instanceof HTMLElement) miniStatus.textContent = label;
      syncMediaSession();
    };

    const setPlayingUi = () => {
      if (play instanceof HTMLButtonElement) {
        const pauseMode = playing && !paused;
        play.setAttribute("aria-label", pauseMode ? copy.pause : copy.play);
        play.setAttribute("title", pauseMode ? copy.pause : copy.play);
      }
      if (playIcon instanceof HTMLElement) playIcon.hidden = playing && !paused;
      if (pauseIcon instanceof HTMLElement) pauseIcon.hidden = !(playing && !paused);
      root.classList.toggle("is-playing", playing);
      root.classList.toggle("is-paused", paused);
      syncCollapsedSurface();
      syncMediaSession();
    };

    const clearHighlight = () => {
      if (activeSource instanceof HTMLElement) activeSource.classList.remove("tts-active-source");
      if (activeDynamicBlock instanceof HTMLElement) activeDynamicBlock.classList.remove("tts-active-block");
      activeSource = null;
      activeDynamicBlock = null;
      delete root.dataset.ttsDynamicPlayingBlock;
    };

    const highlightSource = (source) => {
      clearHighlight();
      if (!(source instanceof HTMLElement)) return;
      activeSource = source;
      source.classList.add("tts-active-source");
      const dynamicBlock = source.closest("[data-dynamic-block]");
      if (dynamicBlock instanceof HTMLElement) {
        activeDynamicBlock = dynamicBlock;
        dynamicBlock.classList.add("tts-active-block");
        root.dataset.ttsDynamicPlayingBlock = dynamicBlock.dataset.blockKey || "";
      }
      const rect = source.getBoundingClientRect();
      const headerHeight = Number.parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue("--header-height"),
      ) || 62;
      const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
      const playerHeight = player.hidden ? 0 : player.getBoundingClientRect().height;
      const topLimit = headerHeight + 18;
      const bottomLimit = viewportHeight - Math.max(110, playerHeight + 24);
      if (rect.top < topLimit || rect.bottom > bottomLimit) {
        source.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
      }
    };

    const getRate = () => {
      if (!(rateSelect instanceof HTMLSelectElement)) return 1;
      const value = Number(rateSelect.value);
      return Number.isFinite(value) ? value : 1;
    };

    const syncEstimatedTime = () => {
      if (!(estimate instanceof HTMLElement)) return;
      if (!chunks.length) {
        estimate.textContent = "";
        return;
      }
      const words = chunks.reduce((total, chunk) => total + normalize(chunk?.text).split(/\s+/).filter(Boolean).length, 0);
      const baseWordsPerMinute = lang === "en" ? 175 : 165;
      const minutes = Math.max(1, Math.ceil(words / Math.max(1, baseWordsPerMinute * getRate())));
      estimate.textContent = `${minutes} ${copy.minuteApprox}`;
    };

    const getVoiceValue = (voice) => `${voice.name}|||${voice.lang}`;

    const femaleVoiceName = /(female|woman|zira|susan|samantha|victoria|karen|moira|tessa|monica|paulina|sabina|lucia|lucía|elvira|dalia|aria|jenny|helena|sofia|sofía|maria|maría|carmen|isabella|ava|emma|grace)/i;
    const maleVoiceName = /(male|man|david|mark|daniel|guy|jorge|raul|raúl|pablo|diego|antonio|carlos|miguel|juan|andres|andrés|thomas|george|james|mateo|samuel)/i;

    const getVoiceScore = (voice, targetLanguage) => {
      const targetBase = targetLanguage === "en" ? "en" : "es";
      const preferredLocales = targetBase === "en"
        ? ["en-US", "en-GB", "en-AU", "en-CA"]
        : ["es-PE", "es-MX", "es-US", "es-ES", "es-CO", "es-AR"];
      const naturalName = /(natural|neural|premium|enhanced|online|google|siri|aria|jenny|guy|elvira|dalia|paulina|raul|raúl|jorge|lucia|lucía)/i;
      const legacyName = /(desktop|compact|basic|eloquence|espeak|festival)/i;
      const localeIndex = preferredLocales.findIndex((locale) => locale.toLowerCase() === voice.lang?.toLowerCase());
      return (localeIndex >= 0 ? 100 - localeIndex * 8 : 50)
        + (naturalName.test(voice.name) ? 90 : 0)
        + (!voice.localService ? 18 : 0)
        + (voice.default ? 6 : 0)
        - (legacyName.test(voice.name) ? 45 : 0);
    };

    const getRankedVoices = (targetLanguage) => [...voices]
      .filter((voice) => voice.lang?.toLowerCase().startsWith(targetLanguage))
      .sort((a, b) => getVoiceScore(b, targetLanguage) - getVoiceScore(a, targetLanguage) || a.name.localeCompare(b.name));

    const getBestVoice = (targetLanguage) => getRankedVoices(targetLanguage)[0] ?? null;

    const getCuratedProfileVoices = (targetLanguage) => {
      const ranked = getRankedVoices(targetLanguage);
      const female = ranked.filter((voice) => femaleVoiceName.test(voice.name));
      const male = ranked.filter((voice) => maleVoiceName.test(voice.name));
      const used = new Set();
      const pick = (preferred) => {
        const candidate = preferred.find((voice) => !used.has(voice))
          ?? ranked.find((voice) => !used.has(voice))
          ?? preferred[0]
          ?? ranked[0]
          ?? null;
        if (candidate) used.add(candidate);
        return candidate;
      };
      return {
        f1: pick(female),
        f2: pick(female),
        m1: pick(male),
        m2: pick(male),
      };
    };

    const getSelectedVoiceConfiguration = () => {
      const value = voiceSelect instanceof HTMLSelectElement ? voiceSelect.value : "profile:auto";
      const targetLanguage = lang;
      if (value === "profile:auto" || !value) {
        const voice = getBestVoice(targetLanguage);
        return { voice, language: voice?.lang || pageSpeechLang, rateMultiplier: .96, pitch: 1 };
      }

      const profiles = getCuratedProfileVoices(targetLanguage);
      const profileConfig = {
        "profile:f1": { voice: profiles.f1, rateMultiplier: .98, pitch: 1.04 },
        "profile:f2": { voice: profiles.f2, rateMultiplier: .95, pitch: 1.09 },
        "profile:m1": { voice: profiles.m1, rateMultiplier: .97, pitch: .90 },
        "profile:m2": { voice: profiles.m2, rateMultiplier: .94, pitch: .95 },
      };
      const profile = profileConfig[value];
      if (profile) {
        return {
          ...profile,
          language: profile.voice?.lang || pageSpeechLang,
        };
      }

      return { voice: getBestVoice(targetLanguage), language: pageSpeechLang, rateMultiplier: .96, pitch: 1 };
    };

    const stopSpeech = ({ reset = false, keepMini = false } = {}) => {
      session += 1;
      window.clearTimeout(foregroundRecoveryTimer);
      window.clearTimeout(semanticPauseTimer);
      resumeAfterVisibility = false;
      speechProvider.cancel();
      playing = false;
      paused = false;
      keepMiniVisible = keepMini;
      if (reset) currentIndex = 0;
      clearHighlight();
      setStatus();
      setPlayingUi();
    };

    const requestDynamicBlock = (direction) => {
      if (!isDynamicPresentation()) return false;
      const before = dynamicState.blockKey;
      document.dispatchEvent(new CustomEvent("bibli:tts-dynamic-navigate", {
        detail: {
          lessonId: dynamicState.lessonId,
          blockKey: dynamicState.blockKey,
          direction,
        },
      }));
      return dynamicState.blockKey !== before;
    };

    const refreshDynamicQueue = ({ continuePlayback = false, preservePaused = false } = {}) => {
      if (!isDynamicPresentation()) return;
      session += 1;
      speechProvider.cancel();
      clearHighlight();
      chunks = buildDynamicChunks();
      currentIndex = 0;
      if (!chunks.length) {
        playing = false;
        paused = false;
        setStatus();
        setPlayingUi();
        return;
      }
      if (continuePlayback && !preservePaused) {
        playing = true;
        paused = false;
        speakCurrent();
        return;
      }
      playing = continuePlayback || preservePaused;
      paused = preservePaused;
      setStatus();
      setPlayingUi();
    };

    const speakCurrent = () => {
      window.clearTimeout(foregroundRecoveryTimer);
      resumeAfterVisibility = false;
      if (!chunks.length) chunks = buildChunks();
      if (!chunks.length) {
        if (status instanceof HTMLElement) status.textContent = copy.noContent;
        return;
      }
      currentIndex = Math.max(0, Math.min(currentIndex, chunks.length - 1));
      session += 1;
      const token = session;
      speechProvider.cancel();
      const chunk = chunks[currentIndex];
      prepareAudioSession();
      const selectedVoice = getSelectedVoiceConfiguration();
      const prosody = speechNormalizer.getProsody(chunk.semanticRole);
      const semanticRate = Number(prosody?.rate_multiplier) || 1;
      const selectedVoiceId = selectedVoice.voice
        ? `${selectedVoice.voice.name}|||${selectedVoice.voice.lang}`
        : (voiceSelect instanceof HTMLSelectElement ? voiceSelect.value : "profile:auto");
      root.dataset.ttsSemanticRole = chunk.semanticRole;
      void buildTtsCacheKey({
        text: chunk.text,
        locale: selectedVoice.language,
        voiceId: selectedVoiceId,
        modelId: speechProvider.modelId,
        rulesVersion: speechNormalizer.rulesVersion,
        semanticRole: chunk.semanticRole,
      }).then((cacheKey) => {
        if (token === session) root.dataset.ttsCacheKey = cacheKey;
      });
      speechProvider.speak({
        text: chunk.text,
        language: selectedVoice.language,
        rate: Math.max(.6, Math.min(1.6, getRate() * selectedVoice.rateMultiplier * semanticRate)),
        pitch: selectedVoice.pitch,
        volume: 1,
        voice: selectedVoice.voice,
        onStart: () => {
          if (token !== session) return;
          playing = true;
          paused = false;
          setStatus();
          setPlayingUi();
          highlightSource(chunk.source);
        },
        onEnd: () => {
          if (token !== session) return;
          // Mobile browsers can suspend Web Speech while the page is backgrounded.
          // Keep the logical session alive and replay the current fragment on return
          // instead of advancing silently while the app is not visible.
          if (document.visibilityState !== "visible") {
            resumeAfterVisibility = true;
            return;
          }
          const finishOrAdvance = () => {
            if (token !== session) return;
            if (currentIndex < chunks.length - 1) {
              currentIndex += 1;
              speakCurrent();
              return;
            }
            if (isDynamicPresentation() && requestDynamicBlock("next")) return;
            playing = false;
            paused = false;
            keepMiniVisible = false;
            resumeAfterVisibility = false;
            clearHighlight();
            setStatus();
            setPlayingUi();
          };
          const pauseAfterMs = Math.max(0, Math.min(700, Number(prosody?.pause_after_ms) || 0));
          window.clearTimeout(semanticPauseTimer);
          semanticPauseTimer = window.setTimeout(finishOrAdvance, pauseAfterMs);
        },
        onError: (event) => {
          if (token !== session || event.error === "canceled") return;
          if (event.error === "interrupted" && (document.visibilityState !== "visible" || resumeAfterVisibility)) {
            resumeAfterVisibility = true;
            return;
          }
          playing = false;
          paused = false;
          keepMiniVisible = false;
          resumeAfterVisibility = false;
          clearHighlight();
          setPlayingUi();
        },
      });
    };

    const openPlayer = ({ autoplay = false } = {}) => {
      document.dispatchEvent(new CustomEvent("bibli:tts-opening"));
      const wasPlaying = playing;

      // The dock can request TTS even when the floating launcher was hidden during
      // initial hydration. Always reveal the component root before opening the player.
      root.hidden = false;
      player.hidden = false;
      keepMiniVisible = false;
      root.classList.add("is-open");
      syncCollapsedSurface();
      document.dispatchEvent(new CustomEvent("bibli:tts-state", { detail: { open: true, active: playing, collapsed: false } }));

      if (!chunks.length || !wasPlaying) chunks = buildChunks();
      if (!chunks.length) {
        if (status instanceof HTMLElement) status.textContent = copy.noContent;
        if (miniStatus instanceof HTMLElement) miniStatus.textContent = copy.noContent;
        syncEstimatedTime();
        requestAnimationFrame(() => {
          syncFloatingUiOffset();
          if (close instanceof HTMLButtonElement) close.focus();
        });
        return;
      }

      setStatus();
      requestAnimationFrame(() => {
        syncFloatingUiOffset();
        if (close instanceof HTMLButtonElement) close.focus();
      });
      if (autoplay && !wasPlaying) speakCurrent();
    };

    const minimizePlayer = ({ returnFocus = true } = {}) => {
      if (player.hidden) return;
      player.hidden = true;
      keepMiniVisible = playing;
      root.classList.remove("is-open");
      syncFloatingUiOffset();
      syncCollapsedSurface();
      document.dispatchEvent(new CustomEvent("bibli:tts-state", { detail: { open: false, active: playing, collapsed: keepMiniVisible } }));
      if (!returnFocus) return;
      const dockTrigger = document.querySelector('[data-dock-action="tts"]');
      if (dockTrigger instanceof HTMLButtonElement) dockTrigger.focus();
      else if (mini instanceof HTMLButtonElement && !mini.hidden) mini.focus();
      else if (getComputedStyle(launcher).display !== "none") launcher.focus();
    };

    const refreshVoices = () => {
      voices = speechProvider.getVoices().filter((voice) => voice.lang?.toLowerCase().startsWith(lang));
      if (!(voiceSelect instanceof HTMLSelectElement)) return;
      const storedVoice = localStorage.getItem(voiceKey) ?? "profile:auto";
      voiceSelect.replaceChildren();

      const addOption = (parent, value, label) => {
        const option = document.createElement("option");
        option.value = value;
        option.textContent = label;
        parent.append(option);
      };

      addOption(voiceSelect, "profile:auto", copy.automaticVoice);
      const femaleGroup = document.createElement("optgroup");
      femaleGroup.label = copy.femaleVoices;
      addOption(femaleGroup, "profile:f1", copy.femaleOne);
      addOption(femaleGroup, "profile:f2", copy.femaleTwo);
      voiceSelect.append(femaleGroup);
      const maleGroup = document.createElement("optgroup");
      maleGroup.label = copy.maleVoices;
      addOption(maleGroup, "profile:m1", copy.maleOne);
      addOption(maleGroup, "profile:m2", copy.maleTwo);
      voiceSelect.append(maleGroup);

      const match = Array.from(voiceSelect.options).some((option) => option.value === storedVoice);
      voiceSelect.value = match ? storedVoice : "profile:auto";
      if (!match && storedVoice !== "profile:auto") localStorage.setItem(voiceKey, "profile:auto");
    };

    const storedRate = localStorage.getItem(rateKey);
    if (rateSelect instanceof HTMLSelectElement && ["0.75", "1", "1.25", "1.5"].includes(storedRate ?? "")) {
      rateSelect.value = storedRate;
    }

    const togglePlayback = () => {
      // If Android/iOS suspended the speech engine in the background, our logical
      // `playing` flag can outlive the native utterance. Recover by restarting the
      // current fragment instead of sending an ineffective pause/resume command.
      if (resumeAfterVisibility) {
        speakCurrent();
        return;
      }
      if (playing && !paused && speechProvider.paused) {
        resumeAfterVisibility = false;
        speechProvider.resume();
        paused = false;
        setPlayingUi();
        return;
      }
      if (playing && !paused && !speechProvider.speaking && !speechProvider.pending) {
        resumeAfterVisibility = false;
        speakCurrent();
        return;
      }
      if (playing && !paused) {
        speechProvider.pause();
        paused = true;
        resumeAfterVisibility = false;
        setPlayingUi();
      } else if (playing && paused) {
        if (!speechProvider.speaking && !speechProvider.pending) speakCurrent();
        else speechProvider.resume();
        paused = false;
        resumeAfterVisibility = false;
        setPlayingUi();
      } else {
        resumeAfterVisibility = false;
        speakCurrent();
      }
    };

    const playFromMediaControl = () => {
      if (playing && !paused && (speechProvider.speaking || speechProvider.pending) && !resumeAfterVisibility) {
        setPlayingUi();
        return;
      }
      if (playing && paused && (speechProvider.speaking || speechProvider.pending)) {
        speechProvider.resume();
        paused = false;
        resumeAfterVisibility = false;
        setPlayingUi();
        return;
      }
      resumeAfterVisibility = false;
      speakCurrent();
    };

    const pauseFromMediaControl = () => {
      if (!playing || paused) return;
      speechProvider.pause();
      paused = true;
      resumeAfterVisibility = false;
      setPlayingUi();
    };

    const previousPart = () => {
      if (!chunks.length) chunks = buildChunks();
      if (isDynamicPresentation() && currentIndex === 0 && requestDynamicBlock("previous")) return;
      currentIndex = Math.max(0, currentIndex - 1);
      speakCurrent();
    };

    const nextPart = () => {
      if (!chunks.length) chunks = buildChunks();
      if (isDynamicPresentation() && currentIndex >= Math.max(0, chunks.length - 1) && requestDynamicBlock("next")) return;
      currentIndex = Math.min(Math.max(0, chunks.length - 1), currentIndex + 1);
      speakCurrent();
    };

    launcher.addEventListener("click", () => openPlayer({ autoplay: true }));
    mini?.addEventListener("click", () => openPlayer({ autoplay: false }));
    close?.addEventListener("click", () => minimizePlayer());
    stop?.addEventListener("click", () => stopSpeech({ reset: false }));
    play?.addEventListener("click", togglePlayback);
    previous?.addEventListener("click", previousPart);
    next?.addEventListener("click", nextPart);

    if (mediaSession) {
      const setMediaHandler = (action, handler) => {
        try { mediaSession.setActionHandler(action, handler); } catch {}
      };
      setMediaHandler("play", playFromMediaControl);
      setMediaHandler("pause", pauseFromMediaControl);
      setMediaHandler("previoustrack", previousPart);
      setMediaHandler("nexttrack", nextPart);
      setMediaHandler("stop", () => stopSpeech({ reset: false }));
      syncMediaSession();
    }
    rateSelect?.addEventListener("change", () => {
      if (rateSelect instanceof HTMLSelectElement) localStorage.setItem(rateKey, rateSelect.value);
      syncEstimatedTime();
      if (playing) speakCurrent();
    });
    voiceSelect?.addEventListener("change", () => {
      if (voiceSelect instanceof HTMLSelectElement) localStorage.setItem(voiceKey, voiceSelect.value);
      if (playing) speakCurrent();
    });

    document.addEventListener("bibli:dynamic-block-change", (event) => {
      if (!(event instanceof CustomEvent)) return;
      const detail = event.detail || {};
      dynamicState = {
        lessonId: detail.lessonId || "",
        blockId: detail.blockId || "",
        blockKey: detail.blockKey || "",
        position: Number(detail.position) || 0,
        total: Number(detail.total) || 0,
      };
      root.dataset.ttsDynamicBlockKey = dynamicState.blockKey;
      root.dataset.ttsDynamicBlockPosition = String(dynamicState.position || 0);
      root.dataset.ttsDynamicBlockTotal = String(dynamicState.total || 0);
      if (!isDynamicPresentation()) return;
      const wasPlaying = playing;
      const wasPaused = paused;
      refreshDynamicQueue({ continuePlayback: wasPlaying && !wasPaused, preservePaused: wasPlaying && wasPaused });
    });

    document.addEventListener("bibli:study-presentation-change", () => {
      const playerWasOpen = !player.hidden;
      const miniWasVisible = mini instanceof HTMLButtonElement && !mini.hidden;
      stopSpeech({ reset: true, keepMini: miniWasVisible });
      chunks = [];
      requestAnimationFrame(() => {
        chunks = buildChunks();
        currentIndex = 0;
        setStatus();
        syncEstimatedTime();
        syncCollapsedSurface();
        syncFloatingUiOffset();
        if (playerWasOpen) {
          root.hidden = false;
          player.hidden = false;
          root.classList.add("is-open");
        }
        document.dispatchEvent(new CustomEvent("bibli:tts-state", {
          detail: { open: !player.hidden, active: false, collapsed: miniWasVisible },
        }));
      });
    });

    document.addEventListener("bibli:lesson-mode-change", () => {
      const playerWasOpen = !player.hidden;
      const miniWasVisible = mini instanceof HTMLButtonElement && !mini.hidden;

      // Study and Reading expose different source text. Never continue speaking the
      // previous mode after the visible content changes. Reset the queue, but keep
      // the same player surface open so the mode switch does not feel like closing
      // the listening tool. The user explicitly starts the new mode when ready.
      stopSpeech({ reset: true, keepMini: miniWasVisible });
      chunks = [];

      if (playerWasOpen) {
        root.hidden = false;
        player.hidden = false;
        root.classList.add("is-open");
      } else if (miniWasVisible) {
        root.hidden = false;
        player.hidden = true;
        keepMiniVisible = true;
        root.classList.remove("is-open");
      }

      requestAnimationFrame(() => {
        chunks = buildChunks();
        currentIndex = 0;
        setStatus();
        syncEstimatedTime();
        syncCollapsedSurface();
        syncFloatingUiOffset();
        document.dispatchEvent(new CustomEvent("bibli:tts-state", {
          detail: { open: !player.hidden, active: false, collapsed: miniWasVisible },
        }));
      });
    });

    document.addEventListener("bibli:tts-open", () => openPlayer({ autoplay: !playing }));
    document.addEventListener("bibli:tts-toggle", () => {
      if (player.hidden) openPlayer({ autoplay: !playing && !keepMiniVisible });
      else minimizePlayer();
    });
    document.addEventListener("bibli:tts-close", () => { if (!player.hidden) minimizePlayer({ returnFocus: false }); });
    document.addEventListener("bibli:reader-preferences-opening", () => { if (!player.hidden) minimizePlayer({ returnFocus: false }); });
    document.addEventListener("bibli:global-search-opening", () => { if (!player.hidden) minimizePlayer({ returnFocus: false }); });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !player.hidden) minimizePlayer();
    });

    const recoverSpeechAfterForeground = () => {
      if (!resumeAfterVisibility || paused || document.visibilityState !== "visible") return;
      window.clearTimeout(foregroundRecoveryTimer);
      foregroundRecoveryTimer = window.setTimeout(() => {
        if (!resumeAfterVisibility || paused || document.visibilityState !== "visible") return;
        // A fresh utterance is more reliable than resume() after an OS-level suspension.
        // Replay the current fragment from its beginning so no words are silently skipped.
        playing = true;
        setPlayingUi();
        speakCurrent();
      }, 180);
    };

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState !== "visible") {
        if (playing && !paused) resumeAfterVisibility = true;
        syncMediaSession();
        return;
      }
      prepareAudioSession();
      syncMediaSession();
      recoverSpeechAfterForeground();
    });
    window.addEventListener("pageshow", recoverSpeechAfterForeground);

    if ("ResizeObserver" in window) {
      new ResizeObserver(() => {
        if (!player.hidden) syncFloatingUiOffset();
      }).observe(player);
    }
    window.addEventListener("beforeunload", () => {
      window.clearTimeout(foregroundRecoveryTimer);
      window.clearTimeout(semanticPauseTimer);
      speechProvider.cancel();
      if (typeof detachVoicesChanged === "function") detachVoicesChanged();
      document.documentElement.style.setProperty("--tts-player-offset", "0px");
      delete document.documentElement.dataset.ttsPlayerOpen;
      delete document.documentElement.dataset.ttsActive;
    });

    refreshVoices();
    const detachVoicesChanged = speechProvider.setVoicesChangedHandler(refreshVoices);

    const hasReadableContent = document.querySelector("[data-reader-content]");
    if (hasReadableContent || lessonDockActive()) {
      root.hidden = false;
      launcher.hidden = false;
      setPlayingUi();
      syncCollapsedSurface();
    }
  })();
</script>

