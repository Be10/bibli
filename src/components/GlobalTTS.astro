---
import Icon from "./Icon.astro";

type LanguageCode = "es" | "en";
interface Props { lang?: LanguageCode; }
const { lang = "es" } = Astro.props;
const copy = lang === "en"
  ? {
      launcher: "Read aloud",
      title: "Read aloud",
      ready: "Ready to read",
      part: "Part",
      of: "of",
      previous: "Previous part",
      play: "Play",
      pause: "Pause",
      next: "Next part",
      stop: "Stop",
      close: "Minimize reader",
      voice: "Voice",
      automaticVoice: "Bibli · Automatic",
      bibliVoices: "English voices",
      femaleVoices: "Female voices",
      maleVoices: "Male voices",
      femaleOne: "Bibli · Grace",
      femaleTwo: "Bibli · Emma",
      maleOne: "Bibli · James",
      maleTwo: "Bibli · Daniel",
      verse: "Verse",
      speed: "Speed",
      unavailable: "Text to speech is not available in this browser.",
      noContent: "There is no readable content on this page.",
      estimatedTime: "Estimated",
      minuteApprox: "min approx.",
    }
  : {
      launcher: "Escuchar",
      title: "Lectura en voz alta",
      ready: "Listo para leer",
      part: "Fragmento",
      of: "de",
      previous: "Fragmento anterior",
      play: "Reproducir",
      pause: "Pausar",
      next: "Fragmento siguiente",
      stop: "Detener",
      close: "Minimizar lector",
      voice: "Voz",
      automaticVoice: "Bibli · Automática",
      bibliVoices: "Voces en español",
      femaleVoices: "Voces femeninas",
      maleVoices: "Voces masculinas",
      femaleOne: "Bibli · Clara",
      femaleTwo: "Bibli · Serena",
      maleOne: "Bibli · Mateo",
      maleTwo: "Bibli · Samuel",
      verse: "Versículo",
      speed: "Velocidad",
      unavailable: "La lectura en voz alta no está disponible en este navegador.",
      noContent: "No hay contenido de lectura en esta página.",
      estimatedTime: "Duración",
      minuteApprox: "min aprox.",
    };
---

<div class="global-tts" data-global-tts data-tts-lang={lang} hidden>
  <button type="button" class="tts-launcher" data-tts-launcher aria-label={copy.launcher} title={copy.launcher}>
    <Icon name="volume" size={19} />
    <span>{copy.launcher}</span>
  </button>

  <section class="tts-player" data-tts-player hidden aria-label={copy.title}>
    <header class="tts-player-head">
      <div class="tts-player-copy">
        <span class="tts-eyebrow">{copy.title}</span>
        <strong data-tts-status aria-live="polite">{copy.ready}</strong>
        <small class="tts-estimate" aria-live="polite"><Icon name="clock" size={13} /><span data-tts-estimate></span></small>
      </div>
      <button type="button" class="tts-close" data-tts-close aria-label={copy.close} title={copy.close}>
        <Icon name="close" size={17} />
      </button>
    </header>

    <div class="tts-controls" role="group" aria-label={copy.title}>
      <button type="button" class="tts-control" data-tts-previous aria-label={copy.previous} title={copy.previous}>
        <Icon name="skip-back" size={18} />
      </button>
      <button type="button" class="tts-control tts-play" data-tts-play aria-label={copy.play} title={copy.play}>
        <span data-tts-play-icon><Icon name="play" size={20} /></span>
        <span data-tts-pause-icon hidden><Icon name="pause" size={20} /></span>
      </button>
      <button type="button" class="tts-control" data-tts-next aria-label={copy.next} title={copy.next}>
        <Icon name="skip-forward" size={18} />
      </button>
      <button type="button" class="tts-control" data-tts-stop aria-label={copy.stop} title={copy.stop}>
        <Icon name="square" size={16} />
      </button>
    </div>

    <div class="tts-options">
      <label>
        <span>{copy.speed}</span>
        <select data-tts-rate>
          <option value="0.75">0.75×</option>
          <option value="1" selected>1×</option>
          <option value="1.25">1.25×</option>
          <option value="1.5">1.5×</option>
        </select>
      </label>
      <label class="tts-voice-label">
        <span>{copy.voice}</span>
        <select data-tts-voice>
          <option value="profile:auto">{copy.automaticVoice}</option>
        </select>
      </label>
    </div>
  </section>

  <button type="button" class="tts-mini" data-tts-mini hidden aria-label={copy.launcher} title={copy.launcher}>
    <span class="tts-mini-indicator" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="tts-mini-copy"><strong>{copy.title}</strong><small data-tts-mini-status>{copy.ready}</small></span>
    <Icon name="arrow-up" size={17} />
  </button>
</div>

<script define:vars={{ copy }}>
  (() => {
    const root = document.querySelector("[data-global-tts]");
    if (!(root instanceof HTMLElement)) return;

    const synth = window.speechSynthesis;
    const Utterance = window.SpeechSynthesisUtterance;
    const lang = root.dataset.ttsLang === "en" ? "en" : "es";
    const pageSpeechLang = lang === "en" ? "en-US" : "es-PE";
    const voiceKey = `bibli-tts-voice-${lang}-v1`;
    const rateKey = "bibli-tts-rate-v1";

    const launcher = root.querySelector("[data-tts-launcher]");
    const player = root.querySelector("[data-tts-player]");
    const close = root.querySelector("[data-tts-close]");
    const previous = root.querySelector("[data-tts-previous]");
    const play = root.querySelector("[data-tts-play]");
    const next = root.querySelector("[data-tts-next]");
    const stop = root.querySelector("[data-tts-stop]");
    const status = root.querySelector("[data-tts-status]");
    const estimate = root.querySelector("[data-tts-estimate]");
    const mini = root.querySelector("[data-tts-mini]");
    const miniStatus = root.querySelector("[data-tts-mini-status]");
    const rateSelect = root.querySelector("[data-tts-rate]");
    const voiceSelect = root.querySelector("[data-tts-voice]");
    const playIcon = root.querySelector("[data-tts-play-icon]");
    const pauseIcon = root.querySelector("[data-tts-pause-icon]");

    if (!synth || !Utterance || !(launcher instanceof HTMLButtonElement) || !(player instanceof HTMLElement)) {
      root.hidden = true;
      return;
    }

    let chunks = [];
    let currentIndex = 0;
    let activeSource = null;
    let session = 0;
    let playing = false;
    let paused = false;
    let voices = [];

    const lessonDockActive = () => document.documentElement.dataset.lessonDock === "true";
    const syncCollapsedSurface = () => {
      const expanded = !player.hidden;
      if (mini instanceof HTMLButtonElement) mini.hidden = expanded || !playing;
      if (launcher instanceof HTMLButtonElement) launcher.hidden = expanded || playing || lessonDockActive();
      document.documentElement.dataset.ttsActive = playing ? "true" : "false";
    };

    const syncFloatingUiOffset = () => {
      const rootElement = document.documentElement;
      if (player.hidden) {
        delete rootElement.dataset.ttsPlayerOpen;
        rootElement.style.setProperty("--tts-player-offset", "0px");
        return;
      }
      const height = Math.ceil(player.getBoundingClientRect().height + 12);
      rootElement.dataset.ttsPlayerOpen = "true";
      rootElement.style.setProperty("--tts-player-offset", `${height}px`);
    };

    const normalize = (value) => String(value ?? "").replace(/\s+/g, " ").trim();
    const escapeRegExp = (value) => String(value).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const spanishBooks = [
      "Génesis", "Éxodo", "Levítico", "Números", "Deuteronomio", "Josué", "Jueces", "Rut",
      "1 Samuel", "2 Samuel", "1 Reyes", "2 Reyes", "1 Crónicas", "2 Crónicas", "Esdras",
      "Nehemías", "Ester", "Job", "Salmo", "Salmos", "Proverbios", "Eclesiastés", "Cantares",
      "Isaías", "Jeremías", "Lamentaciones", "Ezequiel", "Daniel", "Oseas", "Joel", "Amós",
      "Abdías", "Jonás", "Miqueas", "Nahúm", "Habacuc", "Sofonías", "Hageo", "Zacarías",
      "Malaquías", "Mateo", "Marcos", "Lucas", "Juan", "Hechos", "Romanos", "1 Corintios",
      "2 Corintios", "Gálatas", "Efesios", "Filipenses", "Colosenses", "1 Tesalonicenses",
      "2 Tesalonicenses", "1 Timoteo", "2 Timoteo", "Tito", "Filemón", "Hebreos", "Santiago",
      "1 Pedro", "2 Pedro", "1 Juan", "2 Juan", "3 Juan", "Judas", "Apocalipsis",
    ];
    const englishBooks = [
      "Genesis", "Exodus", "Leviticus", "Numbers", "Deuteronomy", "Joshua", "Judges", "Ruth",
      "1 Samuel", "2 Samuel", "1 Kings", "2 Kings", "1 Chronicles", "2 Chronicles", "Ezra",
      "Nehemiah", "Esther", "Job", "Psalm", "Psalms", "Proverbs", "Ecclesiastes", "Song of Solomon",
      "Song of Songs", "Isaiah", "Jeremiah", "Lamentations", "Ezekiel", "Daniel", "Hosea", "Joel",
      "Amos", "Obadiah", "Jonah", "Micah", "Nahum", "Habakkuk", "Zephaniah", "Haggai",
      "Zechariah", "Malachi", "Matthew", "Mark", "Luke", "John", "Acts", "Romans",
      "1 Corinthians", "2 Corinthians", "Galatians", "Ephesians", "Philippians", "Colossians",
      "1 Thessalonians", "2 Thessalonians", "1 Timothy", "2 Timothy", "Titus", "Philemon",
      "Hebrews", "James", "1 Peter", "2 Peter", "1 John", "2 John", "3 John", "Jude", "Revelation",
    ];
    const referenceBooks = [...spanishBooks, ...englishBooks]
      .sort((a, b) => b.length - a.length)
      .map(escapeRegExp)
      .join("|");
    const bibleReferencePattern = new RegExp(
      `(^|[^\\p{L}\\p{N}])(${referenceBooks})\\s+(\\d{1,3})\\s*:\\s*(\\d{1,3})(?:\\s*[–—-]\\s*(?:(\\d{1,3})\\s*:\\s*)?(\\d{1,3}))?(?=$|[^\\p{L}\\p{N}])`,
      "giu",
    );

    const speakBibleReference = (_match, prefix, book, chapter, verse, endChapter, endVerse) => {
      if (lang === "en") {
        if (endVerse && endChapter) return `${prefix}${book}, chapter ${chapter}, verse ${verse}, to chapter ${endChapter}, verse ${endVerse}`;
        if (endVerse) return `${prefix}${book}, chapter ${chapter}, verses ${verse} to ${endVerse}`;
        return `${prefix}${book}, chapter ${chapter}, verse ${verse}`;
      }
      if (endVerse && endChapter) return `${prefix}${book}, capítulo ${chapter}, versículo ${verse}, al capítulo ${endChapter}, versículo ${endVerse}`;
      if (endVerse) return `${prefix}${book}, capítulo ${chapter}, versículos ${verse} al ${endVerse}`;
      return `${prefix}${book}, capítulo ${chapter}, versículo ${verse}`;
    };

    const prepareSpeechText = (value) => {
      let text = String(value ?? "")
        .replace(/[\p{Extended_Pictographic}\p{Emoji_Modifier}\uFE0F\u200D]/gu, " ")
        .replace(/[•▪◦✦✧✝✓◌≡↝⌖◇]/g, ", ");
      text = text.replace(bibleReferencePattern, speakBibleReference);
      text = text.replace(/(\d+)\s*[–—-]\s*(\d+)/g, (_match, start, end) =>
        lang === "en" ? `${start} to ${end}` : `${start} al ${end}`,
      );
      text = text.replace(/(\d+)\s*:\s*(\d+)/g, "$1, $2");
      return normalize(text);
    };

    const isVisible = (element) => {
      if (!(element instanceof HTMLElement)) return false;
      const style = getComputedStyle(element);
      return style.display !== "none" && style.visibility !== "hidden" && element.getClientRects().length > 0;
    };

    const splitLongText = (text, source) => {
      const clean = prepareSpeechText(text);
      if (clean.length <= 520) return clean ? [{ text: clean, source }] : [];
      const sentences = clean.match(/[^.!?…]+[.!?…]+|[^.!?…]+$/g) ?? [clean];
      const parts = [];
      let buffer = "";
      for (const sentence of sentences) {
        const nextValue = normalize(`${buffer} ${sentence}`);
        if (buffer && nextValue.length > 520) {
          parts.push({ text: buffer, source });
          buffer = normalize(sentence);
        } else {
          buffer = nextValue;
        }
      }
      if (buffer) parts.push({ text: buffer, source });
      return parts;
    };

    const getActiveReader = () => {
      const readers = Array.from(document.querySelectorAll("[data-reader-content]"));
      return readers.find((element) => isVisible(element)) ?? readers[0] ?? null;
    };

    const buildChunks = () => {
      const reader = getActiveReader();
      if (!(reader instanceof HTMLElement)) return [];

      const lessonIntro = [];
      if (reader.matches("[data-study-content]")) {
        const title = document.querySelector("[data-tts-lesson-title]");
        const reference = document.querySelector("[data-tts-lesson-reference]");
        if (title instanceof HTMLElement && isVisible(title)) lessonIntro.push(...splitLongText(title.textContent, title));
        if (reference instanceof HTMLElement && isVisible(reference)) lessonIntro.push(...splitLongText(reference.textContent, reference));
      }

      const bibleVerses = Array.from(reader.querySelectorAll(".bible-chapter-verse"));
      if (bibleVerses.length) {
        return [...lessonIntro, ...bibleVerses.flatMap((verse) => {
          const number = normalize(verse.querySelector(".verse-number")?.textContent);
          const text = normalize(verse.querySelector(".verse-text")?.textContent ?? verse.textContent);
          return splitLongText(number ? `${copy.verse} ${number}. ${text}` : text, verse);
        })];
      }

      const readingVerses = Array.from(reader.querySelectorAll(".verse[id^='reading-v']"));
      if (readingVerses.length) {
        return [...lessonIntro, ...readingVerses.flatMap((verse) => {
          const number = normalize(verse.querySelector("sup")?.textContent);
          const text = normalize(verse.textContent?.replace(number, ""));
          return splitLongText(number ? `${copy.verse} ${number}. ${text}` : text, verse);
        })];
      }

      const candidates = Array.from(reader.querySelectorAll("h2, h3, p, li"));
      const bodyChunks = candidates.flatMap((element) => {
        if (!isVisible(element)) return [];
        if (element.matches("p") && element.closest("li")) return [];
        return splitLongText(element.textContent, element);
      });
      return [...lessonIntro, ...bodyChunks];
    };

    const setStatus = () => {
      syncEstimatedTime();
      if (!(status instanceof HTMLElement)) return;
      if (!chunks.length) {
        status.textContent = copy.ready;
        if (miniStatus instanceof HTMLElement) miniStatus.textContent = copy.ready;
        return;
      }
      const label = `${copy.part} ${currentIndex + 1} ${copy.of} ${chunks.length}`;
      status.textContent = label;
      if (miniStatus instanceof HTMLElement) miniStatus.textContent = label;
    };

    const setPlayingUi = () => {
      if (play instanceof HTMLButtonElement) {
        const pauseMode = playing && !paused;
        play.setAttribute("aria-label", pauseMode ? copy.pause : copy.play);
        play.setAttribute("title", pauseMode ? copy.pause : copy.play);
      }
      if (playIcon instanceof HTMLElement) playIcon.hidden = playing && !paused;
      if (pauseIcon instanceof HTMLElement) pauseIcon.hidden = !(playing && !paused);
      root.classList.toggle("is-playing", playing);
      root.classList.toggle("is-paused", paused);
      syncCollapsedSurface();
    };

    const clearHighlight = () => {
      if (activeSource instanceof HTMLElement) activeSource.classList.remove("tts-active-source");
      activeSource = null;
    };

    const highlightSource = (source) => {
      clearHighlight();
      if (!(source instanceof HTMLElement)) return;
      activeSource = source;
      source.classList.add("tts-active-source");
      const rect = source.getBoundingClientRect();
      const headerHeight = Number.parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue("--header-height"),
      ) || 62;
      const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
      const playerHeight = player.hidden ? 0 : player.getBoundingClientRect().height;
      const topLimit = headerHeight + 18;
      const bottomLimit = viewportHeight - Math.max(110, playerHeight + 24);
      if (rect.top < topLimit || rect.bottom > bottomLimit) {
        source.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
      }
    };

    const getRate = () => {
      if (!(rateSelect instanceof HTMLSelectElement)) return 1;
      const value = Number(rateSelect.value);
      return Number.isFinite(value) ? value : 1;
    };

    const syncEstimatedTime = () => {
      if (!(estimate instanceof HTMLElement)) return;
      if (!chunks.length) {
        estimate.textContent = "";
        return;
      }
      const words = chunks.reduce((total, chunk) => total + normalize(chunk?.text).split(/\s+/).filter(Boolean).length, 0);
      const baseWordsPerMinute = lang === "en" ? 175 : 165;
      const minutes = Math.max(1, Math.ceil(words / Math.max(1, baseWordsPerMinute * getRate())));
      estimate.textContent = `${minutes} ${copy.minuteApprox}`;
    };

    const getVoiceValue = (voice) => `${voice.name}|||${voice.lang}`;

    const femaleVoiceName = /(female|woman|zira|susan|samantha|victoria|karen|moira|tessa|monica|paulina|sabina|lucia|lucía|elvira|dalia|aria|jenny|helena|sofia|sofía|maria|maría|carmen|isabella|ava|emma|grace)/i;
    const maleVoiceName = /(male|man|david|mark|daniel|guy|jorge|raul|raúl|pablo|diego|antonio|carlos|miguel|juan|andres|andrés|thomas|george|james|mateo|samuel)/i;

    const getVoiceScore = (voice, targetLanguage) => {
      const targetBase = targetLanguage === "en" ? "en" : "es";
      const preferredLocales = targetBase === "en"
        ? ["en-US", "en-GB", "en-AU", "en-CA"]
        : ["es-PE", "es-MX", "es-US", "es-ES", "es-CO", "es-AR"];
      const naturalName = /(natural|neural|premium|enhanced|online|google|siri|aria|jenny|guy|elvira|dalia|paulina|raul|raúl|jorge|lucia|lucía)/i;
      const legacyName = /(desktop|compact|basic|eloquence|espeak|festival)/i;
      const localeIndex = preferredLocales.findIndex((locale) => locale.toLowerCase() === voice.lang?.toLowerCase());
      return (localeIndex >= 0 ? 100 - localeIndex * 8 : 50)
        + (naturalName.test(voice.name) ? 90 : 0)
        + (!voice.localService ? 18 : 0)
        + (voice.default ? 6 : 0)
        - (legacyName.test(voice.name) ? 45 : 0);
    };

    const getRankedVoices = (targetLanguage) => [...voices]
      .filter((voice) => voice.lang?.toLowerCase().startsWith(targetLanguage))
      .sort((a, b) => getVoiceScore(b, targetLanguage) - getVoiceScore(a, targetLanguage) || a.name.localeCompare(b.name));

    const getBestVoice = (targetLanguage) => getRankedVoices(targetLanguage)[0] ?? null;

    const getCuratedProfileVoices = (targetLanguage) => {
      const ranked = getRankedVoices(targetLanguage);
      const female = ranked.filter((voice) => femaleVoiceName.test(voice.name));
      const male = ranked.filter((voice) => maleVoiceName.test(voice.name));
      const used = new Set();
      const pick = (preferred) => {
        const candidate = preferred.find((voice) => !used.has(voice))
          ?? ranked.find((voice) => !used.has(voice))
          ?? preferred[0]
          ?? ranked[0]
          ?? null;
        if (candidate) used.add(candidate);
        return candidate;
      };
      return {
        f1: pick(female),
        f2: pick(female),
        m1: pick(male),
        m2: pick(male),
      };
    };

    const getSelectedVoiceConfiguration = () => {
      const value = voiceSelect instanceof HTMLSelectElement ? voiceSelect.value : "profile:auto";
      const targetLanguage = lang;
      if (value === "profile:auto" || !value) {
        const voice = getBestVoice(targetLanguage);
        return { voice, language: voice?.lang || pageSpeechLang, rateMultiplier: .96, pitch: 1 };
      }

      const profiles = getCuratedProfileVoices(targetLanguage);
      const profileConfig = {
        "profile:f1": { voice: profiles.f1, rateMultiplier: .98, pitch: 1.04 },
        "profile:f2": { voice: profiles.f2, rateMultiplier: .95, pitch: 1.09 },
        "profile:m1": { voice: profiles.m1, rateMultiplier: .97, pitch: .90 },
        "profile:m2": { voice: profiles.m2, rateMultiplier: .94, pitch: .95 },
      };
      const profile = profileConfig[value];
      if (profile) {
        return {
          ...profile,
          language: profile.voice?.lang || pageSpeechLang,
        };
      }

      return { voice: getBestVoice(targetLanguage), language: pageSpeechLang, rateMultiplier: .96, pitch: 1 };
    };

    const stopSpeech = ({ reset = false } = {}) => {
      session += 1;
      synth.cancel();
      playing = false;
      paused = false;
      if (reset) currentIndex = 0;
      clearHighlight();
      setStatus();
      setPlayingUi();
    };

    const speakCurrent = () => {
      if (!chunks.length) chunks = buildChunks();
      if (!chunks.length) {
        if (status instanceof HTMLElement) status.textContent = copy.noContent;
        return;
      }
      currentIndex = Math.max(0, Math.min(currentIndex, chunks.length - 1));
      session += 1;
      const token = session;
      synth.cancel();
      const chunk = chunks[currentIndex];
      const utterance = new Utterance(chunk.text);
      const selectedVoice = getSelectedVoiceConfiguration();
      utterance.lang = selectedVoice.language;
      utterance.rate = Math.max(.6, Math.min(1.6, getRate() * selectedVoice.rateMultiplier));
      utterance.pitch = selectedVoice.pitch;
      utterance.volume = 1;
      if (selectedVoice.voice) utterance.voice = selectedVoice.voice;
      utterance.onstart = () => {
        if (token !== session) return;
        playing = true;
        paused = false;
        setStatus();
        setPlayingUi();
        highlightSource(chunk.source);
      };
      utterance.onend = () => {
        if (token !== session) return;
        if (currentIndex < chunks.length - 1) {
          currentIndex += 1;
          speakCurrent();
        } else {
          playing = false;
          paused = false;
          clearHighlight();
          setStatus();
          setPlayingUi();
        }
      };
      utterance.onerror = (event) => {
        if (token !== session || event.error === "canceled" || event.error === "interrupted") return;
        playing = false;
        paused = false;
        clearHighlight();
        setPlayingUi();
      };
      synth.speak(utterance);
    };

    const openPlayer = ({ autoplay = false } = {}) => {
      document.dispatchEvent(new CustomEvent("bibli:tts-opening"));
      const wasPlaying = playing;
      if (!chunks.length || !wasPlaying) chunks = buildChunks();
      if (!chunks.length) {
        if (status instanceof HTMLElement) status.textContent = copy.noContent;
        return;
      }
      player.hidden = false;
      root.classList.add("is-open");
      syncCollapsedSurface();
      document.dispatchEvent(new CustomEvent("bibli:tts-state", { detail: { open: true, active: playing } }));
      setStatus();
      requestAnimationFrame(() => {
        syncFloatingUiOffset();
        if (close instanceof HTMLButtonElement) close.focus();
      });
      if (autoplay && !wasPlaying) speakCurrent();
    };

    const minimizePlayer = ({ returnFocus = true } = {}) => {
      if (player.hidden) return;
      player.hidden = true;
      root.classList.remove("is-open");
      syncFloatingUiOffset();
      syncCollapsedSurface();
      document.dispatchEvent(new CustomEvent("bibli:tts-state", { detail: { open: false, active: playing } }));
      if (!returnFocus) return;
      const dockTrigger = document.querySelector('[data-dock-action="tts"]');
      if (dockTrigger instanceof HTMLButtonElement) dockTrigger.focus();
      else if (mini instanceof HTMLButtonElement && !mini.hidden) mini.focus();
      else if (getComputedStyle(launcher).display !== "none") launcher.focus();
    };

    const refreshVoices = () => {
      voices = synth.getVoices().filter((voice) => voice.lang?.toLowerCase().startsWith(lang));
      if (!(voiceSelect instanceof HTMLSelectElement)) return;
      const storedVoice = localStorage.getItem(voiceKey) ?? "profile:auto";
      voiceSelect.replaceChildren();

      const addOption = (parent, value, label) => {
        const option = document.createElement("option");
        option.value = value;
        option.textContent = label;
        parent.append(option);
      };

      addOption(voiceSelect, "profile:auto", copy.automaticVoice);
      const femaleGroup = document.createElement("optgroup");
      femaleGroup.label = copy.femaleVoices;
      addOption(femaleGroup, "profile:f1", copy.femaleOne);
      addOption(femaleGroup, "profile:f2", copy.femaleTwo);
      voiceSelect.append(femaleGroup);
      const maleGroup = document.createElement("optgroup");
      maleGroup.label = copy.maleVoices;
      addOption(maleGroup, "profile:m1", copy.maleOne);
      addOption(maleGroup, "profile:m2", copy.maleTwo);
      voiceSelect.append(maleGroup);

      const match = Array.from(voiceSelect.options).some((option) => option.value === storedVoice);
      voiceSelect.value = match ? storedVoice : "profile:auto";
      if (!match && storedVoice !== "profile:auto") localStorage.setItem(voiceKey, "profile:auto");
    };

    const storedRate = localStorage.getItem(rateKey);
    if (rateSelect instanceof HTMLSelectElement && ["0.75", "1", "1.25", "1.5"].includes(storedRate ?? "")) {
      rateSelect.value = storedRate;
    }

    launcher.addEventListener("click", () => openPlayer({ autoplay: true }));
    mini?.addEventListener("click", () => openPlayer({ autoplay: false }));
    close?.addEventListener("click", () => minimizePlayer());
    stop?.addEventListener("click", () => stopSpeech({ reset: false }));
    play?.addEventListener("click", () => {
      if (playing && !paused) {
        synth.pause();
        paused = true;
        setPlayingUi();
      } else if (playing && paused) {
        synth.resume();
        paused = false;
        setPlayingUi();
      } else {
        speakCurrent();
      }
    });
    previous?.addEventListener("click", () => {
      if (!chunks.length) chunks = buildChunks();
      currentIndex = Math.max(0, currentIndex - 1);
      speakCurrent();
    });
    next?.addEventListener("click", () => {
      if (!chunks.length) chunks = buildChunks();
      currentIndex = Math.min(Math.max(0, chunks.length - 1), currentIndex + 1);
      speakCurrent();
    });
    rateSelect?.addEventListener("change", () => {
      if (rateSelect instanceof HTMLSelectElement) localStorage.setItem(rateKey, rateSelect.value);
      syncEstimatedTime();
      if (playing) speakCurrent();
    });
    voiceSelect?.addEventListener("change", () => {
      if (voiceSelect instanceof HTMLSelectElement) localStorage.setItem(voiceKey, voiceSelect.value);
      if (playing) speakCurrent();
    });

    document.addEventListener("bibli:lesson-mode-change", () => {
      if (playing) stopSpeech({ reset: true });
      chunks = [];
      requestAnimationFrame(() => {
        chunks = buildChunks();
        setStatus();
      });
    });

    document.addEventListener("bibli:tts-open", () => openPlayer({ autoplay: !playing }));
    document.addEventListener("bibli:tts-toggle", () => {
      if (player.hidden) openPlayer({ autoplay: !playing });
      else minimizePlayer();
    });
    document.addEventListener("bibli:tts-close", () => { if (!player.hidden) minimizePlayer({ returnFocus: false }); });
    document.addEventListener("bibli:reader-preferences-opening", () => { if (!player.hidden) minimizePlayer({ returnFocus: false }); });
    document.addEventListener("bibli:global-search-opening", () => { if (!player.hidden) minimizePlayer({ returnFocus: false }); });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !player.hidden) minimizePlayer();
    });
    if ("ResizeObserver" in window) {
      new ResizeObserver(() => {
        if (!player.hidden) syncFloatingUiOffset();
      }).observe(player);
    }
    window.addEventListener("beforeunload", () => {
      synth.cancel();
      document.documentElement.style.setProperty("--tts-player-offset", "0px");
      delete document.documentElement.dataset.ttsPlayerOpen;
      delete document.documentElement.dataset.ttsActive;
    });

    refreshVoices();
    synth.addEventListener?.("voiceschanged", refreshVoices);
    if ("onvoiceschanged" in synth) synth.onvoiceschanged = refreshVoices;

    const hasReadableContent = document.querySelector("[data-reader-content]");
    if (hasReadableContent) {
      root.hidden = false;
      launcher.hidden = false;
      setPlayingUi();
      syncCollapsedSurface();
    }
  })();
</script>

